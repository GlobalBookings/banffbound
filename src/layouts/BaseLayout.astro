---
import Header from '../components/Header.astro';
import BookingHeader from '../components/BookingHeader.astro';
import BookingFooter from '../components/BookingFooter.astro';
import Footer from '../components/Footer.astro';
import ExploreMoreBar from '../components/ExploreMoreBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  lastUpdated?: string;
  noindex?: boolean;
  focusedLanding?: boolean;
}

const { title, description = 'Plan Banff, Lake Louise and the nearby towns with practical travel guides, winter adventures, hotel comparisons and free interactive planning tools.', image = 'https://images.unsplash.com/photo-1609198092458-38a293c7ac4b?w=1200&q=80', canonicalUrl, lastUpdated, noindex = false, focusedLanding = false } = Astro.props;
const pageTitle = title === 'Home' ? 'BanffBound — Banff National Park Trip Planner 2026 | Trails, Hotels & Local Tips' : `${title} | BanffBound`;
const canonical = new URL(canonicalUrl || Astro.url.pathname, Astro.site || 'https://banffbound.com');
canonical.search = '';
canonical.hash = '';
const socialImage = new URL(image, Astro.site || 'https://banffbound.com').href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="3hFnttFwDgl3EBATUfxs-nE0IrtdyopWJ1xlgEQPUo8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#1a3a2a">
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" /></noscript>
    {lastUpdated && <meta property="article:modified_time" content={lastUpdated} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="BanffBound" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{pageTitle}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://banffbound.com/#organization',
          name: 'BanffBound',
          url: 'https://banffbound.com',
          logo: {
            '@type': 'ImageObject',
            url: 'https://banffbound.com/favicon.svg',
          },
          sameAs: [],
          description: 'Comprehensive travel guide to Banff National Park, Lake Louise, Jasper, Canmore and the Canadian Rockies.',
        },
        {
          '@type': 'WebSite',
          '@id': 'https://banffbound.com/#website',
          url: 'https://banffbound.com',
          name: 'BanffBound',
          publisher: { '@id': 'https://banffbound.com/#organization' },
          inLanguage: 'en',
          description: 'Your ultimate guide to Banff, Alberta. Discover the best things to do, eat, drink, shop, and experience in the Canadian Rockies.',
        },
        {
          '@type': 'WebPage',
          '@id': canonical.href + '#webpage',
          url: canonical.href,
          name: pageTitle,
          isPartOf: { '@id': 'https://banffbound.com/#website' },
          description: description,
          inLanguage: 'en',
          ...(lastUpdated ? { dateModified: lastUpdated } : {}),
        },
      ],
    })} />

  </head>
  <body data-paid-landing={focusedLanding ? 'true' : undefined} data-pagefind-ignore={noindex ? 'all' : undefined}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {focusedLanding ? <BookingHeader /> : <Header />}
    <main data-pagefind-body id="main-content" role="main" tabindex="-1" style={`margin-top: ${focusedLanding ? 68 : 100}px;`}>
      <slot />
    </main>
    {focusedLanding ? <BookingFooter /> : <Footer />}
    {!focusedLanding && <ExploreMoreBar />}

    <button class="back-to-top" id="back-to-top" aria-label="Back to top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Privacy choices" aria-describedby="cookie-description" hidden>
      <div class="cookie-banner-inner">
        <p id="cookie-description" class="cookie-banner-text">Choose whether to load optional analytics, advertising and booking widgets. You can browse and use booking links without them. <a href="/privacy">Privacy details</a></p>
        <div class="cookie-banner-actions">
          <button type="button" id="cookie-accept" class="cookie-btn cookie-btn-accept">Accept all</button>
          <button type="button" id="cookie-reject" class="cookie-btn cookie-btn-manage">Reject optional</button>
          <button type="button" id="cookie-manage" class="cookie-btn cookie-btn-manage" aria-expanded="false" aria-controls="cookie-preferences">Manage preferences</button>
        </div>
      </div>
      <div id="cookie-preferences" class="cookie-preferences" hidden>
        <div class="cookie-pref-row"><label><input type="checkbox" checked disabled /> <span><strong>Essential</strong> — Saves these choices and supports site functions.</span></label></div>
        <div class="cookie-pref-row"><label><input type="checkbox" id="pref-analytics" /> <span><strong>Analytics</strong> — Google Analytics usage measurement.</span></label></div>
        <div class="cookie-pref-row"><label><input type="checkbox" id="pref-advertising" /> <span><strong>Advertising</strong> — Google Ads measurement and AdSense.</span></label></div>
        <div class="cookie-pref-row"><label><input type="checkbox" id="pref-affiliate" /> <span><strong>Booking widgets</strong> — Embedded Expedia and GetYourGuide content.</span></label></div>
        <p class="cookie-pref-note">Turning a service off reloads this page to stop its code. Ordinary links still open the booking provider, where its own privacy choices apply.</p>
        <button type="button" id="cookie-save" class="cookie-btn cookie-btn-accept">Save preferences</button>
      </div>
      <div class="cookie-banner-status"><p id="cookie-storage-status" role="status" aria-live="polite"></p><button type="button" id="cookie-close" class="cookie-btn cookie-btn-manage" hidden>Close choices</button></div>
    </div>
    <noscript><p class="consent-noscript">Optional analytics, advertising and booking widgets are off when JavaScript is disabled. Ordinary booking links remain available.</p></noscript>

    <script is:inline>
      (function() {
        var btn = document.getElementById('back-to-top');
        if (!btn) return;
        window.addEventListener('scroll', function() {
          if (window.scrollY > 500) {
            btn.classList.add('visible');
          } else {
            btn.classList.remove('visible');
          }
        });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>

    <style is:global>
      .cookie-banner[hidden], .cookie-preferences[hidden], .cookie-banner button[hidden] { display: none !important; }
      .cookie-banner-status { max-width: var(--max-width, 1200px); margin: 0 auto; padding: 0 1.5rem .75rem; }
      .cookie-banner-status:has(p:empty):has(button[hidden]) { display: none; }
      .cookie-banner-status p { font-size: .83rem; line-height: 1.5; }
      .cookie-pref-note { font-size: .8rem; line-height: 1.6; margin: .8rem 0; }
      .consent-noscript { padding: 1rem; text-align: center; font-size: .8rem; }
      .cookie-banner {
        max-height: 90vh; overflow: auto;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 9999;
        background: var(--color-dark, #1a1a1a);
        color: rgba(255,255,255,0.85);
        border-top: 2px solid var(--color-accent, #c8a96e);
        box-shadow: 0 -4px 24px rgba(0,0,0,0.2);
      }

      .cookie-banner-inner {
        max-width: var(--max-width, 1200px);
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
      }

      .cookie-banner-text {
        font-size: 0.88rem;
        line-height: 1.5;
        margin: 0;
      }

      .cookie-banner-text a {
        color: var(--color-accent, #c8a96e);
        text-decoration: underline;
      }

      .cookie-banner-actions {
        display: flex;
        gap: 0.5rem;
        flex-shrink: 0; flex-wrap: wrap;
      }

      .cookie-btn {
        padding: 0.55rem 1.2rem;
        border: none;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        font-family: var(--font-body, 'Source Sans 3', sans-serif);
        transition: all 0.2s ease;
        white-space: nowrap;
      }

      .cookie-btn-accept {
        background: var(--color-accent, #c8a96e);
        color: var(--color-dark, #1a1a1a);
      }

      .cookie-btn-accept:hover {
        background: var(--color-accent-light, #dfc9a0);
      }

      .cookie-btn-manage {
        background: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.8);
      }

      .cookie-btn-manage:hover {
        background: rgba(255,255,255,0.18);
        color: #fff;
      }

      .cookie-preferences {
        max-width: var(--max-width, 1200px);
        margin: 0 auto;
        padding: 0 1.5rem 1rem;
      }

      .cookie-pref-row {
        padding: 0.4rem 0;
        font-size: 0.85rem;
      }

      .cookie-pref-row label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
      }

      .cookie-pref-row input[type="checkbox"] {
        accent-color: var(--color-accent, #c8a96e);
        width: 16px;
        height: 16px;
      }

      .cookie-preferences .cookie-btn {
        margin-top: 0.75rem;
      }

      @media (max-width: 768px) {
        .cookie-banner-inner {
          flex-direction: column;
          align-items: stretch;
          text-align: center;
          gap: 0.75rem;
        }

        .cookie-banner-actions {
          justify-content: center;
        }
      }

      /* Pagefind UI overrides */
      .pagefind-ui__search-input {
        font-family: var(--font-body) !important;
        border-radius: 8px !important;
        border: 2px solid var(--color-bg-alt) !important;
        font-size: 1rem !important;
        padding: 0.7rem 1rem !important;
      }
      .pagefind-ui__search-input:focus {
        border-color: var(--color-primary) !important;
        outline: none !important;
        box-shadow: 0 0 0 3px rgba(26,58,42,0.1) !important;
      }
      .pagefind-ui__result-link {
        color: var(--color-primary) !important;
        font-family: var(--font-heading) !important;
        font-weight: 600 !important;
      }
      .pagefind-ui__result-link:hover { color: var(--color-accent) !important; }
      .pagefind-ui__button {
        background: var(--color-primary) !important;
        border-radius: 8px !important;
      }
      .pagefind-ui__button:hover { background: var(--color-primary-light) !important; }

      /* Back to top */
      .back-to-top {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 900;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--color-primary);
        color: var(--color-white);
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all 0.3s ease;
      }
      .back-to-top.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      .back-to-top:hover {
        background: var(--color-primary-light);
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(0,0,0,0.2);
      }
      @media (max-width: 768px) {
        .back-to-top { bottom: 1.25rem; right: 1.25rem; width: 40px; height: 40px; }
      }
    </style>

    <script>
      import { initConsent } from '../scripts/consent.js';
      import { initTracking } from '../scripts/tracking.js';
      initConsent();
      initTracking();
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>
