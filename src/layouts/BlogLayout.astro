---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WinterStatusNotice from '../components/WinterStatusNotice.astro';
import HotelStaysBanner from '../components/HotelStaysBanner.astro';
import ActivityBookingCTA from '../components/ActivityBookingCTA.astro';
import { blogPosts } from '../data/blogPosts';
import { getArticleBookingContext } from '../data/articleBookingContext';
import { resolveActivityBookingTarget } from '../data/activityCampaignTargets';

interface Props {
  title: string;
  description: string;
  date: string;
  lastUpdated?: string;
  partialCorrectionDate?: string;
  partialCorrectionLabel?: string;
  category: string;
  image: string;
  imageIsIllustrative?: boolean;
  imageNote?: string;
  curatedBookingLinks?: boolean;
  readTime: string;
  slug?: string;
}

const { title, description, date, lastUpdated, partialCorrectionDate, partialCorrectionLabel = 'Hotel location paragraph corrected:', category, image, imageIsIllustrative = false, imageNote = '', curatedBookingLinks = false, readTime, slug } = Astro.props;
const bookingContext = getArticleBookingContext(slug, curatedBookingLinks);
const activityBookingTarget = resolveActivityBookingTarget(slug);

const relatedPosts = blogPosts
  .filter(p => p.category === category && p.slug !== slug && p.title !== title)
  .slice(0, 3);
const formattedDate = new Date(date).toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const isoDate = new Date(date).toISOString();
const modifiedDate = partialCorrectionDate || lastUpdated;
const isoModified = modifiedDate ? new Date(modifiedDate).toISOString() : isoDate;
const formattedModified = modifiedDate
  ? new Date(modifiedDate).toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : formattedDate;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  ...(imageIsIllustrative ? {} : { image: new URL(image, 'https://banffbound.com').href }),
  mainEntityOfPage: `https://banffbound.com/blog/${slug}/`,
  datePublished: isoDate,
  dateModified: isoModified,
  author: {
    '@type': 'Person',
    name: 'Jack Chittenden',
    url: 'https://banffbound.com/about',
    sameAs: ['https://jack.me.uk', 'https://linkedin.com/in/jackchittenden'],
  },
  publisher: {
    '@type': 'Organization',
    name: 'BanffBound',
    url: 'https://banffbound.com',
  },
};
---

<BaseLayout title={title} description={description} image={imageIsIllustrative ? undefined : image} lastUpdated={isoModified}>
  <div class="container">
    <Breadcrumbs items={[
      { label: 'Guides', href: '/blog' },
      { label: category, href: `/blog?category=${encodeURIComponent(category)}` },
      { label: title },
    ]} />
  </div>
  <article class="blog-article"
    data-landing-page={activityBookingTarget ? 'activity-guide' : undefined}
    data-content-id={activityBookingTarget ? slug : undefined}
    data-content-type={activityBookingTarget ? 'activity-guide' : undefined}
    data-paid-affiliate-campaign={activityBookingTarget?.paidCampaignLabel}
    data-affiliate-target-path={activityBookingTarget ? new URL(activityBookingTarget.bookingUrl).pathname : undefined}
    data-offer-id={activityBookingTarget?.offerId}>
    <div class="article-hero">
      <img src={image} alt={imageIsIllustrative ? `Illustrative image; not verified as the place or activity in ${title}` : title} class="article-hero-img" loading="eager" fetchpriority="high" />
      <div class="article-hero-overlay"></div>
      <div class="article-hero-content">
        <span class="badge">{category}</span>
        <h1>{title}</h1>
        <div class="article-meta">
          <a href="/about" class="author-link">Jack Chittenden</a>
          <span>&middot;</span>
          <time datetime={isoDate}>{formattedDate}</time>
          <span>&middot;</span>
          <span>{readTime}</span>
        </div>
      </div>
    </div>
    {imageIsIllustrative && <p class="article-image-note container">{imageNote || 'Illustrative image; not verified as the place or activity described in this guide.'}</p>}
    <div class="expedia-leaderboard container">
      <HotelStaysBanner href={bookingContext.hotelHref} destination={bookingContext.hotelLabel} guideId={slug} />
    </div>
    {activityBookingTarget && <div class="article-booking-start container"><ActivityBookingCTA target={activityBookingTarget} guideId={slug || activityBookingTarget.id} /></div>}
    <div class="article-body container" data-category={category} data-curated-booking={bookingContext.suppressAutomaticCTA ? 'true' : 'false'} data-activity-booking-target={activityBookingTarget?.id}>
      {slug && /winter|ice-walk|hot-springs|snowshoe|ice-skating/.test(slug) && <WinterStatusNotice />}
      <slot />
      <div class="blog-email-capture">
        <p class="blog-email-heading">Enjoyed this guide? Get weekly Banff tips.</p>
        <form action="https://banffbound.us16.list-manage.com/subscribe/post?u=38050436b38afb17f1b30580a&amp;id=c419fe73a6&amp;f_id=002699e0f0" method="post" class="blog-email-form" target="_blank" novalidate>
          <div class="blog-email-group">
            <input type="email" name="EMAIL" placeholder="Your email address" required aria-label="Email address" />
            <button type="submit" class="btn btn-accent">Subscribe</button>
          </div>
          <div aria-hidden="true" style="position: absolute; left: -5000px;"><input type="text" name="b_38050436b38afb17f1b30580a_c419fe73a6" tabindex="-1" value="" /></div>
        </form>
      </div>
      <div class="gyg-widget-container">
        <h2>Recommended Tours & Activities</h2>
        <div class="affiliate-panel" data-affiliate-embed="gyg-auto">
          <p><a href={bookingContext.tourHref} target="_blank" rel="noopener noreferrer sponsored">Browse {bookingContext.tourLabel} activity results on GetYourGuide — affiliate link</a></p>
          <p class="affiliate-embed-status" data-affiliate-status role="status" aria-live="polite">Optional partner content is off. You can use the direct link without enabling it.</p>
          <button type="button" data-open-consent class="affiliate-preferences">Privacy choices</button>
          <div data-affiliate-mount hidden></div>
        </div>
      </div>
      <div class="article-footer">
        <div class="article-updated">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {partialCorrectionDate ? partialCorrectionLabel : 'Last updated:'} <time datetime={isoModified}>{formattedModified}</time>
        </div>
        <div class="author-bio-card">
          <div class="author-bio-avatar">JC</div>
          <div class="author-bio-info">
            <strong>Written by Jack Chittenden</strong>
            <p>Creator of BanffBound. Researching the Canadian Rockies through destination guides, hotel comparisons and practical trip-planning tools.</p>
            <div class="author-bio-links">
              <a href="/about">About Jack</a>
              <a href="https://linkedin.com/in/jackchittenden" target="_blank" rel="noopener">LinkedIn</a>
            </div>
          </div>
        </div>
        {relatedPosts.length > 0 && (
          <div class="related-posts">
            <h3>Related Guides</h3>
            <div class="related-posts-grid">
              {relatedPosts.map(p => (
                <a href={`/blog/${p.slug}`} class="related-post-card">
                  <span class="related-post-category">{p.category}</span>
                  <span class="related-post-title">{p.title}</span>
                  <span class="related-post-meta">{p.readTime}</span>
                </a>
              ))}
            </div>
          </div>
        )}
        <a href="/blog" class="btn btn-outline">&larr; Back to All Guides</a>
        <p class="trip-report-cta">Been to Banff? <a href="/trip-reports">Share your trip report</a> and help fellow travellers plan their adventure.</p>
      </div>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script>
    import { initAffiliateEmbeds } from '../scripts/affiliateEmbeds.js';
    initAffiliateEmbeds();
  </script>
  <script is:inline>
  (function() {
    var body = document.querySelector('.article-body');
    if (!body) return;
    if (body.dataset.curatedBooking === 'true') return;
    if (body.dataset.activityBookingTarget) return;
    var cat = (body.dataset.category || '').toLowerCase();

    // Category-specific CTA config
    var ctaConfig = {
      'hiking': { heading: 'Plan Your Hike', desc: 'Find guided hiking tours and trail-side accommodation in Banff.', btn1: { text: 'Explore 81 Trails', href: '/trails' }, gyg: 'Browse Hiking Tours', gygQ: '&q=hiking' },
      'food & drink': { heading: 'Hungry in Banff?', desc: 'Discover guided food tours and hotels near the best restaurants.', btn1: { text: 'Full Restaurant Guide', href: '/eat-and-drink' }, gyg: 'Food & Drink Tours', gygQ: '&q=food' },
      'accommodation': { heading: 'Find Your Stay', desc: 'Compare 95+ Banff hotels by area, budget and amenities.', btn1: { text: 'Compare 95+ Hotels', href: '/hotel-directory' }, gyg: 'Browse Tours', gygQ: '' },
      'seasonal': { heading: 'Plan Your Season', desc: 'Book seasonal activities and find the best deals on accommodation.', btn1: { text: 'Trip Builder', href: '/trip-builder' }, gyg: 'Seasonal Activities', gygQ: '' },
      'itineraries': { heading: 'Build Your Trip', desc: 'Use our interactive planner to customise your Banff itinerary.', btn1: { text: 'Trip Builder', href: '/trip-builder' }, gyg: 'Browse Tours', gygQ: '' },
      'planning': { heading: 'Plan Your Banff Trip', desc: 'Compare hotels, book tours, and get your park pass sorted.', btn1: { text: 'Compare 95+ Hotels', href: '/hotel-directory' }, gyg: 'Browse Tours', gygQ: '' },
      'tips': { heading: 'Make the Most of Banff', desc: 'Book activities and find accommodation for your trip.', btn1: { text: 'Trip Builder', href: '/trip-builder' }, gyg: 'Browse Activities', gygQ: '' },
    };
    var cfg = ctaConfig[cat] || { heading: 'Plan Your Banff Trip', desc: 'Find hotels, tours, and activities for your Canadian Rockies adventure.', btn1: { text: 'Compare 95+ Hotels', href: '/hotel-directory' }, gyg: 'Browse Tours', gygQ: '' };

    var h2s = body.querySelectorAll('h2');
    if (h2s.length < 2) return;
    var contentH2s = [];
    for (var i = 0; i < h2s.length; i++) {
      if (!h2s[i].closest('.gyg-widget-container')) contentH2s.push(h2s[i]);
    }
    if (contentH2s.length < 2) return;

    var cta = document.createElement('div');
    cta.className = 'mid-article-cta';
    cta.innerHTML =
      '<div class="mid-cta-inner">' +
        '<strong>' + cfg.heading + '</strong>' +
        '<p>' + cfg.desc + '</p>' +
        '<div class="mid-cta-buttons">' +
          '<a href="' + cfg.btn1.href + '" class="mid-cta-btn">' + cfg.btn1.text + '</a>' +
          '<a href="https://www.getyourguide.com/banff-l284/?partner_id=QW960HO' + cfg.gygQ + '" target="_blank" rel="noopener sponsored" class="mid-cta-btn mid-cta-gyg">' + cfg.gyg + '</a>' +
          '<a href="https://www.expedia.ca/Hotel-Search?destination=Banff%2C+Alberta&camref=1101l3MtWX" target="_blank" rel="noopener sponsored" class="mid-cta-btn mid-cta-exp">Check Hotel Deals</a>' +
        '</div>' +
      '</div>';
    contentH2s[1].parentNode.insertBefore(cta, contentH2s[1]);

    // Sticky CTA bar — appears after scrolling past hero
    var sticky = document.createElement('div');
    sticky.className = 'sticky-cta-bar';
    sticky.innerHTML =
      '<div class="sticky-cta-inner">' +
        '<span>' + cfg.heading + '</span>' +
        '<div class="sticky-cta-links">' +
          '<a href="' + cfg.btn1.href + '" class="sticky-cta-btn">' + cfg.btn1.text + '</a>' +
          '<a href="https://www.getyourguide.com/banff-l284/?partner_id=QW960HO' + cfg.gygQ + '" target="_blank" rel="noopener sponsored" class="sticky-cta-btn sticky-gyg">' + cfg.gyg + '</a>' +
        '</div>' +
      '</div>';
    document.body.appendChild(sticky);

    var hero = document.querySelector('.article-hero');
    var stickyVisible = false;
    window.addEventListener('scroll', function() {
      var threshold = hero ? hero.offsetHeight + hero.offsetTop : 400;
      var shouldShow = window.scrollY > threshold;
      if (shouldShow !== stickyVisible) {
        stickyVisible = shouldShow;
        sticky.classList.toggle('sticky-visible', shouldShow);
      }
    });
  })();
  </script>
</BaseLayout>

<style>
  .article-image-note { font-size: .85rem; color: var(--color-text-light); padding-top: .75rem; }
  [data-affiliate-mount][hidden] { display: none !important; }
  .affiliate-panel { border: 1px solid #d4d9ce; border-radius: 10px; padding: 1rem; text-align: left; background: var(--color-bg-alt); }
  .affiliate-panel a { text-decoration: underline; text-underline-offset: .15em; }
  .affiliate-embed-status { font-size: .85rem; margin: .6rem 0; }
  .affiliate-preferences { font: inherit; background: transparent; border: 1px solid var(--color-primary); color: var(--color-primary); border-radius: 6px; min-height: 44px; padding: .45rem .8rem; cursor: pointer; }
  [data-affiliate-mount] { margin-top: 1rem; }
  .gyg-widget-container {
    margin: 2.5rem 0;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .gyg-widget-container h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .expedia-leaderboard {
    text-align: center;
    padding: 1.5rem 0 0;
    max-width: 1040px;
    margin: 0 auto;
  }
  .article-booking-start { max-width: 1040px; }

  .article-hero {
    position: relative;
    height: 50vh;
    min-height: 400px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .article-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 60%);
  }

  .article-hero-content {
    position: relative;
    z-index: 2;
    color: var(--color-white);
    padding: 3rem;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
  }

  .article-hero-content h1 {
    color: var(--color-white);
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.5rem 0;
    max-width: 800px;
  }

  .article-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .article-meta :global(.author-link) {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
  }

  .article-body {
    max-width: 800px;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .article-body :global(.article-table-scroll) { overflow-x: auto; max-width: 100%; margin: 1.5rem 0; border: 1px solid #dce1d5; border-radius: 8px; }
  .article-body :global(table) { border-collapse: collapse; width: 100%; font-size: .88rem; min-width: 540px; }
  .article-body :global(th), .article-body :global(td) { padding: .9rem; text-align: left; vertical-align: top; border-bottom: 1px solid #dce1d5; }
  .article-body :global(th) { background: var(--color-primary); color: white; }
  .article-body :global(tr:nth-child(even)) { background: var(--color-bg-alt); }
  .article-body :global(details) { border: 1px solid #dce1d5; border-radius: 8px; padding: 1rem 1.25rem; margin: 1rem 0; }
  .article-body :global(summary) { color: var(--color-primary); cursor: pointer; font-weight: 600; }
  .article-body :global(details p) { margin-top: 1rem; }
  .article-body :global(h2) {
    scroll-margin-top: 125px;
    margin: 2.5rem 0 1rem;
    font-size: 1.8rem;
  }

  .article-body :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: 1.3rem;
  }

  .article-body :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .article-body :global(ul), .article-body :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
    line-height: 1.8;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body :global(strong) {
    color: var(--color-dark);
  }

  .article-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(th a) {
    color: inherit;
  }

  .article-body :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    background: var(--color-bg-alt);
    padding: 1.25rem 1.5rem;
    border-radius: 0 var(--radius) var(--radius) 0;
    margin: 1.5rem 0;
    font-style: italic;
  }

  .article-body :global(.tip-box) {
    background: var(--color-bg-alt);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .article-body :global(.editor-note) {
    background: var(--color-bg-alt);
    border-left: 4px solid #2d6a4f;
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    font-size: 0.97em;
    line-height: 1.6;
  }

  .blog-email-capture {
    margin: 2.5rem 0;
    padding: 2rem;
    border: 2px solid var(--color-bg-alt);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    text-align: center;
  }

  .blog-email-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .blog-email-form {
    max-width: 420px;
    margin: 0 auto;
  }

  .blog-email-group {
    display: flex;
    gap: 0.5rem;
  }

  .blog-email-group input[type="email"] {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 2px solid rgba(0,0,0,0.08);
    border-radius: var(--radius);
    background: var(--color-white);
    font-size: 0.95rem;
    font-family: var(--font-body);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .blog-email-group input[type="email"]:focus {
    border-color: var(--color-accent);
  }

  .blog-email-group .btn {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .article-updated {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-text-light);
  }

  .author-bio-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    width: 100%;
  }

  .author-bio-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    flex-shrink: 0;
    border: 3px solid var(--color-accent);
  }

  .author-bio-info strong {
    font-size: 1rem;
    color: var(--color-dark);
    display: block;
    margin-bottom: 0.35rem;
  }

  .author-bio-info p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }

  .author-bio-links {
    display: flex;
    gap: 1rem;
  }

  .author-bio-links a {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .author-bio-links a:hover {
    color: var(--color-accent);
  }

  .trip-report-cta {
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin-top: 0.5rem;
  }

  .trip-report-cta a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .trip-report-cta a:hover {
    color: var(--color-accent);
  }

  .related-posts {
    margin: 2rem 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .related-posts h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }
  .related-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 0.75rem;
  }
  .related-post-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s, transform 0.15s;
  }
  .related-post-card:hover {
    background: #e8f5ee;
    transform: translateY(-1px);
  }
  .related-post-category {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
  }
  .related-post-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
  }
  .related-post-meta {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  .article-body :global(.mid-article-cta) {
    margin: 2rem 0;
    padding: 1.5rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, #2d6b4a 100%);
    border-radius: var(--radius);
    color: var(--color-white);
  }

  .article-body :global(.mid-cta-inner strong) {
    font-size: 1.1rem;
    color: var(--color-white);
    display: block;
    margin-bottom: 0.25rem;
  }

  .article-body :global(.mid-cta-inner p) {
    color: rgba(255,255,255,0.85);
    margin-bottom: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .article-body :global(.mid-cta-buttons) {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .article-body :global(.mid-cta-btn) {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
