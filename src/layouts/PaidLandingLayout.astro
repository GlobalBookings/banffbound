---
import BaseLayout from './BaseLayout.astro';
interface Props { title:string;description:string;eyebrow:string;heading:string;intro:string;primaryCta:{label:string;href:string};heroImage?:string;heroAlt?:string; }
const {title,description,eyebrow,heading,intro,primaryCta,heroImage,heroAlt='Illustrative travel photograph'}=Astro.props;
const landingId=Astro.url.pathname.split('/').filter(Boolean).at(-1) || '';
---
<BaseLayout title={title} description={description} image={heroImage} lastUpdated="2026-10-29" focusedLanding>
  <div data-landing-page={landingId} class="booking-landing">
    <section class="booking-hero"><div class="booking-hero-inner"><div class="booking-hero-copy"><p class="booking-eyebrow">{eyebrow}</p><h1>{heading}</h1><p class="booking-intro">{intro}</p><a class="btn booking-primary" href={primaryCta.href} data-landing-id={landingId} data-landing-placement="hero">{primaryCta.label}<span aria-hidden="true">→</span></a><p class="booking-disclosure">Independent BanffBound guide. We may earn a commission from qualifying bookings through affiliate links.</p></div><div class="booking-hero-detail">{heroImage&&<img src={heroImage} alt={heroAlt} class="booking-hero-image" loading="eager" fetchpriority="high" />}{Astro.slots.has('hero-detail')?<slot name="hero-detail" />:<div class="booking-steps"><span class="booking-small-title">A clearer way to choose</span><ol><li><span>1</span><div><strong>Find your fit</strong><p>Compare the location, layout or experience that matters to your trip.</p></div></li><li><span>2</span><div><strong>Check current options</strong><p>Follow your chosen provider link for dates, the full price and booking terms.</p></div></li><li><span>3</span><div><strong>Book with the provider</strong><p>Complete the reservation on your chosen provider’s website.</p></div></li></ol></div>}</div></div></section>
    <div class="booking-body"><slot /></div>
  </div>
</BaseLayout>
<style>
.booking-hero{background:linear-gradient(125deg,#153b29 5%,#2f5d43 100%);color:#f3f4ed;padding:3.5rem 1.5rem 3.8rem}.booking-hero-inner{max-width:1200px;margin:auto;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:3rem;align-items:center}.booking-eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.15em;font-weight:700;color:#e3c18a;margin-bottom:1rem}.booking-hero h1{color:#fff;font-size:clamp(2.2rem,4.2vw,3.6rem);line-height:1.12;margin:0 0 1.25rem;max-width:700px}.booking-intro{font-size:1.07rem;line-height:1.75;max-width:670px;margin-bottom:1.5rem;color:#e4ece2}.booking-primary{display:inline-flex;gap:1.2rem;align-items:center;justify-content:center;background:#e4bd7c;color:#193e2b;font-size:1rem;padding:1rem 1.4rem;font-weight:750;border:0;border-radius:8px;text-decoration:none}.booking-primary:hover{background:#f1cd93;transform:translateY(-1px)}.booking-primary span{font-size:1.25rem}.booking-disclosure{font-size:.72rem;line-height:1.6;color:#d3dfd2;margin:1rem 0 0;max-width:550px}.booking-hero-detail{min-width:0}.booking-hero-image{display:block;width:100%;max-height:260px;aspect-ratio:16/10;object-fit:cover;border-radius:14px;margin-bottom:1rem}.booking-steps{background:#f5f4e9;color:#25432f;padding:1.6rem;border-radius:14px;box-shadow:0 14px 35px #06211330}.booking-small-title{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;font-weight:800}.booking-steps ol{padding:0;margin:1.2rem 0 0;list-style:none;display:grid;gap:1rem}.booking-steps li{display:flex;gap:.9rem;align-items:flex-start}.booking-steps li>span{display:grid;place-items:center;flex:0 0 30px;height:30px;border:1px solid #a9b99e;border-radius:50%;font-size:.8rem;font-weight:700}.booking-steps strong{font-size:.95rem}.booking-steps p{font-size:.8rem;line-height:1.6;color:#56654f;margin:.2rem 0 0}.booking-body{background:#fafbf7}.booking-body :global(section){scroll-margin-top:88px}.booking-body :global(a:focus-visible),.booking-primary:focus-visible{outline:3px solid #e4b776;outline-offset:4px}@media(max-width:760px){.booking-hero{padding:2.5rem 1.1rem}.booking-hero-inner{grid-template-columns:1fr;gap:1.8rem}.booking-hero h1{font-size:clamp(2.15rem,7vw,3.2rem)}.booking-intro{font-size:1rem}.booking-hero-detail{max-width:650px}.booking-steps{padding:1.25rem}.booking-primary{width:100%}}
</style>
