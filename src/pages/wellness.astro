---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const places = [
  { name:'Banff Upper Hot Springs', kind:'Outdoor public bathing', text:'A developed hot pool on Sulphur Mountain, reached from Mountain Avenue. It is a separate attraction from the Banff Gondola and Cave and Basin.', check:'At our 28 October 2026 review, Parks Canada still listed fall maintenance from October 13 to early November. Confirm reopening before travelling. Normal admission is in person, first-come, first-served; advance reservations are unavailable.', source:'https://parks.canada.ca/pn-np/ab/banff/sources-banff-springs', guide:'/blog/banff-hot-springs-guide/', label:'Plan a pool visit' },
  { name:'Fairmont Spa at Banff Springs', kind:'Booked hotel spa', text:'The spa is inside Fairmont Banff Springs, at 405 Spray Avenue. Spa treatments, thermal access and the hotel’s aquatic pools have separate eligibility and booking arrangements.', check:'Fairmont lists spa access for ages 18+. Ask about non-hotel guest availability, the selected treatment’s facility access and your exact date. A room, salon appointment or restaurant reservation does not automatically include spa access.', source:'https://www.fairmont.com/en/hotels/banff/fairmont-banff-springs/wellness.html', guide:'/blog/banff-wellness-weekend/', label:'Plan a slower weekend' },
  { name:'Kananaskis Nordic Spa / Yora', kind:'Adult spa excursion in Kananaskis Village', text:'This spa is behind Pomeroy Kananaskis Mountain Lodge, outside Banff town. Plan the Highway 1/Highway 40 journey separately from a Banff outing.', check:'At our review it had an October maintenance closure and announced its coming Yora Nordic Spa Kananaskis identity. Operator pages differed over the closure’s final day. Confirm actual reopening, available facilities and your reservation directly. The spa lists an 18+ age requirement; its FAQ describes stairs to pools and other outdoor facilities. Ask about access after the works.', source:'https://knordicspa.com/transformation-journey/', guide:'/towns/kananaskis/', label:'Understand the Kananaskis base' },
];
const faqs = [
  {question:'Can I swim at Cave and Basin?',answer:'No. Cave and Basin is a heritage and interpretation visit, with protected thermal springs. Swimming is not permitted. Banff Upper Hot Springs is a separate public bathing facility; check its operating status before visiting.'},
  {question:'Can I reserve Banff Upper Hot Springs admission?',answer:'Parks Canada lists in-person, first-come, first-served admission. Advance tickets and reservations are not available. Check the current maintenance notice and hours before travelling.'},
  {question:'Does a hotel booking include spa access?',answer:'Only when the selected rate or package explicitly says so. Hotel pools, spa thermal facilities, treatments and classes can have different age, booking and guest-eligibility rules. Confirm directly with the property.'},
  {question:'Is every relaxing activity indoors?',answer:'No. Upper Hot Springs and Nordic hydrotherapy include outdoor areas. Cave and Basin combines indoor exhibits with outdoor parts of the site. For an indoor-focused alternative, check a museum’s current exhibition and opening days.'},
];
---
<BaseLayout title="Banff Wellness & Winter Warm-Ups — Pools, Spas & Slow Days" description="Plan Banff hot springs, conditional hotel spa visits, Cave and Basin and indoor winter alternatives. Check closures, reservations, access needs and transport before booking." lastUpdated="2026-10-28">
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))})} />
  <div class="container"><Breadcrumbs items={[{label:'Wellness & winter warm-ups'}]} /></div>
  <section class="page-hero"><img src="/images/blog/banff-wellness-weekend.webp" alt="Planning a slower mountain break" class="page-hero-bg" loading="eager" fetchpriority="high" /><div class="page-hero-content"><span class="badge">Make room for a slower day</span><h1>Wellness & winter warm-ups</h1><p>A pool visit, a booked treatment, a museum afternoon or simply more time to pause.</p></div></section>
  <section class="section"><div class="container wellness-content"><div class="section-header"><h2>What would feel good today?</h2><p>Choose the outing first, then check its opening, access and journey. “Spa”, “pool” and “historic hot springs” describe different visits.</p></div>
    <div class="choice-box"><label for="warm-up-choice">Choose your kind of slow day</label><select id="warm-up-choice"><option value="">Explore all the choices</option><option value="pool">A public hot pool</option><option value="spa">A reserved spa experience</option><option value="indoor">An indoor-focused outing</option><option value="family">A flexible day with children</option></select><p id="warm-up-advice" aria-live="polite">The options below remain available while you decide.</p></div>
    <aside class="status-note"><strong>Closure checks: 28 October 2026</strong><p>Upper Hot Springs and the Kananaskis spa both had temporary closure notices at review. Dates below are dated planning information, not a confirmation that either has reopened. Use the linked official operator before leaving or paying.</p></aside>
    <div class="wellness-list">{places.map(place=><article class="wellness-card"><div class="wellness-card-body"><span class="wellness-kind">{place.kind}</span><h2>{place.name}</h2><p>{place.text}</p><p class="wellness-details">{place.check}</p><div class="card-links"><a href={place.source} target="_blank" rel="noopener">Check the official information ↗</a><a href={place.guide}>{place.label} →</a></div></div></article>)}</div>
  </div></section>
  <section class="section" style="background:var(--color-bg-alt)"><div class="container wellness-content"><div class="section-header"><h2>A warm break can be cultural, too</h2><p>Choose an indoor focus with room to change the rest of the day.</p></div><div class="grid grid-2"><article class="card"><div class="card-body"><h3>Cave and Basin</h3><p>At 311 Cave Avenue, the historic site offers exhibits, short films and thermal-spring interpretation. It combines indoor and outdoor areas, and its winter schedule does not include every day. The springs are for observing; bathing is not permitted.</p><a class="text-link" href="/blog/cave-and-basin-guide/">Plan a Cave and Basin visit →</a></div></article><article class="card"><div class="card-body"><h3>The Whyte</h3><p>Explore art and heritage at 111 Bear Street in Banff. Check the current exhibitions and holiday closures, and ask the museum about access needs. Leave time for a meal or a short town stop afterwards rather than booking every hour.</p><a class="text-link" href="https://www.whyte.org/visit" target="_blank" rel="noopener">Official visit information ↗</a></div></article></div></div></section>
  <section class="section"><div class="container wellness-content"><h2>Five checks before you commit</h2><ul class="planning-checks"><li><strong>The right admission:</strong> check whether you are buying a treatment, thermal session, hotel pool visit or heritage admission.</li><li><strong>Everyone’s eligibility:</strong> confirm children’s rules, non-guest access and what any accompanying person needs.</li><li><strong>Access that fits:</strong> ask about slopes, steps, lifts, changing facilities and aquatic equipment; a general accessibility label does not describe every part of a visit.</li><li><strong>The whole journey:</strong> check the exact address and actual timetable. Cave Avenue, Mountain Avenue, Spray Avenue and Kananaskis Village are different destinations.</li><li><strong>A flexible finish:</strong> read cancellation terms and leave time to dress, eat and return. A spa stop does not belong in a tight airport connection.</li></ul><p>For a short outdoor break, use an open route suited to the day’s surface and your mobility. Snow, ice and short daylight change an otherwise simple walk. Explore the <a href="/winter">winter guide</a> and <a href="/towns/">town guides</a> for alternatives.</p>
    <div class="stay-box"><h2>Choose a restful base</h2><p>Compare <a href="/winter-stays">winter stays</a> by location, room and transport. Confirm any pool, spa or class inclusion directly with the hotel before reserving.</p><a class="btn" href="https://www.expedia.ca/Hotel-Search?destination=Banff%2C+Alberta&amp;camref=1101l3MtWX" target="_blank" rel="noopener sponsored">Compare Banff accommodation</a><small>Affiliate link: BanffBound may earn a commission. Hotel searches do not reserve spa treatments or attraction entry.</small></div>
    <section class="faq-list"><h2>Common questions</h2>{faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</section><p class="review">Reviewed 28 October 2026 using the official Parks, museum and operator sources linked above. For individual bathing or treatment needs, use the provider’s current guidance.</p>
  </div></section>
</BaseLayout>
<script>
  const select=document.getElementById('warm-up-choice') as HTMLSelectElement;
  const advice=document.getElementById('warm-up-advice')!;
  const suggestions:Record<string,string>={pool:'Start with the current Upper Hot Springs notice. If it is operating, allow for first-come admission and the Mountain Avenue journey. Keep another plan if it is closed.',spa:'Choose a specific treatment or thermal session, then confirm availability, age rules, non-hotel guest access and facilities included. Check the whole return journey.',indoor:'Compare The Whyte’s current exhibitions with Cave and Basin’s open days. Cave and Basin has outdoor sections too, so check how much of the visit suits your needs.',family:'Start with a museum or a flexible town outing. Adult-only spas are a separate plan; confirm eligibility and any childcare arrangement directly rather than assuming it is included.'};
  select?.addEventListener('change',()=>{advice.textContent=suggestions[select.value]||'The options below remain available while you decide.';});
</script>
<style>
 .wellness-content{max-width:1000px}.choice-box,.stay-box{background:var(--color-bg-alt);padding:1.5rem;border-radius:var(--radius);margin-bottom:2rem}.choice-box label{display:block;font-weight:600}.choice-box select{font:inherit;width:100%;max-width:440px;padding:.7rem;border:1px solid #aeb9ad;border-radius:6px;background:white;margin:.7rem 0}.choice-box p{margin:.3rem 0}.status-note{padding:1.2rem 1.4rem;background:#fff3d8;border-left:4px solid #b18c47;border-radius:8px;margin:2rem 0}.status-note p{margin-top:.5rem}.wellness-list{display:flex;flex-direction:column;gap:1.5rem}.wellness-card{background:white;border:1px solid #dce2d8;border-radius:var(--radius);overflow:hidden}.wellness-card-body{padding:1.6rem}.wellness-card-body h2{font-size:1.8rem;margin:.5rem 0 1rem}.wellness-card-body p{margin:.8rem 0;color:var(--color-text-light)}.wellness-kind{font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--color-primary)}.wellness-details{background:var(--color-bg-alt);padding:1rem;border-radius:8px;font-size:.9rem}.card-links{display:flex;flex-wrap:wrap;gap:.8rem 1.4rem;font-size:.9rem}.card-links a,.text-link,.wellness-content p a{color:var(--color-primary);text-decoration:underline;text-underline-offset:3px}.card-body p{margin:.8rem 0}.planning-checks{margin:1.5rem 0;padding-left:1.3rem}.planning-checks li{margin:.75rem 0}.stay-box{margin:2.5rem 0}.stay-box p{margin:1rem 0}.stay-box small{display:block;margin-top:1rem;color:var(--color-text-light);font-size:.8rem}.faq-list details{border-bottom:1px solid #dce2d8;padding:1rem 0}.faq-list summary{font-weight:600;cursor:pointer}.faq-list p{margin-top:.7rem}.review{font-size:.8rem;color:var(--color-text-light);margin-top:2rem}@media(max-width:600px){.wellness-card-body{padding:1.2rem}.card-links{flex-direction:column}.choice-box,.stay-box{padding:1.2rem}}
</style>
