---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WinterStatusNotice from '../components/WinterStatusNotice.astro';
import photoCredits from '../data/winterActivityPhotoCredits.json';
import { activities, activityImageNote } from '../data/activities';
import { activityContextLabels, activityInterestLabels, activityListSchema, activitySearchUrl } from '../data/activityPlanning';

const faqs = [
  { question: 'Does a winter filter show which activities are open today?', answer: 'No. Filters organise planning guides by interest and seasonal context. Confirm current access, operator dates, conditions, participant requirements and transport before choosing an activity.' },
  { question: 'Are the booking links direct reservations for the named activity?', answer: 'Direct operator links lead to the stated source or operator. GetYourGuide links open a marketplace search, where products and destinations may differ. Read the actual itinerary, eligibility, meeting point, inclusions and cancellation terms before paying.' },
  { question: 'How should I choose an activity for a mixed group?', answer: 'Start with the least experienced participant, actual ages and any support needs. Compare the activity format, required effort, weather exposure, transport and warm-up options. Ask the operator about the specific programme rather than relying on a broad difficulty label.' },
];
---

<BaseLayout title="Banff Activities: Winter & Summer Planning Guides" description="Compare 12 Banff-area activity plans with direct sources, seasonal context, readiness questions and transport checks. Choose lessons, rinks, walks and guided outings." lastUpdated="2026-10-29">
  <script type="application/ld+json" set:html={JSON.stringify(activityListSchema(activities))} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) })} />
  <div class="container"><Breadcrumbs items={[{ label: 'Activities' }]} /></div>
  <section class="page-hero">
    <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1600&q=80" alt="" class="page-hero-bg" loading="eager" fetchpriority="high" />
    <div class="page-hero-content"><span class="badge">Choose the experience, then confirm the day</span><h1>Activities in Banff</h1><p>A first ski lesson, a managed rink, a guided sled ride or a summer paddle: compare what each outing asks of your group before you book.</p><p class="image-note">Illustrative mountain image; location and conditions unverified.</p></div>
  </section>
  <section class="section"><div class="container">
    <WinterStatusNotice />
    <div class="planning-note"><h2>Start with four decisions</h2><ol><li><strong>People:</strong> ages, experience, equipment fit and access or support needs.</li><li><strong>Place:</strong> the actual resort, rink, river base or trailhead, rather than a broad “Banff” search label.</li><li><strong>Journey:</strong> pickup, preparation time, return transport and equipment-return deadline.</li><li><strong>Change of plan:</strong> current access, weather terms, cancellation and a shorter or warmer alternative.</li></ol><p>Sources reviewed <time datetime="2026-10-29">29 October 2026</time>, with individual source dates in each guide. These are planning records, not current operation reports. <a href="/what-to-do-today">Plan around today’s conditions</a>.</p></div>

    <form id="activity-filters" class="activity-filters" hidden aria-label="Filter activity planning guides">
      <label>Find an activity<input id="activity-search" type="search" placeholder="Name or planning topic" /></label>
      <label>Seasonal context<select id="activity-season"><option value="all">All seasonal contexts</option>{Object.entries(activityContextLabels).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
      <label>Interest<select id="activity-interest"><option value="all">All interests</option>{Object.entries(activityInterestLabels).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
      <button type="reset" class="btn btn-outline">Reset filters</button>
      <p>Filters organise ideas. They do not assess suitability, current conditions or whether an operator is running.</p>
    </form>
    <p id="activity-result-count" role="status" aria-live="polite">All {activities.length} activity guides</p>
    <noscript><p>All activity guides are shown below. Follow a guide for its readiness, logistics and source checks.</p></noscript>
    <p id="activity-empty" class="planning-note" hidden>No guides match these filters. Reset filters to see all activities.</p>
    <div class="grid grid-3" id="activity-cards">
      {activities.map(activity => <article class="card activity-card" data-seasons={activity.contexts.join(' ')} data-interests={activity.interests.join(' ')} data-search={`${activity.name} ${activity.description} ${activity.locations.map(location => location.name).join(' ')}`.toLowerCase()}>
        <figure><img src={activity.image} alt="" class="card-image" loading="lazy" /><figcaption>{activity.imageNote || activityImageNote}{activity.photoCreditId && photoCredits.filter(credit => credit.id === activity.photoCreditId).map(credit => <span> <a href={credit.sourceUrl} target="_blank" rel="noopener">Photo</a> by <a href={credit.authorUrl} target="_blank" rel="noopener">{credit.author}</a> · <a href={credit.licenseUrl} target="_blank" rel="noopener">{credit.license}</a>. {credit.changeNote}</span>)}</figcaption></figure>
        <div class="card-body"><p class="activity-context">{activity.contexts.map(context => activityContextLabels[context]).join(' · ')}</p><h2><a href={activity.link}>{activity.name}</a></h2><p>{activity.description}</p><dl><div><dt>Timing</dt><dd>{activity.season}</dd></div><div><dt>Preparation</dt><dd>{activity.difficulty}</dd></div></dl><p><strong>First question:</strong> {activity.readiness[0]}</p><a class="guide-link" href={activity.link}>Read {activity.name.toLowerCase()} planning →</a><p class="review-date">Guide reviewed {activity.reviewedAt}</p></div>
      </article>)}
    </div>
  </div></section>
  <section class="section" style="background:var(--color-bg-alt)"><div class="container"><h2>Build the rest of the day</h2><div class="grid grid-3"><div class="card"><div class="card-body"><h3>First snow day</h3><p>Reserve instruction around the right resort, equipment and return journey.</p><p><a href="/learn-to-ski">First lesson guide</a> · <a href="/ski-day-planner">Ski-day planner</a></p></div></div><div class="card"><div class="card-body"><h3>A base that fits the activity</h3><p>Banff, Canmore and Lake Louise have different final transfers and evening options.</p><p><a href="/towns">Compare bases</a> · <a href="/winter-stays">Winter stays</a></p></div></div><div class="card"><div class="card-body"><h3>Return and backup</h3><p>Check actual transport, closures and the weather before committing to the outing.</p><p><a href="/car-free-banff">Car-free planning</a> · <a href="/winter">Winter trip guide</a></p></div></div></div></div></section>
  <section class="section"><div class="container"><h2>Optional booking search</h2><p>Search GetYourGuide for Banff-area tours. This is an affiliate marketplace search, not a verified product, direct operator booking or current-availability report. We may earn a commission if you book through it.</p><a class="btn btn-primary" href={activitySearchUrl('Banff Activities')} target="_blank" rel="noopener sponsored">Search Banff activities on GetYourGuide ↗</a><p>Confirm destination, meeting point, inclusions, eligibility and cancellation on the selected product.</p></div></section>
  <section class="section" style="background:var(--color-bg-alt)"><div class="container"><h2>Activity planning questions</h2>{faqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>
</BaseLayout>

<script>
  const form = document.getElementById('activity-filters');
  const search = document.getElementById('activity-search');
  const season = document.getElementById('activity-season');
  const interest = document.getElementById('activity-interest');
  const cards = Array.from(document.querySelectorAll('.activity-card'));
  const count = document.getElementById('activity-result-count');
  const empty = document.getElementById('activity-empty');
  if (form && search && season && interest && count && empty) {
    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const show = (!query || card.dataset.search.includes(query))
          && (season.value === 'all' || card.dataset.seasons.split(' ').includes(season.value))
          && (interest.value === 'all' || card.dataset.interests.split(' ').includes(interest.value));
        card.hidden = !show;
        if (show) visible++;
      }
      count.textContent = `${visible} of ${cards.length} activity guides`;
      empty.hidden = visible !== 0;
    }
    form.addEventListener('submit', event => event.preventDefault());
    form.addEventListener('input', applyFilters);
    form.addEventListener('change', applyFilters);
    form.addEventListener('reset', event => {
      event.preventDefault();
      search.value = '';
      season.value = 'all';
      interest.value = 'all';
      applyFilters();
    });
    form.hidden = false;
    applyFilters();
  }
</script>

<style>
  .image-note,.review-date {font-size:.78rem;line-height:1.5;opacity:.9}
  .planning-note {padding:1.4rem;background:var(--color-bg-alt);border-left:4px solid var(--color-accent);border-radius:var(--radius);margin:1.5rem 0}
  .planning-note li {margin:.65rem 0;line-height:1.6}
  .activity-filters {display:flex;gap:1rem;flex-wrap:wrap;align-items:end;background:var(--color-bg-alt);padding:1.25rem;border-radius:var(--radius);margin:1.5rem 0}
  .activity-filters[hidden],.activity-card[hidden] {display:none}
  .activity-filters label {display:flex;flex-direction:column;gap:.45rem;font-weight:700;flex:1 1 180px}
  .activity-filters input,.activity-filters select {width:100%;font:inherit;padding:.65rem;background:white;color:var(--color-text);border:1px solid #a9b6ae;border-radius:6px}
  .activity-filters p {flex-basis:100%;margin:0;font-size:.86rem}
  .activity-card figure {margin:0}.activity-card figcaption {font-size:.7rem;color:var(--color-text-light);line-height:1.4;padding:.5rem 1rem}
  .activity-card h2 {font-size:1.35rem}.activity-card h2 a {color:inherit}.activity-context {font-size:.76rem;font-weight:700;color:var(--color-primary)}
  .activity-card dl {font-size:.86rem}.activity-card dl div {margin:.75rem 0}.activity-card dt {font-weight:700}.activity-card dd {margin:0;line-height:1.6}
  .guide-link {font-weight:700}.activity-card .card-body p {line-height:1.65}
  details {padding:1rem 0;border-bottom:1px solid #d6ded8}summary {font-weight:700;cursor:pointer}details p {line-height:1.7;margin:.7rem 0}
  @media(max-width:600px){.activity-filters label{flex-basis:100%}.planning-note{padding:1rem}}
</style>
