---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolDirectoryInteractions from '../components/ToolDirectoryInteractions.astro';

const toolCategories = [
  { name: 'Winter Planning', tools: [
    { href: '/winter', title: 'Find Your Winter Day', desc: 'Search winter guides by interest and explore the season month by month.', icon: '❄️' },
    { href: '/ski-day-planner', title: 'Ski Day Planner', desc: 'A personalised resort day with lessons, rentals, transport and a saved checklist.', icon: '🎿' },
    { href: '/learn-to-ski', title: 'Your First Ski Lesson', desc: 'Compare first-timer options and get ready for the first day on snow.', icon: '⛷️' },
    { href: '/winter-stays', title: 'Winter Stay Finder', desc: 'Filter hotels and lodges by your base and trip priorities.', icon: '🏔️' },
    { href: '/blog/banff-heli-skiing/#heli-ski-planner', title: 'Heli-Ski Trip Questions', desc: 'Compare two BC base journeys and build the transport, overnight and equipment questions for an operator enquiry.', icon: '🚁' },
    { href: '/towns', title: 'Choose a Mountain Base', desc: 'Banff, Canmore, Lake Louise, Field, Golden and Kananaskis compared.', icon: '🏘️' },
  ] },
  {
    name: 'Trip Planning',
    tools: [
      { href: '/trip-cost', title: 'Trip Cost Calculator', desc: 'Build and compare two trip budgets using your own CAD quotes, with explicit cost units, missing items and a reserve.', icon: '💰' },
      { href: '/trip-builder', title: 'Itinerary Builder', desc: 'Edit 1-7 winter or summer days, move outings, save a plan and share your itinerary.', icon: '📋' },
      { href: '/calgary-to-banff', title: 'Calgary to Banff Guide', desc: 'Airport arrival timeline, shuttle options, driving tips, and timing.', icon: '✈️' },
      { href: '/canmore-vs-banff', title: 'Canmore vs Banff', desc: 'Interactive decision tool. Pick your priorities, get a recommendation.', icon: '🏘️' },
      { href: '/monthly-weather', title: 'Weather by Month', desc: 'Sourced temperature normals, packing and access checks for every month.', icon: '🌤️' },
      { href: '/park-pass', title: 'Park Pass & Admission Planner', desc: 'Check the journey, age bands and existing passes, then compare dated daily and Discovery admission fees.', icon: '🎫' },
      { href: '/car-free-banff', title: 'Car-Free Banff', desc: 'Complete guide to visiting without a vehicle. Shuttles, transit, day trips.', icon: '🚌' },
      { href: '/packing-list', title: 'Packing List', desc: 'Activity-specific checklist with optional saved progress, printing and gear links.', icon: '🎒' },
    ],
  },
  { name: 'Dining & Evenings', tools: [
    { href: '/eat-and-drink/#dining-finder', title: 'Dining Finder', desc: 'Filter 32 venue entries by area and meal format, with sourced menus, contacts, booking routes and material notices.', icon: '🍽️' },
    { href: '/blog/banff-nightlife-guide/#evening-planner', title: 'Build a Banff Evening', desc: 'Compare five evening formats and connect the meal, performance or activity with the return journey.', icon: '🌙' },
  ] },
  {
    name: 'Trail Tools',
    tools: [
      { href: '/trail-map', title: 'Interactive Trail Map', desc: 'Trail listings with indicative map points, route filters and official report links.', icon: '🗺️' },
      { href: '/quiet-trails', title: 'Quiet Trail Planning', desc: 'Compare route demands, access, seasons and the full journey.', icon: '🤫' },
      { href: '/alternatives', title: 'Compare Trail Plans', desc: 'Understand different route demands before changing the day.', icon: '🔄' },
      { href: '/parking', title: 'Parking & Transport Planner', desc: 'Match 11 destinations to seasonal access, group needs and the return journey.', icon: '🅿️' },
      { href: '/shuttle-reservations', title: 'Lake Shuttle Planning', desc: 'Compare actual lake services, reservation steps and connections.', icon: '🚐' },
      { href: '/accessible-trails', title: 'Accessible Banff', desc: 'Compare physical trail profiles, visitor features and transport arrangements.', icon: '♿' },
      { href: '/larch-season', title: 'Larch Season Planner', desc: 'Compare five hiking endpoints, seasonal transport and autumn timing with official source links.', icon: '🍂' },
    ],
  },
  {
    name: 'Safety & Wildlife',
    tools: [
      { href: '/wildlife-tracker', title: 'Wildlife Tracker', desc: 'Compare public visitor areas, habitat, species and seasonal access.', icon: '🐻' },
      { href: '/wildlife-safety', title: 'Wildlife Encounters', desc: 'What to do if you meet a bear, elk, cougar, or wolf.', icon: '⚠️' },
      { href: '/bear-spray', title: 'Bear Spray Guide', desc: 'How to use it, where to buy or rent, practice tips.', icon: '🧴' },
      { href: '/solo-hiking', title: 'Solo Hiker Safety', desc: 'Checklist, best trails for solo hikers, emergency contacts.', icon: '🥾' },
      { href: '/emergency-card', title: 'Emergency SOS Card', desc: 'Printable card with emergency numbers, protocols, and GPS coordinates.', icon: '🆘' },
      { href: '/air-quality', title: 'Air Quality Tracker', desc: 'Wildfire smoke risk, AQI scale, and what to do on smoky days.', icon: '💨' },
      { href: '/altitude-guide', title: 'Altitude & Elevation Guide', desc: 'Compare named elevation points, five visitor journeys and the questions for an overnight plan.', icon: '⛰️' },
      { href: '/wildlife-calendar', title: 'Wildlife Calendar', desc: 'Choose your month for wildlife preparation and seasonal context.', icon: '📅' },
    ],
  },
  {
    name: 'Activities & Adventures',
    tools: [
      { href: '/activities', title: 'Activity Planning', desc: 'Seasonal activity choices, practical preparation and current operator sources.', icon: '🏔️' },
      { href: '/paddling', title: 'Paddling Planning', desc: 'Compare lake outings, river options, access and current watercraft rules.', icon: '🛶' },
      { href: '/what-to-do-today', title: 'What to Do Today', desc: 'Choose an outing by season, base, time and interests, then check access.', icon: '☀️' },
      { href: '/icefields-parkway-planner', title: 'Icefields Parkway', desc: 'Build a seasonal stop shortlist, change direction and copy your journey checks.', icon: '🛣️' },
      { href: '/photo-spots', title: 'Photo Spots', desc: 'Compare ten photo destinations by season and light, with actual access checks and sun-time resources.', icon: '📸' },
      { href: '/ski-pass-calculator', title: 'Ski Pass Calculator', desc: 'Compare eligible whole ski plans using your current ticket and pass quotes.', icon: '⛷️' },
      { href: '/via-ferrata', title: 'Via Ferrata Guide', desc: 'Routes, prices, fitness requirements for Mt Norquay.', icon: '🧗' },
      { href: '/camping', title: 'Camping Guide', desc: 'All 12 campgrounds with fees, facilities, and FCFS strategy.', icon: '⛺' },
      { href: '/bird-checklist', title: 'Bird Checklist', desc: '30+ species organized by habitat with checkboxes.', icon: '🐦' },
    ],
  },
  {
    name: 'Family & Accessibility',
    tools: [
      { href: '/family-guide', title: 'Family Guide', desc: 'Activities filtered by child age: toddlers, kids, tweens, teens.', icon: '👨‍👩‍👧‍👦' },
      { href: '/dog-friendly', title: 'Dog-Friendly Guide', desc: 'Trails, restaurants, and hotels that welcome your dog.', icon: '🐕' },
      { href: '/accessible-trails', title: 'Accessible Banff', desc: 'Trail surfaces, widths and slopes, plus adaptive visitor resources.', icon: '♿' },
    ],
  },
  {
    name: 'Lake & Nature Guides',
    tools: [
      { href: '/lake-faq', title: 'Lake FAQ & Science', desc: 'Sourced answers about colour, ice, swimming, watercraft and actual access.', icon: '💧' },
      { href: '/lakes', title: 'Choose a Lake Day', desc: 'Compare 10 lakes by area, trip season and the kind of outing.', icon: '🏔️' },
    ],
  },
];
---

<BaseLayout title="Banff Planning Tools & Guides — Free Trip Planners" description="Find Banff trip planners, trail comparisons, quote-based budgets, ski-day tools, dining and transport guides. Search by topic or browse all planning links for free.">

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Banff Planning Tools',
    description: 'Find Banff trip planners, trail comparisons, quote-based budgets, ski-day tools, dining and transport guides. Search by topic or browse all planning links for free.',
    url: 'https://banffbound.com/tools',
    mainEntity: {
      '@type': 'ItemList',
      name: 'Banff Trip Planning Tools',
      numberOfItems: toolCategories.reduce((acc, cat) => acc + cat.tools.length, 0),
      itemListElement: toolCategories.flatMap((cat, ci) =>
        cat.tools.map((tool, ti) => ({
          '@type': 'ListItem',
          position: toolCategories.slice(0, ci).reduce((sum, category) => sum + category.tools.length, 0) + ti + 1,
          item: {
            '@type': 'WebPage',
            name: tool.title,
            description: tool.desc,
            url: `https://banffbound.com${tool.href}`,
          },
        }))
      ),
    },
  })} />

  <div class="container">
    <Breadcrumbs items={[{ label: 'Planning Tools' }]} />
  </div>

  <section class="tools-hero">
    <div class="container">
      <span class="badge">Free Tools</span>
      <h1>Banff Planning Tools</h1>
      <p>Give your trip a shape. Find a mountain base, compare the whole ski day, build a budget or choose your next meal. Explore the planners and practical guides below.</p>
    </div>
  </section>

  <section class="section" id="tool-directory" aria-labelledby="tools-find-title">
    <div class="container">
      <h2 id="tools-find-title">Find the next piece of your trip</h2>
      <form id="tools-find" hidden><label for="tools-query">Search tools and guides<input id="tools-query" type="search" placeholder="Try lessons, budget or lakes" /></label><label for="tools-category">Topic<select id="tools-category"><option value="all">All topics</option>{toolCategories.map(cat=><option value={cat.name}>{cat.name}</option>)}</select></label><button type="reset">Show all</button></form>
      <p id="tools-status" role="status" aria-live="polite">{toolCategories.reduce((count,cat)=>count+cat.tools.length,0)} guide and tool links</p>
      <p id="tools-empty" hidden>No links match those choices. Try another search or topic, or show all.</p>
      {toolCategories.map(cat => (
        <div class="tool-category" data-tool-category={cat.name}>
          <h2>{cat.name}</h2>
          <div class="tool-grid">
            {cat.tools.map(tool => (
              <a href={tool.href} class="tool-card" data-tool-search={`${tool.title} ${tool.desc} ${tool.href} ${cat.name}`} data-tool-topic={cat.name}>
                <span class="tool-icon">{tool.icon}</span>
                <div class="tool-info">
                  <h3>{tool.title}</h3>
                  <p>{tool.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
  <ToolDirectoryInteractions />
</BaseLayout>

<style>
  .tools-hero{background:var(--color-primary);color:#fff;padding:4rem 0}.tools-hero h1{color:#fff;font-size:clamp(2.4rem,5vw,3.8rem);margin:1rem 0}.tools-hero p{max-width:760px;font-size:1.1rem;line-height:1.85}#tools-find{display:flex;gap:1rem;align-items:end;flex-wrap:wrap;padding:1.25rem;background:var(--color-bg-alt);border-radius:12px;margin:1.5rem 0}#tools-find label{flex:1;min-width:210px;font-size:.85rem;font-weight:700}#tools-find input,#tools-find select{display:block;width:100%;margin-top:.6rem;background:#fff;color:var(--color-text);border:1px solid #aab2ab;border-radius:6px;padding:.75rem;font:inherit}#tools-find button{padding:.75rem 1.1rem;border-radius:6px;border:1px solid var(--color-primary);background:#fff;color:var(--color-primary);font:inherit;font-weight:700;cursor:pointer}#tools-status{font-weight:700;margin-bottom:2rem}#tools-empty{padding:1.5rem;border-radius:10px;background:var(--color-bg-alt);line-height:1.8}#tools-find[hidden],#tools-empty[hidden],.tool-card[hidden],.tool-category[hidden]{display:none}#tools-find :focus-visible{outline:3px solid var(--color-accent);outline-offset:3px}

  .tool-category { margin-bottom: 3rem; }
  .tool-category h2 { font-size: 1.3rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--color-bg-alt); }

  .tool-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .tool-card {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--color-white); border-radius: var(--radius); padding: 1.25rem;
    box-shadow: var(--shadow); text-decoration: none; color: inherit;
    transition: all 0.2s; border-left: 3px solid transparent;
  }
  .tool-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); border-left-color: var(--color-accent); }
  .tool-icon { font-size: 1.8rem; flex-shrink: 0; }
  .tool-info h3 { font-size: 0.95rem; margin-bottom: 0.25rem; }
  .tool-info p { font-size: 0.82rem; color: var(--color-text-light); line-height: 1.4; }

  @media (max-width: 768px) { .tool-grid { grid-template-columns: 1fr; } }
</style>
