---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolDirectoryInteractions from '../components/ToolDirectoryInteractions.astro';

interface DirectoryTool { href: string; title: string; desc: string; topics?: string[]; }
const toolCategories: { name: string; tools: DirectoryTool[] }[] = [
  { name: 'Winter Planning', tools: [
    { href: '/winter', title: 'Find Your Winter Day', desc: 'Search winter guides by interest and explore the season month by month.' },
    { href: '/ski-day-planner', title: 'Ski Day Planner', desc: 'Put lessons, rentals, transport and a checklist in order for a resort day.' },
    { href: '/learn-to-ski', title: 'Your First Ski Lesson', desc: 'Compare first-timer lessons and prepare for the first day on snow.' },
    { href: '/winter-stays', title: 'Winter Stay Finder', desc: 'Filter hotels and lodges by your base and trip priorities.' },
    { href: '/blog/banff-heli-skiing/#heli-ski-planner', title: 'Heli-Ski Trip Questions', desc: 'Compare two BC base journeys and build the transport, overnight and equipment questions for an operator enquiry.' },
    { href: '/towns', title: 'Choose a Mountain Base', desc: 'Banff, Canmore, Lake Louise, Field, Golden and Kananaskis compared.' },
  ] },
  {
    name: 'Trip Planning',
    tools: [
      { href: '/trip-cost', title: 'Trip Cost Calculator', desc: 'Build and compare two trip budgets using your own CAD quotes, with explicit cost units, missing items and a reserve.' },
      { href: '/trip-builder', title: 'Itinerary Builder', desc: 'Edit 1-7 winter or summer days, move outings, save a plan and share your itinerary.' },
      { href: '/calgary-to-banff', title: 'Calgary to Banff Guide', desc: 'Connect the airport, mountain base and return with carrier and driving checks.' },
      { href: '/canmore-vs-banff', title: 'Canmore vs Banff', desc: 'Compare the two bases against your priorities and daily journeys.' },
      { href: '/monthly-weather', title: 'Weather by Month', desc: 'Sourced temperature normals, packing and access checks for every month.' },
      { href: '/park-pass', title: 'Park Pass & Admission Planner', desc: 'Check the journey, age bands and existing passes, then compare dated daily and Discovery admission fees.' },
      { href: '/car-free-banff', title: 'Car-Free Banff', desc: 'Join town transit, regional services and seasonal day-trip connections.' },
      { href: '/packing-list', title: 'Packing List', desc: 'Activity-specific checklist with optional saved progress, printing and gear links.' },
    ],
  },
  { name: 'Dining & Evenings', tools: [
    { href: '/eat-and-drink/#dining-finder', title: 'Dining Finder', desc: 'Filter 32 venue entries by area and meal format, with sourced menus, contacts, booking routes and material notices.' },
    { href: '/blog/banff-nightlife-guide/#evening-planner', title: 'Build a Banff Evening', desc: 'Compare five evening formats and connect the meal, performance or activity with the return journey.' },
  ] },
  {
    name: 'Trail Tools',
    tools: [
      { href: '/trail-map', title: 'Interactive Trail Map', desc: 'Trail listings with indicative map points, route filters and official report links.' },
      { href: '/quiet-trails', title: 'Quiet Trail Planning', desc: 'Compare route demands, access, seasons and the full journey.' },
      { href: '/alternatives', title: 'Compare Trail Plans', desc: 'Understand different route demands before changing the day.' },
      { href: '/parking', title: 'Parking & Transport Planner', desc: 'Match 11 destinations to seasonal access, group needs and the return journey.' },
      { href: '/shuttle-reservations', title: 'Lake Shuttle Planning', desc: 'Compare actual lake services, reservation steps and connections.' },
      { href: '/larch-season', title: 'Larch Season Planner', desc: 'Compare five hiking endpoints, seasonal transport and autumn timing with official source links.' },
    ],
  },
  {
    name: 'Safety & Wildlife',
    tools: [
      { href: '/wildlife-tracker', title: 'Wildlife Area Planning', desc: 'Compare public visitor areas, habitat, species and seasonal access.' },
      { href: '/wildlife-safety', title: 'Wildlife Encounters', desc: 'What to do if you meet a bear, elk, cougar, or wolf.' },
      { href: '/bear-spray', title: 'Bear Spray Guide', desc: 'How to use it, where to buy or rent, practice tips.' },
      { href: '/solo-hiking', title: 'Solo Hiking Preparation', desc: 'Prepare solo-outing questions, a return plan and emergency contacts.' },
      { href: '/emergency-card', title: 'Emergency Reference Card', desc: 'Prepare a printable reference with emergency contacts and outing details.' },
      { href: '/air-quality', title: 'Air Quality & Smoke', desc: 'Find official monitoring links and questions for a change of plan.' },
      { href: '/altitude-guide', title: 'Altitude & Elevation Guide', desc: 'Compare named elevation points, five visitor journeys and the questions for an overnight plan.' },
      { href: '/wildlife-calendar', title: 'Wildlife Calendar', desc: 'Choose your month for wildlife preparation and seasonal context.' },
    ],
  },
  {
    name: 'Activities & Adventures',
    tools: [
      { href: '/activities', title: 'Activity Planning', desc: 'Seasonal activity choices, practical preparation and current operator sources.' },
      { href: '/paddling', title: 'Paddling Planning', desc: 'Compare lake outings, river options, access and current watercraft rules.' },
      { href: '/what-to-do-today', title: 'What to Do Today', desc: 'Choose an outing by season, base, time and interests, then check access.' },
      { href: '/icefields-parkway-planner', title: 'Icefields Parkway', desc: 'Build a seasonal stop shortlist, change direction and copy your journey checks.' },
      { href: '/photo-spots', title: 'Photo Spots', desc: 'Compare ten photo destinations by season and light, with actual access checks and sun-time resources.' },
      { href: '/ski-pass-calculator', title: 'Ski Pass Calculator', desc: 'Compare eligible whole ski plans using your current ticket and pass quotes.' },
      { href: '/via-ferrata', title: 'Via Ferrata Guide', desc: 'Read about Norquay route formats and check current operator requirements.' },
      { href: '/camping', title: 'Camping Guide', desc: 'Explore campground options, then confirm seasonal services and reservations.' },
      { href: '/bird-checklist', title: 'Bird Checklist', desc: 'Use a habitat-based species list with observation checkboxes.' },
    ],
  },
  {
    name: 'Family & Accessibility',
    tools: [
      { href: '/family-guide', title: 'Family Guide', desc: 'Compare family outing ideas by age, season and activity, with eligibility checks.' },
      { href: '/dog-friendly', title: 'Dog-Friendly Guide', desc: 'Connect permitted outings, carrier rules, supervision and a confirmed pet room.' },
      { href: '/accessible-trails', title: 'Accessible Banff', desc: 'Compare physical trail profiles, visitor features and transport arrangements.', topics: ['Family & Accessibility', 'Trail Tools'] },
    ],
  },
  {
    name: 'Lake & Nature Guides',
    tools: [
      { href: '/lake-faq', title: 'Lake FAQ & Science', desc: 'Sourced answers about colour, ice, swimming, watercraft and actual access.' },
      { href: '/lakes', title: 'Choose a Lake Day', desc: 'Compare 10 lakes by area, trip season and the kind of outing.' },
    ],
  },
 ];
const planningStages = [
  { id: 'shape-your-visit', number: '01', title: 'Shape your visit', intro: 'Start with a base, a budget and the days between arrival and departure.', topics: ['Trip Planning', 'Winter Planning'] },
  { id: 'choose-an-outing', number: '02', title: 'Choose one main outing', intro: 'Compare the place, season and approach before adding the next stop.', topics: ['Trail Tools', 'Activities & Adventures', 'Lake & Nature Guides'] },
  { id: 'prepare-your-group', number: '03', title: 'Prepare for the people coming', intro: 'Bring access needs, family arrangements and practical preparation into the plan.', topics: ['Family & Accessibility', 'Safety & Wildlife'] },
  { id: 'finish-the-day', number: '04', title: 'Finish the day', intro: 'Join a meal or an evening out with the journey back to your base.', topics: ['Dining & Evenings'] },
];
const orderedCategories = planningStages.flatMap(stage => stage.topics.map(name => toolCategories.find(category => category.name === name)!));
const toolCount = orderedCategories.reduce((count, category) => count + category.tools.length, 0);
---

<BaseLayout title="Banff Planning Tools & Guides — Free Trip Planners" description="Find Banff trip planners, trail comparisons, quote-based budgets, ski-day tools, dining and transport guides. Search by topic or browse all planning links for free.">

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Banff Planning Tools',
    description: 'Find Banff trip planners, trail comparisons, quote-based budgets, ski-day tools, dining and transport guides. Search by topic or browse all planning links for free.',
    url: 'https://banffbound.com/tools',
    mainEntity: {
      '@type': 'ItemList',
      name: 'Banff Trip Planning Tools',
      numberOfItems: toolCount,
      itemListElement: orderedCategories.flatMap((cat, ci) =>
        cat.tools.map((tool, ti) => ({
          '@type': 'ListItem',
          position: orderedCategories.slice(0, ci).reduce((sum, category) => sum + category.tools.length, 0) + ti + 1,
          item: {
            '@type': 'WebPage',
            name: tool.title,
            description: tool.desc,
            url: `https://banffbound.com${tool.href}`,
          },
        }))
      ),
    },
  })} />

  <div class="container">
    <Breadcrumbs items={[{ label: 'Planning Tools' }]} />
  </div>

  <section class="tools-hero">
    <div class="container">
      <span class="tools-eyebrow">Build the trip, one decision at a time</span>
      <h1>Banff Planning Tools</h1>
      <p>Choose the next piece of your trip: a base, an outing, the practical details or a meal. Browse the complete directory in planning order, or search for the question in front of you.</p>
    </div>
  </section>

  <section class="section" id="tool-directory" aria-labelledby="tools-find-title">
    <div class="container">
      <h2 id="tools-find-title">Find the next piece of your trip</h2>
      <form id="tools-find" hidden><label for="tools-query">Search tools and guides<input id="tools-query" type="search" placeholder="Try lessons, budget or lakes" /></label><label for="tools-category">Topic<select id="tools-category"><option value="all">All topics</option>{toolCategories.map(cat=><option value={cat.name}>{cat.name}</option>)}</select></label><button type="reset">Show all</button></form>
      <p id="tools-status" role="status" aria-live="polite" aria-atomic="true">{toolCount} guide and tool links</p>
      <noscript><p class="directory-note">All {toolCount} destinations are listed below. Each title opens its planner or guide; no search is needed.</p></noscript>
      <p id="tools-empty" hidden>No links match those choices. Try another search or topic, or show all.</p>
      {planningStages.map(stage => (
        <section class="tool-stage" data-tool-stage={stage.id} aria-labelledby={stage.id}>
          <header class="stage-heading"><span class="stage-number" aria-hidden="true">{stage.number}</span><div><h2 id={stage.id}>{stage.title}</h2><p>{stage.intro}</p></div></header>
          <div class="stage-topics">{stage.topics.map(name => {
            const category = toolCategories.find(item => item.name === name)!;
            return <section class="tool-category" data-tool-category={category.name} aria-label={category.name}>
              <h3 class="topic-heading">{category.name}</h3>
              <ul class="tool-rows">{category.tools.map(tool => (
                <li><a href={tool.href} class="tool-card tool-row" data-tool-search={`${tool.title} ${tool.desc} ${tool.href} ${(tool.topics || [category.name]).join(' ')}`} data-tool-topic={category.name} data-tool-topics={(tool.topics || [category.name]).join('|')}>
                  <div class="tool-info"><h4>{tool.title}</h4><p>{tool.desc}</p>{tool.topics && <span class="cross-topic">Also in {tool.topics.filter(topic => topic !== category.name).join(' · ')}</span>}</div>
                  <span class="row-arrow" aria-hidden="true">→</span>
                </a></li>
              ))}</ul>
            </section>;
          })}</div>
        </section>
      ))}
    </div>
  </section>
  <ToolDirectoryInteractions />
</BaseLayout>

<style>
  .tools-hero { background:var(--color-primary); color:#fff; padding:3.5rem 0 4rem; border-bottom:4px solid var(--color-accent); }
  .tools-eyebrow { color:var(--color-accent); font-size:.8rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .tools-hero h1 { color:#fff; font-size:clamp(2.4rem,5vw,3.8rem); margin:1rem 0; }
  .tools-hero p { max-width:740px; font-size:1.1rem; line-height:1.8; }
  #tool-directory { padding-top:3rem; }
  #tools-find-title { font-size:1.65rem; }
  #tools-find { display:flex; gap:1rem; align-items:end; flex-wrap:wrap; padding:1.25rem 0; border-block:1px solid #c7cfc8; margin:1.5rem 0 1rem; }
  #tools-find label { flex:1; min-width:210px; font-size:.85rem; font-weight:700; }
  #tools-find input,#tools-find select { display:block; width:100%; margin-top:.6rem; background:#fff; color:var(--color-text); border:1px solid #94a196; border-radius:4px; padding:.75rem; font:inherit; }
  #tools-find button { padding:.75rem 1.1rem; border-radius:4px; border:1px solid var(--color-primary); background:var(--color-primary); color:#fff; font:inherit; font-weight:700; cursor:pointer; }
  #tools-status { font-size:.9rem; font-weight:700; margin-bottom:2rem; }
  #tools-empty { padding:1.5rem 0; border-block:1px solid var(--color-accent); line-height:1.8; }
  .directory-note { line-height:1.7; }
  [hidden] { display:none !important; }
  .tool-stage { padding:2rem 0 3rem; border-top:2px solid var(--color-primary); }
  .stage-heading { display:grid; grid-template-columns:3.5rem minmax(0,1fr); gap:1rem; margin-bottom:2rem; }
  .stage-number { color:#87652f; font-family:var(--font-heading); font-size:2rem; line-height:1.2; }
  .stage-heading h2 { margin:0 0 .5rem; font-size:clamp(1.7rem,3vw,2.3rem); }
  .stage-heading p { max-width:660px; margin:0; color:var(--color-text-light); line-height:1.7; }
  .tool-category { display:grid; grid-template-columns:minmax(160px, .8fr) minmax(0, 3fr); gap:2rem; margin:0 0 2rem 4.5rem; }
  .topic-heading { margin:.95rem 0 0; font:700 .8rem/1.6 var(--font-body); text-transform:uppercase; letter-spacing:.06em; color:var(--color-text-light); }
  .tool-rows { margin:0; padding:0; list-style:none; border-top:1px solid #c7cfc8; }
  .tool-row { display:flex; gap:1.5rem; justify-content:space-between; align-items:center; padding:1rem .25rem; border-bottom:1px solid #c7cfc8; text-decoration:none; color:inherit; }
  .tool-info { min-width:0; }
  .tool-info h4 { font-family:var(--font-body); font-size:1.05rem; font-weight:700; line-height:1.5; margin:0 0 .3rem; color:var(--color-primary); }
  .tool-info p { font-size:.9rem; margin:0; color:var(--color-text-light); line-height:1.65; max-width:68ch; }
  .row-arrow { flex-shrink:0; color:#87652f; font-size:1.3rem; }
  .cross-topic { display:block; margin-top:.5rem; font-size:.75rem; color:var(--color-text-light); }
  .tool-row:hover h4 { text-decoration:underline; text-underline-offset:.2em; }
  .tool-row:hover { background:var(--color-bg-alt); }
  #tools-find :focus-visible,.tool-row:focus-visible { outline:3px solid var(--color-accent); outline-offset:3px; }
  @media(max-width:800px) { .tool-category { grid-template-columns:minmax(0,1fr); gap:.65rem; margin-left:4.5rem; } .topic-heading { margin-top:0; } }
  @media(max-width:480px) { .tools-hero { padding:2.5rem 0 3rem; } .stage-heading { grid-template-columns:2rem minmax(0,1fr); gap:.75rem; } .stage-number { font-size:1.5rem; } .tool-category { margin-left:0; } #tools-find label { flex-basis:100%; min-width:0; } .tool-row { gap:.75rem; padding-block:1rem; } }
</style>
