---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WeatherSnapshot from '../components/WeatherSnapshot.astro';
import { cameraLocations, resortReports, weatherSources } from '../data/weatherPlanning';
const faqs = [
  {q:'Where can I check the Banff and Lake Louise forecasts?',a:'Use Environment and Climate Change Canada’s separate destination forecasts and alerts. A town observation, a lakeshore view and conditions at a ski summit describe different places. Local copies are dated and only shown when available and recent.'},
  {q:'Are the webcam pictures live on this page?',a:'Open a provider’s camera viewer to see its images and capture times. This directory does not label stock photographs as live feeds. Cameras can be delayed, dark, obscured or unavailable; check the timestamp in the viewer.'},
  {q:'Does a webcam establish that a ski run, road or lake is safe?',a:'No. A camera shows a limited view. Check the actual resort operating report, road report, trail closures and weather alerts. A snow-covered slope does not establish open lifts, and a frozen-looking lake does not establish suitable ice.'},
  {q:'Why might a local weather value be unavailable?',a:'A source may fail, omit a value or be too old to display. Local copies expire after six hours; source observation and forecast issue times are shown separately when available. Use the official report rather than treating missing data as clear weather.'},
];
---
<BaseLayout title="Banff Weather & Webcams: Forecasts, Mountain Views & Snow Reports" description="Check Banff and Lake Louise forecasts, open official mountain webcams, and find the Big 3 resort reports. Compare the destination, capture time and operating conditions." lastUpdated="2026-10-28">
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))})} />
  <div class="container"><Breadcrumbs items={[{label:'Weather & Webcams'}]} /></div>
  <section class="report-hero"><div class="container"><span class="eyebrow">A clearer view of the day</span><h1>Check the sky.<br />Then check the plan.</h1><p>Banff town, Lake Louise and the mountain summits can have different conditions. Start with the forecast for your destination, compare a camera view, then check the route or activity you intend to use.</p><nav aria-label="Weather page sections"><a href="#weather">Weather reports ↓</a><a href="#cameras">Find a camera ↓</a><a href="#snow-reports">Resort reports ↓</a></nav></div></section>
  <section class="section" id="weather"><div class="container"><WeatherSnapshot /></div></section>
  <section class="section camera-section" id="cameras"><div class="container">
    <div class="section-heading"><span class="eyebrow">Look around before you leave</span><h2>Open a view of the mountains</h2><p>Choose the place, then use the provider’s viewer and capture time. Darkness, weather and camera outages can limit what you see. These links open the actual camera providers.</p></div>
    <div class="camera-filters" aria-label="Filter camera locations" hidden><button type="button" data-camera-filter="all" aria-pressed="true">All views</button><button type="button" data-camera-filter="banff" aria-pressed="false">Banff views</button><button type="button" data-camera-filter="lake-louise" aria-pressed="false">Lake Louise lakeshore</button><button type="button" data-camera-filter="ski" aria-pressed="false">Ski mountains</button></div>
    <p id="camera-count" aria-live="polite">Six provider camera pages to explore.</p>
    <div class="camera-grid">{cameraLocations.map((camera,index)=><article class="camera-card" data-camera-area={camera.area}><span class="camera-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><span class="eyebrow">{camera.kind}</span><h3>{camera.name}</h3><p class="camera-place">{camera.label}</p><p>{camera.note}</p><a href={camera.url} target="_blank" rel="noopener">Open camera viewer ↗</a></article>)}</div>
    <p class="source-note">A camera view does not replace <a href={weatherSources.bulletins} target="_blank" rel="noopener">park closures</a>, the <a href={weatherSources.trails} target="_blank" rel="noopener">trail report</a>, <a href="https://511.alberta.ca/" target="_blank" rel="noopener">Alberta 511</a> or <a href="https://www.drivebc.ca/" target="_blank" rel="noopener">DriveBC</a>.</p>
  </div></section>
  <section class="section" id="snow-reports"><div class="container">
    <div class="section-heading"><span class="eyebrow">Before a ski day</span><h2>Read the mountain’s own report</h2><p>Check open lifts and terrain, wind holds, new snow, the measurement location and report time. Snowfall, settled base depth and a forecast are different measurements; one number cannot describe the whole resort.</p></div>
    <div class="report-grid">{resortReports.map(report=><article><h3>{report.name}</h3><a class="btn" href={report.url} target="_blank" rel="noopener">Official conditions ↗</a><a href={report.guide}>Read our resort guide →</a></article>)}</div>
    <div class="decision-panel"><h3>Turn the report into a realistic day</h3><p>Confirm the lesson or activity, then the transport and final return. Keep a nearby alternative if the original plan stops suiting your group.</p><nav aria-label="Plan after checking weather"><a href="/ski-day-planner">Build a ski day →</a><a href="/what-to-do-today">Choose another outing →</a><a href="/packing-list">Check your packing →</a></nav></div>
  </div></section>
  <section class="section faq-section"><div class="container"><h2>Weather and webcam questions</h2><div class="faqs">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div><p class="source-note">Source links checked 28 October 2026: <a href={weatherSources.banff}>ECCC Banff</a>, <a href={weatherSources.lakeLouise}>ECCC Lake Louise</a>, the named operator camera viewers and each resort’s official report. For trip-season context, use the <a href="/weather">climate guide</a> and <a href="/monthly-weather">month-by-month planner</a>.</p></div></section>
</BaseLayout>
<script>
  const filterBar=document.querySelector<HTMLElement>('.camera-filters');
  const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-camera-filter]'));
  const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-camera-area]'));
  buttons.forEach(button=>button.addEventListener('click',()=>{
    buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
    cards.forEach(card=>{card.hidden=button.dataset.cameraFilter!=='all' && card.dataset.cameraArea!==button.dataset.cameraFilter;});
    const count=document.querySelector('#camera-count');
    if(count) count.textContent=String(cards.filter(card=>!card.hidden).length)+' provider camera pages to explore.';
  }));
  if(filterBar) filterBar.hidden=false;
</script>
<style>
  .eyebrow{display:block;text-transform:uppercase;letter-spacing:.09em;font-size:.72rem;font-weight:700;color:#806120;margin-bottom:.7rem}
  .report-hero{background:#173d2d;color:#e1e9e3;padding:4rem 0}.report-hero .eyebrow{color:#e8cb87}.report-hero h1{color:white;font-size:clamp(2.7rem,5.3vw,4.8rem);line-height:1.08;margin:0 0 1.4rem}.report-hero p{max-width:46rem;font-size:1.1rem}
  nav{display:flex;flex-wrap:wrap;gap:.8rem 1.5rem;margin-top:1.5rem}.report-hero a{color:#edce87;font-weight:600}
  #weather,#cameras,#snow-reports{scroll-margin-top:7rem}.section-heading{max-width:52rem;margin-bottom:1.7rem}.section-heading h2{margin-bottom:.8rem}.section-heading p,.camera-card>p,.decision-panel p{color:var(--color-text-light)}
  .camera-section,.faq-section{background:var(--color-bg-alt)}.camera-filters{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.5rem 0 1rem}.camera-filters button{border:1px solid #b9c6b9;background:white;border-radius:2rem;padding:.65rem 1rem;font:inherit;font-size:.86rem;cursor:pointer}.camera-filters button[aria-pressed="true"]{background:var(--color-primary);color:white}
  #camera-count{font-size:.84rem;color:var(--color-text-light);margin-bottom:1.3rem}.camera-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.3rem}.camera-card{border:1px solid #d8e1d9;background:white;border-radius:var(--radius);padding:1.5rem}.camera-number{display:block;font-family:var(--font-heading);font-size:2.3rem;color:#9c7f45;margin-bottom:1.5rem}.camera-card h3{font-size:1.4rem;margin-bottom:.6rem}.camera-card .camera-place{color:var(--color-primary);font-weight:600;font-size:.83rem}.camera-card p{font-size:.9rem;margin-bottom:1rem}.camera-card a{font-weight:600;font-size:.9rem}
  .report-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.3rem}.report-grid article{border:1px solid #d8e1d9;border-radius:var(--radius);padding:1.5rem}.report-grid h3{margin-bottom:1.3rem}.report-grid .btn{display:block;text-align:center;margin-bottom:1rem}.report-grid article>a:last-child{font-size:.9rem}
  .decision-panel{margin-top:2rem;padding:1.8rem;border-radius:var(--radius);background:#f1f4ef}.decision-panel h3{margin-bottom:.7rem}.source-note{font-size:.82rem;color:var(--color-text-light);margin-top:1.7rem;max-width:60rem}.faqs{max-width:58rem}details{border-bottom:1px solid #d8e1d9;padding:1.1rem 0}summary{font-weight:600;cursor:pointer}details p{padding-top:.8rem;color:var(--color-text-light)}
  [hidden]{display:none!important}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #b18a3a;outline-offset:4px}
  @media(max-width:1000px){.camera-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.camera-grid,.report-grid{grid-template-columns:1fr}.report-hero{padding:3rem 0}}
</style>
