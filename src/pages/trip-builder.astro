---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WinterStatusNotice from '../components/WinterStatusNotice.astro';
import { defaultTripPlan, plannerActivities, plannerTemplates, activityById, tripStayUrl, activityFitsSeason } from '../data/tripPlanner';
import '../styles/tripPlanner.css';
const initial = defaultTripPlan();
const faqs = [
  { q:'Can I customise a Banff itinerary?', a:'Yes. Start with a seasonal template, choose your base and transport, then add, remove or reorder activities and days. The builder allows one to seven days with up to three outings each. Keep a full ski, lesson or road day focused on that main activity.' },
  { q:'Does this planner check opening times or make bookings?', a:'No. It organises planning ideas and flags transport or crowded-day tradeoffs. The durations are editorial allowances, not appointment times or driving estimates, and do not include your transfers. Check the linked official information, weather, closures and your booking confirmations before travelling.' },
  { q:'Can I use a summer itinerary in winter?', a:'Choose the winter season instead. Summer-only activities such as the Moraine Lake shuttle, lake canoeing and the Minnewanka cruise are excluded from winter plans. A seasonal category is not a current conditions report. Shared links with incompatible activity selections are rejected.' },
  { q:'Where is my plan saved and what does sharing include?', a:'When browser storage is available, your selections save on this device. A shared link contains the season, base, transport and activity selections. It contains no hotel reservation, booking confirmation or personal contact information. If saving or copying is unavailable, use the displayed link or print the plan.' },
];
---
<BaseLayout title="Banff Trip Builder: Custom Winter & Summer Itineraries" description="Build a Banff itinerary with editable days, winter and summer activities, transport checks and hotel links. Save your plan, share a link or print it for your trip." lastUpdated="2026-10-29">
  <div class="container"><Breadcrumbs items={[{ label:'Trip Builder' }]} /></div>
  <section class="trip-hero"><div class="container"><span class="trip-eyebrow">A good trip has room to breathe</span><h1>Your Banff trip.<br /><em>Make it yours.</em></h1><p>Start with an idea, move a day, leave an afternoon open. Build a winter or summer itinerary around the places and pace that suit you.</p><a href="#your-trip" class="btn btn-accent">Start shaping your trip ↓</a></div></section>
  <div class="container trip-content">
    <div class="trip-context"><p><strong>One main outing is often enough.</strong> Allowances below leave room for a warm drink, a late bus or a change of weather. Check the real opening days, transport and activity availability before booking.</p><a href="/winter">Winter guide →</a><a href="/towns">Compare mountain bases →</a><a href="/ski-day-planner">Plan one ski day →</a></div>
    <WinterStatusNotice />
    <section id="your-trip" class="trip-editor" aria-labelledby="trip-editor-heading">
      <div class="trip-section-heading"><span class="trip-eyebrow">The pieces that shape your days</span><h2 id="trip-editor-heading">First, choose your starting point</h2></div>
      <form id="trip-settings" hidden>
        <div class="trip-settings-grid">
          <label for="trip-season">Season<select id="trip-season"><option value="winter">Winter / snow season</option><option value="summer">Summer / hiking season</option></select></label>
          <label for="trip-base">My overnight base<select id="trip-base"><option value="banff">Banff</option><option value="canmore">Canmore</option><option value="louise">Lake Louise</option></select></label>
          <label for="trip-transport">Getting around<select id="trip-transport"><option value="car-free">Car-free / arranged transfers</option><option value="drive">Driving</option></select></label>
        </div>
        <p class="trip-small">Changing season removes incompatible outings. You can undo the last edit. A car-free selection still needs a confirmed connection for every outing.</p>
        <div class="trip-template-row"><label for="trip-template">Start from a suggested itinerary<select id="trip-template">{plannerTemplates.map(template => <option value={template.id}>{template.season === 'winter' ? 'Winter' : 'Summer'} · {template.name}</option>)}</select></label><button type="button" id="load-trip-template" class="btn btn-primary">Load this idea</button></div>
        <p id="trip-template-description" class="trip-small">{plannerTemplates[0].description}</p>
      </form>
      <p id="trip-week-note" class="trip-small">Planning a week? The two seven-day starts follow our <a href="/blog/7-day-banff-itinerary/">winter and summer week guide</a>. Change the active day for your group, move the slower day when needed and remove the final town placeholder if departure leaves no outing time. These are editable ideas, not booked activities.</p>
      <noscript><p>This is a complete three-day winter example for a Banff base. Enable JavaScript to edit, save and share a plan. The guides, official links and hotel search work without it.</p></noscript>
      <div class="trip-toolbar" id="trip-toolbar" hidden><button type="button" id="trip-add-day">+ Add an open day</button><button type="button" id="trip-undo" disabled>Undo last edit</button><button type="button" id="trip-share">Copy my plan link</button><button type="button" id="trip-print">Print my plan</button><button type="button" id="trip-reset">Start again</button></div>
      <p id="trip-status" role="status" aria-live="polite" class="trip-status"></p>
      <p id="trip-save-status" class="trip-small"></p>
      <div id="trip-share-fallback" hidden><label for="trip-share-link">Select and copy your plan link<input type="text" id="trip-share-link" readonly /></label></div>
      <div class="trip-result-heading"><h2>Your days in the Rockies</h2><p id="trip-summary">3 days · 5 outings · Winter · Banff base</p></div>
      <div id="trip-days" class="trip-days">{initial.days.map((ids,index) => <article class="trip-day"><div class="trip-day-header"><div><span class="trip-eyebrow">Day {index+1}</span><h3 tabindex="-1" id={`trip-day-${index}`}>{ids.length ? `${ids.length} ${ids.length === 1 ? 'outing' : 'outings'}, with room between` : 'An open day'}</h3></div></div><ol class="trip-day-list">{ids.map(id => { const activity = activityById[id]; return <li class="trip-outing"><div class="trip-outing-icon" aria-hidden="true">{activity.icon}</div><div class="trip-outing-content"><div class="trip-outing-title"><h4>{activity.name}</h4><span>{activity.fullDay ? 'Main day activity' : `Allow about ${activity.hours}h`}</span></div><p>{activity.description}</p><div class="trip-outing-links"><a href={activity.guide}>Plan this outing →</a><a href={activity.source} target="_blank" rel="noopener">Official information ↗</a></div></div></li>; })}</ol></article>)}</div>
      <div class="trip-checks" aria-labelledby="trip-checks-heading"><h3 id="trip-checks-heading">Make the connections work</h3><ul id="trip-checks-list"><li>Day 2 needs a confirmed Lake Louise transfer and return connection.</li></ul><p>These checks organise logistics. They do not establish safe terrain, road access, rink opening or a suitable activity for your group.</p></div>
    </section>
    <section id="trip-catalogue" aria-labelledby="trip-catalogue-heading">
      <div class="trip-section-heading"><span class="trip-eyebrow">A little inspiration</span><h2 id="trip-catalogue-heading">What belongs in your trip?</h2><p id="trip-catalogue-note">Winter ideas and year-round town outings. Follow each guide for the details.</p></div>
      <div class="trip-catalogue-controls" id="trip-catalogue-controls" hidden><label for="trip-add-to">Add activities to<select id="trip-add-to">{initial.days.map((_,i) => <option value={i}>Day {i+1}</option>)}</select></label><label for="trip-activity-search">Find an activity<input id="trip-activity-search" type="search" placeholder="Try lessons, skating, culture…" autocomplete="off" /></label></div>
      <p id="trip-catalogue-count" class="trip-small" aria-live="polite"></p>
      <div class="trip-catalogue-grid">{plannerActivities.map(activity => <article class="trip-idea" hidden={!activityFitsSeason(activity, initial.season)} data-activity={activity.id} data-season={activity.season} data-search={`${activity.name} ${activity.description}`.toLowerCase()}><div class="trip-idea-top"><span aria-hidden="true">{activity.icon}</span><span>{activity.season === 'all' ? 'Year-round idea' : activity.season === 'winter' ? 'Winter idea' : 'Summer idea'}</span></div><h3>{activity.name}</h3><p>{activity.description}</p><a href={activity.guide}>Read the planning guide →</a><button class="trip-add-activity" type="button" data-add-activity={activity.id} hidden>Add to Day 1</button></article>)}</div>
      <p id="trip-catalogue-empty" hidden>No activities match. Try a broader search or another season.</p>
      <p class="trip-small">The list deliberately avoids suggesting Johnston Canyon’s main trail or Upper Hot Springs as available during their current reported closures. Use the dated notice and official sources above for reopening updates. For a separate heli-ski extension, see <a href="/blog/banff-heli-skiing">heli-skiing near Banff</a>.</p>
    </section>
    <aside class="trip-stays"><div><span class="trip-eyebrow">Make the morning easier</span><h2>Now find a base that fits.</h2><p id="trip-stay-note">Compare Banff stays, then check the exact address, room type, shuttle stop, total rate and cancellation terms.</p><p class="trip-small">Expedia links are affiliate links. BanffBound may earn a commission if you book.</p></div><div class="trip-stay-actions"><a id="trip-stay-link" class="btn btn-accent" href={tripStayUrl(initial.base)} target="_blank" rel="sponsored noopener">Check Banff stays on Expedia ↗</a><a href="/winter-stays">Compare winter hotel options →</a><a href="/hotel-directory">Browse the full hotel directory →</a></div></aside>
    <section class="trip-faq"><div class="trip-section-heading"><h2>Before you set off</h2></div>{faqs.map(faq => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</section>
    <section class="trip-sources"><h2>How this planner works</h2><p>Reviewed 28 October 2026. Templates and time allowances are editorial suggestions. The linked activity guides and official sources provide the next planning steps. Check <a href="https://parks.canada.ca/pn-np/ab/banff/bulletins">Parks Canada bulletins</a>, <a href="https://roamtransit.com/">Roam Transit</a>, <a href="https://511.alberta.ca/">Alberta 511</a>, <a href="https://www.drivebc.ca/">DriveBC</a> and your booked operator’s current details.</p><p>Summer-only boating, Moraine Lake transport and alpine hiking are separated from winter ideas. Early and late season operations vary. Cave and Basin’s published winter days and temporary closures also need checking; it is a historic site rather than a swimming pool.</p></section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'WebApplication', name:'Banff Trip Builder', url:'https://banffbound.com/trip-builder/', applicationCategory:'TravelApplication', operatingSystem:'Any', browserRequirements:'JavaScript for editing; static example and guide links available without it', offers:{ '@type':'Offer',price:'0',priceCurrency:'CAD' }, description:'A free editable itinerary planner for winter and summer trips to Banff and the nearby towns.' })} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'FAQPage', mainEntity:faqs.map(faq => ({ '@type':'Question', name:faq.q, acceptedAnswer:{ '@type':'Answer',text:faq.a } })) })} />
</BaseLayout>
<script>
  import { defaultTripPlan, createTripPlan, plannerActivities, plannerTemplates, activityById, activityFitsSeason, decodeTripPlan, encodeTripPlan, tripPlanWarnings, tripStayUrl, MAX_DAY_ACTIVITIES, MAX_TRIP_DAYS, type TripPlan } from '../data/tripPlanner';
  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const season = byId<HTMLSelectElement>('trip-season');
  const base = byId<HTMLSelectElement>('trip-base');
  const transport = byId<HTMLSelectElement>('trip-transport');
  const template = byId<HTMLSelectElement>('trip-template');
  const targetDay = byId<HTMLSelectElement>('trip-add-to');
  const search = byId<HTMLInputElement>('trip-activity-search');
  const status = byId('trip-status');
  const saveStatus = byId('trip-save-status');
  const dayList = byId('trip-days');
  const storageKey = 'bb-trip-plan-v2';
  let plan = defaultTripPlan();
  let previous: string | null = null;
  let canSave = true;
  let initialMessage = '';
  const params = new URLSearchParams(location.search);
  const shared = params.get('plan');
  const legacyTemplate = params.get('template');
  const openedIncomingPlan = shared !== null || legacyTemplate !== null;
  if (shared !== null) { const parsed = decodeTripPlan(shared); if (parsed) { plan = parsed; initialMessage = 'Shared plan opened. Your saved trip stays unchanged until you edit this one.'; } else initialMessage = 'That shared plan could not be loaded. A winter example is shown; you can build a fresh plan below.'; }
  else if (legacyTemplate && plannerTemplates.some(item => item.id === legacyTemplate)) plan = createTripPlan(legacyTemplate);
  else {
    try {
      const saved = localStorage.getItem(storageKey);
      const parsed = saved ? decodeTripPlan(saved) : null;
      if (parsed) { plan = parsed; initialMessage = 'Your saved plan is ready to edit.'; }
      else { const oldTemplate = localStorage.getItem('bb-trip-template'); if (oldTemplate && plannerTemplates.some(item => item.id === oldTemplate)) plan = createTripPlan(oldTemplate); }
    } catch { canSave = false; }
  }
  const baseNames = { banff:'Banff', canmore:'Canmore', louise:'Lake Louise' };
  function node<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) {
    const element = document.createElement(tag); element.className = className; if (text) element.textContent = text; return element;
  }
  function link(label: string, href: string, external = false) { const element = node('a','',label); element.href = href; if (external) { element.target = '_blank'; element.rel = 'noopener'; } return element; }
  function button(label: string, action: () => void, disabled = false, name?: string) { const element = node('button','',label); element.type = 'button'; element.disabled = disabled; if (name) element.setAttribute('aria-label',name); element.addEventListener('click',action); return element; }
  function focusDay(index: number) { byId(`trip-day-${Math.max(0,Math.min(index,plan.days.length-1))}`)?.focus(); }
  function updateUrl() { const url = new URL(location.href); url.searchParams.delete('template'); url.searchParams.set('plan',encodeTripPlan(plan)); history.replaceState(null,'',url); }
  function save() {
    if (canSave) { try { localStorage.setItem(storageKey,encodeTripPlan(plan)); } catch { canSave = false; } }
    saveStatus.textContent = canSave ? 'Saved in this browser. Sharing includes your planning choices, not bookings.' : 'Saving is unavailable. Keep a share link or print the plan for later.';
  }
  function edit(change: () => void, message: string, focus?: number) { previous = encodeTripPlan(plan); change(); render(); save(); updateUrl(); status.textContent = message; if (focus !== undefined) focusDay(focus); }
  function renderDays() {
    dayList.replaceChildren();
    plan.days.forEach((ids,index) => {
      const article = node('article','trip-day');
      const header = node('div','trip-day-header');
      const titleWrap = node('div',''); titleWrap.append(node('span','trip-eyebrow',`Day ${index+1}`));
      const title = node('h3','',ids.length ? `${ids.length} ${ids.length === 1 ? 'outing' : 'outings'}, with room between` : 'An open day'); title.id = `trip-day-${index}`; title.tabIndex = -1; titleWrap.append(title); header.append(titleWrap);
      const dayActions = node('div','trip-day-actions trip-no-print');
      dayActions.append(button('Move day earlier',() => edit(() => { [plan.days[index-1],plan.days[index]] = [plan.days[index],plan.days[index-1]]; },`Day moved to position ${index}.`,index-1),index === 0));
      dayActions.append(button('Move day later',() => edit(() => { [plan.days[index+1],plan.days[index]] = [plan.days[index],plan.days[index+1]]; },`Day moved to position ${index+2}.`,index+1),index === plan.days.length-1));
      dayActions.append(button('Remove day',() => edit(() => { plan.days.splice(index,1); },'Day removed. Undo restores it.',index),plan.days.length === 1)); header.append(dayActions); article.append(header);
      if (!ids.length) article.append(node('p','trip-open-day','A rest day, a travel day, or space for something you have not discovered yet. Add an outing from the ideas below.'));
      const list = node('ol','trip-day-list');
      ids.forEach((id,activityIndex) => {
        const activity = activityById[id]; const li = node('li','trip-outing');
        const icon = node('div','trip-outing-icon',activity.icon); icon.setAttribute('aria-hidden','true'); li.append(icon);
        const content = node('div','trip-outing-content'); const titleRow = node('div','trip-outing-title'); titleRow.append(node('h4','',activity.name),node('span','',activity.fullDay ? 'Main day activity' : `Allow about ${activity.hours}h`)); content.append(titleRow,node('p','',activity.description));
        const links = node('div','trip-outing-links'); links.append(link('Plan this outing →',activity.guide),link('Official information ↗',activity.source,true)); content.append(links);
        const actions = node('div','trip-outing-actions trip-no-print');
        actions.append(button('↑ Earlier',() => edit(() => { [ids[activityIndex-1],ids[activityIndex]] = [ids[activityIndex],ids[activityIndex-1]]; },'Outing moved earlier.',index),activityIndex === 0,`Move ${activity.name} earlier in Day ${index+1}`));
        actions.append(button('↓ Later',() => edit(() => { [ids[activityIndex+1],ids[activityIndex]] = [ids[activityIndex],ids[activityIndex+1]]; },'Outing moved later.',index),activityIndex === ids.length-1,`Move ${activity.name} later in Day ${index+1}`));
        actions.append(button('Remove',() => edit(() => { ids.splice(activityIndex,1); },`${activity.name} removed.`,index),false,`Remove ${activity.name} from Day ${index+1}`)); content.append(actions); li.append(content); list.append(li);
      });
      article.append(list); dayList.append(article);
    });
  }
  function updateCatalogue() {
    const term = search.value.trim().toLowerCase(); let count = 0;
    document.querySelectorAll<HTMLElement>('.trip-idea').forEach(card => { const activity = activityById[card.dataset.activity!]; const show = activityFitsSeason(activity,plan.season) && (card.dataset.search || '').includes(term); card.hidden = !show; if (show) count++; });
    const index = Number(targetDay.value) || 0; const selected = plan.days[index] || plan.days[0];
    document.querySelectorAll<HTMLButtonElement>('[data-add-activity]').forEach(add => { const added = selected.includes(add.dataset.addActivity!); add.disabled = added || selected.length >= MAX_DAY_ACTIVITIES; add.textContent = added ? `Already in Day ${index+1}` : selected.length >= MAX_DAY_ACTIVITIES ? `Day ${index+1} has three outings` : `Add to Day ${index+1}`; add.setAttribute('aria-label',`${add.textContent}: ${activityById[add.dataset.addActivity!].name}`); add.hidden = false; });
    byId('trip-catalogue-count').textContent = `${count} ${plan.season} ${count === 1 ? 'idea' : 'ideas'} to explore`;
    byId('trip-catalogue-empty').hidden = count > 0;
  }
  function render() {
    season.value = plan.season; base.value = plan.base; transport.value = plan.transport;
    Array.from(template.options).forEach(option => { option.hidden = plannerTemplates.find(item => item.id === option.value)?.season !== plan.season; });
    if (template.selectedOptions[0]?.hidden) template.value = plannerTemplates.find(item => item.season === plan.season)!.id;
    byId('trip-template-description').textContent = plannerTemplates.find(item => item.id === template.value)?.description || '';
    renderDays();
    const oldTarget = Math.min(Number(targetDay.value)||0,plan.days.length-1); targetDay.replaceChildren(); plan.days.forEach((_,index) => { const option = node('option','',`Day ${index+1}`); option.value = String(index); targetDay.append(option); }); targetDay.value = String(oldTarget);
    byId('trip-summary').textContent = `${plan.days.length} ${plan.days.length === 1 ? 'day' : 'days'} · ${plan.days.flat().length} ${plan.days.flat().length === 1 ? "outing" : "outings"} · ${plan.season === 'winter' ? 'Winter' : 'Summer'} · ${baseNames[plan.base]} base`;
    byId<HTMLButtonElement>('trip-add-day').disabled = plan.days.length >= MAX_TRIP_DAYS; byId<HTMLButtonElement>('trip-undo').disabled = !previous;
    byId('trip-catalogue-note').textContent = `${plan.season === 'winter' ? 'Winter' : 'Summer'} ideas and year-round town outings. Season labels do not confirm current operations.`;
    const checks = byId('trip-checks-list'); checks.replaceChildren(); const warnings = tripPlanWarnings(plan); (warnings.length ? warnings : ['Keep checking your actual booking times, transport, weather and current operations.']).forEach(warning => checks.append(node('li','',warning)));
    const stay = byId<HTMLAnchorElement>('trip-stay-link'); stay.href = tripStayUrl(plan.base); stay.textContent = `Check ${baseNames[plan.base]} stays on Expedia ↗`;
    byId('trip-stay-note').textContent = `Compare ${baseNames[plan.base]} stays, then check the exact address, room type, shuttle stop, total rate and cancellation terms.`;
    byId('trip-share-fallback').hidden = true;
    updateCatalogue();
  }
  byId<HTMLFormElement>('trip-settings').addEventListener('submit',event => event.preventDefault());
  season.addEventListener('change',() => edit(() => { plan.season = season.value as TripPlan['season']; plan.days = plan.days.map(ids => ids.filter(id => activityFitsSeason(activityById[id],plan.season))); },'Season updated. Outings from the other season were removed; undo restores them.'));
  base.addEventListener('change',() => edit(() => { plan.base = base.value as TripPlan['base']; },'Base updated. Check the revised transfers and hotel search.'));
  transport.addEventListener('change',() => edit(() => { plan.transport = transport.value as TripPlan['transport']; },'Transport preference updated. Confirm the actual connections before booking.'));
  template.addEventListener('change',() => { byId('trip-template-description').textContent = plannerTemplates.find(item => item.id === template.value)?.description || ''; });
  byId('load-trip-template').addEventListener('click',() => edit(() => { const next = createTripPlan(template.value); next.base = plan.base; next.transport = plan.transport; plan = next; },'Suggested itinerary loaded. Every day is editable.',0));
  byId('trip-add-day').addEventListener('click',() => { if (plan.days.length < MAX_TRIP_DAYS) edit(() => { plan.days.push([]); },'An open day was added.',plan.days.length); });
  byId('trip-undo').addEventListener('click',() => { const restored = previous ? decodeTripPlan(previous) : null; if (restored) { plan = restored; previous = null; render(); save(); updateUrl(); status.textContent = 'Last edit undone.'; } });
  byId('trip-reset').addEventListener('click',() => edit(() => { plan = defaultTripPlan(); template.value = plannerTemplates[0].id; },'Started again with a winter weekend. Undo restores your previous plan.',0));
  targetDay.addEventListener('change',updateCatalogue); search.addEventListener('input',updateCatalogue);
  document.querySelectorAll<HTMLButtonElement>('[data-add-activity]').forEach(add => add.addEventListener('click',() => { const id = add.dataset.addActivity!; const index = Number(targetDay.value)||0; if (plan.days[index].length < MAX_DAY_ACTIVITIES && !plan.days[index].includes(id) && activityFitsSeason(activityById[id],plan.season)) edit(() => { plan.days[index].push(id); },`${activityById[id].name} added to Day ${index+1}.`); }));
  byId('trip-share').addEventListener('click',async () => { const url = new URL(location.href); url.searchParams.delete('template'); url.searchParams.set('plan',encodeTripPlan(plan)); url.hash = ''; try { await navigator.clipboard.writeText(url.href); status.textContent = 'Plan link copied. It shares your choices, not any bookings.'; } catch { const field = byId<HTMLInputElement>('trip-share-link'); field.value = url.href; byId('trip-share-fallback').hidden = false; field.focus(); field.select(); status.textContent = 'Select and copy your plan link above.'; } });
  byId('trip-print').addEventListener('click',() => window.print());
  if (legacyTemplate && plannerTemplates.some(item => item.id === legacyTemplate)) template.value = legacyTemplate;
  render();
  if (openedIncomingPlan) saveStatus.textContent = 'Your previous saved trip has not been changed. Editing this plan saves it in this browser.';
  else save();
  status.textContent = initialMessage;
  ['trip-settings','trip-toolbar','trip-catalogue-controls'].forEach(id => { byId(id).hidden = false; });
</script>
