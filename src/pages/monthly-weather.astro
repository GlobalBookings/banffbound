---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TemperatureUnits from '../components/TemperatureUnits.astro';
import WinterStatusNotice from '../components/WinterStatusNotice.astro';
import { climateMonths, weatherSources } from '../data/weatherPlanning';
import '../styles/weatherPlanning.css';
const faqs=[
 {q:'Which month is best for a Banff trip?',a:'Start with the activities you want and their confirmed operating calendars. Winter suits resort and snow planning when operations are confirmed; summer supports many lake and hiking outings subject to access. Spring and autumn require more flexibility. No month guarantees open trails, the best snow, lower hotel prices or a particular crowd level.'},
 {q:'What do the monthly high and low temperatures mean?',a:'They are ECCC’s 1991–2020 BANFF composite normal daily maximum and minimum temperatures. They describe historical town-area climate, not the warmest and coldest possible weather, a forecast for this year or mountain summit conditions.'},
 {q:'Does a winter month guarantee skating or snow activities?',a:'No. Check the current managed rink or operator, equipment, weather and access. A season label or a frozen-looking lake does not establish suitable ice, an open route or a running tour.'},
 {q:'How should I compare monthly hotel costs?',a:'Check the same room, dates, occupancy, fees, currency and cancellation terms with the property and provider. Holidays, events and availability can change the total. This planner does not label a month as the cheapest without a current comparable quote.'},
];
---
<BaseLayout title="Banff Weather by Month: Seasonal Plans, Temperatures & Packing" description="Explore all twelve Banff months with sourced temperature normals, practical packing and access checks. Choose a season around confirmed activities and a flexible trip plan." lastUpdated="2026-10-28">
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))})} />
 <div class="container"><Breadcrumbs items={[{label:'Planning Tools',href:'/tools'},{label:'Weather by Month'}]} /></div>
 <section class="weather-hero"><div class="container"><span class="weather-eyebrow">Find the season that fits your plans</span><h1>Your month.<br />Your kind of mountain trip.</h1><p>Choose the experience first, then check the calendar. Use these monthly ideas to shape a trip with room for the weather, your group and a change of plan.</p><nav class="weather-nav" aria-label="Monthly planning"><a href="#months">Explore the months ↓</a><a href="/weather-webcams">Check the current forecast →</a><a href="/winter-stays">Find a winter base →</a></nav></div></section>
 <section class="section"><div class="container"><WinterStatusNotice /><div class="weather-intro"><h2>Explore your travel month</h2><p>Temperatures are <a href={weatherSources.normals} target="_blank" rel="noopener">ECCC BANFF composite 1991–2020 normals</a>: historical daily maximum and minimum, not trip forecasts or extremes. The planning notes are editorial ideas; check the linked operator, road and trail reports for your dates.</p></div>
 <form id="month-controls" class="month-controls" hidden><label for="month-choice">Bring a month into view</label><select id="month-choice"><option value="all">Explore all twelve months</option>{climateMonths.map(m=><option value={m.id}>{m.name}</option>)}</select><button type="button" id="month-reset">Show all months</button></form><TemperatureUnits />
 <p id="month-result" class="weather-source-note" aria-live="polite">Twelve months to explore.</p>
 <div id="months" class="month-grid">{climateMonths.map(m=><article class="month-card" id={m.id} data-month={m.id}><span class="weather-eyebrow">{m.season==='transition'?'A season in transition':m.season==='winter'?'Snow-season planning':'Summer-access planning'}</span><h2>{m.name}</h2><div class="month-temps"><p><span>Normal daily maximum</span><strong data-celsius={m.high}>{m.high.toFixed(1)}°C</strong></p><p><span>Normal daily minimum</span><strong data-celsius={m.low}>{m.low.toFixed(1)}°C</strong></p></div><h3>{m.heading}</h3><p>{m.text}</p><details><summary>Packing and trip-day checks</summary><p><strong>Think about packing:</strong> {m.pack}</p><p><strong>Confirm before leaving:</strong> {m.check}</p></details><nav aria-label={m.name+' planning links'}>{m.links.map(link=><a href={link.href}>{link.name} →</a>)}</nav></article>)}</div>
 <p class="weather-source-note">Temperature source and period are shared with the <a href="/weather">climate guide</a>. These are not current snow depths, live crowd predictions or hotel-price comparisons. For daylight on a specific date, use the <a href={weatherSources.sun} target="_blank" rel="noopener">NRC sun calculator</a> and its interpretation notes. Reviewed 28 October 2026.</p>
 <div class="weather-next"><h3>Put a few good days together</h3><nav aria-label="Build a seasonal trip"><a href="/trip-builder">Editable winter & summer itineraries →</a><a href="/towns">Compare your overnight base →</a><a href="/packing-list">Build your packing checklist →</a><a href="/hotels">Compare researched hotels →</a></nav></div></div></section>
 <section class="section weather-soft"><div class="container"><h2>Month-by-month questions</h2><div class="weather-faqs">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
</BaseLayout>
<script>
 const controls=document.querySelector<HTMLFormElement>('#month-controls');
 const choice=document.querySelector<HTMLSelectElement>('#month-choice');
 const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-month]'));
 const result=document.querySelector('#month-result');
 function showMonth(value:string){const found=cards.find(card=>card.dataset.month===value);cards.forEach(card=>{card.hidden=Boolean(found)&&card!==found;});if(choice)choice.value=found?value:'all';if(result)result.textContent=found?'Showing '+found.querySelector('h2')?.textContent+'. Show all months to compare.':'Twelve months to explore.';}
 if(controls&&choice){controls.hidden=false;controls.addEventListener('submit',event=>event.preventDefault());choice.addEventListener('change',()=>{showMonth(choice.value);history.replaceState(null,'',choice.value==='all'?location.pathname:'#'+choice.value);});document.querySelector('#month-reset')?.addEventListener('click',()=>{showMonth('all');history.replaceState(null,'',location.pathname);});showMonth(location.hash.slice(1));window.addEventListener('hashchange',()=>showMonth(location.hash.slice(1)));}
</script>
<style>
 .month-controls{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;background:#f1f4ef;border-radius:var(--radius);padding:1.2rem;margin:1.5rem 0}.month-controls label{font-weight:600;font-size:.9rem}.month-controls select,.month-controls button{font:inherit;min-height:44px;border:1px solid #acbba9;border-radius:6px;background:white;padding:.6rem .8rem}.month-controls button{cursor:pointer}.month-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin-top:1.4rem}.month-card{padding:1.7rem;border:1px solid #d8e1d9;border-radius:var(--radius);background:white;scroll-margin-top:7rem}.month-card h2{font-size:1.9rem;margin-bottom:1rem}.month-card h3{font-size:1.25rem;margin-bottom:.8rem}.month-card>p,.month-card details p{color:var(--color-text-light);font-size:.94rem}.month-temps{display:flex;gap:1.5rem;border-top:1px solid #d8e1d9;border-bottom:1px solid #d8e1d9;padding:1rem 0;margin-bottom:1.2rem}.month-temps span,.month-temps strong{display:block}.month-temps span{font-size:.7rem;color:var(--color-text-light)}.month-temps strong{font-size:1.5rem;font-weight:600;color:var(--color-primary)}.month-card details{margin-top:1rem;padding-top:1rem;border-top:1px solid #d8e1d9}.month-card summary{font-weight:600;font-size:.9rem;cursor:pointer}.month-card details p{margin-top:.7rem}.month-card nav{display:flex;flex-wrap:wrap;gap:.6rem 1.2rem;margin-top:1.2rem;font-size:.85rem;font-weight:600}@media(max-width:750px){.month-grid{grid-template-columns:1fr}.month-controls select{width:100%}.month-temps{gap:1rem}}
</style>
