---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const GYG_PARTNER_ID = 'QW960HO';

const featuredTours = [
  {
    name: 'Athabasca Glacier & Columbia Icefield Day Trip',
    description: 'Compare the dated itinerary, departure point, transport and any glacier activity included in this listing. Check seasonal operation and the return before planning an Icefields Parkway day.',
    image: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&q=80',
    linkLabel: 'View the Icefields trip listing',
    gygUrl: `https://www.getyourguide.com/banff-l284/athabasca-glacier-columbia-icefield-day-trip-t113074/?partner_id=${GYG_PARTNER_ID}`,
    type: 'Day Trip',
  },
  {
    name: 'Emerald Lake & Takakkaw Falls Tour',
    description: 'Use Banff tour results to compare Yoho itineraries. Confirm that the actual product includes your chosen stops; Takakkaw Falls road access and other outdoor activities are seasonal.',
    image: 'https://images.unsplash.com/photo-1503614472-8c93d56e92ce?w=600&q=80',
    linkLabel: 'Search Banff tour results',
    gygUrl: `https://www.getyourguide.com/banff-l284/?partner_id=${GYG_PARTNER_ID}`,
    type: 'Day Trip',
  },
  {
    name: 'Sunset & Stars Walking Tour',
    description: 'Check this evening-walk listing for its meeting point, walking demands and supplied equipment. Weather and mountain horizons affect the view; sunset colours and visible stars are not guaranteed.',
    image: 'https://images.unsplash.com/photo-1531366936337-7c912a4589a7?w=600&q=80',
    linkLabel: 'View the evening-walk listing',
    gygUrl: `https://www.getyourguide.com/banff-l284/banff-sunset-and-stargazing-evening-walking-tour-t441813/?partner_id=${GYG_PARTNER_ID}`,
    type: 'Evening',
  },
  {
    name: 'Wildlife Safari & Scenic Drive',
    description: 'Compare the wildlife and nature category, then read the actual itinerary, guide credentials, transport and viewing practices. No tour can guarantee that a wild animal will appear.',
    image: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=600&q=80',
    linkLabel: 'Browse the wildlife and nature category',
    gygUrl: `https://www.getyourguide.com/banff-l284/safaris-wildlife-activities-tc40/?partner_id=${GYG_PARTNER_ID}`,
    type: 'Wildlife',
  },
  {
    name: 'Lake Louise & Moraine Lake Tour',
    description: 'Search for the actual lake itinerary and transport arrangement. Moraine Lake journeys are seasonal; confirm the road-access period and do not assume a winter Lake Louise tour also reaches Moraine Lake.',
    image: 'https://images.unsplash.com/photo-1503614472-8c93d56e92ce?w=600&q=80',
    linkLabel: 'Search Banff tour results',
    gygUrl: `https://www.getyourguide.com/banff-l284/?partner_id=${GYG_PARTNER_ID}`,
    type: 'Day Trip',
  },
  {
    name: 'Banff Gondola Experience',
    description: 'Compare sightseeing products in the destination results. Check which gondola, timed entry, return transport and dining are included in the actual product; a search link is not a ticket reservation.',
    image: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=600&q=80',
    linkLabel: 'Search Banff sightseeing products',
    gygUrl: `https://www.getyourguide.com/banff-l284/?partner_id=${GYG_PARTNER_ID}`,
    type: 'Sightseeing',
  },
];

const categories = [
  { label: 'All Tours', icon: '&#127760;', url: `https://www.getyourguide.com/banff-l284/?partner_id=${GYG_PARTNER_ID}` },
  { label: 'Day Trips', icon: '&#128652;', url: `https://www.getyourguide.com/banff-l284/day-trips-tc1/?partner_id=${GYG_PARTNER_ID}` },
  { label: 'Wildlife & Nature', icon: '&#128059;', url: `https://www.getyourguide.com/banff-l284/safaris-wildlife-activities-tc40/?partner_id=${GYG_PARTNER_ID}` },
  { label: 'Winter Sports', icon: '&#9924;', url: `https://www.getyourguide.com/banff-l284/winter-sports-tc26/?partner_id=${GYG_PARTNER_ID}` },
  { label: 'Water Activities', icon: '&#128675;', url: `https://www.getyourguide.com/banff-l284/water-activities-tc8/?partner_id=${GYG_PARTNER_ID}` },
  { label: 'Food & Drink', icon: '&#127860;', url: `https://www.getyourguide.com/banff-l284/food-drink-tc36/?partner_id=${GYG_PARTNER_ID}` },
];
---

<BaseLayout title="Banff Tours & Activities: Compare Listings and Plan the Journey" description="Compare Banff tour listings, categories and destination searches. Check the actual itinerary, season, transport and cancellation terms; optional partner widgets follow your privacy choices." lastUpdated="2026-10-29">
  <div class="container">
    <Breadcrumbs items={[{ label: 'Tours & Adventures' }]} />
  </div>
  <section class="page-hero">
    <img
      src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1600&q=80"
      alt="Illustrative mountain landscape; not a verified photograph of a listed tour"
      class="page-hero-bg"
      loading="eager"
      fetchpriority="high"
    />
    <div class="page-hero-content">
      <span class="badge">Book Adventures</span>
      <h1>Tours & Adventures</h1>
      <p>Compare the outing, meeting point and return before you book. Prices, availability, inclusions and cancellation terms come from the actual product and date.</p>
    </div>
  </section>

  <!-- Category Quick Links -->
  <section class="categories-bar">
    <div class="container">
      <div class="categories-grid">
        {categories.map(cat => (
          <a href={cat.url} target="_blank" rel="noopener noreferrer sponsored" class="category-pill">
            <span set:html={cat.icon}></span>
            <span>{cat.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Tours -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge">Compare the outing</span>
        <h2>Tour ideas and listing links</h2>
        <p>Some links open a specific listing; others open a category or Banff search results, as labelled. Confirm the exact activity and operator there. Images are illustrative stock landscapes, not verified tour photographs.</p>
        <p>Affiliate links: BanffBound may earn a commission from qualifying bookings. These native links work without optional affiliate content.</p>
      </div>
      <div class="grid grid-3">
        {featuredTours.map(tour => (
          <a href={tour.gygUrl} target="_blank" rel="noopener noreferrer sponsored" class="tour-card card">
            <div class="tour-image-wrap">
              <img src={tour.image} alt="Illustrative landscape; not verified as this tour" class="card-image" loading="lazy" />
              <span class="tour-type-badge">{tour.type}</span>
            </div>
            <div class="card-body">
              <h3>{tour.name}</h3>
              <p>{tour.description}</p>
              <span class="book-btn">{tour.linkLabel} &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GetYourGuide Widget -->
  <section class="section" style="background: var(--color-bg-alt);">
    <div class="container">
      <div class="section-header">
        <span class="badge">More Adventures</span>
        <h2>Explore All Banff Activities</h2>
        <p>Use the direct link, or enable optional affiliate content in Privacy choices to request GetYourGuide’s embedded results.</p>
      </div>
      <div class="widget-container" data-affiliate-embed="gyg-activities">
        <p data-affiliate-status role="status" aria-live="polite">Optional partner content is off. You can use the direct link without enabling it.</p>
        <button type="button" data-open-consent class="affiliate-preferences">Privacy choices</button>
        <div data-affiliate-mount hidden></div>
      </div>
      <div class="widget-cta">
        <a href={`https://www.getyourguide.com/banff-l284/?partner_id=${GYG_PARTNER_ID}`}
           target="_blank" rel="noopener noreferrer sponsored" class="btn btn-primary">
          Browse Banff tours on GetYourGuide — affiliate link &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge">Travel Guides</span>
        <h2>Plan Your Banff Adventure</h2>
        <p>Insider guides to help you make the most of your trip.</p>
      </div>
      <div class="grid grid-4">
        <a href="/blog/best-things-to-do-in-banff-2026" class="card" style="display:block;">
          <div class="card-body">
            <h3 style="font-size: 0.95rem;">20 Best Things to Do in Banff</h3>
            <p style="font-size: 0.82rem; color: var(--color-text-light);">Complete activity guide with booking links.</p>
            <span style="font-size: 0.8rem; color: var(--color-accent); font-weight: 600;">Read Guide &rarr;</span>
          </div>
        </a>
        <a href="/blog/3-day-banff-itinerary" class="card" style="display:block;">
          <div class="card-body">
            <h3 style="font-size: 0.95rem;">Perfect 3-Day Itinerary</h3>
            <p style="font-size: 0.82rem; color: var(--color-text-light);">Day-by-day plan for first-time visitors.</p>
            <span style="font-size: 0.8rem; color: var(--color-accent); font-weight: 600;">Read Guide &rarr;</span>
          </div>
        </a>
        <a href="/blog/banff-gondola-tickets-guide" class="card" style="display:block;">
          <div class="card-body">
            <h3 style="font-size: 0.95rem;">Banff Gondola Tickets Guide</h3>
            <p style="font-size: 0.82rem; color: var(--color-text-light);">Prices, discounts & how to book.</p>
            <span style="font-size: 0.8rem; color: var(--color-accent); font-weight: 600;">Read Guide &rarr;</span>
          </div>
        </a>
        <a href="/hotel-directory" class="card" style="display:block;">
          <div class="card-body">
            <h3 style="font-size: 0.95rem;">Where to Stay in Banff</h3>
            <p style="font-size: 0.82rem; color: var(--color-text-light);">Compare 95+ hotels, lodges & inns.</p>
            <span style="font-size: 0.8rem; color: var(--color-accent); font-weight: 600;">Browse Hotels &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initAffiliateEmbeds } from '../scripts/affiliateEmbeds.js';
  initAffiliateEmbeds();
</script>

<style>
  .categories-bar {
    background: var(--color-primary);
    padding: 1.25rem 0;
  }

  .categories-grid {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .categories-grid::-webkit-scrollbar { display: none; }

  .category-pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.2rem;
    background: rgba(255,255,255,0.12);
    color: var(--color-white);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .category-pill:hover {
    background: var(--color-accent);
    color: var(--color-dark);
  }

  .tour-card { display: block; }

  .tour-image-wrap {
    position: relative;
  }

  .tour-image-wrap .card-image {
    height: 200px;
  }

  .tour-type-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
  }

  .tour-rating {
    margin-bottom: 0.5rem;
  }

  .stars {
    color: #f59e0b;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .tour-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(0,0,0,0.06);
  }

  .tour-meta {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .tour-price {
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.95rem;
  }

  .book-btn {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-white);
    background: var(--color-accent);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.2s ease;
    width: 100%;
    text-align: center;
  }

  .tour-card:hover .book-btn {
    background: var(--color-primary);
  }

  .widget-container {
    max-width: 100%;
    margin: 0 auto;
    padding: 1.25rem;
    border: 1px solid #d4d9ce;
    border-radius: 10px;
  }

  .widget-cta {
    text-align: center;
    margin-top: 2rem;
  }
  [data-affiliate-mount][hidden] { display: none !important; }
  [data-affiliate-mount] { margin-top: 1rem; }
  .affiliate-preferences { font: inherit; background: transparent; border: 1px solid var(--color-primary); color: var(--color-primary); border-radius: 6px; min-height: 44px; padding: .45rem .8rem; cursor: pointer; }
</style>
