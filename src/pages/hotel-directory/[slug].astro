---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { directoryHotels as hotels, hotelDirectorySchema, hotelDirectoryPlanningChecks, isHotelDirectoryIndexable } from '../../data/hotelDirectory';

export function getStaticPaths() {
  return hotels.map(hotel => ({
    params: { slug: hotel.slug },
    props: { hotel },
  }));
}

const { hotel } = Astro.props;
const otherHotels = hotels.filter(h => h.slug !== hotel.slug && h.area === hotel.area && h.sourceStatus === 'reviewed').slice(0, 4);
const GYG = 'QW960HO';
const galleryImages = [...new Set([hotel.image, ...(hotel.images || [])].filter((image: unknown): image is string => typeof image === 'string' && image.trim().length > 0))];
const primaryImage = galleryImages[0];
const hasCoordinates = Number.isFinite(hotel.lat) && Number.isFinite(hotel.lng) && Math.abs(hotel.lat) <= 90 && Math.abs(hotel.lng) <= 180;
const hasSourcedCoordinates = hasCoordinates && hotel.coordinateStatus === 'source-verified' && typeof hotel.coordinateSource === 'string' && hotel.coordinateSource.startsWith('https://');
const isDestinationSearch = /\/Hotel-Search(?:[/?#]|$)/i.test(hotel.expediaUrl);
const bookingLabel = isDestinationSearch ? 'Search the area on Expedia' : ['unreviewed', 'former-name'].includes(hotel.sourceStatus) ? 'Open the retained provider listing' : 'Check room options on Expedia';
const bookingNote = isDestinationSearch
  ? 'This opens destination search results, which can include other properties. Confirm the exact property, address and unit, then compare the selected room and final total.'
  : 'Confirm the property address, selected room, final total and booking terms with the provider. Read current guest reviews there before choosing.';
// Legacy descriptions can contain undated prices as well as the old rate fields.
// Omit those sentences rather than presenting them as current room or fee quotes.
const withoutPriceClaims = (text: string) => text.split(/(?<=[.!?])\s+/).filter(sentence => !/\$\s*\d/.test(sentence)).join(' ');
const listedAmenities = (hotel.amenities || hotel.highlights).filter(item => !/\$\s*\d/.test(item));

const areaGuides: Record<string, Array<{href: string; title: string; desc: string}>> = {
  'Yoho National Park': [
    { href: '/towns/field-yoho/', title: 'Field & Yoho travel guide', desc: 'A quiet BC base with a separate winter access plan.' },
    { href: '/blog/banff-winter-driving', title: 'Winter driving', desc: 'Check Alberta and BC route requirements and reports.' },
    { href: '/winter-stays', title: 'Winter stays finder', desc: 'Compare lodge and town-hotel tradeoffs.' },
  ],
  'Downtown Banff': [
    { href: '/blog/where-to-stay-in-banff', title: 'Where to Stay in Banff: Best Areas & Hotels', desc: 'Compare every neighbourhood and budget tier.' },
    { href: '/blog/best-banff-restaurants-where-to-eat', title: 'Best Banff Restaurants', desc: 'Local picks for every budget.' },
    { href: '/blog/3-day-banff-itinerary', title: '3-Day Banff Itinerary', desc: 'First-time visitor? Start here.' },
    { href: '/blog/banff-nightlife-guide', title: 'Banff Nightlife Guide', desc: 'Best bars, pubs & entertainment.' },
  ],
  'Tunnel Mountain': [
    { href: '/blog/where-to-stay-in-banff', title: 'Where to Stay in Banff: Best Areas & Hotels', desc: 'Compare every neighbourhood and budget tier.' },
    { href: '/blog/banff-camping-guide', title: 'Camping in Banff Guide', desc: 'Complete campground guide nearby.' },
    { href: '/blog/best-banff-hiking-trails-guide', title: 'Best Banff Hiking Trails', desc: '15 must-do hikes from your doorstep.' },
    { href: '/blog/3-day-banff-itinerary', title: '3-Day Banff Itinerary', desc: 'First-time visitor? Start here.' },
  ],
  'Lake Louise': [
    { href: '/blog/lake-louise-complete-guide', title: 'Lake Louise Complete Guide', desc: 'Everything you need to know.' },
    { href: '/blog/moraine-lake-guide', title: 'Moraine Lake Guide', desc: 'How to visit in 2026.' },
    { href: '/blog/lake-agnes-tea-house', title: 'Lake Agnes Tea House Hike', desc: 'Iconic hike above Lake Louise.' },
    { href: '/blog/lake-louise-ski-resort', title: 'Lake Louise Ski Resort Guide', desc: 'Largest resort in the Rockies.' },
  ],
  'Canmore': [
    { href: '/blog/where-to-stay-in-banff', title: 'Where to Stay in Banff & Canmore', desc: 'Compare areas and prices.' },
    { href: '/blog/best-banff-hiking-trails-guide', title: 'Best Hiking Trails', desc: '15 must-do hikes in the area.' },
    { href: '/blog/banff-craft-beer-guide', title: 'Craft Beer Guide', desc: 'Breweries and taprooms nearby.' },
    { href: '/blog/banff-trip-cost-budget-guide', title: 'Banff Trip Cost Guide', desc: 'Budget breakdown for your trip.' },
  ],
  'Bow Valley': [
    { href: '/blog/bow-valley-parkway-guide', title: 'Bow Valley Parkway Guide', desc: 'Scenic drive and wildlife.' },
    { href: '/blog/icefields-parkway-guide', title: 'Icefields Parkway Guide', desc: 'Canada\'s most scenic road.' },
    { href: '/blog/johnston-canyon-guide', title: 'Johnston Canyon Guide', desc: 'Nearby canyon hike.' },
    { href: '/blog/banff-wildlife-guide', title: 'Wildlife Viewing Guide', desc: 'Where to see bears, elk & more.' },
  ],
  'Castle Junction': [
    { href: '/blog/bow-valley-parkway-guide', title: 'Bow Valley Parkway Guide', desc: 'Scenic drive and wildlife.' },
    { href: '/blog/johnston-canyon-guide', title: 'Johnston Canyon Guide', desc: 'Nearby canyon hike.' },
    { href: '/blog/banff-wildlife-guide', title: 'Wildlife Viewing Guide', desc: 'Where to see bears, elk & more.' },
    { href: '/blog/7-day-banff-itinerary', title: '7-Day Banff Itinerary', desc: 'Complete week in the Rockies.' },
  ],
};
const relatedGuides = hotel.sourceStatus === 'unreviewed' ? [
  { href: '/towns', title: 'Choose a mountain base', desc: 'Compare actual towns and regional transport before selecting a property.' },
  { href: '/winter-stays', title: 'Reviewed winter stays', desc: 'Compare sourced hotel and lodge examples.' },
  { href: '/vacation-rentals', title: 'Condo and cabin planning', desc: 'Compare room layouts, kitchens and the full journey.' },
] : areaGuides[hotel.area] || areaGuides['Downtown Banff'];

const hotelSchema = hotelDirectorySchema(hotel);
---

<BaseLayout title={`${hotel.name} | Banff Hotel Directory`} description={hotel.sourceStatus === 'unreviewed' ? `Retained directory lead for ${hotel.name}. Current property identity and facilities await source review. Compare reviewed alternatives and confirm the provider listing.` : hotel.description} lastUpdated={hotel.checkedOn} noindex={!isHotelDirectoryIndexable(hotel.slug)}>

  <div class="container">
    <Breadcrumbs items={[
      { label: 'Hotels', href: '/hotel-directory' },
      { label: hotel.area, href: `/hotel-directory?area=${encodeURIComponent(hotel.area)}` },
      { label: hotel.name },
    ]} />
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(hotelSchema)} />

  <!-- Hero with gallery -->
  <section class:list={['hotel-hero', { 'no-photo': galleryImages.length === 0 }]}>
    {galleryImages.length > 0 ? <div class={`hero-gallery${galleryImages.length === 1 ? ' single-image' : ''}`}>
      <div class="hero-main-img">
        <img src={galleryImages[0]} alt={hotel.name} loading="eager" fetchpriority="high" width="1200" height="800" />
      </div>
      {galleryImages.length > 1 && (
        <div class="hero-side-imgs">
          {galleryImages.slice(1, 5).map((img, i) => (
            <div class="hero-thumb">
              <img src={img} alt={`${hotel.name} - View ${i + 2}`} loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </div> : <div class="hero-photo-fallback container"><p>Property photo unavailable. Confirm the exact property and room with the linked source.</p></div>}
    <div class="hero-overlay">
      <div class="container">
        <span class="badge">{hotel.sourceStatusLabel}</span>
        <h1>{hotel.name}</h1>
        <div class="hero-meta">
          <span>{hotel.sourceStatus === 'unreviewed' ? 'Stored classification: ' : ''}{hotel.type}</span>
          <span class="hero-sep">·</span>
          <span>Editorial budget tier: {hotel.priceRange}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container"><p class="photo-caption">{hotel.photoNote}</p></div>

  <!-- Quick booking bar -->
  <div class="booking-strip">
    <div class="container booking-strip-inner">
      <div class="booking-strip-price">
        <span class="strip-label">{isDestinationSearch ? 'Destination search: confirm the exact property or unit' : 'Check your dates for a current total quote'}</span>
      </div>
      <a href={hotel.expediaUrl} target="_blank" rel="noopener sponsored" class="btn btn-accent">
        {bookingLabel} →
      </a>
    </div>
  </div>

  <!-- Main content -->
  <section class="section">
    <div class="container">
      <div class="hotel-layout">
        <div class="hotel-main">

          <aside class="facility-confirmation">
            <h2>{hotel.sourceStatusLabel}</h2>
            <p>{hotel.sourceScope}</p>
            {hotel.operationNote && <p><strong>Operation and identity:</strong> {hotel.operationNote}</p>}
            <p><a href="/winter-stays">Compare winter stays and transport tradeoffs &rarr;</a></p>
            {hotel.facilityNote && <p><strong>Facility notice:</strong> {hotel.facilityNote}</p>}
            {hotel.sourceLinks.length > 0 && <ul>{hotel.sourceLinks.map(source => <li><a href={source.url} target="_blank" rel="noopener">{source.label} &nearr;</a></li>)}</ul>}
            {hotel.checkedOn && <p>Source scope checked <time datetime={hotel.checkedOn}>{hotel.checkedOn}</time>.</p>}
            <p>The provider link is retained separately from the operator sources. Confirm the property identity, address and selected room returned by that link before paying.</p>
            {isDestinationSearch && <p><strong>Provider destination search:</strong> {hotel.providerDestination || 'Check the destination on the provider page'}. This is not a property or unit reservation; confirm its actual address separately.</p>}
          </aside>

          <!-- Overview -->
          {['reviewed', 'location-only'].includes(hotel.sourceStatus) && <div class="content-section">
            <h2>Overview</h2>
            {hotel.overview ? (
              <p class="overview-text">{withoutPriceClaims(hotel.overview)}</p>
            ) : (
              <p class="overview-text">{withoutPriceClaims(hotel.description)}</p>
            )}
            {hotel.totalRooms && <p class="hotel-stat"><strong>Total rooms:</strong> {hotel.totalRooms}</p>}
            {hotel.yearBuilt && <p class="hotel-stat"><strong>Established:</strong> {hotel.yearBuilt}</p>}
            {hotel.lastRenovated && <p class="hotel-stat"><strong>Last renovated:</strong> {hotel.lastRenovated}</p>}
            {hotel.address && <p class="hotel-stat"><strong>Address:</strong> {hotel.address}</p>}
          </div>}

          {['unreviewed', 'former-name'].includes(hotel.sourceStatus) && <div class="content-section"><h2>Continue with a complete stay comparison</h2><div class="planning-checks">{hotelDirectoryPlanningChecks.map(check => <div><h3>{check.title}</h3><p>{check.text}</p></div>)}</div><p>Use the source-reviewed alternatives below and confirm the identity returned by the retained provider link.</p></div>}

          <!-- Popular amenities -->
          {listedAmenities.length > 0 && <div class="content-section">
            <h2>Popular Amenities</h2>
            <div class="amenities-grid">
              {listedAmenities.map(a => (
                <div class="amenity-item">
                  <span class="amenity-icon">✓</span>
                  <span>{a}</span>
                </div>
              ))}
            </div>
          </div>}

          <!-- Room features -->
          {hotel.roomFeatures && hotel.roomFeatures.length > 0 && (
            <div class="content-section">
              <h2>Room Features</h2>
              <div class="room-features-grid">
                {hotel.roomFeatures.map(f => (
                  <div class="room-feature">
                    <span class="feature-dot"></span>
                    <span>{f}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Dining -->
          {hotel.dining && (
            <div class="content-section">
              <h2>Dining</h2>
              <p>{withoutPriceClaims(hotel.dining)}</p>
            </div>
          )}

          <!-- Location & Nearby -->
          <div class="content-section">
            <h2>Location & Getting Around</h2>
            <p><strong>{hotel.sourceStatus === 'unreviewed' ? 'Stored area label (not a verified address):' : 'Area:'}</strong> {hotel.area}</p>
            {hotel.address && <p><strong>Listed address:</strong> {hotel.address}</p>}
            <p class="location-note"><strong>{hasSourcedCoordinates ? 'Source-backed property locator.' : hasCoordinates ? 'Indicative map location.' : 'Map point unavailable.'}</strong> {hotel.coordinateNote}</p>
            {hasSourcedCoordinates && <p class="location-source"><a href={hotel.coordinateSource} target="_blank" rel="noopener">Coordinate source &nearr;</a>{hotel.coordinateCheckedOn && <> · Checked <time datetime={hotel.coordinateCheckedOn}>{hotel.coordinateCheckedOn}</time></>}</p>}
            <div class="nearby-grid">
              {hotel.nearbyAttractions.map(a => (
                <div class="nearby-item">
                  <span class="nearby-pin">📍</span>
                  <span>{a}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Check-in / Check-out -->
          {(hotel.checkIn || hotel.checkOut) && (
            <div class="content-section">
              <h2>Check-in & Check-out</h2>
              <div class="checkin-grid">
                {hotel.checkIn && (
                  <div class="checkin-box">
                    <span class="checkin-label">Check-in</span>
                    <span class="checkin-time">{hotel.checkIn}</span>
                  </div>
                )}
                {hotel.checkOut && (
                  <div class="checkin-box">
                    <span class="checkin-label">Check-out</span>
                    <span class="checkin-time">{hotel.checkOut}</span>
                  </div>
                )}
              </div>
            </div>
          )}

          <!-- Policies -->
          {hotel.policies && (
            <div class="content-section">
              <h2>Good to Know</h2>
              <p>{withoutPriceClaims(hotel.policies) || 'Confirm the current policies and terms for the room rate you choose.'}</p>
            </div>
          )}

          <!-- Booking tip -->
          <div class="content-section">
            <div class="tip-box">
              <strong>Compare the full booking:</strong> Use the same dates, party size and room type when comparing quotes. Include taxes, required fees, parking, meals and transport, then check cancellation terms. A budget tier is an editorial category, not a room rate.
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="hotel-sidebar">
          <div class="booking-card">
            <div class="booking-price">{isDestinationSearch ? 'Search stays in the area' : ['unreviewed', 'former-name'].includes(hotel.sourceStatus) ? 'Check the provider identity' : 'Get a quote for your dates'}</div>
            <a href={hotel.expediaUrl} target="_blank" rel="noopener sponsored" class="btn btn-accent booking-btn">
              {bookingLabel} →
            </a>
            <p class="booking-note">{bookingNote} Affiliate link: BanffBound may earn a commission if you book.</p>
          </div>

          <div class="sidebar-card">
            <h3>Directory summary</h3>
            <div class="fact-row"><span>Source status</span><span>{hotel.sourceStatusLabel}</span></div>
            <div class="fact-row"><span>{hotel.sourceStatus === 'unreviewed' ? 'Stored type' : 'Type'}</span><span>{hotel.type}</span></div>
            <div class="fact-row"><span>{hotel.sourceStatus === 'unreviewed' ? 'Stored area' : 'Area'}</span><span>{hotel.area}</span></div>
            <div class="fact-row"><span>Editorial budget tier</span><span>{hotel.priceRange}</span></div>
            {hotel.totalRooms && <div class="fact-row"><span>Rooms</span><span>{hotel.totalRooms}</span></div>}
            {hotel.checkIn && <div class="fact-row"><span>Check-in</span><span>{hotel.checkIn}</span></div>}
            {hotel.checkOut && <div class="fact-row"><span>Check-out</span><span>{hotel.checkOut}</span></div>}
          </div>

          <div class="sidebar-card">
            <h3>Book Banff Experiences</h3>
            <p style="font-size: 0.85rem; color: var(--color-text-light); margin-bottom: 0.75rem;">Compare operator activities, then confirm the actual starting place and return.</p>
            <a href={`https://www.getyourguide.com/banff-l284/?partner_id=${GYG}`} target="_blank" rel="noopener sponsored" class="btn btn-primary sidebar-btn">Browse Tours →</a>
          </div>

          <div class="sidebar-card">
            <h3>Need More Options?</h3>
            <a href="/hotel-directory" class="btn btn-outline sidebar-btn">View {hotels.length} Directory Records →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related guides -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>{hotel.sourceStatus === 'unreviewed' ? 'Compare your base and stay type' : `Guides for ${hotel.area}`}</h2>
        <p>Plan the base, season and complete journey.</p>
      </div>
      <div class="grid grid-4">
        {relatedGuides.map(guide => (
          <a href={guide.href} class="card" style="display: block;">
            <div class="card-body">
              <h3 style="font-size: 0.95rem; margin-bottom: 0.25rem;">{guide.title}</h3>
              <p style="font-size: 0.82rem; color: var(--color-text-light); margin: 0;">{guide.desc}</p>
              <span style="display: inline-block; margin-top: 0.5rem; font-size: 0.8rem; color: var(--color-accent); font-weight: 600;">Read Guide &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Related hotels -->
  {otherHotels.length > 0 && (
    <section class="section" style="background: var(--color-bg-alt);">
      <div class="container">
        <div class="section-header">
          <h2>Source-reviewed alternatives</h2>
          <p>Compare the actual addresses and journeys; an area grouping does not establish the same location.</p>
        </div>
        <div class="grid grid-4">
          {otherHotels.map(h => (
            <a href={`/hotel-directory/${h.slug}`} class="card">
              {h.image?.trim() ? <img src={h.image} alt={h.name} class="card-image" style="height: 160px;" loading="lazy" /> : <div class="related-photo-fallback">Property photo unavailable</div>}
              <div class="card-body">
                <span class="mini-stars">Editorial budget tier: {h.priceRange}</span>
                <h3 style="font-size: 0.95rem;">{h.name}</h3>
                <p style="font-size: 0.8rem; color: var(--color-text-light);">Check dates and room options &rarr;</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .facility-confirmation { background: var(--color-bg-alt); border-left: 4px solid var(--color-accent); padding: 1.4rem; border-radius: var(--radius); margin-bottom: 2rem; }
  .facility-confirmation h2 { font-size: 1.4rem; margin-bottom: .8rem; }
  .facility-confirmation p { font-size: .88rem; margin-top: .7rem; color: var(--color-text-light); }
  .facility-confirmation a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
  .facility-confirmation ul { padding-left: 1.2rem; font-size: .87rem; line-height: 1.8; }
  .planning-checks h3 { font-size: 1rem; margin: 1rem 0 .4rem; }
  .planning-checks p { font-size: .9rem; line-height: 1.7; }
  .photo-caption { font-size: .78rem; color: var(--color-text-light); margin: .7rem 0; }
  .hotel-hero { position: relative; }
  .hotel-hero.no-photo { background: var(--color-primary); color: white; }
  .no-photo .hero-overlay { position: static; background: none; padding: 1rem 0 2rem; }
  .hero-photo-fallback { padding-top: 2rem; font-size: .9rem; color: rgba(255,255,255,.85); }
  .related-photo-fallback { height: 160px; display: grid; place-items: center; padding: 1rem; text-align: center; background: var(--color-bg-alt); color: var(--color-text-light); font-size: .85rem; }
  .location-note { margin-top: 1rem; padding: 1rem; background: var(--color-bg-alt); border-radius: var(--radius); font-size: .9rem; }
  .location-source { font-size: .85rem; }
  .location-source a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }

  .hero-gallery {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4px;
    max-height: 420px;
    overflow: hidden;
  }

  .hero-gallery.single-image { grid-template-columns: 1fr; }

  .hero-main-img img {
    width: 100%;
    height: 420px;
    object-fit: cover;
  }

  .hero-side-imgs {
    display: grid;
    grid-template-rows: repeat(2, 1fr);
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
  }

  .hero-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.8));
    padding: 3rem 0 1.5rem;
    color: white;
  }

  .hero-overlay h1 { color: white; margin-bottom: 0.5rem; }
  .hero-overlay .badge { margin-bottom: 0.5rem; }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    opacity: 0.9;
    flex-wrap: wrap;
  }

  .hero-sep { opacity: 0.5; }
  .hero-review { color: var(--color-accent); font-weight: 600; }

  .booking-strip {
    background: var(--color-primary);
    color: white;
    padding: 0.75rem 0;
    position: sticky;
    top: 60px;
    z-index: 50;
  }

  .booking-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .strip-label { font-size: 0.8rem; opacity: 0.7; }
  .strip-price { font-family: var(--font-heading); font-size: 1.3rem; font-weight: 700; margin-left: 0.5rem; }

  .hotel-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
  }

  .content-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }

  .content-section:last-child { border-bottom: none; }

  .content-section h2 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  .overview-text {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--color-text);
  }

  .hotel-stat {
    font-size: 0.9rem;
    margin-top: 0.5rem;
    color: var(--color-text-light);
  }

  .review-callout {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem;
    background: #f0f7f0;
    border-radius: var(--radius);
    margin-bottom: 2.5rem;
    border-left: 4px solid var(--color-primary);
  }

  .review-score-box {
    background: var(--color-primary);
    color: white;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    text-align: center;
    min-width: 70px;
    flex-shrink: 0;
  }

  .review-number { font-size: 1.5rem; font-weight: 700; }
  .review-scale { font-size: 0.8rem; opacity: 0.7; }

  .review-detail strong { display: block; font-size: 1.05rem; margin-bottom: 0.25rem; }
  .review-count { font-size: 0.85rem; color: var(--color-text-light); }

  .guest-loves { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }
  .love-tag {
    background: white;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 20px;
    padding: 0.2rem 0.6rem;
    font-size: 0.78rem;
    color: var(--color-primary);
    font-weight: 500;
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }

  .amenity-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
