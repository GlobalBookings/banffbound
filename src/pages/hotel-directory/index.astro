---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { hotelAreas } from '../../data/hotels';
import { directoryHotels as hotels, hotelDirectoryPlanningChecks } from '../../data/hotelDirectory';

const areas = [...new Set(hotels.map(h => h.area))];
const types = [...new Set(hotels.map(h => h.type))].sort();
const mappedHotelsCount = hotels.filter(h => Number.isFinite(h.lat) && Number.isFinite(h.lng) && h.coordinateStatus !== 'unavailable').length;
const reviewedCount = hotels.filter(h => h.sourceStatus === 'reviewed').length;
const locationCount = hotels.filter(h => h.sourceStatus === 'location-only').length;
const historyCount = hotels.filter(h => h.sourceStatus === 'former-name').length;
const pendingCount = hotels.filter(h => h.sourceStatus === 'unreviewed').length;
const withoutPriceClaims = (text: string) => text.split(/(?<=[.!?])\s+/).filter(sentence => !/\$\s*\d/.test(sentence)).join(' ');
const areaNotes: Record<string, string> = {
  'Banff Avenue hotel strip': 'Banff Avenue continues beyond the central pedestrian blocks. Compare the exact address with groceries, your activity pickup, winter walking conditions and the last local bus.',
  'Spray Avenue': 'Banff Springs is on Spray Avenue, separate from the central Banff Avenue hotel strip. Match the actual walking or local transit journey to your plans.',
  'Sulphur Mountain': 'An elevated Banff location near the gondola and Upper Hot Springs area. Check the road or bus journey back from town, winter walking conditions and each attraction’s operation separately.',
  'Yoho National Park': 'A separate national park in British Columbia. Check the exact lodge address, winter road access, meal arrangements and any guest parking shuttle; this is not a Lake Louise village stay.',
  'Downtown Banff': 'Compare the exact address with restaurants and the ski-shuttle stop you need; not every Banff property has the same walk.',
  'Tunnel Mountain': 'A hillside area above central Banff. Check the route and current bus service before planning to walk with luggage or ski gear.',
  'Bow Valley': 'Locations vary widely. Check the actual address, road access and meal arrangements rather than assuming a town-centre stay.',
  'Castle Junction': 'Cabin and lodge stays between Banff and Lake Louise. Confirm winter access, meals and your transport plan.',
  'Canmore': 'A separate town outside Banff National Park. Compare suite options and the full journey to your chosen ski resort.',
  'Lake Louise': 'The village, lakeshore and ski resort are separate places. Check which location the hotel actually serves.',
};

const hotelData = JSON.stringify(hotels.map(h => ({
  slug: h.slug,
  name: h.name,
  area: h.area,
  type: h.type,
  price: h.priceRange,
  lat: h.lat,
  lng: h.lng,
  img: h.image,
  coordinateStatus: h.coordinateStatus,
  coordinateSource: h.coordinateSource,
  coordinateNote: h.coordinateNote,
  sourceStatus: h.sourceStatus,
  sourceStatusLabel: h.sourceStatusLabel,
  destinationSearch: /\/Hotel-Search(?:[/?#]|$)/i.test(h.expediaUrl),
})));
---

<BaseLayout title="Banff Hotel Directory — Reviewed Stays & Listing Leads" description="Compare source-reviewed hotel profiles and retained directory leads around Banff. Filter area, type, editorial budget tier and source status, then confirm the exact room and dates.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Banff hotel directory', url: 'https://banffbound.com/hotel-directory/', mainEntity: { '@type': 'ItemList', numberOfItems: hotels.length, itemListElement: hotels.map((hotel, i) => ({ '@type': 'ListItem', position: i + 1, name: hotel.name, url: `https://banffbound.com/hotel-directory/${hotel.slug}/` })) } })} />
  <div class="container">
    <Breadcrumbs items={[{ label: 'Hotels' }]} />
  </div>
  <section class="page-hero directory-hero">
    <div class="page-hero-content">
      <span class="badge">Hotel Directory</span>
      <h1>Where to Stay in Banff</h1>
      <p>Start with {reviewedCount} hotel and lodge profiles whose selected facts have been source-reviewed. Compare actual room layouts and base choices, then confirm current operation, availability and the complete booking.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="directory-note">Budget tiers ($–$$$$) are editorial categories, not room quotes. Check the exact property address, selected room, final price and facility status for your dates. For a curated shortlist with winter transport tradeoffs, use the <a href="/winter-stays">winter stays finder</a>.</p>
      <p class="directory-note">All {hotels.length} retained records remain discoverable: {reviewedCount} selected-fact reviews, {locationCount} location-only profile, {historyCount} former-name histories and {pendingCount} legacy leads awaiting source review. Legacy area/type labels are stored classifications, not verified addresses or facilities. Unverified photos and property claims are withheld.</p>
      <!-- Filter bar -->
      <noscript><p class="directory-note">All {hotels.length} hotel profiles are listed below. Search, filters and the map need JavaScript; each profile and its source notes remain available without it.</p></noscript>
      <div class="filter-bar" id="filters" hidden>
        <div class="filter-group search-group">
          <input type="text" id="search-input" placeholder="Search hotels..." class="search-input" aria-label="Search hotels" />
        </div>
        <div class="filter-group">
          <select id="source-filter" aria-label="Filter by source status">
            <option value="all">All source statuses</option>
            <option value="reviewed">Selected facts reviewed</option>
            <option value="location-only">Location only</option>
            <option value="former-name">Former-name histories</option>
            <option value="unreviewed">Legacy leads awaiting review</option>
          </select>
        </div>
        <div class="filter-group">
          <select id="area-filter" aria-label="Filter by area">
            <option value="all">All Areas</option>
            {areas.map(a => <option value={a}>{a}</option>)}
          </select>
        </div>
        <div class="filter-group">
          <select id="type-filter" aria-label="Filter by property type">
            <option value="all">All Types</option>
            {types.map(t => <option value={t}>{t}</option>)}
          </select>
        </div>
        <div class="filter-group">
          <select id="price-filter" aria-label="Filter by editorial budget tier">
            <option value="all">All editorial budget tiers</option>
            <option value="$">$ Budget</option>
            <option value="$$">$$ Mid-Range</option>
            <option value="$$$">$$$ Upscale</option>
            <option value="$$$$">$$$$ Luxury</option>
          </select>
        </div>
        <button id="clear-filters" type="button" class="clear-btn" style="display:none;">Clear filters</button>
        <span class="result-count" id="result-count" role="status" aria-live="polite">{hotels.length} directory records</span>
      </div>

      <!-- View toggle -->
      <p class="map-location-note" id="hotel-map-note">Only {mappedHotelsCount} source-documented location points are plotted. They are property locators, not parking entrances or arrival directions, and do not establish current operation. Records without a sourced point remain in the complete grid. Legacy manual coordinates are not plotted.</p>
      <div class="view-toggle" id="view-controls" hidden>
        <button id="grid-view-btn" type="button" class="view-btn active" aria-pressed="true" aria-controls="hotel-grid">Grid</button>
        <button id="map-view-btn" type="button" class="view-btn" aria-pressed="false" aria-controls="map-container" aria-describedby="hotel-map-note">Map</button>
      </div>
      <p id="map-status" class="map-status" role="status" aria-live="polite"></p>

      <!-- Interactive Map -->
      <div id="map-container" class="map-container" style="display:none;">
        <p id="map-result-count" class="map-result-count" role="status" aria-live="polite"></p>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <div id="hotel-map" aria-label="Directory map: source-documented property locators only" style="height: 500px; border-radius: var(--radius); overflow: hidden;"></div>
      </div>

      <!-- Hotel grid -->
      <div class="hotel-grid" id="hotel-grid">
        {hotels.map(hotel => (
          <a href={`/hotel-directory/${hotel.slug}`} class="hotel-card"
             data-area={hotel.area} data-price={hotel.priceRange}
             data-type={hotel.type}
             data-source={hotel.sourceStatus}
             data-name={hotel.name.toLowerCase()} data-slug={hotel.slug}>
            {hotel.image?.trim() ? <img src={hotel.image} alt={hotel.name} class="hotel-card-img" loading="lazy" /> : <div class="hotel-card-img hotel-photo-fallback">Property photo unavailable</div>}
            <div class="hotel-card-body">
              <div class="hotel-card-top">
                <span class="hotel-price">Editorial budget tier: {hotel.priceRange}</span>
              </div>
              <h3>{hotel.name}</h3>
              <p class="source-badge">{hotel.sourceStatusLabel}</p>
              {hotel.operationNote && <p class="operation-note">{hotel.operationNote}</p>}
              <p class="hotel-area">{hotel.sourceStatus === 'unreviewed' ? 'Stored labels: ' : ''}{hotel.area} · {hotel.type}</p>
              <p class="hotel-desc">{withoutPriceClaims(hotel.description).slice(0, 120)}...</p>
              <div class="hotel-card-footer">
                <span class="hotel-avg">{hotel.sourceStatus === 'unreviewed' ? 'Source review pending' : hotel.sourceStatus === 'former-name' ? 'Check current identity' : /\/Hotel-Search(?:[/?#]|$)/i.test(hotel.expediaUrl) ? 'Destination search available' : 'Check dates for a quote'}</span>
                <span class="hotel-link">View Details →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-bg-alt);">
    <div class="container">
      <div class="section-header">
        <h2>Compare the stay and the whole journey</h2>
      </div>
      <div class="grid grid-2 stay-checks">{hotelDirectoryPlanningChecks.map(check => <article><h3>{check.title}</h3><p>{check.text}</p></article>)}</div>
      <div class="section-header">
        <h2>Banff Hotel Areas Guide</h2>
        <p>Where you stay in Banff matters. Here's what each area offers.</p>
      </div>
      <div class="grid grid-3">
        {hotelAreas.map(area => (
          <div class="card">
            <div class="card-body">
              <h3>{area.name}</h3>
              <p>{areaNotes[area.name] || area.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ hotelData }}>
(() => {
  const allHotels = JSON.parse(hotelData);
  const searchInput = document.getElementById('search-input');
  const areaFilter = document.getElementById('area-filter');
  const typeFilter = document.getElementById('type-filter');
  const priceFilter = document.getElementById('price-filter');
  const sourceFilter = document.getElementById('source-filter');
  const clearBtn = document.getElementById('clear-filters');
  const cards = document.querySelectorAll('.hotel-card');
  const countEl = document.getElementById('result-count');
  const gridViewBtn = document.getElementById('grid-view-btn');
  const mapViewBtn = document.getElementById('map-view-btn');
  const mapContainer = document.getElementById('map-container');
  const hotelGrid = document.getElementById('hotel-grid');
  const mapStatus = document.getElementById('map-status');
  const mapResultCount = document.getElementById('map-result-count');

  let map = null;
  let markers = [];
  let leaflet = null;
  let mapLoading = false;
  let loadAttempt = 0;

  function hasMapPoint(hotel) {
    return Number.isFinite(hotel.lat) && Number.isFinite(hotel.lng)
      && Math.abs(hotel.lat) <= 90 && Math.abs(hotel.lng) <= 180
      && hotel.coordinateStatus === 'source-verified' && typeof hotel.coordinateSource === 'string' && hotel.coordinateSource.startsWith('https://');
  }

  function applyFilters() {
    const search = searchInput.value.toLowerCase().trim();
    const area = areaFilter.value;
    const type = typeFilter.value;
    const price = priceFilter.value;
    const source = sourceFilter.value;
    let visible = 0;
    const visibleSlugs = new Set();

    cards.forEach(card => {
      const matchSearch = !search || card.dataset.name.includes(search) || card.dataset.area.toLowerCase().includes(search);
      const show = matchSearch && (area === 'all' || card.dataset.area === area)
        && (type === 'all' || card.dataset.type === type)
        && (price === 'all' || card.dataset.price === price) && (source === 'all' || card.dataset.source === source);
      card.style.display = show ? '' : 'none';
      if (show) {
        visible++;
        visibleSlugs.add(card.dataset.slug);
      }
    });

    countEl.textContent = visible + ' directory record' + (visible !== 1 ? 's' : '');
    clearBtn.style.display = (search || area !== 'all' || type !== 'all' || price !== 'all' || source !== 'all') ? '' : 'none';
    const mapped = allHotels.filter(h => visibleSlugs.has(h.slug) && hasMapPoint(h)).length;
    mapResultCount.textContent = mapped + ' of ' + visible + ' matching records have a source-documented point. Use Grid for the complete results.';
    if (map) updateMapMarkers(visibleSlugs);
  }

  function clearAll() {
    searchInput.value = '';
    areaFilter.value = 'all';
    typeFilter.value = 'all';
    priceFilter.value = 'all';
    sourceFilter.value = 'all';
    applyFilters();
  }

  const params = new URLSearchParams(window.location.search);
  const paramArea = params.get('area');
  const paramType = params.get('type');
  const paramPrice = params.get('price');
  const paramSource = params.get('source');
  if (paramArea && Array.from(areaFilter.options).some(o => o.value === paramArea)) areaFilter.value = paramArea;
  if (paramType) {
    const opt = Array.from(typeFilter.options).find(o => o.value.toLowerCase() === paramType.toLowerCase());
    if (opt) typeFilter.value = opt.value;
  }
  if (paramPrice && Array.from(priceFilter.options).some(o => o.value === paramPrice)) priceFilter.value = paramPrice;
  if (paramSource && Array.from(sourceFilter.options).some(o => o.value === paramSource)) sourceFilter.value = paramSource;

  searchInput.addEventListener('input', applyFilters);
  areaFilter.addEventListener('change', applyFilters);
  typeFilter.addEventListener('change', applyFilters);
  priceFilter.addEventListener('change', applyFilters);
  sourceFilter.addEventListener('change', applyFilters);
  clearBtn.addEventListener('click', clearAll);

  function showGrid() {
    gridViewBtn.classList.add('active');
    mapViewBtn.classList.remove('active');
    gridViewBtn.setAttribute('aria-pressed', 'true');
    mapViewBtn.setAttribute('aria-pressed', 'false');
    hotelGrid.style.display = '';
    mapContainer.style.display = 'none';
  }
  gridViewBtn.addEventListener('click', showGrid);

  mapViewBtn.addEventListener('click', () => {
    mapViewBtn.classList.add('active');
    gridViewBtn.classList.remove('active');
    mapViewBtn.setAttribute('aria-pressed', 'true');
    gridViewBtn.setAttribute('aria-pressed', 'false');
    hotelGrid.style.display = 'none';
    mapContainer.style.display = '';
    if (map) {
      map.invalidateSize();
      applyFilters();
    } else loadMap();
  });

  function loadMap() {
    if (mapLoading) return;
    mapLoading = true;
    const attempt = ++loadAttempt;
    mapStatus.textContent = 'Loading map…';
    const script = document.createElement('script');
    const timer = window.setTimeout(() => failed(), 15000);
    function failed() {
      if (attempt !== loadAttempt) return;
      loadAttempt++;
      window.clearTimeout(timer);
      mapLoading = false;
      if (map) map.remove();
      map = null;
      markers = [];
      leaflet = null;
      script.remove();
      showGrid();
      mapStatus.textContent = 'The map could not load. All matching hotels remain available in the grid; choose Map to retry.';
    }
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.onerror = failed;
    script.onload = () => {
      if (attempt !== loadAttempt) return;
      window.clearTimeout(timer);
      try {
        if (!window.L) throw new Error('Map library unavailable');
        leaflet = window.L;
        initMap();
        mapLoading = false;
        mapStatus.textContent = '';
      } catch {
        failed();
      }
    };
    document.head.appendChild(script);
  }

  function popupFor(hotel) {
    const popup = document.createElement('div');
    popup.className = 'hotel-map-popup';
    if (typeof hotel.img === 'string' && hotel.img.trim()) {
      const img = document.createElement('img');
      img.src = hotel.img;
      img.alt = hotel.name;
      img.className = 'hotel-popup-image';
      popup.appendChild(img);
    } else {
      const fallback = document.createElement('p');
      fallback.className = 'hotel-popup-photo-fallback';
      fallback.textContent = 'Property photo unavailable';
      popup.appendChild(fallback);
    }
    const name = document.createElement('strong');
    name.textContent = hotel.name;
    popup.appendChild(name);
    const status = document.createElement('p');
    status.textContent = hotel.sourceStatusLabel;
    popup.appendChild(status);
    const area = document.createElement('p');
    area.textContent = hotel.area + ' · Editorial budget tier: ' + hotel.price;
    popup.appendChild(area);
    const location = document.createElement('p');
    location.textContent = (hotel.coordinateStatus === 'source-verified' ? 'Source-backed property locator. ' : 'Indicative listing point. ') + (hotel.coordinateNote || 'Confirm the actual address and arrival directions.');
    popup.appendChild(location);
    if (hotel.coordinateStatus === 'source-verified' && hotel.coordinateSource.startsWith('https://')) {
      const source = document.createElement('a');
      source.href = hotel.coordinateSource;
      source.target = '_blank';
      source.rel = 'noopener';
      source.textContent = 'Coordinate source';
      popup.appendChild(source);
    }
    const quote = document.createElement('p');
    quote.textContent = hotel.destinationSearch ? 'Destination search available; confirm the exact property.' : 'Check dates for a current quote';
    popup.appendChild(quote);
    const link = document.createElement('a');
    link.href = '/hotel-directory/' + encodeURIComponent(hotel.slug);
    link.textContent = 'View details →';
    popup.appendChild(link);
    return popup;
  }

  function initMap() {
    map = leaflet.map('hotel-map').setView([51.22, -115.75], 10);
    leaflet.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 18,
    }).addTo(map);
    allHotels.filter(hasMapPoint).forEach(hotel => {
      const marker = leaflet.marker([hotel.lat, hotel.lng], {
        title: hotel.name + ' — source-documented property locator',
        alt: hotel.name + ' — source-documented property locator',
        keyboard: true,
      }).addTo(map);
      marker.bindPopup(popupFor(hotel));
      marker._hotelSlug = hotel.slug;
      markers.push(marker);
    });
    applyFilters();
    map.invalidateSize();
  }

  function updateMapMarkers(visibleSlugs) {
    const visiblePoints = [];
    markers.forEach(marker => {
      if (visibleSlugs.has(marker._hotelSlug)) {
        marker.addTo(map);
        visiblePoints.push(marker.getLatLng());
      }
      else marker.remove();
    });
    if (visiblePoints.length && mapContainer.style.display !== 'none') {
      map.fitBounds(leaflet.latLngBounds(visiblePoints), { padding: [24, 24], maxZoom: 13 });
    }
  }

  document.getElementById('filters').hidden = false;
  document.getElementById('view-controls').hidden = false;
  applyFilters();
})();
</script>

<style>
  .directory-hero { background: var(--color-primary); }
  .source-badge { font-size: .73rem; font-weight: 800; color: var(--color-primary); margin: .4rem 0; }
  .operation-note { font-size: .78rem; line-height: 1.6; background: var(--color-bg-alt); border-left: 3px solid var(--color-accent); padding: .6rem; }
  .stay-checks { margin-bottom: 2.5rem; }
  .stay-checks h3 { font-size: 1.1rem; }
  .stay-checks p { font-size: .9rem; line-height: 1.7; color: var(--color-text-light); }
  .filter-bar[hidden], .view-toggle[hidden] { display: none !important; }
  .map-location-note { max-width: 950px; margin-bottom: 1rem; font-size: .85rem; color: var(--color-text-light); }
  .map-status { font-size: .85rem; color: var(--color-primary); }
  .map-status:empty { display: none; }
  .map-result-count { padding: 1rem; margin: 0; font-size: .85rem; background: var(--color-bg-alt); }
  .hotel-photo-fallback { display: grid; place-items: center; padding: 1rem; text-align: center; background: var(--color-bg-alt); color: var(--color-text-light); font-size: .85rem; }
  :global(.hotel-indicative-dot) { display: block; width: 18px; height: 18px; border: 3px solid #9b6d0b; border-radius: 50%; background: rgba(212,168,67,.15); }
  :global(.hotel-map-popup) { min-width: 190px; max-width: 260px; font-size: .8rem; line-height: 1.45; }
  :global(.hotel-map-popup p) { margin: .5rem 0; }
  :global(.hotel-popup-image) { width: 100%; height: 100px; object-fit: cover; border-radius: 4px; margin-bottom: 6px; }
  :global(.hotel-popup-photo-fallback) { padding: 1rem; background: #f3f4ef; color: #465149; text-align: center; }
  .directory-note { max-width: 950px; margin-bottom: 1.5rem; color: var(--color-text-light); font-size: .88rem; }
  .directory-note a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }
  .filter-bar {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    padding: 1rem 1.5rem;
    background: var(--color-white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .search-group { flex: 1; min-width: 180px; }

  .search-input {
    width: 100%;
    padding: 0.5rem 0.8rem;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 6px;
    font-size: 0.85rem;
    background: var(--color-white);
    outline: none;
    transition: border-color 0.2s;
  }

  .search-input:focus {
    border-color: var(--color-primary);
  }

  .search-input::placeholder { color: #aaa; }

  .filter-group select {
    padding: 0.5rem 0.8rem;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 6px;
    font-size: 0.85rem;
    background: var(--color-white);
    cursor: pointer;
  }

  .clear-btn {
    padding: 0.4rem 0.8rem;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 6px;
    font-size: 0.8rem;
    background: none;
    cursor: pointer;
    color: var(--color-text-light);
  }

  .clear-btn:hover { background: var(--color-bg-alt); }

  .result-count {
    margin-left: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .view-toggle {
    display: flex;
    gap: 0;
    margin-bottom: 1.5rem;
  }

  .view-btn {
    padding: 0.5rem 1.25rem;
    border: 1px solid rgba(0,0,0,0.15);
    background: var(--color-white);
    font-size: 0.85rem;
    cursor: pointer;
    font-weight: 500;
    color: var(--color-text-light);
    transition: all 0.2s;
  }

  .view-btn:first-child { border-radius: 6px 0 0 6px; }
  .view-btn:last-child { border-radius: 0 6px 6px 0; border-left: none; }

  .view-btn.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .map-container {
    margin-bottom: 1.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .hotel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .hotel-card {
    background: var(--color-white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .hotel-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .hotel-card-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .hotel-card-body {
    padding: 1rem 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .hotel-card-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }

  .hotel-stars {
    color: var(--color-accent);
    font-size: 0.8rem;
  }

  .hotel-price {
    font-weight: 700;
    color: var(--color-primary);
