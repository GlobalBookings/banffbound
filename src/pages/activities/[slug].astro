---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WinterStatusNotice from '../../components/WinterStatusNotice.astro';
import { activities, activityImageNote } from '../../data/activities';
import { activitySearchUrl } from '../../data/activityPlanning';

export function getStaticPaths() {
  return activities.filter(activity => !activity.isExternal).map(activity => ({ params: { slug: activity.slug }, props: { activity } }));
}
const { activity } = Astro.props;
const related = activities.filter(item => item.slug !== activity.slug && item.contexts.some(context => activity.contexts.includes(context))).slice(0, 3);
const schema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: `${activity.name}: Banff-Area Planning Guide`,
  description: activity.description, url: `https://banffbound.com/activities/${activity.slug}`,
  dateModified: activity.reviewedAt, author: { '@type': 'Organization', name: 'BanffBound', url: 'https://banffbound.com' },
};
---

<BaseLayout title={`${activity.name}: Access, Booking & Trip Planning`} description={activity.description} lastUpdated={activity.reviewedAt}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  {activity.faqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: activity.faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) })} />}
  <div class="container"><Breadcrumbs items={[{ label: 'Activities', href: '/activities' }, { label: activity.name }]} /></div>
  <section class="page-hero">
    <img src={activity.image.replace('w=600', 'w=1600')} alt="" class="page-hero-bg" loading="eager" fetchpriority="high" />
    <div class="page-hero-content"><span class="badge">{activity.tagline}</span><h1>{activity.name}</h1><p>{activity.description}</p><p class="image-note">{activityImageNote}</p></div>
  </section>
  <section class="section"><div class="container activity-detail">
    {activity.category === 'winter' && <WinterStatusNotice />}
    <div class="planning-summary"><h2>What this plan involves</h2><dl><div><dt>Seasonal context</dt><dd>{activity.season}</dd></div><div><dt>Preparation</dt><dd>{activity.difficulty}</dd></div><div><dt>Editorial review</dt><dd><time datetime={activity.reviewedAt}>{activity.reviewedAt}</time>; individual source checks below. This is not a live conditions or availability report.</dd></div></dl><p>Use the <a href="/conditions">official conditions sources</a> and <a href="/weather">weather planning</a> before departing.</p></div>

    <h2>Places and formats to compare</h2><p>Choose the actual venue, route or operator format. A broad destination name does not establish where the outing starts.</p>
    <div class="grid grid-2">{activity.locations.map(location => <section class="card"><div class="card-body"><h3>{location.name}</h3><p>{location.description}</p></div></section>)}</div>

    <section class="detail-section"><h2>Is this the right outing for your group?</h2><p>Use these questions with the operator, facility or route adviser before making a reservation. Include the least experienced participant and describe specific support needs.</p><ul>{activity.readiness.map(question => <li>{question}</li>)}</ul><p><a href="/accessible-trails">Plan access requirements</a> and ask about the full journey, including the approach, changing areas, transfers and return.</p></section>
    <section class="detail-section"><h2>Build the journey and return</h2><ol>{activity.logistics.map(item => <li>{item}</li>)}</ol><p><a href="/towns">Compare Banff, Canmore and Lake Louise bases</a> · <a href="/car-free-banff">Plan without a car</a> · <a href="/packing-list">Pack for the actual activity</a></p></section>
    <section class="detail-section"><h2>Before you leave</h2><ul>{activity.tips.map(item => <li>{item}</li>)}</ul></section>

    <section class="detail-section source-panel"><h2>Direct sources and operator checks</h2><p>These are direct official or operator information links. Each date records an editorial source check, not current operation or a reservation.</p><ul>{activity.sources.map(item => <li><a href={item.url} target="_blank" rel="noopener">{item.label} ↗</a><br /><span class="source-date">Source checked <time datetime={item.checkedAt}>{item.checkedAt}</time></span></li>)}</ul><p>Providers can change their seasons, requirements and terms. Confirm the selected product directly, especially when a source check is older than your travel date.</p></section>
    <section class="detail-section"><h2>Keep planning</h2><div class="guide-links">{activity.guides.map(guide => <a href={guide.href}>{guide.label} →</a>)}</div><p><a href="/winter">Winter trip guide</a> · <a href="/winter-stays">Winter accommodation planning</a> · <a href="/what-to-do-today">Flexible plans for today</a></p></section>
  </div></section>

  <section class="section" style="background:var(--color-bg-alt)"><div class="container activity-detail"><h2>Optional marketplace search</h2><p>{activity.bookingNote}</p><p>We may earn a commission from the following affiliate search links. They do not certify an operator, guarantee availability or confirm that a product matches this guide.</p><a href={activitySearchUrl(activity.gygSearch)} class="btn btn-primary" target="_blank" rel="noopener sponsored">Search {activity.name.toLowerCase()} on GetYourGuide ↗</a><p>Read the actual product’s destination, dates, meeting point, participant rules, inclusions and cancellation terms. Direct source links above are separate from this search.</p><h3>Choose a base after confirming the meeting point</h3><p>A Banff hotel search does not ensure pickup or a workable connection to Lake Louise, Canmore, Kananaskis or a river base.</p><a href="https://www.expedia.com/Banff-Hotels.d602125.Travel-Guide-Hotels?camref=1101l3MtWX" target="_blank" rel="noopener sponsored">Search Banff accommodation on Expedia ↗</a><p><a href="/towns">Compare destination bases first</a>.</p></div></section>
  {activity.faqs.length > 0 && <section class="section"><div class="container activity-detail"><h2>{activity.name} planning questions</h2>{activity.faqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>}
  <section class="section" style="background:var(--color-bg-alt)"><div class="container"><h2>Other activity plans</h2><div class="grid grid-3">{related.map(item => <a href={item.link} class="card"><div class="card-body"><h3>{item.name}</h3><p>{item.description}</p><span>Read planning guide →</span></div></a>)}</div><p><a href="/activities">All activity guides and filters →</a></p></div></section>
</BaseLayout>

<style>
  .activity-detail{max-width:1050px}.activity-detail p,.activity-detail li{line-height:1.75}.image-note{font-size:.76rem!important;line-height:1.5!important;opacity:.9}
  .planning-summary,.source-panel{padding:1.5rem;background:var(--color-bg-alt);border-left:4px solid var(--color-accent);border-radius:var(--radius);margin:0 0 2rem}
  dl div{margin:.85rem 0}dt{font-weight:700}dd{margin:.2rem 0;line-height:1.65}.detail-section{margin-top:2.5rem}.detail-section li{margin:.7rem 0}.card-body p{line-height:1.7}.source-date{font-size:.8rem;color:var(--color-text-light)}
  .guide-links{display:flex;flex-wrap:wrap;gap:.7rem}.guide-links a{padding:.7rem 1rem;background:var(--color-bg-alt);border-radius:var(--radius);font-weight:700}
  details{padding:1rem 0;border-bottom:1px solid #d6ded8}summary{font-weight:700;cursor:pointer}details p{margin:.7rem 0}
  @media(max-width:600px){.planning-summary,.source-panel{padding:1rem}.btn{white-space:normal}.guide-links a{width:100%}}
</style>
