---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { wildlifeReviewedAt, wildlifeSources, wildlifeSeasons, wildlifeCalendarFaqs } from '../data/wildlifeSafety';
const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: wildlifeCalendarFaqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
const sourceLabels: Record<string, string> = { winter: 'Winter safety', spray: 'Bear spray', bears: 'Bear-country preparation', parkway: 'Parkway restrictions', elkSeasons: 'Seasonal elk guidance', elk: 'Elk safety', bulletins: 'Current notices', viewing: 'Viewing rules' };
---

<BaseLayout title="Banff Wildlife Calendar: Seasonal Preparation, Elk Rut & Winter Advice" description="A month-by-month Banff wildlife preparation calendar with elk calving and rut guidance, winter precautions, seasonal access checks and official sources. No promised sightings." lastUpdated={wildlifeReviewedAt}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="container"><Breadcrumbs items={[{ label: 'Wildlife', href: '/wildlife' }, { label: 'Wildlife Calendar' }]} /></div>
  <header class="calendar-hero"><div class="container"><span class="badge">A seasonal field guide</span><h1>Banff wildlife calendar</h1><p>Choose the preparation for your travel month. Seasons affect animal behaviour and access rules, but they cannot predict what you will see or make a close encounter safe.</p><p class="review">Official sources reviewed <time datetime={wildlifeReviewedAt}>29 October 2026</time>. This calendar contains no live animal locations or sighting forecasts.</p></div></header>
  <div class="container calendar-content">
    <section aria-labelledby="plan-heading"><h2 id="plan-heading">Plan an outing that works without a sighting</h2><p>Choose a walk, landscape stop or guided learning experience for its own value. Carry binoculars and allow time to wait well back or change direction when wildlife occupies a path. Never follow tracks, seek a nest or approach an animal to complete a checklist.</p><p><a href="/wildlife-safety">Read the encounter and reporting guide</a> before leaving. Parks Canada’s minimum distances are 100 metres from bears, wolves, cougars and coyotes, and 30 metres from deer, elk, sheep and moose. Give more space whenever an animal reacts to you. <a href={wildlifeSources.viewing}>Official viewing rules</a>.</p></section>

    <section aria-labelledby="calendar-heading"><h2 id="calendar-heading">Preparation through the year</h2>
      <form id="wildlife-month-filter" class="filter" hidden>
        <div><label for="wildlife-month">Travel month</label><select id="wildlife-month" name="month"><option value="all">All months</option>{months.map((month, index) => <option value={index + 1}>{month}</option>)}</select></div>
        <button type="reset" class="btn btn-secondary">Show all months</button>
        <p id="wildlife-month-count" role="status" aria-live="polite" aria-atomic="true">6 seasonal cards shown.</p>
      </form>
      <noscript><p>All six seasonal cards are shown below. Each covers two months; no JavaScript is needed to read the guide.</p></noscript>
      <div class="season-grid" id="wildlife-season-cards">{wildlifeSeasons.map(season => <article class="season-card" id={`season-${season.id}`} data-season={season.id}>
        <span class="season-label">{season.season}</span><h3>{season.title}</h3><p>{season.summary}</p><ul>{season.preparation.map(item => <li>{item}</li>)}</ul><p class="sources">Sources: {season.sourceKeys.map((key, index) => <><a href={wildlifeSources[key]}>{sourceLabels[key]}</a>{index < season.sourceKeys.length - 1 ? ' · ' : ''}</>)}</p>
      </article>)}</div>
    </section>

    <section class="access-note" aria-labelledby="access-heading"><h2 id="access-heading">Seasonal access is a separate check</h2><p>The Bow Valley Parkway has an annual overnight travel restriction from <strong>1 March to 25 June, 8 p.m. to 8 a.m.</strong> on the 17 km section between Johnston Canyon Campground and Fireside Picnic Area. It applies to driving, cycling and walking. This is not a description of every Parkway section or a guarantee that another route is open. <a href={wildlifeSources.parkway}>Check the exact official restriction and other Parkway access details</a>.</p><p>Temporary wildlife closures and group-size restrictions can apply elsewhere. Read <a href={wildlifeSources.bulletins}>current Parks Canada bulletins</a> and trailhead signs on the day. In winter, also check weather, avalanche terrain and ice hazards; the wildlife calendar does not assess a route’s suitability.</p></section>

    <section aria-labelledby="seasonal-heading"><h2 id="seasonal-heading">How to use seasonal behaviour responsibly</h2><div class="principles">
      <article><h3>Calves and mating groups need room</h3><p>Do not separate a cow from a calf or walk between elk. Keep the whole group in view from a distance and take another route if necessary. A calf may be hidden; an apparently solitary cow still deserves space.</p></article>
      <article><h3>Feeding is more important than a photograph</h3><p>Keep stops brief and let animals carry on without changing their behaviour. At a roadside sighting, stay in the vehicle, stop only where legal and safe, and move on if congestion develops.</p></article>
      <article><h3>Denning does not mean absent</h3><p>Parks Canada explicitly includes bear spray in its winter packing advice and says bears can wake briefly. Prepare for wildlife on winter outings rather than using snow or a month as reassurance.</p></article>
    </div><p>Read <a href={wildlifeSources.elk}>elk guidance</a>, <a href={wildlifeSources.viewing}>responsible viewing advice</a> and <a href={wildlifeSources.winter}>winter preparation</a> for the underlying rules.</p></section>

    <section aria-labelledby="faq-heading"><h2 id="faq-heading">Calendar questions</h2>{wildlifeCalendarFaqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
    <aside class="next"><h2>Continue planning</h2><p><a href="/bear-spray">Local bear-spray preparation</a> · <a href="/wildlife">Wildlife field guide</a> · <a href="/trails">Trail directory</a> · <a href="/winter">Winter planning</a> · <a href="/towns">Choose a base</a></p><p>Review dates refer to the linked sources, not observations of animals. Seasonal windows vary and official pages may describe them differently; current signs and restrictions take priority.</p></aside>
  </div>
</BaseLayout>

<script>
  import { getWildlifeSeason } from '../data/wildlifeSafety';
  function initWildlifeCalendar() {
    const form = document.querySelector<HTMLFormElement>('#wildlife-month-filter');
    const select = document.querySelector<HTMLSelectElement>('#wildlife-month');
    const count = document.querySelector<HTMLElement>('#wildlife-month-count');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-season]')];
    if (!form || !select || !count || !cards.length || form.dataset.ready) return;
    form.dataset.ready = 'true';
    const render = () => {
      const season = getWildlifeSeason(select.value);
      if (!season) select.value = 'all';
      for (const card of cards) card.hidden = Boolean(season && card.dataset.season !== season.id);
      count.textContent = season ? `1 seasonal card shown for ${select.selectedOptions[0]?.textContent ?? 'your month'}: ${season.title}. This is preparation, not a sighting forecast.` : `${cards.length} seasonal cards shown. This is preparation, not a sighting forecast.`;
    };
    const requested = new URL(window.location.href).searchParams.get('month');
    if (getWildlifeSeason(requested)) select.value = String(requested);
    form.addEventListener('submit', event => event.preventDefault());
    select.addEventListener('change', render);
    form.addEventListener('reset', event => { event.preventDefault(); select.value = 'all'; render(); });
    render();
    form.hidden = false;
  }
  initWildlifeCalendar();
  document.addEventListener('astro:page-load', initWildlifeCalendar);
</script>

<style>
  [hidden]{display:none!important}.calendar-hero{background:var(--color-primary);color:white;padding:3rem 0}.calendar-hero h1,.calendar-hero p{color:white;max-width:820px}.review{font-size:.9rem;opacity:.9}.calendar-content{max-width:1080px;padding:2rem 1.5rem 3rem}.calendar-content section{margin-bottom:2.5rem}.calendar-content a{text-decoration:underline;text-underline-offset:.15em}.filter{display:flex;flex-wrap:wrap;align-items:end;gap:1rem;background:var(--color-bg-alt);padding:1.25rem;border-radius:10px;margin:1rem 0}.filter label{display:block;font-weight:700;margin-bottom:.4rem}.filter select{font:inherit;min-height:46px;padding:.5rem 2rem .5rem .7rem;border:1px solid #73776e;border-radius:5px;max-width:100%}.filter p{flex-basis:100%;margin:0}.season-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:1.25rem}.season-card{background:white;border:1px solid #d8d8ce;border-top:5px solid var(--color-accent);border-radius:12px;padding:1.5rem}.season-label{font-weight:700;color:var(--color-primary);font-size:.9rem}.season-card li{margin:.65rem 0}.sources{font-size:.88rem;margin-bottom:0}.access-note,.next{padding:1.5rem;background:var(--color-bg-alt);border-radius:12px}.principles{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:1.25rem}.calendar-content details{border-bottom:1px solid #d8d8ce;padding:1rem}.calendar-content summary{font-weight:700;cursor:pointer}@media print{.filter{display:none}.season-card[hidden]{display:block!important}.season-card{break-inside:avoid}.calendar-hero{background:white;color:black;padding:1rem 0}.calendar-hero h1,.calendar-hero p{color:black}}
</style>
