---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const AFFILIATE_TAG = 'banffbound-20';
const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const activities = [
  { id: 'hiking', name: 'Hiking / trail walking' }, { id: 'skiing', name: 'Resort skiing / snowboarding' },
  { id: 'lesson', name: 'First ski / snowboard lesson' }, { id: 'skating', name: 'Ice skating' },
  { id: 'snowshoeing', name: 'Snowshoeing' }, { id: 'paddling', name: 'Canoeing / kayaking' },
  { id: 'camping', name: 'Camping' }, { id: 'photography', name: 'Photography' },
  { id: 'dining', name: 'Dining out' }, { id: 'hotsprings', name: 'Pool / hot springs' },
  { id: 'driving', name: 'Driving / rental car' }, { id: 'flying', name: 'Flying to Canada' },
];
interface PackingItem { id: string; name: string; note?: string; tags?: string[]; amazon?: string; }
const groups: { id: string; name: string; items: PackingItem[] }[] = [
  { id: 'plans', name: 'Bookings, documents & day plan', items: [
    { id: 'travel-id', name: 'ID / passport and required travel documents' },
    { id: 'insurance', name: 'Travel insurance details and emergency contacts', note: 'Check that your actual activities are covered.' },
    { id: 'bookings', name: 'Accommodation and activity confirmations saved offline' },
    { id: 'park-pass', name: 'Park entry / camping permits checked for your dates', note: 'Check the current admission and reservation requirements; an equipment list is not a permit.' },
    { id: 'payment', name: 'Payment cards and some Canadian cash' },
    { id: 'conditions', name: 'Current forecast, operating status and closures checked', note: 'Recheck on the day, including the return journey.' },
    { id: 'route-plan', name: 'Route, turnaround time and return plan shared with a contact', tags: ['hiking', 'snowshoeing', 'camping'] },
    { id: 'ski-ticket', name: 'Resort ticket / pass and permitted lift access confirmed', note: 'A room or lesson booking does not automatically include a lift ticket.', tags: ['skiing'] },
    { id: 'rental-booking', name: 'Skis or board, boots and fitting / collection arrangements', note: 'Confirm your rental reservation, equipment, pickup location and return time.', tags: ['skiing'] },
    { id: 'ski-transfer', name: 'Ski shuttle / drive, pickup and last return confirmed', note: 'At Sunshine, include the base-to-village gondola and check its current operation.', tags: ['skiing'] },
    { id: 'lesson-confirmation', name: 'Correct lesson age, ability, discipline and date booked', tags: ['lesson'] },
    { id: 'lesson-meeting', name: 'Lesson meeting point, check-in and fitting time saved', note: 'Follow the operator’s arrival instructions; a first lesson does not establish readiness for other terrain.', tags: ['lesson'] },
    { id: 'child-lesson', name: 'If relevant: child supervision, lunch and collection arranged', tags: ['lesson'] },
    { id: 'paddle-permission', name: 'Paddling location, operator and current access / biosecurity rules checked', note: 'Not every waterbody or rental operates in every season.', tags: ['paddling'] },
    { id: 'camp-reservation', name: 'Booked campsite, permit, opening dates and services confirmed', tags: ['camping'] },
    { id: 'vehicle-check', name: 'Actual vehicle, tires, route requirements and rental terms checked', note: 'Confirm the tires supplied; an AWD label is not a tire check. See the Alberta and BC sources below.', tags: ['driving'] },
    { id: 'flight-restrictions', name: 'Airline and CATSA restrictions checked for outdoor equipment', note: 'Bear spray and camping fuel are not allowed in carry-on or checked baggage; arrange them at your destination.', tags: ['flying', 'camping'] },
  ] },
  { id: 'clothing', name: 'Clothing & layers', items: [
    { id: 'everyday-tops', name: 'Everyday tops, underwear and comfortable trousers' },
    { id: 'midlayer', name: 'Fleece or other warm mid-layer' },
    { id: 'rain-shell', name: 'Waterproof rain / wind shell', amazon: 'waterproof rain jacket' },
    { id: 'winter-base', name: 'Thermal base layers: top and bottom', tags: ['winter'], amazon: 'merino wool base layer' },
    { id: 'winter-jacket', name: 'Insulated winter jacket', tags: ['winter'], amazon: 'down jacket winter' },
    { id: 'snow-pants', name: 'Waterproof snow pants for snow activities', tags: ['winter'], amazon: 'insulated snow pants' },
    { id: 'warm-sweater', name: 'Warm sweater / extra insulating layer', tags: ['winter'] },
    { id: 'light-base', name: 'Light thermal layer for changeable conditions', tags: ['shoulder'], amazon: 'lightweight base layer' },
    { id: 'warm-vest', name: 'Warm fleece or insulated vest', tags: ['shoulder'], amazon: 'down vest' },
    { id: 'summer-shorts', name: 'Shorts and light trousers', tags: ['summer'] },
    { id: 'wicking-shirts', name: 'Moisture-wicking tops and a long-sleeve sun shirt', tags: ['summer', 'hiking'] },
    { id: 'ski-layers', name: 'Ski layers that fit together without restricting movement', note: 'Use wool or synthetic layers against the skin; avoid jeans as ski clothing.', tags: ['skiing'] },
    { id: 'quick-dry', name: 'Quick-dry paddling clothes and a dry change', note: 'Dress for the water conditions and follow your operator’s briefing.', tags: ['paddling'] },
    { id: 'swimsuit', name: 'Swimsuit', tags: ['summer', 'hotsprings'] },
    { id: 'dinner-outfit', name: 'Optional smart-casual outfit for your booked restaurant', tags: ['dining'] },
  ] },
  { id: 'feet', name: 'Footwear, hands & head', items: [
    { id: 'walking-shoes', name: 'Comfortable everyday walking shoes' },
    { id: 'sunglasses', name: 'Sunglasses', amazon: 'polarized sunglasses' },
    { id: 'summer-hat', name: 'Sun hat / cap', tags: ['summer'] },
    { id: 'winter-boots', name: 'Insulated waterproof winter boots', tags: ['winter'], amazon: 'insulated winter boots' },
    { id: 'ice-cleats', name: 'Ice cleats fitted to your boots for icy walking', note: 'Practice fitting them. They do not make a steep, closed or avalanche-exposed route appropriate.', tags: ['winter', 'snowshoeing'], amazon: 'ice cleats boots' },
    { id: 'winter-hat', name: 'Warm toque / beanie', tags: ['winter', 'shoulder'], amazon: 'merino wool beanie' },
    { id: 'winter-gloves', name: 'Insulated waterproof gloves or mittens', tags: ['winter'], amazon: 'insulated winter gloves' },
    { id: 'light-gloves', name: 'Light warm gloves', tags: ['shoulder'], amazon: 'lightweight hiking gloves' },
    { id: 'neck-warmer', name: 'Neck gaiter / balaclava', tags: ['winter', 'skiing'] },
    { id: 'warm-socks', name: 'Warm socks and spare dry socks', tags: ['winter'], amazon: 'merino wool socks' },
    { id: 'hand-warmers', name: 'Optional hand / toe warmers', tags: ['winter'], amazon: 'hand warmers' },
    { id: 'trail-footwear', name: 'Trail footwear matched to the route and conditions', note: 'Choose a suitable pair rather than assuming one boot works for every season.', tags: ['hiking', 'summer', 'shoulder'], amazon: 'hiking boots waterproof' },
    { id: 'waterproof-boots', name: 'If needed: waterproof boots for wet shoulder-season plans', tags: ['shoulder'], amazon: 'waterproof hiking boots' },
    { id: 'sandals', name: 'Sandals / flip-flops for your accommodation or pool', tags: ['summer', 'hotsprings'] },
    { id: 'water-shoes', name: 'Water footwear recommended by your paddling operator', tags: ['paddling'], amazon: 'water shoes' },
  ] },
  { id: 'daybag', name: 'Day bag & outdoor basics', items: [
    { id: 'daypack', name: 'Daypack with room for spare layers', amazon: 'hiking daypack' },
    { id: 'water', name: 'Water bottle and enough drinking water for the plan' },
    { id: 'food', name: 'Food / snacks and extra supplies for delays' },
    { id: 'thermos', name: 'Optional thermos for a warm drink', tags: ['winter'] },
    { id: 'first-aid', name: 'Personal first-aid supplies and any required medication' },
    { id: 'offline-map', name: 'Route information and offline map / navigation backup', note: 'Do not rely on a phone app or mobile coverage alone.', tags: ['hiking', 'snowshoeing', 'camping'] },
    { id: 'headlamp', name: 'Headlamp / flashlight and spare power', tags: ['hiking', 'snowshoeing', 'camping', 'winter'], amazon: 'headlamp camping' },
    { id: 'emergency-kit', name: 'Emergency shelter / blanket, whistle and repair basics', note: 'Match the kit and communication plan to the outing; know how to use it.', tags: ['hiking', 'snowshoeing', 'camping'] },
    { id: 'trekking-poles', name: 'Optional hiking poles appropriate for the surface', tags: ['hiking', 'snowshoeing'], amazon: 'trekking poles hiking' },
    { id: 'bear-spray', name: 'Bear spray arranged locally, accessible, and use understood', note: 'Parks Canada recommends it for winter walking too. Bear bells are not a substitute. Do not pack bear spray on a flight.', tags: ['hiking', 'snowshoeing', 'camping', 'summer'], amazon: 'bear spray Canada' },
    { id: 'outdoor-communication', name: 'Communication / emergency plan suited to the route', note: 'Mobile coverage is unreliable in parts of the park; a device is useful only if you know its limits and how to use it.', tags: ['hiking', 'snowshoeing', 'camping'] },
    { id: 'dry-bag', name: 'Dry bag for spare clothing and electronics', tags: ['paddling'], amazon: 'waterproof dry bag' },
    { id: 'pool-towel', name: 'Towel if your pool / hot-springs booking requires one', tags: ['hotsprings'], amazon: 'microfiber travel towel' },
    { id: 'vehicle-kit', name: 'Vehicle emergency kit, scraper and extra warm clothing', note: 'Check the vehicle’s winter equipment and current road reports before departure.', tags: ['driving'] },
  ] },
  { id: 'activity-gear', name: 'Ski, snow & water equipment', items: [
    { id: 'ski-helmet', name: 'Correctly fitted ski / snowboard helmet', note: 'Confirm whether your rental includes it; do not assume every lesson bundle does.', tags: ['skiing'] },
    { id: 'ski-goggles', name: 'Goggles suitable for the expected light', tags: ['skiing'], amazon: 'ski goggles' },
    { id: 'ski-socks', name: 'Ski socks: one well-fitting pair worn, plus a dry spare', tags: ['skiing'], amazon: 'ski socks merino' },
    { id: 'ski-pass-holder', name: 'Pass pocket / holder compatible with your resort', tags: ['skiing'] },
    { id: 'skates', name: 'Skates and a confirmed rental / fitting if needed', note: 'Use an operator-confirmed open rink; packing skates is not an ice-safety assessment.', tags: ['skating'] },
    { id: 'skate-protection', name: 'Helmet and any protection appropriate for your skating session', tags: ['skating'] },
    { id: 'snowshoes', name: 'Snowshoes: route-appropriate size and rental confirmed', note: 'Snowshoes do not establish avalanche-terrain skills.', tags: ['snowshoeing'] },
    { id: 'gaiters', name: 'Optional gaiters for your snow / trail conditions', tags: ['snowshoeing'], amazon: 'waterproof gaiters' },
    { id: 'pfd', name: 'Properly fitted, approved lifejacket / PFD to wear', note: 'Confirm it and the boat’s required safety equipment with the operator before launching.', tags: ['paddling'] },
  ] },
  { id: 'camping', name: 'Camping: confirm the site first', items: [
    { id: 'tent', name: 'Tent / shelter appropriate to your booked campsite and conditions', tags: ['camping'], amazon: 'backpacking tent' },
    { id: 'sleeping-bag', name: 'Sleeping bag chosen for expected overnight conditions', tags: ['camping'], amazon: 'sleeping bag cold weather' },
    { id: 'sleeping-pad', name: 'Insulating sleeping pad', tags: ['camping'], amazon: 'camping sleeping pad' },
    { id: 'stove', name: 'Camp stove, cookware and locally arranged fuel', note: 'Follow current fire restrictions. Fuel cannot go in airline carry-on or checked baggage.', tags: ['camping'] },
    { id: 'food-storage', name: 'Food and scented-item storage required at your booked site', note: 'Confirm lockers, the site’s storage system or approved containers; do not assume a rope alone satisfies every site’s rules.', tags: ['camping'] },
    { id: 'camp-water', name: 'Drinking-water supply / treatment matched to site services', tags: ['camping'] },
    { id: 'camp-hygiene', name: 'Waste bags, campsite hygiene supplies and a leave-no-trace plan', tags: ['camping'] },
  ] },
  { id: 'tech', name: 'Tech & photography', items: [
    { id: 'phone-power', name: 'Phone, charger and portable battery pack' },
    { id: 'camera', name: 'Camera if you want one' },
    { id: 'tripod', name: 'Tripod', tags: ['photography'], amazon: 'travel tripod camera' },
    { id: 'lens-cleaner', name: 'Lens-cleaning kit', tags: ['photography'], amazon: 'lens cleaning kit camera' },
    { id: 'memory-cards', name: 'Spare memory cards and batteries', tags: ['photography'] },
    { id: 'polarizing-filter', name: 'Optional polarizing filter', tags: ['photography'], amazon: 'camera polarizing filter' },
  ] },
  { id: 'personal', name: 'Personal care & sun protection', items: [
    { id: 'toiletries', name: 'Toothbrush, toothpaste, deodorant and personal toiletries' },
    { id: 'lip-spf', name: 'Lip balm with SPF' },
    { id: 'sunscreen', name: 'Sunscreen for exposed skin, including winter days', amazon: 'sunscreen SPF 50 sport' },
    { id: 'shoulder-sunscreen', name: 'If preferred: your shoulder-season sunscreen choice', note: 'An alternative to the sunscreen above, not a second required bottle.', tags: ['shoulder'], amazon: 'sunscreen SPF 30' },
    { id: 'insect-repellent', name: 'Insect repellent for your summer outing', tags: ['summer'], amazon: 'insect repellent spray' },
    { id: 'after-sun', name: 'Optional skin moisturiser / after-sun lotion', tags: ['summer'] },
  ] },
];
const itemCount = groups.reduce((total, group) => total + group.items.length, 0);
const amazonLink = (term: string) => `https://www.amazon.ca/s?k=${encodeURIComponent(term)}&tag=${AFFILIATE_TAG}`;
const sources = [
  { name: 'Parks Canada: winter walking, recommended gear and avalanche awareness', url: 'https://parks.canada.ca/pn-np/ab/banff/activ/marchehiver-winterwalking' },
  { name: 'Parks Canada: natural ice and skating', url: 'https://parks.canada.ca/pn-np/ab/banff/activ/patinage-skating' },
  { name: 'Avalanche Canada: start here and training', url: 'https://avalanche.ca/start-here' },
  { name: 'Sunshine: first-timer clothing, rentals and arrival', url: 'https://www.skibanff.com/plan/first-time-visitors/first-timers-guide' },
  { name: 'Parks Canada: camping permits, facilities and food storage', url: 'https://parks.canada.ca/pn-np/ab/banff/activ/camping' },
  { name: 'Transport Canada: lifejackets and paddling safety resources', url: 'https://tc.canada.ca/en/marine-transportation/marine-safety/boating-safety/boating-safety-resources' },
  { name: 'Alberta: safer winter highways', url: 'https://www.alberta.ca/safer-winter-highways' },
  { name: 'BC: passenger-vehicle tire and chain requirements', url: 'https://www2.gov.bc.ca/gov/content/transportation/driving-and-cycling/traveller-information/seasonal/winter-driving/about-winter-tires' },
  { name: 'CATSA: flying with outdoor equipment', url: 'https://www.catsa-acsta.gc.ca/en/travel-tips/outdoor-adventure' },
];
const faqs = [
  { question: 'Does my travel month tell me exactly what to pack?', answer: 'No. The month creates a seasonal starting point, not a forecast. Conditions vary with elevation, route and the day. Winter activities add winter clothing even if your travel month is outside winter; check that the activity is actually operating.' },
  { question: 'Will the packing checklist remember my progress?', answer: 'Only if you turn on Save on this browser. It saves your selected month, activities, view and checked item IDs in this browser, without an account. Turn saving off to remove this version’s saved checklist. Reset all check marks clears progress for every item, including hidden items, while keeping your selections.' },
  { question: 'Does a completed gear list mean a winter route or frozen lake is safe?', answer: 'No. A checklist does not assess ice, avalanche terrain, weather, closures or your experience. Equipment does not provide terrain skills. Use current official conditions, operator instructions and appropriate training or qualified guidance.' },
];
---

<BaseLayout title="Banff Packing List: Winter, Summer & Ski-Day Checklist" description="Build a Banff packing checklist by travel month and activity. Prepare for a ski lesson, summer hike or camping trip; save progress on this browser or print the list." canonicalUrl="https://banffbound.com/packing-list/" lastUpdated="2026-10-28">
  <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) })} />
  <div class="container"><Breadcrumbs items={[{ label: 'Packing list' }]} /></div>
  <section class="packing-hero"><div class="container"><span class="eyebrow">Pack for the day you have planned</span><h1>Your Banff<br />packing checklist.</h1><p>Warm layers for a first lesson. A day bag for a summer trail. The confirmations that make the return journey work. Choose your month and activities, then tick things off as you pack or arrange them.</p><a class="btn btn-accent" href="#packing-checklist">Start my checklist &darr;</a></div></section>

  <section class="section"><div class="container">
    <nav class="journey-links no-print" aria-label="Plan the day before packing"><a href="/learn-to-ski"><strong>First lesson &rarr;</strong><span>Check tickets, rental inclusions and arrival.</span></a><a href="/ski-day-planner"><strong>Ski day planner &rarr;</strong><span>Put the resort, lesson and transport together.</span></a><a href="/skiing"><strong>Compare ski resorts &rarr;</strong><span>Choose your resort and actual activity.</span></a><a href="/winter"><strong>Winter guide &rarr;</strong><span>Understand seasonal access and trip choices.</span></a></nav>
    <div class="tool-controls no-print" id="packing-controls" hidden>
      <form id="packing-form"><div class="control-heading"><span class="eyebrow">Make the list fit your plans</span><h2>When are you going, and what will you do?</h2></div><label class="month-label" for="packing-month">Travel month<select id="packing-month" name="month"><option value="all">All-season starter / not sure yet</option>{months.map((month, index) => <option value={index}>{month}</option>)}</select></label>
        <fieldset><legend>Planned activities</legend><p class="control-help">Select what you have planned. A first lesson also adds resort ski essentials. Selecting an activity does not confirm that it is open.</p><div class="activity-grid">{activities.map(activity => <label><input type="checkbox" name="activity" value={activity.id} /><span>{activity.name}</span></label>)}</div></fieldset>
        <div class="filter-footer"><label for="packing-view">Show<select id="packing-view" name="view"><option value="all">All items in my plan</option><option value="unpacked">Still to pack / arrange</option><option value="packed">Already packed / arranged</option></select></label><button type="reset">Reset selections</button><p>Changing selections keeps your check marks. Reset selections keeps progress and returns to the all-season starter.</p></div>
      </form>
      <div class="save-controls"><label><input type="checkbox" id="packing-remember" /><span>Save on this browser</span></label><p id="packing-save-status" role="status">Optional: remember selections and check marks here between visits. No account is needed.</p></div>
    </div>
    <noscript><div class="no-script-note"><strong>The complete checklist is below.</strong> Tick the items that apply to your trip and print using your browser. Month/activity filtering and saved progress require JavaScript; the full list and source links remain usable here.</div></noscript>

    <div class="checklist-heading" id="packing-checklist"><div><span class="eyebrow">Packed or arranged</span><h2 id="packing-title">Complete Banff packing checklist</h2><p id="packing-context">Use the season and activity labels to choose what applies. This is a starting point; adapt it to your group, operator and current conditions.</p><div id="packing-progress-wrap" hidden><label for="packing-progress" id="packing-progress-text">0 of {itemCount} items packed or arranged</label><progress id="packing-progress" value="0" max={itemCount}></progress><p id="packing-results" aria-live="polite" role="status"></p></div></div><div class="checklist-actions no-print" id="packing-actions" hidden><button type="button" id="packing-print">Print this view</button><button type="button" id="packing-share">Copy plan link</button><button type="button" id="packing-reset">Reset all check marks</button><p>Print uses the current filters. Reset clears every check mark, including hidden items, and keeps your month and activities.</p></div></div>
    <p id="packing-action-status" class="action-status" role="status" aria-live="polite"></p><div id="packing-share-fallback" class="share-fallback no-print" hidden><label for="packing-share-url">Plan link: copy manually</label><input id="packing-share-url" readonly /><p>The link shares month and activities, never your checked items.</p></div>
    <div class="scope-note"><strong>Packing is one part of planning.</strong> This list does not assess conditions, ice, avalanche terrain, road access or your ability. Ice cleats, snowshoes and rescue equipment do not provide terrain skills. Check current official guidance and follow your operator or instructor’s directions.</div>
    <p class="affiliate-note">Amazon search links are affiliate links using BanffBound’s existing tag. We may earn a commission from qualifying purchases. These are product searches, not live price, review or suitability recommendations. Check the equipment, fit and transport restrictions before buying.</p>
    <div class="packing-groups">{groups.map(group => <section class="packing-group" data-group={group.id} aria-labelledby={`group-${group.id}`}><h3 id={`group-${group.id}`}>{group.name}</h3><ul>{group.items.map(item => <li class="packing-row" data-item-id={item.id} data-tags={(item.tags || []).join(' ')}><input type="checkbox" id={`pack-${item.id}`} data-pack-id={item.id} /><div class="pack-copy"><label for={`pack-${item.id}`}><span class="item-name">{item.name}</span></label>{item.note && <p>{item.note}</p>}{item.tags?.length && <span class="item-tags">{item.tags.map(tag => activities.find(activity => activity.id === tag)?.name || `${tag.charAt(0).toUpperCase()}${tag.slice(1)} season`).join(' · ')}</span>}</div>{item.amazon && <a class="shop-link no-print" href={amazonLink(item.amazon)} target="_blank" rel="noopener sponsored" aria-label={`Search Amazon for ${item.name}`}>Shop &nearr;</a>}</li>)}</ul></section>)}</div>
    <div id="packing-empty" class="empty-note" hidden><h3>No items in this view.</h3><p>Change the activity or show all items in your plan. A fully checked list is not confirmation that conditions or terrain are appropriate.</p></div>

    <section class="planning-notes" aria-labelledby="packing-conditions"><span class="eyebrow">Check before setting out</span><h2 id="packing-conditions">The equipment is not the go-ahead</h2><div class="note-grid"><article><h3>Winter walking and avalanche terrain</h3><p>A summer trail sign does not establish a winter route. <a href="https://parks.canada.ca/pn-np/ab/banff/activ/marchehiver-winterwalking" target="_blank" rel="noopener">Parks Canada’s winter walking guidance</a> recommends route checks, maps, warm extras and emergency supplies. <a href="https://avalanche.ca/start-here" target="_blank" rel="noopener">Avalanche Canada</a> explains why even flat ground can lie beneath an avalanche slope. A shopping list does not replace training, terrain judgment or qualified guidance.</p></article><article><h3>Skating needs an open, appropriate surface</h3><p>Parks Canada does not monitor natural ice for safety or mark its hazards. Packing skates does not assess thickness or access. Choose an operator-confirmed open rink and follow current closures and <a href="https://parks.canada.ca/pn-np/ab/banff/activ/patinage-skating" target="_blank" rel="noopener">official skating guidance</a>.</p></article><article><h3>Rental car means checking the actual tires</h3><p>Confirm the tires supplied and the requirements for your route. <a href="https://www.alberta.ca/safer-winter-highways" target="_blank" rel="noopener">Alberta recommends winter preparation</a>; <a href="https://www2.gov.bc.ca/gov/content/transportation/driving-and-cycling/traveller-information/seasonal/winter-driving/about-winter-tires" target="_blank" rel="noopener">BC has seasonal requirements on designated routes</a>. A vehicle type or a packed emergency kit does not establish road conditions. Recheck <a href="https://511.alberta.ca/" target="_blank" rel="noopener">Alberta 511</a> and <a href="https://www.drivebc.ca/" target="_blank" rel="noopener">DriveBC</a>.</p></article><article><h3>Flying changes what you can bring</h3><p><a href="https://www.catsa-acsta.gc.ca/en/travel-tips/outdoor-adventure" target="_blank" rel="noopener">CATSA prohibits bear spray and camping fuel in carry-on and checked baggage</a>. Arrange them locally and check the carrier’s rules for other equipment. For paddling, confirm the boat’s kit and wear a <a href="https://tc.canada.ca/en/marine-transportation/marine-safety/boating-safety/boating-safety-resources" target="_blank" rel="noopener">properly fitted approved lifejacket / PFD</a>.</p></article></div></section>
    <section class="packing-faq"><h2>Packing checklist questions</h2>{faqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
    <section class="source-list"><h2>Sources and review date</h2><p>Reviewed 28 October 2026. The item selection and seasonal grouping are editorial starting points, not a current forecast or a complete backcountry equipment specification. Use these primary sources and your booked operator’s current instructions.</p><ul>{sources.map(source => <li><a href={source.url} target="_blank" rel="noopener">{source.name}</a></li>)}</ul></section>
  </div></section>
</BaseLayout>

<script>
  const initPackingList = () => {
    const form = document.querySelector<HTMLFormElement>('#packing-form');
    if (!form || form.dataset.ready) return;
    const month = document.querySelector<HTMLSelectElement>('#packing-month')!;
    const view = document.querySelector<HTMLSelectElement>('#packing-view')!;
    const remember = document.querySelector<HTMLInputElement>('#packing-remember')!;
    const activityInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="activity"]'));
    const checks = Array.from(document.querySelectorAll<HTMLInputElement>('[data-pack-id]'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-item-id]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
    const allowedIds = new Set(checks.map(check => check.dataset.packId!));
    const allowedActivities = new Set(activityInputs.map(input => input.value));
    const allowedMonths = new Set(Array.from(month.options).map(option => option.value));
    const allowedViews = new Set(['all', 'unpacked', 'packed']);
    const checked = new Set<string>();
    const key = 'banffbound-packing-v2';
    const saveStatus = document.querySelector<HTMLElement>('#packing-save-status')!;
    const actionStatus = document.querySelector<HTMLElement>('#packing-action-status')!;
    const title = document.querySelector<HTMLElement>('#packing-title')!;
    const context = document.querySelector<HTMLElement>('#packing-context')!;
    const progress = document.querySelector<HTMLProgressElement>('#packing-progress')!;
    const progressText = document.querySelector<HTMLElement>('#packing-progress-text')!;
    const results = document.querySelector<HTMLElement>('#packing-results')!;
    const empty = document.querySelector<HTMLElement>('#packing-empty')!;
    const monthNames = Array.from(month.options).slice(1).map(option => option.textContent || '');
    let saveFailed = false;
    const selectedActivities = () => activityInputs.filter(input => input.checked).map(input => input.value);
    const ensureLessonGear = () => {
      if (activityInputs.some(input => input.value === 'lesson' && input.checked)) activityInputs.find(input => input.value === 'skiing')!.checked = true;
    };
    const seasonFor = (value: string) => value === 'all' ? 'all' : [10, 11, 0, 1, 2].includes(Number(value)) ? 'winter' : [5, 6, 7].includes(Number(value)) ? 'summer' : 'shoulder';
    const removeSaved = () => {
      try { window.localStorage.removeItem(key); saveFailed = false; return true; }
      catch { saveFailed = true; return false; }
    };
    const save = () => {
      if (!remember.checked) return;
      try {
        window.localStorage.setItem(key, JSON.stringify({ version: 2, month: month.value, activities: selectedActivities(), view: view.value, checked: Array.from(checked) }));
        saveFailed = false;
        saveStatus.textContent = 'Selections and check marks are saved on this browser. Turn saving off to remove this saved checklist.';
      } catch {
        saveFailed = true;
        saveStatus.textContent = 'Browser saving is unavailable. You can still use and print this checklist; changes may not survive a reload.';
      }
    };
    try {
      const raw = window.localStorage.getItem(key);
      if (raw) {
        const saved: unknown = JSON.parse(raw);
        if (saved && typeof saved === 'object' && 'version' in saved && saved.version === 2) {
          const data = saved as Record<string, unknown>;
          if (typeof data.month === 'string' && allowedMonths.has(data.month)) month.value = data.month;
          if (typeof data.view === 'string' && allowedViews.has(data.view)) view.value = data.view;
          if (Array.isArray(data.activities)) for (const input of activityInputs) input.checked = data.activities.includes(input.value);
          if (Array.isArray(data.checked)) for (const id of data.checked) if (typeof id === 'string' && allowedIds.has(id)) checked.add(id);
          remember.checked = true;
          saveStatus.textContent = 'Saved selections and check marks restored from this browser.';
        } else saveStatus.textContent = 'The saved checklist could not be restored. This checklist still works; turn saving on to start a new saved copy.';
      }
    } catch {
      saveFailed = true;
      saveStatus.textContent = 'A saved checklist could not be read. You can still use and print this list; turn saving on to try saving a new copy.';
    }
    const params = new URLSearchParams(window.location.search);
    if (params.has('month') || params.has('activities')) {
      const chosenMonth = params.get('month') || 'all';
      month.value = allowedMonths.has(chosenMonth) ? chosenMonth : 'all';
      const chosenActivities = new Set((params.get('activities') || '').split(',').filter(activity => allowedActivities.has(activity)));
      for (const input of activityInputs) input.checked = chosenActivities.has(input.value);
      view.value = 'all';
    }
    ensureLessonGear();
    for (const check of checks) check.checked = checked.has(check.dataset.packId!);
    const updateUrl = () => {
      const url = new URL(window.location.href);
      month.value === 'all' ? url.searchParams.delete('month') : url.searchParams.set('month', month.value);
      const selected = selectedActivities();
      selected.length ? url.searchParams.set('activities', selected.join(',')) : url.searchParams.delete('activities');
      try { window.history.replaceState({}, '', url); } catch { /* The checklist remains usable if history is unavailable. */ }
    };
    const update = () => {
      const selected = selectedActivities();
      const season = seasonFor(month.value);
      const winterActivity = selected.some(activity => ['skiing', 'lesson', 'skating', 'snowshoeing'].includes(activity));
      const tags = new Set([...selected, season]);
      if (season === 'all') for (const value of ['winter', 'summer', 'shoulder']) tags.add(value);
      if (winterActivity) tags.add('winter');
      let total = 0, packed = 0, shown = 0;
      for (const row of rows) {
        const itemTags = (row.dataset.tags || '').split(' ').filter(Boolean);
        const included = !itemTags.length || itemTags.some(tag => tags.has(tag));
        const done = checked.has(row.dataset.itemId!);
        if (included) { total++; if (done) packed++; }
        row.hidden = !included || (view.value === 'unpacked' && done) || (view.value === 'packed' && !done);
        if (!row.hidden) shown++;
      }
      for (const group of groups) group.hidden = !Array.from(group.querySelectorAll<HTMLElement>('[data-item-id]')).some(row => !row.hidden);
      progress.max = Math.max(total, 1); progress.value = packed;
      progressText.textContent = `${packed} of ${total} items packed or arranged`;
      results.textContent = `${shown} ${shown === 1 ? 'item' : 'items'} shown. Progress covers all items in this plan, including checked items hidden by the view filter.`;
      title.textContent = month.value === 'all' ? 'Your all-season packing starter' : `Your ${monthNames[Number(month.value)]} packing checklist`;
      context.textContent = `Seasonal starting point: ${season === 'all' ? 'all seasons' : season}. ${selected.length ? `${selected.length} activities selected.` : 'Choose activities to add their equipment and booking checks.'} ${winterActivity && season !== 'winter' ? 'Winter activities also add winter layers; this does not confirm seasonal operation.' : 'Recheck the actual forecast, route and operator instructions.'}`;
      empty.hidden = shown > 0;
    };
    form.addEventListener('submit', event => event.preventDefault());
    form.addEventListener('change', event => {
      const target = event.target as HTMLInputElement;
      if (target.name === 'activity' && target.value === 'skiing' && !target.checked) activityInputs.find(input => input.value === 'lesson')!.checked = false;
      ensureLessonGear(); update(); updateUrl(); save();
    });
    form.addEventListener('reset', () => window.setTimeout(() => { ensureLessonGear(); update(); updateUrl(); save(); actionStatus.textContent = 'Selections reset. Your check marks have been kept.'; }, 0));
    for (const check of checks) check.addEventListener('change', () => {
      const id = check.dataset.packId!;
      check.checked ? checked.add(id) : checked.delete(id);
      update(); save();
    });
    remember.addEventListener('change', () => {
      if (remember.checked) save();
      else saveStatus.textContent = removeSaved() ? 'Saving is off. The saved checklist was removed; your current selections and checks remain for this visit.' : 'Saving is off, but browser storage could not be cleared. The checklist works for this visit; use your browser’s site-data controls if you need to remove a previously saved copy.';
    });
    document.querySelector('#packing-reset')!.addEventListener('click', () => {
      checked.clear(); for (const check of checks) check.checked = false;
      update(); save();
      actionStatus.textContent = saveFailed && remember.checked ? 'All check marks cleared for this visit, including hidden items. Browser storage could not be updated.' : 'All check marks reset, including hidden items. Your month and activity selections are unchanged.';
    });
    document.querySelector('#packing-print')!.addEventListener('click', () => window.print());
    document.querySelector('#packing-share')!.addEventListener('click', async () => {
      const url = new URL('/packing-list/', window.location.origin);
      if (month.value !== 'all') url.searchParams.set('month', month.value);
      const selected = selectedActivities(); if (selected.length) url.searchParams.set('activities', selected.join(','));
      try {
        await navigator.clipboard.writeText(url.href);
        document.querySelector<HTMLElement>('#packing-share-fallback')!.hidden = true;
        actionStatus.textContent = 'Plan link copied. It shares the month and activities, never your checked items.';
      } catch {
        const field = document.querySelector<HTMLInputElement>('#packing-share-url')!;
        field.value = url.href; document.querySelector<HTMLElement>('#packing-share-fallback')!.hidden = false; field.focus(); field.select();
        actionStatus.textContent = 'Copy the plan link below. Your checked items are not included.';
      }
    });
    form.dataset.ready = 'true';
    for (const id of ['packing-controls', 'packing-actions', 'packing-progress-wrap']) document.getElementById(id)!.hidden = false;
    update();
  };
  initPackingList();
  document.addEventListener('astro:page-load', initPackingList);
</script>

