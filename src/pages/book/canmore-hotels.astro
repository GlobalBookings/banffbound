---
import PaidLandingLayout from '../../layouts/PaidLandingLayout.astro';
import GatewayHotelComparison from '../../components/GatewayHotelComparison.astro';
import { directoryHotels } from '../../data/hotelDirectory';
import { canmoreStayExamples } from '../../data/townStayPlanning';
import { gatewayHotelLinks } from '../../data/gatewayHotelLinks';
const stays = canmoreStayExamples.map(example => {
  const hotel = directoryHotels.find(item => item.slug === example.slug && item.sourceStatus === 'reviewed');
  if (!hotel) throw new Error(`Canmore comparison requires a reviewed profile: ${example.slug}`);
  return { id: hotel.slug, name: hotel.name, address: hotel.address, area: example.area, room: example.room,
    journey: example.journey, image: hotel.image, guide: `/hotel-directory/${hotel.slug}/`, booking: gatewayHotelLinks[example.slug] };
});
---
<PaidLandingLayout title="Canmore Hotels: Compare Rooms, Kitchen Suites & Check Dates" description="Compare six Canmore-area stays by address, room type, kitchen and transport. Check live dates and room prices on Expedia." heading="Find the right Canmore hotel." eyebrow="Canmore hotel comparison" intro="Compare a downtown room, a suite with a full kitchen and a separate Bow Valley road base. Pick the address that fits your plans, then check your dates." primaryCta={{label:'Compare the six stays',href:'#compare-stays'}} heroImage="/images/blog/canmore-day-trip.webp" heroAlt="Mountain scenery around Canmore" lastUpdated="2026-11-12">
  <GatewayHotelComparison stays={stays} place="Canmore" landingId="canmore-hotels" searchUrl={gatewayHotelLinks.canmoreSearch} />
  <nav class="container gateway-next" aria-label="Compare other bases"><a href="/hotel-directory/?area=Canmore">Browse the Canmore hotel directory →</a><a href="/book/banff-hotels/">Compare Banff hotels →</a><a href="/towns/canmore/#getting-around">Getting around Canmore →</a><a href="/calgary-to-banff/">Plan the Calgary transfer →</a></nav>
</PaidLandingLayout>
<style>.gateway-next{display:flex;flex-wrap:wrap;gap:1rem 1.6rem;padding-bottom:3rem}.gateway-next a{color:var(--color-primary);font-weight:650}</style>
