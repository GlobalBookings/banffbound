---
import PaidLandingLayout from '../../layouts/PaidLandingLayout.astro';
import ActivityCarousel from '../../components/ActivityCarousel.astro';
import { winterActivityLandingId, winterActivityReviewedAt, winterActivityOffers, winterActivityFinalOffers, winterActivityPaidCampaign, winterActivityFaqs, winterActivityClosureSource } from '../../data/winterActivityLanding';
import { winterActivityCatalogue, winterActivityCategories, winterActivityCatalogueReviewedAt } from '../../data/winterActivityCatalogue';
import winterPhotoCredits from '../../data/winterActivityPhotoCredits.json';
const activityAnchor = (activity: typeof winterActivityCatalogue[number]) => {
  const offer = winterActivityOffers.find(candidate => candidate.id === activity.bookingOfferId);
  return offer ? offer.anchor : activity.id;
};
const heroPhoto = winterActivityCatalogue[0]?.gallery[0];
const usedPhotos = new Set(winterActivityCatalogue.flatMap(activity => activity.gallery.map(image => image.src)));
const photoCredits = winterPhotoCredits.filter(photo => usedPhotos.has(photo.src));
const activityList = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Top 20 winter activities in Banff',
  numberOfItems: winterActivityCatalogue.length,
  itemListElement: winterActivityCatalogue.map(activity => ({ '@type': 'ListItem', position: activity.rank, name: activity.name, url: `https://banffbound.com/book/banff-winter-activities/#${activityAnchor(activity)}` })),
};
---
<PaidLandingLayout
  title="Top 20 Winter Activities in Banff"
  description="Find your winter highlight in Banff: compare 20 activities, browse the photos and discover mountain views, winter adventures and cosy days in town."
  eyebrow="Your winter shortlist"
  heading="Top 20 winter activities in Banff"
  intro="Mountain views, snowy adventures and a few cosy favourites. Find the winter day that belongs on your trip."
  primaryCta={{ label: 'Find out more', href: '#experiences' }}
  lastUpdated={winterActivityCatalogueReviewedAt}
  landingId={winterActivityLandingId}
>
  <script type="application/ld+json" set:html={JSON.stringify(activityList)} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: winterActivityFaqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) })} />
  <div slot="hero-detail" class="winter-hero-detail">
    {heroPhoto && <><img src={heroPhoto.src} alt={heroPhoto.alt} width="800" height="600" loading="eager" fetchpriority="high" /><div class="hero-photo-caption">{heroPhoto.caption}</div></>}
    <div class="hero-highlights"><span>20 winter ideas</span><span>Photos to explore</span><span>Your kind of day</span></div>
  </div>
  <section class="landing-section" id="experiences" aria-labelledby="experience-heading">
    <div class="section-intro"><span class="section-kicker">The winter edit</span><h2 id="experience-heading">20 ways to make it a Banff winter</h2><p>Our editorial shortlist puts fifteen published GetYourGuide experiences first, followed by five other winter plans. Compare the actual destination and format, then check your date with the provider.</p></div>
    <div class="shortlist-note"><p><strong>Affiliate disclosure:</strong> booking links open GetYourGuide. BanffBound may earn a commission from qualifying bookings.</p><p>Seasonal activities depend on dates, snow and access. Photos show their credited subject or regional setting, which may differ from a tour’s exact stops; they do not show a particular product, inclusions or current conditions. <a href="#photo-credits">Photo credits</a>.</p></div>
    <form id="winter-experience-form" class="experience-filter" hidden aria-describedby="winter-experience-count">
      <div><label for="winter-experience">What’s your kind of winter day?</label><select id="winter-experience" name="category">{winterActivityCategories.map(option => <option value={option.value}>{option.label}</option>)}</select></div>
      <button type="reset">Show all</button>
    </form>
    <p id="winter-experience-count" class="experience-count" role="status" aria-live="polite" aria-atomic="true">20 activities to explore</p>
    <noscript><p>All 20 activities, photos and links are shown below. Swipe or scroll each photo gallery to browse without JavaScript.</p></noscript>
    <ol class="experience-list">
      {winterActivityCatalogue.map(activity => {
        const offer = winterActivityOffers.find(candidate => candidate.id === activity.bookingOfferId);
        return <li class="experience-item" data-winter-activity={activity.id} data-experience-category={activity.category} value={activity.rank}>
          <article class="experience-card" id={activityAnchor(activity)} aria-labelledby={`activity-title-${activity.id}`}>
            <div class="activity-visual"><ActivityCarousel id={activity.id} name={activity.name} images={activity.gallery} /><span class="rank-badge" aria-label={`Number ${activity.rank}`}>{String(activity.rank).padStart(2, '0')}</span></div>
            <div class="activity-copy">
              <p class="format-tag">{winterActivityCategories.find(category => category.value === activity.category)?.label}</p>
              <h3 id={`activity-title-${activity.id}`}>{activity.name}</h3>
              <p class="fit">{activity.fit}</p><p class="activity-description">{activity.description}</p>
              <p class="practical-note" id={`activity-note-${activity.id}`}>{activity.practicalNote}</p>
              {offer?.needsCanyonCheck && <p class="card-access"><strong>Johnston Canyon closure — checked October 30, 2026:</strong> Parks lists the trail and day-use area closed from October 13 to a scheduled December 11, 2026. Reopening is not confirmed. Ask the operator to confirm the route for your date before booking. <a href={winterActivityClosureSource} target="_blank" rel="noopener">Current notice</a>.</p>}
              <div class="activity-actions">
                <a class="more-cta" href={activity.internalHref} target={activity.internalHref.startsWith('https://') ? '_blank' : undefined} rel={activity.internalHref.startsWith('https://') ? 'noopener' : undefined} aria-label={`${activity.informationLabel || 'Find out more'}: ${activity.name}`}>{activity.informationLabel || 'Find out more'}</a>
                {offer && <a class="booking-cta" href={offer.bookingUrl} target="_blank" rel="noopener sponsored" aria-label={`${offer.cta}: ${activity.name}`} aria-describedby={`activity-note-${activity.id}`} data-landing-id={winterActivityLandingId} data-offer-id={offer.id} data-landing-placement="detail-card" data-paid-affiliate-campaign={winterActivityPaidCampaign} data-affiliate-target-path={new URL(offer.bookingUrl).pathname}>{offer.cta}</a>}
              </div>
              {offer && <details class="booking-details"><summary>Good to know before booking</summary><p><strong>Provider:</strong> {offer.provider}.</p><p>{offer.tradeoff}</p><p>{offer.transport}</p><p>{offer.group}</p><p>{offer.bookingCheck}</p><ul>{offer.sourceUrls.map(source => <li><a href={source} target="_blank" rel="noopener">Provider source information</a></li>)}</ul></details>}
            </div>
          </article>
        </li>;
      })}
    </ol>
    <aside class="access-note"><strong>Johnston Canyon access — checked October 30, 2026:</strong> Parks Canada’s construction notice lists the trail and day-use area closed from October 13 to a scheduled December 11, 2026. This is not confirmation of reopening. For either canyon experience, confirm the route for your date before paying. <a href={winterActivityClosureSource} target="_blank" rel="noopener">Current Parks notice</a>.</aside>
  </section>
  <section class="landing-section faq-section" aria-labelledby="faq-heading"><div class="section-intro"><span class="section-kicker">A little planning goes a long way</span><h2 id="faq-heading">Before you book</h2></div>{winterActivityFaqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
  <section class="landing-section photo-credits" id="photo-credits" aria-label="Photo credits"><details><summary>Photo credits</summary><p>These historical photographs show the credited subject or setting. Images are cropped to fit the layout.</p><ul>{photoCredits.map(photo => <li><a href={photo.sourceUrl} target="_blank" rel="noopener">{photo.title}</a> — {photo.author}. <a href={photo.licenseUrl} target="_blank" rel="noopener">{photo.license}</a>. {photo.changeNote}</li>)}</ul></details></section>
  <section class="landing-section final-choice" aria-labelledby="final-heading">
    <span class="section-kicker">Choose your kind of day</span><h2 id="final-heading">A ride, a road day or an evening out?</h2>
    <p>Start with these three different formats, or return to all fifteen product choices above. Check the actual date, option and terms before paying.</p>
    <div class="final-links">{winterActivityFinalOffers.map(offer => <div class="final-offer">
      <h3>{offer.name}</h3><p class="final-access" id={`final-note-${offer.id}`}>{offer.seasonalNotice}</p>
      <a href={offer.bookingUrl} target="_blank" rel="noopener sponsored" aria-label={`${offer.cta}: ${offer.name}`} aria-describedby={`final-note-${offer.id}`} data-landing-id={winterActivityLandingId} data-offer-id={offer.id} data-landing-placement="final-shortlist" data-paid-affiliate-campaign={winterActivityPaidCampaign} data-affiliate-target-path={new URL(offer.bookingUrl).pathname}>{offer.cta}</a>
    </div>)}</div>
    <p class="source-note">Editorial shortlist reviewed {winterActivityCatalogueReviewedAt}. Product identities and linked provider information reviewed {winterActivityReviewedAt}. Published listings are not a live availability feed.</p>
    <p class="source-note"><a href="/editorial/">Editorial approach</a> · <a href="/contact/">Contact BanffBound</a></p>
  </section>
</PaidLandingLayout>

<script>
  import { buildWinterActivityCatalogueSelection, normaliseWinterActivityCategory, winterActivityCategories } from '../../data/winterActivityCatalogue';
  function initWinterExperienceFilter() {
    const form = document.getElementById('winter-experience-form') as HTMLFormElement | null;
    const select = document.getElementById('winter-experience') as HTMLSelectElement | null;
    const count = document.getElementById('winter-experience-count');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-winter-activity]')];
    if (!form || !select || !count || !cards.length || form.dataset.ready) return;
    form.dataset.ready = 'true';
    let hadParameter = false;
    try {
      const values = new URL(window.location.href).searchParams.getAll('category');
      hadParameter = values.length > 0;
      select.value = normaliseWinterActivityCategory(values.length === 1 ? values[0] : undefined);
    } catch { select.value = 'all'; }
    function update(writeUrl = false) {
      const result = buildWinterActivityCatalogueSelection(select!.value);
      select!.value = result.category;
      const visible = new Set(result.activityIds);
      for (const card of cards) card.hidden = !visible.has(card.dataset.winterActivity!);
      const label = winterActivityCategories.find(option => option.value === result.category)!.label;
      count!.textContent = `${result.activityIds.length} ${result.activityIds.length === 1 ? 'activity shown' : 'activities shown'} — ${label}`;
      if (writeUrl) {
        try {
          const url = new URL(window.location.href);
          result.category === 'all' ? url.searchParams.delete('category') : url.searchParams.set('category', result.category);
          window.history.replaceState({}, '', url);
        } catch { /* The local preference filter still works without URL updates. */ }
      }
    }
    form.addEventListener('submit', event => event.preventDefault());
    form.addEventListener('change', () => update(true));
    form.addEventListener('reset', event => { event.preventDefault(); select.value = 'all'; update(true); });
    update(hadParameter);
    form.hidden = false;
  }
  initWinterExperienceFilter();
  document.addEventListener('astro:page-load', initWinterExperienceFilter);
</script>
<style>
  [hidden]{display:none!important}.winter-hero-detail{position:relative}.winter-hero-detail>img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:16px}.hero-photo-caption{font-size:.7rem;color:#d6e2d3;line-height:1.4;margin:.5rem 0}.hero-highlights{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}.hero-highlights span{border:1px solid #58705b;border-radius:20px;padding:.4rem .65rem;font-size:.76rem;color:#ecf1e5}
  .landing-section{max-width:1180px;margin:0 auto;padding:3rem 1.25rem}.section-intro{max-width:760px;margin-bottom:1.4rem}.section-intro h2{margin:.45rem 0 .8rem;font-size:clamp(1.8rem,3vw,2.5rem);line-height:1.2}.section-intro p{font-size:1.02rem;line-height:1.75;color:#526254}.section-kicker{text-transform:uppercase;letter-spacing:.12em;font-size:.73rem;font-weight:800;color:#276044}.shortlist-note{display:flex;gap:1.25rem;flex-wrap:wrap;border-top:1px solid #dce3d8;padding-top:1rem;margin-bottom:1.2rem}.shortlist-note p{flex:1 1 300px;font-size:.78rem;line-height:1.6;color:#536251;margin:0}
  .experience-filter{display:flex;align-items:end;gap:.8rem;flex-wrap:wrap;padding:1rem 1.2rem;margin:1.2rem 0 .7rem;background:#edf2e8;border:1px solid #dce4d5;border-radius:12px}.experience-filter>div{flex:1 1 300px}.experience-filter label{display:block;font-size:.85rem;font-weight:700;margin-bottom:.45rem}.experience-filter select,.experience-filter button{font:inherit;font-size:.9rem;min-height:44px;border:1px solid #879980;border-radius:7px;padding:.65rem .8rem;background:white;color:#153e2c}.experience-filter select{width:100%}.experience-filter button{cursor:pointer;font-weight:700}.experience-filter :focus-visible{outline:3px solid #1c6d4b;outline-offset:3px}.experience-count{font-size:.8rem;color:#596856;font-weight:600;margin:0 0 1.4rem}
  .experience-list{display:grid;gap:1.5rem;padding:0;margin:0;list-style:none}.experience-item{min-width:0}.experience-card{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.35fr);gap:1.8rem;align-items:start;border:1px solid #dce3d8;border-radius:20px;padding:1.15rem;background:white;scroll-margin-top:88px;box-shadow:0 6px 24px #183d2910}.activity-visual{position:relative;min-width:0}.rank-badge{position:absolute;top:.8rem;left:.8rem;display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:#f5e7c8;color:#1b402e;font-size:1.1rem;font-weight:800;box-shadow:0 2px 8px #112d2430;pointer-events:none}.activity-copy{min-width:0;padding:.5rem .65rem .5rem 0}.format-tag{font-size:.7rem;text-transform:uppercase;letter-spacing:.07em;font-weight:750;color:#42704d;margin:0 0 .6rem}.activity-copy h3{font-size:clamp(1.5rem,2.1vw,1.9rem);line-height:1.2;margin:0 0 .75rem;color:#193e2b}.activity-copy p{line-height:1.7}.fit{font-size:.96rem;font-weight:650;margin:.2rem 0 .6rem;color:#294e37}.activity-description{font-size:.94rem;color:#52614e;margin:.4rem 0 .8rem}.practical-note{font-size:.8rem;color:#617058;border-left:3px solid #d8c594;padding-left:.8rem;line-height:1.6!important;margin:.85rem 0}.card-access{padding:.7rem .85rem;background:#fff6e5;border:1px solid #eddbb4;border-radius:8px;font-size:.78rem;line-height:1.6!important;color:#694b23}.card-access a{color:inherit}
  .activity-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.1rem}.more-cta,.booking-cta{display:inline-flex;justify-content:center;align-items:center;min-height:46px;padding:.7rem 1.2rem;border-radius:8px;font-size:.9rem;font-weight:750;text-decoration:none;line-height:1.4}.more-cta{border:1px solid #355d40;background:#fff;color:#234b32}.more-cta:hover{background:#f0f5ed}.booking-cta{border:1px solid #b94416;background:#c64a18;color:white}.booking-cta:hover{background:#a63a10}.activity-actions a:focus-visible,summary:focus-visible{outline:3px solid #1c6d4b;outline-offset:4px}.booking-details{margin-top:1rem;border-top:1px solid #e2e7dc;padding-top:.8rem}.booking-details summary{font-size:.8rem;color:#426147;font-weight:650;cursor:pointer}.booking-details p{font-size:.82rem;color:#57664f}.booking-details a{color:#28553a}
  .access-note{margin-top:1.5rem;padding:1rem 1.2rem;background:#fff6e6;border:1px solid #ead9b7;border-radius:12px;font-size:.82rem;line-height:1.7;color:#654d25}.access-note a{color:inherit}.faq-section{max-width:920px;padding-top:1rem}.faq-section details{border-top:1px solid #d7dfd9;padding:1rem 0}.faq-section summary{cursor:pointer;font-weight:650;line-height:1.5}.faq-section details p{line-height:1.8;margin:.8rem 0;color:#52614f;font-size:.94rem}
  .photo-credits{padding-top:0;padding-bottom:2rem;max-width:920px;color:#52614f;font-size:.8rem;line-height:1.7}.photo-credits summary{font-weight:650;cursor:pointer}.photo-credits ul{padding-left:1.2rem}.photo-credits li{margin:.6rem 0}.photo-credits a{color:#275a3a}
  .final-choice{background:#173f2c;color:#fff;border-radius:20px;margin-bottom:3rem;padding:2.5rem}.final-choice>.section-kicker{color:#e5c68f}.final-choice h2{color:white;font-size:clamp(1.8rem,3vw,2.5rem);line-height:1.2;margin:.7rem 0}.final-choice>p{color:#dce6d7;line-height:1.75;max-width:750px}.final-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.5rem 0 2rem}.final-offer{background:#244d37;border:1px solid #52705a;border-radius:12px;padding:1.1rem;display:flex;flex-direction:column;align-items:start}.final-offer h3{font-size:1.05rem;line-height:1.45;color:white;margin:0 0 1rem}.final-offer>a{display:inline-flex;justify-content:center;align-items:center;min-height:44px;padding:.6rem 1rem;background:#ead1a0;color:#163c29;border-radius:7px;font-size:.9rem;font-weight:750;text-decoration:none;margin-top:auto}.final-offer>.final-access{margin:0 0 1rem}.final-offer>p{font-size:.75rem;line-height:1.6;color:#dce6d7;margin:.8rem 0 0}.source-note{font-size:.76rem;color:#c4d4bf!important;line-height:1.7}.source-note a{color:inherit}a{overflow-wrap:anywhere}
  @media(max-width:760px){.landing-section{padding:2rem 1rem}.experience-card{grid-template-columns:1fr;gap:1.1rem;padding:.85rem;border-radius:16px}.activity-copy{padding:.1rem .25rem .4rem}.experience-list{gap:1.25rem}.activity-copy h3{font-size:1.55rem}.more-cta,.booking-cta{flex:1 1 auto}.hero-highlights{gap:.4rem}.hero-highlights span{font-size:.7rem}.final-choice{border-radius:0;margin-bottom:0;padding:2rem 1.2rem}.final-links{grid-template-columns:1fr}.shortlist-note{gap:.7rem}.faq-section{padding-top:1rem}}
</style>
