---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { trailPlanningRoutes, trailInterests, trailPlanningReviewedAt } from '../data/trailAlternatives';
import { trailReportUrl, trailPark } from '../data/trailPlanning';

const areas = [...new Set(trailPlanningRoutes.map(route => route.area))].sort();
---

<BaseLayout title="Quiet Trail Planning: Banff Routes, Access & Seasons" description="Plan a Banff trail day with room to pause. Compare selected routes by area, season and interest, with actual demands, transport checks and official sources." lastUpdated={trailPlanningReviewedAt}>
  <div class="container"><Breadcrumbs items={[{ label: 'Quiet Trail Planning' }]} /></div>
  <section class="page-hero">
    <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1600&q=80" alt="Mountain landscape" class="page-hero-bg" loading="eager" fetchpriority="high" />
    <div class="page-hero-content"><span class="badge">Plan Your Outing</span><h1>Quiet Trail Planning</h1><p>Give the day room to breathe: choose a route that fits the group, arrange its actual journey and leave space to change plans.</p></div>
  </section>

  <section class="section"><div class="container planning-page">
    <div class="planning-intro"><h2>A quieter pace starts with the whole journey</h2><p>This guide helps reduce rushing between stops. It does not measure visitors, parking occupancy or current trail access, and does not rank routes by how empty they are. A more remote or demanding trail can add transport and preparation rather than solve those problems.</p>
    <ol class="planning-steps"><li><strong>Pick one main outing.</strong> Match the full return distance, surface and activity to the least experienced person. Count the approach from your hotel or bus stop.</li><li><strong>Resolve arrival and return together.</strong> Confirm the actual stop, operating season, reservations and equipment arrangements. Keep a practical alternative near your base.</li><li><strong>Set a route-specific turnaround.</strong> Use the weather, usable daylight, group pace and confirmed transport. A universal early or late start does not establish access, quiet conditions or suitability.</li></ol>
    <p>For overnight logistics use <a href="/towns">the town comparison</a> and <a href="/car-free-banff">car-free planning</a>. For different route demands, open the <a href="/alternatives">route comparison guide</a>.</p></div>

    <h2 id="route-plans">Choose a route description to investigate</h2>
    <p id="filter-explanation">These {trailPlanningRoutes.length} selected examples are in planning order. Season filters describe the source material, not today's suitability or opening. Interest labels describe the outing; they are not difficulty grades. The <a href="/trail-map">full trail directory</a> has more listings.</p>
    <form id="planning-filters" class="planning-filters" aria-label="Filter route plans" aria-describedby="filter-explanation" hidden>
      <div><label for="q-season">Description season</label><select id="q-season" name="season" aria-controls="route-results"><option value="all">All descriptions</option><option value="summer">Summer route description</option><option value="winter">Winter activity description</option></select></div>
      <div><label for="q-area">Area</label><select id="q-area" name="area" aria-controls="route-results"><option value="all">All areas</option>{areas.map(area => <option value={area}>{area}</option>)}</select></div>
      <div><label for="q-interest">Interest or activity</label><select id="q-interest" name="interest" aria-controls="route-results"><option value="all">All interests</option>{Object.entries(trailInterests).map(([value,label]) => <option value={value}>{label}</option>)}</select></div>
      <button type="button" class="btn btn-outline" data-reset>Reset filters</button>
    </form>
    <noscript><p>All route plans are available below without JavaScript. Browser filtering is optional.</p></noscript>
    <p id="route-count" class="result-count" role="status" aria-live="polite" aria-atomic="true">{trailPlanningRoutes.length} route plans</p>
    <div id="route-empty" class="empty-state" hidden><h3>No selected route matches those filters</h3><p>Change the description season, area or interest. A match would still need its own access and conditions check.</p><button type="button" class="btn btn-outline" data-reset>Show all route plans</button></div>
    <div id="route-results" class="planning-results">
      {trailPlanningRoutes.map(route => <article class="planning-card" data-plan data-seasons={route.seasons.join(' ')} data-area={route.area} data-interests={route.interests.join(' ')}>
        <div class="card-heading"><div><p class="eyebrow">{route.area} · {route.seasons.includes('winter') ? 'Winter activity description' : 'Summer route description'}</p><h3><a href={`/trails/${route.slug}`}>{route.trail.name}</a></h3><p class="park-label">{trailPark(route.trail)}</p></div></div>
        <dl class="guide-figures"><div><dt>Stated distance</dt><dd>{route.trail.distance}</dd></div><div><dt>Stated ascent</dt><dd>{route.trail.elevationGain}</dd></div></dl>
        <p><strong>Plan the journey:</strong> {route.access}</p>
        <details><summary>Route demands and seasonal limits</summary><p>{route.demand}</p><p>{route.seasonNote}</p></details>
        {route.trail.currentNotice && <p class="dated-notice"><strong>Access notice checked {route.trail.currentNotice.checkedAt}:</strong> {route.trail.currentNotice.text} <a href={route.trail.currentNotice.url} target="_blank" rel="noopener">Source notice ↗</a></p>}
        <div class="source-links"><a href={route.trail.parksCanadaUrl} target="_blank" rel="noopener">Official route description ↗</a><a href={trailReportUrl(route.trail)} target="_blank" rel="noopener">Current trail report ↗</a>{route.accessSource && <a href={route.accessSource.url} target="_blank" rel="noopener">{route.accessSource.label} ↗</a>}</div>
      </article>)}
    </div>

    <div class="planning-footer"><h2>Check the plan before leaving</h2><p>Read the route's official map, current report and <a href="https://parks.canada.ca/pn-np/ab/banff/bulletins" target="_blank" rel="noopener">Banff bulletins</a> or <a href="https://parks.canada.ca/pn-np/bc/kootenay/bulletins" target="_blank" rel="noopener">Kootenay bulletins</a>. Match clothing and equipment to the outing using the <a href="/packing-list">packing guide</a>. In snow season use <a href="/winter">winter planning</a> and the <a href="/blog/banff-avalanche-safety">avalanche awareness guide</a>; a summer grade is not a winter recommendation.</p><p>Reviewed October 29, 2026. Source figures and planning notes are not live reports. Follow signs, leave space for others to pass, keep to designated routes and give wildlife room. A calm visit can include a shorter outing or a different day; it does not require searching for an empty trail.</p></div>
  </div></section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#planning-filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-plan]'));
  const count = document.querySelector<HTMLElement>('#route-count');
  const empty = document.querySelector<HTMLElement>('#route-empty');
  if (form && count && empty) {
    const fields = ['q-season','q-area','q-interest'].map(id => document.getElementById(id) as HTMLSelectElement);
    const update = () => {
      const [season,area,interest] = fields.map(field => field.value);
      let visible = 0;
      for (const card of cards) {
        const matches = (season === 'all' || card.dataset.seasons?.split(' ').includes(season)) && (area === 'all' || card.dataset.area === area) && (interest === 'all' || card.dataset.interests?.split(' ').includes(interest));
        card.hidden = !matches;
        if (matches) visible++;
      }
      count.textContent = `${visible} route plan${visible === 1 ? '' : 's'}`;
      empty.hidden = visible !== 0;
    };
    form.addEventListener('submit', event => event.preventDefault());
    fields.forEach(field => field.addEventListener('change', update));
    document.querySelectorAll('[data-reset]').forEach(button => button.addEventListener('click', () => { form.reset(); update(); }));
    form.hidden = false;
    update();
  }
</script>

<style>
  [hidden] { display:none !important; }
  .planning-page { max-width:1100px; }
  .planning-intro,.planning-footer { padding:1.5rem; margin-bottom:2rem; background:var(--color-bg-alt); border-radius:var(--radius); }
  .planning-page p,.planning-page li { line-height:1.75; }
  .planning-page p { margin-bottom:.8rem; }
  .planning-steps { padding-left:1.4rem; margin:1rem 0; }
  .planning-steps li { margin-bottom:.8rem; }
  .planning-filters { display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap; padding:1.2rem; background:var(--color-bg-alt); border-radius:var(--radius); margin:1.2rem 0; }
  .planning-filters>div { display:flex; flex:1 1 200px; flex-direction:column; gap:.35rem; }
  label { font-weight:700; font-size:.9rem; }
  select { width:100%; padding:.65rem; font:inherit; color:inherit; background:white; border:1px solid #9ca3af; border-radius:6px; }
  .planning-results { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; margin:1rem 0 2rem; align-items:start; }
  .planning-card { padding:1.4rem; border:1px solid #d1d5db; border-radius:var(--radius); background:var(--color-white); }
  h3 { margin:.2rem 0 .4rem; font-size:1.2rem; }
  .eyebrow,.park-label { color:var(--color-text-light); font-size:.8rem; }
  .eyebrow { margin-bottom:.2rem; }
  .guide-figures { display:grid; grid-template-columns:1fr 1fr; gap:.7rem; margin:1rem 0; padding:.8rem; background:var(--color-bg-alt); border-radius:6px; }
  dt { color:var(--color-text-light); font-size:.75rem; } dd { margin:0; font-size:.9rem; font-weight:600; }
  summary { cursor:pointer; font-weight:700; padding:.6rem 0; } details p { margin:.5rem 0; }
  .source-links { display:flex; flex-direction:column; gap:.45rem; margin-top:1rem; font-size:.87rem; }
  .dated-notice { padding:.9rem; margin-top:1rem; background:#fff3cd; border-radius:6px; font-size:.87rem; }
  .empty-state { padding:1.5rem; border:1px solid #d1d5db; border-radius:var(--radius); }
  .result-count { font-weight:700; }
  a:focus-visible,button:focus-visible,select:focus-visible,summary:focus-visible { outline:3px solid var(--color-primary); outline-offset:3px; }
  @media(max-width:760px) { .planning-results { grid-template-columns:1fr; } .planning-filters { align-items:stretch; } .planning-filters>div { flex-basis:100%; } .guide-figures { grid-template-columns:1fr; } }
</style>
