---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { lakePlans, lakeAreaLabels, lakeInterestLabels, lakeWaterRules, lakeSources, lakePlanningReviewedAt } from '../data/lakePlanning';
import { activitySearchUrl } from '../data/activityPlanning';
const samples = [
  { title:'A lake pause from Banff', text:'Pick one of the Minnewanka-area day-use visits or a Vermilion Lakes viewing stop. Arrange the return to town and leave time for food, photographs and a change of plan.', area:'banff', interest:'view', season:'all' },
  { title:'A summer canoe comparison', text:'Compare Lake Louise, Moraine or Emerald rental arrangements. Choose the actual operator and party requirements before committing to the outward and return journey.', area:'all', interest:'rental', season:'summer' },
  { title:'A winter land-based view', text:'Plan a lake view from a designated land approach, with a warm alternative near your base. The selected lake descriptions do not assess ice or clear the path for today.', area:'all', interest:'view', season:'winter' },
];
---
<BaseLayout title="Lakes in Banff & Nearby Yoho — Choose Your Lake Day" description="Compare 10 Banff-area lakes by place, trip season and outing style. Plan the actual journey, land route, canoe arrangements and current water-use checks." lastUpdated={lakePlanningReviewedAt}>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'ItemList', name:'Banff and nearby Yoho lake planning', url:'https://banffbound.com/lakes/', numberOfItems:lakePlans.length, itemListElement:lakePlans.map((lake,i) => ({ '@type':'ListItem', position:i+1, name:lake.name, description:lake.description, url:'https://banffbound.com/lakes/#lake-'+lake.id })) })} />
  <div class="container"><Breadcrumbs items={[{label:'Lakes'}]} /></div>
  <section class="page-hero"><img src="https://banfflakelouise.bynder.com/m/1e85056f0193bfe9/1500x915_jpg-2022_LakeLouise_Friends_ROAMCreative.jpg" alt="A canoe outing at Lake Louise" class="page-hero-bg" loading="eager" fetchpriority="high" /><div class="page-hero-content"><span class="badge">Choose Your Lake Day</span><h1>Lakes in Banff &amp; Nearby Yoho</h1><p>One lake, the right journey and room to enjoy it. Compare Banff, Lake Louise, the Parkway and nearby Yoho.</p></div></section>
  <section class="section"><div class="container lake-page">
    <div class="intro"><h2>Start with the experience</h2><p>A viewpoint, a shoreline route and a canoe rental are different days. Choose the main objective before adding more stops. A closer lake with time to pause can work better for your group than a long circuit built around a photograph.</p><p>These are selected planning descriptions, not live access, water-temperature, ice or parking reports. Use the direct sources for your date. For colour, swimming and ice questions, open the <a href="/lake-faq">lake FAQ and science guide</a>.</p></div>
    <div class="sample-grid">{samples.map(sample => <article class="sample-card"><h3>{sample.title}</h3><p>{sample.text}</p><button type="button" class="text-button" aria-label={"Explore "+sample.title} data-preset data-area={sample.area} data-interest={sample.interest} data-season={sample.season} hidden>Explore this starting idea ↓</button></article>)}</div>
    <h2 id="lake-plans">Compare the lake plans</h2><p id="lake-filter-note">Season filters select descriptions, not today's operating status or a safety assessment. The winter shoreline selection covers the designated Lake Louise route reviewed here; it is not an inventory of every possible winter trail. Rental comparisons use a summer planning context and still need the operator's actual season.</p>
    <form id="lake-filters" class="lake-filters" aria-label="Filter lake plans" aria-describedby="lake-filter-note" hidden><div><label for="lake-area">Area</label><select id="lake-area"><option value="all">All areas</option>{Object.entries(lakeAreaLabels).map(([value,label]) => <option value={value}>{label}</option>)}</select></div><div><label for="lake-interest">Main outing</label><select id="lake-interest"><option value="all">All selected descriptions</option>{Object.entries(lakeInterestLabels).map(([value,label]) => <option value={value}>{label}</option>)}</select></div><div><label for="lake-season">Trip season</label><select id="lake-season"><option value="all">Compare both contexts</option><option value="summer">Summer planning</option><option value="winter">Winter planning</option></select></div><button type="button" class="btn btn-outline" data-lake-reset>Reset filters</button></form>
    <noscript><p>All 10 lake descriptions and the three starting ideas are available below without JavaScript.</p></noscript>
    <p id="lake-count" role="status" aria-live="polite" aria-atomic="true">{lakePlans.length} selected lake plans</p>
    <div id="lake-empty" class="notice" hidden><h3>No selected plan matches those choices</h3><p>Broaden the area, outing or season. A summer rental description does not become a winter operation. Use the <a href="/winter">winter guide</a> for more kinds of outing.</p><button type="button" class="btn btn-outline" data-lake-reset>Show all lake plans</button></div>
    <div class="lake-grid">{lakePlans.map(lake => <article class="lake-card" id={'lake-'+lake.id} data-lake={lake.id}><p class="eyebrow">{lakeAreaLabels[lake.area]} · {lake.park}</p><h3>{lake.name}</h3><p class="lake-intro">{lake.description}</p><dl><div><dt>Choose the land outing</dt><dd>{lake.land}</dd></div><div><dt>Resolve the journey</dt><dd>{lake.journey}</dd></div></dl><details><summary>Winter planning distinction</summary><p>{lake.winter}</p></details><p class="water-label"><a href={'#water-'+lake.rule}>{lakeWaterRules[lake.rule].label} ↓</a></p><div class="source-links"><a href={lake.guide.href}>{lake.guide.label} →</a><a href={lake.source} target="_blank" rel="noopener">Direct planning source ↗</a></div></article>)}</div>
    <h2 id="water-rules">Read the rule for that waterbody</h2><p>A shoreline visit does not need to become a water activity. If you bring permitted craft or gear, read the applicable permit before leaving home and before changing waters. Banff's current drying requirements distinguish regional use from use elsewhere; the <a href="/paddling">paddling guide</a> explains the current checks and directs you to the permit.</p><div class="rule-grid">{Object.entries(lakeWaterRules).map(([key,rule]) => <article id={'water-'+key} class="rule-card"><h3>{rule.label}</h3><p>{rule.text}</p><a href={rule.url} target="_blank" rel="noopener">Official rule and conditions ↗</a></article>)}</div>
    <div class="intro"><h2>Make the outward trip and return work together</h2><ol><li><strong>Fix the main objective.</strong> Save the actual route, visitor area or operator. Include the approach from the stop or parking area.</li><li><strong>Check the whole chain.</strong> Confirm each vehicle, ticket, stop, equipment rule and final return. The village, lakeshore and ski-resort Park and Ride are different places.</li><li><strong>Keep the day flexible.</strong> Pack for waiting as well as moving. Know the nearest practical alternative and do not depend on an unplanned late connection.</li></ol><p><a href="/parking">Parking and arrival planning</a> · <a href="/shuttle-reservations">Reserved lake journeys</a> · <a href="/accessible-trails">Visitor access features</a> · <a href="/packing-list">Packing checklist</a></p><p>Roam Route 6 is a seasonal service; at review its notice says the 2026 season ended October 4. Route 8X is a different, year-round Banff–Lake Louise service. Use the actual current schedule and booking product. Neither an old timetable nor this editorial review establishes a bus running today.</p><p><a href={lakeSources.route6} target="_blank" rel="noopener">Route 6 notice ↗</a> · <a href={lakeSources.route8} target="_blank" rel="noopener">Route 8X information ↗</a> · <a href={lakeSources.roads} target="_blank" rel="noopener">Seasonal road restrictions ↗</a></p></div>
    <h2>Choose a base after the journey</h2><p>Compare the lake day with the rest of your stay. Banff town, Lake Louise village and Field/Yoho have different onward connections. A hotel named for a lake does not include every shuttle, rental or restaurant booking.</p><p><a href="/towns">Compare town bases</a> · <a href="/hotel-directory">Browse hotel profiles</a> · <a href="/vacation-rentals">Compare suite and condo layouts</a></p><div class="booking-links"><a href={activitySearchUrl('Banff Lake Louise Yoho sightseeing')} class="btn btn-primary" target="_blank" rel="noopener sponsored">Search lake-area tours on GetYourGuide ↗</a><a href="https://www.expedia.ca/Hotel-Search?destination=Banff%2C+Alberta&amp;camref=1101l3MtWX" target="_blank" rel="noopener sponsored">Search Banff stays on Expedia ↗</a></div><p class="small">Affiliate searches: BanffBound may earn a commission from qualifying bookings. Check the actual destination, stops, dates, inclusions and cancellation terms. A general search does not reserve a particular experience.</p>
    <p class="small">Source review: October 29, 2026. Official source links describe routes, rules and services; the guide does not supply current occupancy, water temperature or ice measurements.</p>
  </div></section>
</BaseLayout>
<script>
  import { filterLakePlans, normalizeLakeFilters } from '../data/lakePlanning';
  const form=document.querySelector<HTMLFormElement>('#lake-filters');
  const fields=['lake-area','lake-interest','lake-season'].map(id=>document.getElementById(id) as HTMLSelectElement);
  const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-lake]'));
  const count=document.querySelector<HTMLElement>('#lake-count');
  const empty=document.querySelector<HTMLElement>('#lake-empty');
  if(form&&fields.every(Boolean)&&count&&empty) {
    const update=()=>{
      const ids=new Set(filterLakePlans({area:fields[0].value,interest:fields[1].value,season:fields[2].value}).map(lake=>lake.id));
      cards.forEach(card=>{card.hidden=!ids.has(card.dataset.lake||'');});
      count.textContent=ids.size+' of '+cards.length+' selected lake plans';
      empty.hidden=ids.size!==0;
    };
    const search=new URLSearchParams(location.search);
    const initial=normalizeLakeFilters({area:search.get('area')||'',interest:search.get('interest')||'',season:search.get('season')||''});
    fields[0].value=initial.area;fields[1].value=initial.interest;fields[2].value=initial.season;
    fields.forEach(field=>field.addEventListener('change',update));
    form.addEventListener('submit',event=>event.preventDefault());
    document.querySelectorAll('[data-lake-reset]').forEach(button=>button.addEventListener('click',()=>{form.reset();update();}));
    document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(button=>{
      button.addEventListener('click',()=>{fields[0].value=button.dataset.area||'all';fields[1].value=button.dataset.interest||'all';fields[2].value=button.dataset.season||'all';update();document.querySelector('#lake-plans')?.scrollIntoView({behavior:'smooth'});});
      button.hidden=false;
    });
    form.hidden=false;update();
  }
</script>
<style>
  [hidden]{display:none!important}.lake-page{max-width:1120px}.lake-page p,.lake-page li{line-height:1.75}.lake-page p{margin:.7rem 0 1rem}.lake-page h2{margin:2.5rem 0 1rem;scroll-margin-top:6rem}.lake-page h3{font-size:1.25rem;margin:.15rem 0 .7rem}.intro,.notice{padding:1.5rem;background:var(--color-bg-alt);border-radius:var(--radius);margin:1.5rem 0}.intro h2{margin-top:0}.sample-grid,.lake-grid,.rule-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;margin:1.5rem 0}.sample-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.sample-card{padding:1.25rem;border-top:4px solid var(--color-accent);background:var(--color-bg-alt);border-radius:8px}.lake-card,.rule-card{border:1px solid #cbd5e1;border-radius:var(--radius);padding:1.4rem;scroll-margin-top:6rem}.lake-card h3{font-size:1.65rem}.eyebrow,.small{font-size:.83rem;color:var(--color-text-light)}.lake-intro{font-size:1.04rem}.lake-card dt{font-weight:700;font-size:.9rem}.lake-card dd{margin:.3rem 0 1rem;line-height:1.7}.source-links{display:flex;flex-direction:column;gap:.5rem;margin-top:1rem;font-size:.87rem}.water-label{padding:.6rem .8rem;background:var(--color-bg-alt);border-radius:6px;font-size:.85rem}.lake-filters{display:flex;flex-wrap:wrap;align-items:end;gap:1rem;padding:1.25rem;background:var(--color-bg-alt);border-radius:8px}.lake-filters>div{display:flex;flex:1 1 220px;flex-direction:column;gap:.4rem}label{font-weight:700;font-size:.9rem}select{width:100%;padding:.7rem;font:inherit;color:inherit;background:white;border:1px solid #94a3b8;border-radius:6px}summary{cursor:pointer;font-weight:700;padding:.6rem 0}.text-button{background:none;border:0;color:var(--color-primary);padding:.4rem 0;font:inherit;font-weight:700;text-align:left;cursor:pointer}.booking-links{display:flex;flex-wrap:wrap;gap:1rem}.intro ol{padding-left:1.3rem}.intro li{margin:.7rem 0}a:focus-visible,button:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--color-primary);outline-offset:3px}@media(max-width:760px){.sample-grid,.lake-grid,.rule-grid{grid-template-columns:1fr}.lake-filters>div{flex-basis:100%}.intro,.lake-card,.rule-card{padding:1.1rem}.booking-links .btn{white-space:normal;width:100%}}
</style>
