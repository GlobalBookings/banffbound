---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const resorts = [{ id: 'sunshine', name: 'Sunshine Village' }, { id: 'louise', name: 'Lake Louise' }, { id: 'norquay', name: 'Mt. Norquay' }];
const faqs = [
  { question: 'Does an Ikon Pass give unlimited skiing at SkiBig3?', answer: 'No. For 2026/27, SkiBig3 lists up to 7 combined days with the full Ikon Pass, up to 5 combined days with Ikon Base, and 2, 3 or 4 total days with Ikon Session. These are shared allowances, not a separate allowance at each resort. Check your exact product, remaining days and blackout dates.' },
  { question: 'Why are there no default ticket prices?', answer: 'Quotes vary by date, age, product, purchase time and conditions. Enter current totals for the same adult and dates, in Canadian dollars with taxes and required fees included. This calculator compares your complete eligible quotes, not every offer on the market.' },
  { question: 'Can a multi-day ticket be used any time in the season?', answer: 'Do not assume that. Check the selected ticket’s validity window, grace days, eligible resorts and any blackout restrictions before confirming it covers your plan.' },
  { question: 'What is excluded from the calculation?', answer: 'Accommodation, lessons, equipment, transport, park admission and the original purchase cost of a pass you already own are excluded. The result compares additional lift-access spending for one adult.' },
];
---
<BaseLayout title="Banff Ski Pass Calculator — Compare Your Current Ticket Quotes" description="Compare current adult lift-ticket quotes for Sunshine, Lake Louise and Norquay. Check multi-day coverage and your owned pass's shared days before comparing costs." lastUpdated="2026-10-28">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) })} />
  <div class="container"><Breadcrumbs items={[{ label: 'Skiing', href: '/skiing' }, { label: 'Ski Pass Calculator' }]} /></div>
  <section class="page-hero">
    <img src="https://images.unsplash.com/photo-1551524559-8af4e6624178?w=1600&q=80" alt="Snow-covered ski slopes" class="page-hero-bg" loading="eager" fetchpriority="high" />
    <div class="page-hero-content"><span class="badge">Your quotes. Your ski days.</span><h1>Banff Ski Pass Calculator</h1><p>Compare the lift access you can actually use, using current quotes for your dates.</p></div>
  </section>
  <section class="section"><div class="container calculator">
    <div class="intro"><h2>What will your ski days cost?</h2><p>Plan one resort per ski day. Enter <strong>totals for one adult, in CAD including taxes and required fees</strong>. Blank prices stay unknown. Repeat separately for people with different ages, dates or pass access.</p></div>
    <div class="calc-layout">
      <form id="ski-quote-form" novalidate hidden>
        <fieldset><legend>1. Your days and resort ticket quotes</legend><p class="help">For each resort, enter its total quote covering all the days you plan there. If daily prices differ, add the quoted days first.</p>
          {resorts.map(resort => <div class="resort-inputs"><h3>{resort.name}</h3><div class="input-grid"><label for={`${resort.id}-days`}>Ski days<input id={`${resort.id}-days`} name={`${resort.id}-days`} type="number" min="0" max="60" step="1" value="0" inputmode="numeric" /></label><label for={`${resort.id}-quote`}>Total ticket quote / adult (CAD)<input id={`${resort.id}-quote`} name={`${resort.id}-quote`} type="number" min="0" max="100000" step="0.01" inputmode="decimal" placeholder="Enter current total" /></label></div></div>)}
        </fieldset>
        <fieldset><legend>2. Compare a multi-day ticket (optional)</legend><div class="input-grid"><label for="multi-quote">Total multi-day quote / adult (CAD)<input id="multi-quote" type="number" min="0" max="100000" step="0.01" inputmode="decimal" placeholder="Enter current total" /></label><label for="multi-days">Number of ski days it covers<input id="multi-days" type="number" min="1" max="60" step="1" inputmode="numeric" placeholder="Days in the product" /></label></div><label class="check"><input id="multi-confirm" type="checkbox" /> I checked that this ticket covers every resort and date in my plan, within its validity window.</label><p class="help">A ticket with too few covered days is excluded. This tool does not invent a price for extra days.</p></fieldset>
        <fieldset><legend>3. Compare a pass you already own (optional)</legend><label class="check"><input id="owned-enabled" type="checkbox" /> Include my existing pass at zero additional lift-ticket cost.</label><label for="owned-days">Combined eligible days remaining for this trip<input id="owned-days" type="number" min="0" max="60" step="1" inputmode="numeric" placeholder="Check your pass account" /></label><label class="check"><input id="owned-confirm" type="checkbox" /> I checked my pass product, all planned resorts, dates, blackout restrictions and any required reservations.</label><p class="help">For SkiBig3, Ikon days are shared across Sunshine, Lake Louise and Norquay. This option is excluded if remaining days do not cover the whole plan. The original pass purchase is a sunk cost, excluded here.</p></fieldset>
        <label class="check quote-confirm"><input id="quotes-confirm" type="checkbox" /> My entered quotes cover the same adult and dates in CAD, including taxes and required fees.</label>
        <button class="btn" type="submit">Compare my options</button><button class="btn btn-outline" type="reset">Clear</button>
        <div id="quote-errors" class="errors" role="alert" tabindex="-1" hidden></div>
      </form>
      <aside class="calc-result" aria-labelledby="result-heading"><span class="badge">Your comparison</span><h2 id="result-heading">Start with your ski days</h2><p id="result-summary" aria-live="polite">Add your plan and current quotes, then compare. Nothing is priced until you enter it.</p><ol id="quote-results"></ol><ul id="quote-notes" class="notes"></ul><p class="help">A lower price only helps when the ticket covers the full plan. Confirm the provider's final terms before buying.</p></aside>
    </div>
    <noscript><div class="manual"><h2>Compare without JavaScript</h2><p>Add the resort ticket totals for all planned days. Compare that total with a multi-day quote only if its number of covered days, resorts and validity window cover the entire plan. A pass you already own adds no lift-ticket cost only when you have enough eligible shared days remaining and all trip dates are valid. JavaScript enables the calculation above; the advice and official links remain available without it.</p></div></noscript>
    <section class="pass-notes"><h2>Pass rules to check before buying</h2><p><strong>Ikon is limited at SkiBig3.</strong> For 2026/27, the full pass has up to 7 combined days, Base up to 5, and Session 2, 3 or 4 total days. These are not separate allowances at each resort. Check the <a href="https://www.skibig3.com/season-passes/ikon-pass/" target="_blank" rel="noopener">official SkiBig3 Ikon information</a> for your pass's blackout dates and terms.</p><p><strong>Multi-day tickets have conditions.</strong> Check the <a href="https://www.skibig3.com/ski/lift-tickets/" target="_blank" rel="noopener">SkiBig3 ticket calendar and grace-day rules</a>, and compare exact resort quotes at <a href="https://www.skibanff.com/" target="_blank" rel="noopener">Sunshine</a>, <a href="https://www.skilouise.com/" target="_blank" rel="noopener">Lake Louise</a> and <a href="https://banffnorquay.com/" target="_blank" rel="noopener">Norquay</a>. Park admission is a separate requirement; check our <a href="/park-pass">park pass guide</a>.</p><p class="help">Rules reviewed 28 October 2026. The calculator contains no live ticket-price feed and does not check pass accounts or booking availability.</p></section>
    <section class="faq-list"><h2>Ski pass questions</h2>{faqs.map(f => <details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</section>
    <nav class="next-links" aria-label="Plan your ski trip"><a href="/ski-day-planner">Plan a ski day →</a><a href="/learn-to-ski">First ski lessons →</a><a href="/winter-stays">Find a winter base →</a><a href="/winter">All winter guides →</a></nav>
  </div></section>
</BaseLayout>
<script>
  const form = document.getElementById('ski-quote-form') as HTMLFormElement;
  const input = (id: string) => document.getElementById(id) as HTMLInputElement;
  const summary = document.getElementById('result-summary')!;
  const heading = document.getElementById('result-heading')!;
  const resultList = document.getElementById('quote-results')!;
  const notes = document.getElementById('quote-notes')!;
  const errors = document.getElementById('quote-errors')!;
  const resortNames = [['sunshine', 'Sunshine Village'], ['louise', 'Lake Louise'], ['norquay', 'Mt. Norquay']];
  const money = (amount: number) => new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' }).format(amount);
  const addText = (parent: HTMLElement, tag: string, value: string) => { const node = document.createElement(tag); node.textContent = value; parent.append(node); return node; };
  const read = (id: string) => input(id).value.trim() === '' ? null : input(id).valueAsNumber;
  function clearResults() { resultList.replaceChildren(); notes.replaceChildren(); errors.replaceChildren(); errors.hidden = true; }
  form?.addEventListener('submit', event => {
    event.preventDefault(); clearResults();
    const days = resortNames.map(([id]) => read(`${id}-days`) ?? 0);
    // Inactive optional fields cannot block an otherwise complete comparison.
    const relevantFields = resortNames.flatMap(([id], i) => [input(`${id}-days`), ...(days[i] > 0 ? [input(`${id}-quote`)] : [])]);
    if (input('multi-quote').value || input('multi-days').value || input('multi-confirm').checked) relevantFields.push(input('multi-quote'), input('multi-days'));
    if (input('owned-enabled').checked) relevantFields.push(input('owned-days'));
    const invalid = relevantFields.filter(el => !el.validity.valid);
    form.querySelectorAll<HTMLInputElement>('input[type="number"]').forEach(el => el.removeAttribute('aria-invalid'));
    invalid.forEach(el => el.setAttribute('aria-invalid', 'true'));
    const totalDays = days.reduce((a,b) => a+b, 0);
    const problems: string[] = [];
    if (invalid.length) problems.push('Use whole ski days from 0 to 60, and non-negative CAD quotes with no more than two decimal places. Multi-day coverage must be at least 1.');
    if (!Number.isFinite(totalDays) || totalDays < 1 || totalDays > 60) problems.push('Plan between 1 and 60 ski days in total.');
    if (problems.length) { heading.textContent = 'Check your entries'; summary.textContent = 'No comparison has been made.'; problems.forEach(p => addText(errors, 'p', p)); errors.hidden = false; errors.focus(); return; }
    const options: {name: string; total: number; detail: string}[] = [];
    const quoteConfirmed = input('quotes-confirm').checked;
    const selected = resortNames.map(([id,name],i) => ({ name, days: days[i], quote: read(`${id}-quote`) })).filter(r => r.days > 0);
    if (selected.every(r => r.quote !== null) && quoteConfirmed) options.push({name:'Resort tickets for your plan',total:selected.reduce((sum,r) => sum + r.quote!,0),detail: 'All planned resort-day quotes added together.'});
    else addText(notes,'li','Resort tickets excluded: enter a total quote for each resort with planned days and confirm the quote basis.');
    const multiQuote = read('multi-quote'); const multiDays = read('multi-days');
    if (multiQuote !== null && multiDays !== null && multiDays >= totalDays && input('multi-confirm').checked && quoteConfirmed) options.push({name:'Your multi-day ticket',total:multiQuote,detail:`${multiDays} covered ski days; you confirmed all resorts and dates.`});
    else addText(notes,'li','Multi-day ticket excluded: add a quote, enough covered days, and confirm resort/date validity and the quote basis.');
    if (input('owned-enabled').checked) {
      const remaining = read('owned-days');
      if (remaining !== null && remaining >= totalDays && input('owned-confirm').checked) options.push({name:'Your existing pass',total:0,detail:`${remaining} combined eligible days remaining; original purchase cost excluded.`});
      else addText(notes,'li','Existing pass excluded: confirm enough shared days remain and all resorts, dates, blackout restrictions and reservations are valid.');
    }
    options.sort((a,b) => a.total-b.total);
    if (!options.length) { heading.textContent = 'Add a complete option'; summary.textContent = `${totalDays} ski ${totalDays === 1 ? 'day' : 'days'} planned. No complete eligible option is ready to compare.`; return; }
    const lowest = options[0].total; const tied = options.filter(o => o.total === lowest).length;
    heading.textContent = options.length === 1 ? 'One complete option entered' : tied > 1 ? 'Lowest entered options are tied' : 'Lowest entered eligible option';
    summary.textContent = `${money(lowest)} in additional lift-access spending for one adult across ${totalDays} ski ${totalDays === 1 ? 'day' : 'days'}.${options.length === 1 ? ' Add another complete option to compare.' : ' Only your entered eligible options are compared.'}`;
    options.forEach(option => { const li = addText(resultList, 'li', ''); addText(li,'strong',`${option.name}: ${money(option.total)}`); addText(li,'p',option.detail); });
  });
  form?.addEventListener('reset', () => { clearResults(); heading.textContent = 'Start with your ski days'; summary.textContent = 'Add your plan and current quotes, then compare. Nothing is priced until you enter it.'; form.querySelectorAll('[aria-invalid]').forEach(el => el.removeAttribute('aria-invalid')); });
  form?.addEventListener('input', () => { if (resultList.children.length) { resultList.replaceChildren(); notes.replaceChildren(); heading.textContent = 'Plan changed'; summary.textContent = 'Compare again to update the results with your new entries.'; } });
  if (form) form.hidden = false;
</script>
<style>
  .calculator { max-width: 1100px; }
  .intro { max-width: 780px; margin-bottom: 2rem; }.intro h2 { margin-bottom: .75rem; }
  .calc-layout { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: start; }
  fieldset { border: 1px solid #d9ded6; border-radius: var(--radius); padding: 1.4rem; margin-bottom: 1.3rem; background: white; min-width: 0; }legend { font-weight: 700; padding: 0 .4rem; }
  .resort-inputs { margin-top: 1rem; }.resort-inputs h3 { font-family: var(--font-body); font-size: 1rem; margin-bottom: .5rem; }.input-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: .8rem; }
  label { display: block; font-size: .88rem; font-weight: 600; }input[type="number"] { display: block; width: 100%; border: 1px solid #a9b4a8; padding: .7rem; border-radius: 6px; font: inherit; background: #fff; margin: .35rem 0 .7rem; color: var(--color-text); }input[aria-invalid="true"] { border-color: #a32020; }
  .check { display: flex; align-items: flex-start; gap: .7rem; margin-top: .9rem; font-weight: 500; line-height: 1.5; }.check input { margin-top: .25rem; min-width: 18px; width: 18px; height: 18px; accent-color: var(--color-primary); }.quote-confirm { margin-bottom: 1.2rem; }.help { font-size: .83rem; color: var(--color-text-light); line-height: 1.6; }
  .calc-result { padding: 1.7rem; background: var(--color-bg-alt); border-radius: var(--radius); position: sticky; top: 115px; }.calc-result h2 { margin: 1rem 0; font-size: 1.7rem; }.calc-result ol,.notes { padding-left: 1.2rem; margin: 1rem 0; }.calc-result li { margin: .8rem 0; }.calc-result li p { font-size: .85rem; margin-top: .25rem; }.notes { color: var(--color-text-light); font-size: .83rem; }
  .errors { color: #7c1818; background: #fff0ec; padding: 1rem; margin-top: 1rem; border-left: 3px solid #a32020; }.pass-notes,.faq-list,.manual { margin-top: 3rem; }.pass-notes p { margin: 1rem 0; }.pass-notes a,.manual a { text-decoration: underline; color: var(--color-primary); }
  details { margin-top: 1rem; padding: 1rem; border: 1px solid #d9ded6; border-radius: 8px; background: white; }summary { cursor: pointer; font-weight: 600; }details p { margin-top: .7rem; }
  .next-links { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2rem; }.next-links a { padding: .65rem 1rem; border-radius: 6px; background: var(--color-bg-alt); font-weight: 600; font-size: .9rem; }
  @media(max-width: 800px) { .calc-layout { grid-template-columns: 1fr; }.calc-result { position: static; } }.input-grid > * { min-width: 0; }@media(max-width: 450px) { .input-grid { grid-template-columns: 1fr; }fieldset { padding: 1rem; } }
</style>
