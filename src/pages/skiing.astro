---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const resorts = [
  { name: 'Sunshine Village', description: 'A gondola ride from the lower parking area brings you to the upper village, with skiing across Lookout, Standish and Goat’s Eye. Match the open terrain to your level and leave time for the gondola before a lesson.', bestFor: 'An upper-mountain day or a slope-side lodge stay', official: 'https://www.skibanff.com/', guide: '/blog/sunshine-village-guide/', image: '/images/blog/sunshine-village-guide.webp' },
  { name: 'Lake Louise Ski Resort', description: 'A large resort with terrain choices from learning areas to advanced runs. Road access reaches the resort base. The ski area is separate from Lake Louise village and the famous lakeshore, so check the exact destination.', bestFor: 'Exploring a broad terrain network', official: 'https://www.skilouise.com/', guide: '/blog/lake-louise-ski-resort/', image: '/images/blog/lake-louise-ski-resort.webp' },
  { name: 'Mt. Norquay', description: 'A compact ski area above Banff with learning terrain, steep runs and scheduled evening sessions. Check the operating calendar for night skiing and the separate tubing activity before planning an evening visit.', bestFor: 'A compact resort day or scheduled night session', official: 'https://banffnorquay.com/', guide: '/blog/mt-norquay-guide/', image: '/images/blog/mt-norquay-guide.webp' },
];
const nextSteps = [
 {title:'Plan a ski day',href:'/ski-day-planner',text:'Match a resort, travel plan and experience level. Make room for rentals, lessons and breaks.'},
 {title:'Learn to ski or snowboard',href:'/learn-to-ski',text:'Prepare for a first lesson and check the equipment, lift access and meeting point.'},
 {title:'Compare current ticket quotes',href:'/ski-pass-calculator',text:'Compare your adult resort and multi-day quotes, or check coverage from a pass you already own.'},
 {title:'Find a winter base',href:'/winter-stays',text:'Choose Banff, Canmore, Lake Louise or a slope-side stay to fit your trip.'},
];
---
<BaseLayout title="Skiing in Banff — Resorts, Lessons & Ski Day Planning" description="Plan skiing in Banff at Sunshine Village, Lake Louise and Mt. Norquay. Compare resorts, first lessons, ticket quotes, winter hotels, Nordic skiing and heli-ski trips." lastUpdated="2026-10-28">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'ItemList', name:'Banff downhill ski resorts', numberOfItems:resorts.length, itemListElement:resorts.map((resort,i) => ({ '@type':'ListItem', position:i+1, item:{ '@type':'SkiResort', name:resort.name, url:resort.official, description:resort.description } })) })} />
  <div class="container"><Breadcrumbs items={[{ label:'Winter',href:'/winter' },{ label:'Skiing' }]} /></div>
  <section class="page-hero"><img src="https://images.unsplash.com/photo-1551524559-8af4e6624178?w=1600&q=80" alt="Snowy ski slopes and mountain peaks" class="page-hero-bg" loading="eager" fetchpriority="high" /><div class="page-hero-content"><span class="badge">Find your next ski day</span><h1>Skiing in Banff</h1><p>Three downhill resorts, first lessons, Nordic trails and a winter base that fits the way you travel.</p></div></section>
  <section class="section"><div class="container"><div class="section-header"><h2>Start with your ski day</h2><p>Choose the lesson or terrain you need, then work back through tickets, transport and where to stay.</p></div><div class="grid grid-2">{nextSteps.map(step => <a class="card planning-card" href={step.href}><div class="card-body"><h3>{step.title} →</h3><p>{step.text}</p></div></a>)}</div></div></section>
  <section class="section" style="background:var(--color-bg-alt)"><div class="container"><div class="section-header"><span class="badge">The Big 3</span><h2>Choose a Banff ski resort</h2><p>All three offer lessons and terrain choices. The right resort depends on your plans and the conditions that day.</p></div><div class="grid grid-3">{resorts.map(resort => <article class="card"><img class="card-image" src={resort.image} alt={`${resort.name} winter guide`} loading="lazy" /><div class="card-body"><h3>{resort.name}</h3><p>{resort.description}</p><p class="fit"><strong>Consider for:</strong> {resort.bestFor}</p><a class="text-link" href={resort.guide}>Read the resort guide →</a><a class="text-link" href={resort.official} target="_blank" rel="noopener">Official conditions and tickets ↗</a></div></article>)}</div><p class="center-link"><a href="/sunshine-vs-lake-louise-vs-norquay">Compare Sunshine, Lake Louise and Norquay side by side →</a></p></div></section>
  <section class="section"><div class="container"><div class="section-header"><h2>Tickets, passes and getting to the hill</h2></div><div class="grid grid-3"><article class="card"><div class="card-body"><h3>Lift tickets and park admission</h3><p>A SkiBig3 lift ticket and a Parks Canada admission pass serve different purposes. Check both requirements for your dates. Compare a direct resort quote with a SkiBig3 product only when its covered days and validity fit your whole plan.</p><a class="text-link" href="https://www.skibig3.com/ski/lift-tickets/" target="_blank" rel="noopener">SkiBig3 ticket terms ↗</a><a class="text-link" href="/park-pass">Park admission guide →</a></div></article><article class="card"><div class="card-body"><h3>Already own an Ikon product?</h3><p>Check the remaining <strong>combined</strong> SkiBig3 allowance, your pass variant and blackout dates. It is not an unlimited allowance at each of the three resorts. Use your actual available days when comparing extra spending.</p><a class="text-link" href="https://www.skibig3.com/season-passes/ikon-pass/" target="_blank" rel="noopener">Official Ikon access details ↗</a><a class="text-link" href="/ski-pass-calculator">Compare your quotes →</a></div></article><article class="card"><div class="card-body"><h3>Resort shuttle or winter drive?</h3><p>Check the resort shuttle's exact stop, schedule, ticket requirements and final return. Local Roam services and ski shuttles are different services. If driving, check the road report and your vehicle's winter equipment.</p><a class="text-link" href="/car-free-banff">Car-free trip planning →</a><a class="text-link" href="/blog/banff-winter-driving/">Winter driving guide →</a></div></article></div></div></section>
  <section class="section" style="background:var(--color-bg-alt)"><div class="container"><div class="section-header"><h2>More ways to ski in the Rockies</h2><p>Keep Nordic skiing, guided backcountry trips and a first downhill lesson as separate choices with different equipment and skills.</p></div><div class="grid grid-2"><article class="card"><div class="card-body"><h3>Cross-country skiing</h3><p>Choose a first lesson at Canmore Nordic Centre or a designated winter route suited to your skills. Check grooming, closures and route hazards before leaving. A summer trail map does not establish winter access.</p><a class="text-link" href="/blog/banff-cross-country-skiing/">Nordic skiing in Banff, Lake Louise and Canmore →</a></div></article><article class="card"><div class="card-body"><h3>Heli-skiing near Banff</h3><p>Day heli programs operate from British Columbia bases such as Golden and Panorama. Ask the operator to approve your ability, then plan travel, accommodation and weather flexibility. This is not a first ski lesson.</p><a class="text-link" href="/blog/banff-heli-skiing/">Plan a heli-ski trip →</a></div></article></div></div></section>
  <section class="section"><div class="container essentials"><h2>Before you head out</h2><ul><li>Read the resort's current lift, terrain and weather reports. Tentative season dates do not guarantee open terrain.</li><li>Confirm lesson and rental reservations, ticket collection and the exact meeting point.</li><li>Bring suitable layers, gloves, goggles and a properly fitted helmet. Plan breaks before you are exhausted or cold.</li><li>Stay within open terrain appropriate to your ability, obey signs and ask resort staff if a route is unclear.</li><li>Leave enough time to meet your return shuttle or complete a winter drive without rushing.</li></ul><p>For non-ski days and a mixed group, explore the <a href="/winter">winter activity guide</a>, <a href="/towns">nearby towns</a> and <a href="/winter-stays">winter stays</a>.</p><p class="review">Reviewed 28 October 2026 using the official resort and SkiBig3 sources linked above. Conditions, operating dates and booking terms can change.</p></div></section>
</BaseLayout>
<style>
 .planning-card { border-top: 3px solid var(--color-accent); }.planning-card:hover { transform: translateY(-3px); }.card-body p { margin: .8rem 0; }.fit { font-size: .85rem; }.text-link { display: block; margin-top: .8rem; font-size: .88rem; font-weight: 600; color: var(--color-primary); text-decoration: underline; }.center-link { text-align: center; margin-top: 2rem; font-weight: 600; text-decoration: underline; }.essentials { max-width: 900px; }.essentials ul { margin: 1.5rem 0; padding-left: 1.3rem; }.essentials li { margin: .65rem 0; }.essentials a { text-decoration: underline; color: var(--color-primary); }.review { font-size: .82rem; color: var(--color-text-light); margin-top: 1.5rem; }
</style>
