---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WinterStatusNotice from '../components/WinterStatusNotice.astro';
import WeatherSnapshot from '../components/WeatherSnapshot.astro';
import { dayIdeas, dayIdeaLink, dayDefaults } from '../data/dayIdeas';
import '../styles/weatherPlanning.css';
const areas={banff:'Banff area',canmore:'Canmore area',louise:'Lake Louise area',regional:'Regional outing · confirm the location'};
const faqs=[
 {q:'Are these activities confirmed open today?',a:'No. These are planning ideas filtered by the season and choices you enter. Confirm the actual operator or route, weather, equipment, age or ability requirements and the return journey. The linked sources and planning guides help with those checks.'},
 {q:'Do the time filters include travel?',a:'No. They compare editorial allowances for the outing itself. Travel, queues, rental fitting, check-in and warm breaks may add time. An idea fitting the filter is not a promised schedule or a confirmed connection.'},
 {q:'Does a weather forecast choose a safe activity for me?',a:'No. A town forecast cannot establish route access, suitable natural ice, open ski terrain or a suitable outing for your group. Check the current official reports and the specific activity; change the plan if it no longer suits the conditions or your group.'},
 {q:'Can I turn an idea into an itinerary?',a:'Yes. Each card can open a one-day starting plan in the trip builder using your season and overnight base. The initial plan uses car-free or arranged transport; change that setting if you will drive. Check the suggested connections before booking anything.'},
];
---
<BaseLayout title="Things to Do in Banff Today: Find an Outing That Fits" description="Choose a Banff outing by season, overnight base, time at the activity and interests. Check official conditions, keep a warm alternative and turn an idea into a day plan." lastUpdated="2026-10-28">
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))})} />
 <div class="container"><Breadcrumbs items={[{label:'Planning Tools',href:'/tools'},{label:'Choose an Outing'}]} /></div>
 <section class="weather-hero"><div class="container"><span class="weather-eyebrow">A good day can be a simple one</span><h1>What feels right<br />for your day?</h1><p>A short town outing, a lake view or a full snow day. Start with your time and interests, check the actual conditions and access, then keep some room to change your mind.</p><nav class="weather-nav" aria-label="Choose a day"><a href="#day-ideas">Find an idea ↓</a><a href="/trip-builder">Build a longer trip →</a><a href="/winter">Explore winter guides →</a></nav></div></section>
 <section class="section"><div class="container"><WinterStatusNotice /><WeatherSnapshot /></div></section>
 <section class="section weather-soft" id="day-ideas"><div class="container"><div class="weather-intro"><span class="weather-eyebrow">What belongs in today?</span><h2>Find an outing that fits</h2><p>Activity allowances below are planning estimates, excluding travel. A season or a filter match does not confirm operations, access or suitability. Follow each card to the guide and official source before committing.</p></div>
 <form id="day-filters" class="day-filters" hidden>
 <label>Season<select name="season"><option value="winter">Winter / snow season</option><option value="summer">Summer / hiking season</option></select></label>
 <label>Overnight base<select name="base"><option value="banff">Banff</option><option value="canmore">Canmore</option><option value="louise">Lake Louise</option></select></label>
 <label>Time at the activity<select name="time"><option value="any">Any allowance</option><option value="short">About 2 hours or less</option><option value="half">About 4 hours or less</option></select></label>
 <label>What sounds good?<select name="mood"><option value="all">A little of everything</option><option value="town">Town & heritage time</option><option value="snow">A snow outing</option><option value="lakes">A lake outing</option></select></label>
 <label class="nearby-check"><input type="checkbox" name="nearby" />Only my base area</label><button type="button" id="day-reset">Reset choices</button></form>
 <p id="day-count" class="day-count" aria-live="polite">All 23 seasonal ideas are shown below.</p>
 <noscript><p>All seasons are shown without JavaScript. Read the season label and choose a guide before planning the day.</p></noscript>
 <div class="day-grid">{dayIdeas.map(activity=><article class="day-card" data-day-id={activity.id}><span class="day-icon" aria-hidden="true">{activity.icon}</span><span class="weather-eyebrow">{activity.season==='all'?'Year-round idea':activity.season==='winter'?'Winter idea':'Summer-access idea'}</span><h3>{activity.name}</h3><p class="day-location">{areas[activity.area]}</p><p>{activity.description}</p><p class="day-allowance">Allow about {activity.hours}h at the outing · travel extra</p><nav aria-label={activity.name+' planning'}><a href={activity.guide}>Read the planning guide →</a><a href={activity.source} target="_blank" rel="noopener">Official information ↗</a><a class="day-plan-link" href={dayIdeaLink(activity.id,{...dayDefaults,season:activity.season==='summer'?'summer':'winter'})}>Make this my starting plan →</a></nav></article>)}</div>
 <div id="day-empty" class="weather-next" hidden><h3>No matching idea in this selection.</h3><p>Try a longer allowance, another interest or remove “Only my base area”. A nearby option may still need transport; choose the actual route before leaving.</p><button type="button" id="day-empty-reset">Reset choices</button></div>
 <div class="weather-next"><h3>Check the whole day, including the return</h3><p>A town bus and a resort shuttle are different services. A Lake Louise village stay is separate from the lakeshore and ski resort. The starting plan carries your base into the trip builder so you can check those connections.</p><nav aria-label="Complete your day plan"><a href="/car-free-banff">Check car-free connections →</a><a href="/calgary-to-banff">Plan an airport arrival →</a><a href="/packing-list">Packing checklist →</a><a href="/wellness">A warm-up alternative →</a></nav></div></div></section>
 <section class="section"><div class="container"><h2>Questions before you set out</h2><div class="weather-faqs">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div><p class="weather-source-note">Editorial catalogue reviewed 28 October 2026. Each idea links its source and detailed guide. This chooser does not use weather or a calendar month to declare an activity open, safe or suitable.</p></div></section>
</BaseLayout>
<script>
 import { dayIdeas, matchesDayIdea, dayIdeaLink, readDayFilters, dayDefaults, type DayFilters } from '../data/dayIdeas';
 const form=document.querySelector<HTMLFormElement>('#day-filters');
 const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-day-id]'));
 const count=document.querySelector('#day-count');
 const empty=document.querySelector<HTMLElement>('#day-empty');
 function setForm(filters:DayFilters){if(!form)return;for(const key of ['season','base','time','mood'] as const){const input=form.elements.namedItem(key) as HTMLSelectElement;if(input)input.value=filters[key];}const nearby=form.elements.namedItem('nearby') as HTMLInputElement;if(nearby)nearby.checked=filters.nearby;}
 function render(filters:DayFilters){cards.forEach(card=>{const activity=dayIdeas.find(item=>item.id===card.dataset.dayId);card.hidden=!activity||!matchesDayIdea(activity,filters);const link=card.querySelector<HTMLAnchorElement>('.day-plan-link');if(link&&activity)link.href=dayIdeaLink(activity.id,filters);});const visible=cards.filter(card=>!card.hidden).length;if(count)count.textContent=visible+' '+(visible===1?'idea':'ideas')+' to research · check access and the complete journey.';if(empty)empty.hidden=visible>0;}
 function writeUrl(filters:DayFilters){const q=new URLSearchParams();for(const key of ['season','base','time','mood'] as const)if(filters[key]!==dayDefaults[key])q.set(key,filters[key]);if(filters.nearby)q.set('nearby','1');history.replaceState(null,'',location.pathname+(q.size?'?'+q.toString():'')+location.hash);}
 function reset(){setForm(dayDefaults);render(dayDefaults);writeUrl(dayDefaults);}
 if(form){form.hidden=false;const initial=readDayFilters(location.search);setForm(initial);render(initial);form.addEventListener('submit',event=>event.preventDefault());form.addEventListener('change',()=>{const params=new URLSearchParams();new FormData(form).forEach((value,key)=>params.set(key,String(value)));const checkbox=form.elements.namedItem('nearby') as HTMLInputElement;if(checkbox?.checked)params.set('nearby','1');const filters=readDayFilters(params.toString());render(filters);writeUrl(filters);});document.querySelector('#day-reset')?.addEventListener('click',reset);document.querySelector('#day-empty-reset')?.addEventListener('click',reset);}
</script>
<style>
 #day-ideas{scroll-margin-top:7rem}.day-filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;align-items:end;padding:1.5rem;border:1px solid #d8e1d9;border-radius:var(--radius);background:white}.day-filters label{font-weight:600;font-size:.85rem}.day-filters select{display:block;width:100%;min-height:46px;border:1px solid #b1bfae;border-radius:6px;padding:.6rem;margin-top:.5rem;font:inherit;background:white}.day-filters .nearby-check{grid-column:span 2;display:flex;align-items:center;gap:.7rem;min-height:44px}.nearby-check input{width:20px;height:20px}.day-filters button,#day-empty-reset{font:inherit;background:#173d2d;color:white;border:0;border-radius:6px;padding:.8rem 1rem;cursor:pointer}.day-count{font-size:.84rem;color:var(--color-text-light);margin:1.2rem 0}.day-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.3rem}.day-card{background:white;border:1px solid #d8e1d9;border-radius:var(--radius);padding:1.5rem}.day-icon{display:block;font-size:2.1rem;margin-bottom:1.1rem}.day-card h3{font-size:1.35rem;margin-bottom:.7rem}.day-card p{font-size:.92rem;color:var(--color-text-light);margin-bottom:1rem}.day-card .day-location{font-weight:600;color:var(--color-primary);font-size:.78rem}.day-card .day-allowance{font-size:.77rem;padding-top:1rem;border-top:1px solid #d8e1d9}.day-card nav{display:flex;flex-direction:column;gap:.7rem;font-size:.84rem}.day-plan-link{font-weight:700}#day-empty-reset{margin-top:1rem}@media(max-width:1000px){.day-filters{grid-template-columns:repeat(2,minmax(0,1fr))}.day-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.day-filters,.day-grid{grid-template-columns:1fr}.day-filters .nearby-check{grid-column:auto}}
</style>
