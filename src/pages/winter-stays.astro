---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { hotels } from '../data/hotels';

const picks = [
  { slug: 'moose-hotel-suites', base: 'banff', baseLabel: 'Banff town', parties: ['couple', 'family', 'friends'], priorities: ['walkable', 'soak'], label: 'Town evenings + rooftop soaks', why: 'A Banff Avenue base for a mixed ski and non-ski trip, with rooftop hot pools and a choice of rooms and suites.', tradeoff: 'A kitchenette is a small kitchen nook, not a full cooking setup. Check your room category and the current resort bus pickup.', check: 'Confirm the suite layout, pool access and the walk to your ski shuttle stop.', source: 'https://moosehotelandsuites.com/' },
  { slug: 'mount-royal-hotel', base: 'banff', baseLabel: 'Banff town', parties: ['solo', 'couple', 'friends'], priorities: ['walkable'], label: 'A central town address', why: 'A downtown option for travellers who want restaurants and town time close by rather than an isolated resort stay.', tradeoff: 'A central location can be lively. The official hotel page reported both rooftop hot tubs closed for maintenance when checked on 28 October 2026; do not book expecting a soak without reconfirming.', check: 'Ask for the room position you prefer, current facility status and shuttle pickup details.', source: 'https://www.banffjaspercollection.com/hotels/mount-royal-hotel/' },
  { slug: 'tunnel-mountain-resort', base: 'banff', baseLabel: 'Banff · Tunnel Mountain', parties: ['couple', 'family', 'friends'], priorities: ['kitchen', 'quiet'], label: 'Room to spread out and cook', why: 'Condo and cabin layouts make this a useful shortlist for travellers who want separate living space and self-catering options.', tradeoff: 'This is above the town centre. Confirm bus connections and choose a full-kitchen room if cooking is the reason for booking.', check: 'Compare studio, condo and cabin layouts; kitchens and beds vary by category.', source: 'https://tunnelmountain.com/rooms/' },
  { slug: 'blackstone-mountain-lodge', base: 'canmore', baseLabel: 'Canmore', parties: ['couple', 'family', 'friends'], priorities: ['kitchen', 'soak'], label: 'A longer suite stay', why: 'Condo-style suites offer full kitchens and living space, with an outdoor pool and hot tubs for hotel guests.', tradeoff: 'Hotel-style rooms do not have the same kitchen setup as suites. Getting to a Banff ski lesson needs a separate transport plan.', check: 'Verify suite type, occupancy and fees. Outdoor pool availability can change in extreme cold.', source: 'https://www.blackstonelodge.ca/faq' },
  { slug: 'lake-louise-inn', base: 'lake-louise', baseLabel: 'Lake Louise village', parties: ['solo', 'couple', 'family', 'friends'], priorities: ['ski-shuttle', 'soak'], label: 'Focus on Lake Louise ski days', why: 'A village hotel with an indoor pool, equipment storage and a winter ski shuttle connection advertised by the hotel.', tradeoff: 'The village is separate from the lakeshore. Shuttle times and stops must be checked for the coming ski season; some room types have kitchens and others do not.', check: 'Match the bus timetable to your lesson time, and check your exact room facilities.', source: 'https://www.lakelouiseinn.com/at-a-glance/' },
  { slug: 'fairmont-chateau-lake-louise', base: 'lake-louise', baseLabel: 'Lake Louise lakeshore', parties: ['couple', 'family', 'friends'], priorities: ['quiet'], label: 'Make the lake the main event', why: 'A lakeshore setting for a hotel-led winter break, with the hotel’s seasonal rental and activity services close at hand.', tradeoff: 'The Chateau is not at Lake Louise Ski Resort. A room reservation does not confirm skating conditions, include every activity or guarantee a lake-view room.', check: 'Confirm the room view, activity reservations, all fees and transport to the ski resort.', source: 'https://www.fairmont.com/en/hotels/lake-louise/fairmont-chateau-lake-louise/guest-services.html' },
  { slug: 'sunshine-mountain-lodge', base: 'sunshine', baseLabel: 'On mountain · Sunshine Village', parties: ['couple', 'family', 'friends'], priorities: ['ski-in', 'quiet', 'soak'], label: 'Wake up on the mountain', why: 'The ski-in, ski-out choice inside Banff National Park. A strong fit when skiing Sunshine and staying on the mountain are the point of the trip.', tradeoff: 'Arrive via the gondola and check in at the base. Gondola hours constrain town outings and airport transfers; after-hours arrangements may cost extra and need advance confirmation.', check: 'Confirm gondola arrival and departure, luggage handling, tickets and exactly what your package includes.', source: 'https://www.skibanff.com/plan/first-time-visitors/faqs' },
  { slug: 'emerald-lake-lodge', base: 'yoho', baseLabel: 'Emerald Lake · Yoho National Park, BC', parties: ['couple', 'friends'], priorities: ['quiet'], label: 'A quieter lodge escape', why: 'A retreat near Field in Yoho National Park, suited to a stay built around the lodge and carefully selected winter outings.', tradeoff: 'A guest-parking shuttle serves the lodge; it is not transport from Banff. This is a quiet road-access destination with a separate winter driving plan.', check: 'Reserve meals, verify arrival arrangements and check DriveBC and Yoho bulletins before setting out.', source: 'https://crmr.com/resorts/emerald-lake/faq/' },
].map(pick => {
  const hotel = hotels.find(hotel => hotel.slug === pick.slug);
  if (!hotel) throw new Error(`Missing winter stay: ${pick.slug}`);
  return { ...pick, hotel };
});
const faqs = [
  { question: 'Where can I stay ski-in, ski-out in Banff National Park?', answer: 'Sunshine Mountain Lodge is the on-mountain ski-in, ski-out hotel at Sunshine Village. Banff town hotels and Lake Louise village or lakeshore hotels require transport to ski. Confirm gondola access, lift tickets and package inclusions with Sunshine before booking.' },
  { question: 'Should I choose Banff, Canmore or Lake Louise for a winter stay?', answer: 'Choose Banff for a central town stay and ski shuttle access, Canmore for a longer suite-based trip with a separate ski transport plan, and Lake Louise for a trip focused on its ski resort or lakeshore. Compare the exact address and travel connections, not just the destination name.' },
  { question: 'Does a ski hotel booking include lift tickets and lessons?', answer: 'Only if the booked package explicitly includes them. Read the room or package terms and check tickets, equipment, lessons, shuttle access, parking, taxes and cancellation conditions separately.' },
  { question: 'Are the prices and availability on this page live?', answer: 'No. This is a curated planning shortlist, researched on 28 October 2026. Open the booking link for your dates and compare the final rate, room type and cancellation policy. Facilities and transport can change.' },
];
---

<BaseLayout title="Where to Stay in Banff in Winter: Ski Hotels, Suites & Lodges" description="Find a winter stay in Banff, Canmore, Lake Louise or Yoho. Filter a practical hotel shortlist by base, travel party, kitchens, hot pools and ski access." canonicalUrl="https://banffbound.com/winter-stays/" lastUpdated="2026-10-28">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [
    { '@type': 'ItemList', name: 'Banff winter stays planning shortlist', url: 'https://banffbound.com/winter-stays/', numberOfItems: picks.length, itemListElement: picks.map((pick, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Hotel', name: pick.hotel.name, url: `https://banffbound.com/hotel-directory/${pick.slug}/`, description: pick.why } })) },
    { '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ] })} />
  <div class="container"><Breadcrumbs items={[{ label: 'Winter guide', href: '/winter' }, { label: 'Winter stays' }]} /></div>
  <section class="stays-hero"><div class="container"><span class="eyebrow">Your warm base for a cold day</span><h1>Find your<br />Banff winter stay.</h1><p>A walk to dinner. A kitchen for a ski week. A room on the mountain. Find a winter stay with the right tradeoffs before you compare the rate.</p><a href="#stay-finder" class="btn">Find my winter stay &darr;</a><a href="/towns/" class="hero-link">Compare the towns first &rarr;</a></div></section>

  <section class="section"><div class="container">
    <div class="base-strip"><div><strong>Banff town</strong><span>Restaurants + resort shuttles</span></div><div><strong>Canmore</strong><span>Suite stays + your own transport plan</span></div><div><strong>Lake Louise</strong><span>Village, lake and ski resort are separate</span></div><div><strong>Sunshine</strong><span>On mountain + gondola access</span></div></div>
    <div class="finder" id="stay-finder"><div><span class="eyebrow">Narrow your shortlist</span><h2>What makes a good stay for you?</h2><p>These filters describe useful starting points, not guaranteed room features. Check the exact room and transport before booking.</p></div><form id="stay-filter-form" class="filter-grid" hidden>
      <label>My base<select id="stay-base" name="base"><option value="all">Any base</option><option value="banff">Banff town</option><option value="canmore">Canmore</option><option value="lake-louise">Lake Louise</option><option value="sunshine">Sunshine · on mountain</option><option value="yoho">Emerald Lake · Yoho, BC</option></select></label>
      <label>Travelling with<select id="stay-party" name="party"><option value="all">Any travel party</option><option value="solo">Just me</option><option value="couple">My partner</option><option value="family">Family</option><option value="friends">Friends</option></select></label>
      <label>My priority<select id="stay-priority" name="priority"><option value="all">Any priority</option><option value="walkable">Walk to town restaurants</option><option value="kitchen">A full kitchen option</option><option value="soak">Pool or hot pool</option><option value="ski-shuttle">Lake Louise ski shuttle</option><option value="ski-in">Ski-in, ski-out</option><option value="quiet">A quieter setting</option></select></label>
      <button type="reset" class="reset-button">Reset filters</button>
    </form><noscript><p>All eight stays are listed below. Follow each hotel’s links to compare rooms and confirm facilities.</p></noscript></div>
    <div class="results-heading"><p id="stay-count" role="status" aria-live="polite">{picks.length} stays to explore</p><button type="button" id="share-stays" hidden>Copy my shortlist link</button></div><p id="share-status" class="share-status" aria-live="polite"></p>
    <p class="affiliate-note">Booking links are affiliate links. BanffBound may earn a commission if you book. The shortlist reflects location and trip fit; it is not a ranking based on live rates or guest scores.</p>
    <div class="stay-grid">
      {picks.map(pick => <article class="stay-card" data-stay-base={pick.base} data-stay-parties={pick.parties.join(' ')} data-stay-priorities={pick.priorities.join(' ')}>
        <a href={`/hotel-directory/${pick.slug}`}><img src={pick.hotel.image} alt={pick.hotel.name} width="800" height="500" loading="lazy" /></a>
        <div class="stay-body"><span class="eyebrow">{pick.baseLabel}</span><h3><a href={`/hotel-directory/${pick.slug}`}>{pick.hotel.name}</a></h3><p class="stay-label">{pick.label}</p><p>{pick.why}</p><div class="tradeoff"><strong>Plan around this</strong><p>{pick.tradeoff}</p></div><p class="check"><strong>Before booking:</strong> {pick.check}</p><div class="stay-actions"><a href={pick.hotel.expediaUrl} target="_blank" rel="noopener sponsored" class="btn">Check dates on Expedia &nearr;</a><a href={pick.source} target="_blank" rel="noopener" class="official-link">Check with the hotel &nearr;</a></div></div>
      </article>)}
    </div>
    <div id="no-stays" hidden><h3>No exact match in this shortlist.</h3><p>Try a different base or remove one preference. A full kitchen and a ski-in, ski-out address are very different booking choices.</p><a class="text-link" href="/hotel-directory">Browse the wider hotel directory &rarr;</a></div>
  </div></section>

  <section class="section booking-section"><div class="container booking-grid"><div><span class="eyebrow">Before you click reserve</span><h2>The room is only part of the ski trip.</h2><p>Compare the final cost for the same dates and party size. A low nightly rate can change once you add taxes, fees, parking, meals and transport.</p><p>A kitchen, accessible room, adjoining room or pet-friendly room needs confirmation in your actual booking. Filter tags point to options worth investigating; they do not reserve a particular layout.</p><a class="text-link" href="/ski-day-planner">Build the day around your base &rarr;</a></div><ol class="booking-list"><li><strong>Check the address.</strong> Lake Louise village, lakeshore and resort are separate places. Emerald Lake is in Yoho, BC.</li><li><strong>Check the connections.</strong> Ask about winter shuttle stops, first and last rides, luggage and accessibility.</li><li><strong>Check the package.</strong> Lift tickets, rentals and lessons are included only when the terms say so.</li><li><strong>Check the flexibility.</strong> Compare cancellation terms with your flight, road and activity plans.</li></ol></div></section>

  <section class="section"><div class="container narrow"><h2>Banff winter accommodation questions</h2>{faqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}<div class="source-box"><h3>How we built this shortlist</h3><p>Researched 28 October 2026 using the hotels’ official pages linked on each card. We selected contrasting base locations and room styles, explained the travel tradeoffs and used the existing BanffBound affiliate links. No current prices, availability or review scores are claimed.</p><p>For transfers, check <a href="https://www.skilouise.com/getting-here/by-shuttle/" target="_blank" rel="noopener">Lake Louise’s winter shuttle updates</a>, <a href="https://roamtransit.com/" target="_blank" rel="noopener">Roam Transit</a> and <a href="https://www.skibanff.com/plan/first-time-visitors/faqs" target="_blank" rel="noopener">Sunshine’s lodge access FAQ</a>. Confirm property-specific facilities and access needs directly.</p></div><div class="next-links"><a href="/towns/" class="btn">Explore all six bases &rarr;</a><a href="/winter" class="btn btn-outline">Back to winter planning &rarr;</a></div></div></section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#stay-filter-form');
  const base = document.querySelector<HTMLSelectElement>('#stay-base');
  const party = document.querySelector<HTMLSelectElement>('#stay-party');
  const priority = document.querySelector<HTMLSelectElement>('#stay-priority');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-stay-base]'));
  const count = document.getElementById('stay-count');
  const noStays = document.getElementById('no-stays');
  const shareStatus = document.getElementById('share-status');
  if (form && base && party && priority) {
    const selectors = { base, party, priority };
    const initial = new URLSearchParams(window.location.search);
    Object.entries(selectors).forEach(([key, select]) => {
      const value = initial.get(key);
      if (value && Array.from(select.options).some(option => option.value === value)) select.value = value;
    });
    const update = () => {
      let visible = 0;
      cards.forEach(card => {
        const show = (base.value === 'all' || card.dataset.stayBase === base.value)
          && (party.value === 'all' || card.dataset.stayParties?.split(' ').includes(party.value))
          && (priority.value === 'all' || card.dataset.stayPriorities?.split(' ').includes(priority.value));
        card.hidden = !show;
        if (show) visible++;
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'stay' : 'stays'} to explore`;
      if (noStays) noStays.hidden = visible > 0;
      if (shareStatus) shareStatus.textContent = '';
      const url = new URL(window.location.href);
      Object.entries(selectors).forEach(([key, select]) => { if (select.value === 'all') url.searchParams.delete(key); else url.searchParams.set(key, select.value); });
      window.history.replaceState(null, '', url);
    };
    form.addEventListener('submit', event => event.preventDefault());
    form.addEventListener('change', update);
    form.addEventListener('reset', () => { Object.values(selectors).forEach(select => select.value = 'all'); update(); });
    document.getElementById('share-stays')?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(window.location.href); if (shareStatus) shareStatus.textContent = 'Shortlist link copied. The link preserves your filters.'; }
      catch { if (shareStatus) shareStatus.textContent = `Copy this link from your address bar: ${window.location.href}`; }
    });
    update();
    form.hidden = false;
    document.getElementById('share-stays')!.hidden = false;
  }
</script>

<style>
  .eyebrow{display:block;text-transform:uppercase;letter-spacing:.13em;font-size:.7rem;font-weight:700;color:var(--color-primary);margin-bottom:.7rem}.stays-hero{padding:4rem 0;background:var(--color-bg-alt)}.stays-hero h1{font-size:clamp(2.5rem,5vw,4.3rem);max-width:850px;margin-bottom:1.5rem}.stays-hero p{max-width:680px;font-size:1.1rem;color:var(--color-text-light);margin-bottom:1.8rem}.hero-link{display:inline-block;margin-left:1.25rem;color:var(--color-primary);font-weight:600}.base-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid #dce2d8;border-radius:var(--radius);padding:1.25rem;gap:1rem;margin-bottom:3rem;background:white}.base-strip strong,.base-strip span{display:block}.base-strip span{font-size:.8rem;color:var(--color-text-light);margin-top:.3rem}.finder{background:var(--color-primary);padding:2rem;border-radius:var(--radius);color:white;scroll-margin-top:125px}.finder .eyebrow{color:var(--color-accent-light)}.finder h2{color:white;font-size:2rem}.finder p{max-width:750px;margin-top:1rem;font-size:.9rem}.filter-grid{display:grid;grid-template-columns:1fr 1fr 1.2fr auto;align-items:end;gap:1rem;margin-top:1.5rem}.filter-grid label{font-size:.8rem;font-weight:600;display:block}.filter-grid select{display:block;width:100%;background:white;color:var(--color-primary);border:1px solid #dce2d8;border-radius:6px;font:inherit;font-size:.9rem;padding:.85rem .7rem;margin-top:.5rem;min-height:48px}.reset-button{font:inherit;font-size:.85rem;padding:.8rem;border:1px solid white;color:white;background:transparent;border-radius:6px;cursor:pointer;min-height:48px}.results-heading{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:1.5rem}.results-heading p{font-weight:600;color:var(--color-primary)}.results-heading button{background:transparent;border:0;font:inherit;font-size:.85rem;color:var(--color-primary);cursor:pointer;text-decoration:underline;text-underline-offset:3px;padding:.5rem}.share-status{font-size:.85rem;color:var(--color-primary);overflow-wrap:anywhere}.affiliate-note{font-size:.8rem;color:var(--color-text-light);max-width:900px;margin:1rem 0 1.5rem}.stay-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.stay-card{border:1px solid #dce2d8;border-radius:var(--radius);background:white;overflow:hidden}.stay-card[hidden]{display:none}.stay-card img{height:250px;width:100%;object-fit:cover}.stay-body{padding:1.6rem}.stay-body h3{font-size:1.55rem;margin-bottom:.75rem}.stay-body p{color:var(--color-text-light);margin-bottom:1rem;font-size:.9rem}.stay-body .stay-label{color:var(--color-primary);font-weight:600}.tradeoff{background:var(--color-bg-alt);padding:1rem;border-radius:8px;margin-bottom:1rem}.tradeoff strong{color:var(--color-primary);font-size:.8rem}.tradeoff p{margin-top:.3rem;margin-bottom:0;font-size:.85rem}.check{font-size:.85rem!important}.stay-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin-top:1.3rem}.stay-actions .btn{font-size:.85rem}.official-link{color:var(--color-primary);font-size:.8rem;text-decoration:underline;text-underline-offset:3px}.booking-section{background:var(--color-bg-alt)}.booking-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem}.booking-grid h2{margin-bottom:1.5rem}.booking-grid p{color:var(--color-text-light);margin-bottom:1rem}.booking-list{padding-left:1.5rem}.booking-list li{padding:.25rem 0 1rem .5rem;color:var(--color-text-light)}.booking-list strong{color:var(--color-primary)}.text-link{color:var(--color-primary);font-weight:600;text-decoration:underline;text-underline-offset:3px}#no-stays{background:var(--color-bg-alt);padding:2rem;border-radius:var(--radius)}#no-stays p{margin:1rem 0}.narrow{max-width:900px}.narrow h2{margin-bottom:1.5rem}details{padding:1.2rem 0;border-bottom:1px solid #dce2d8}summary{font-weight:600;cursor:pointer}details p{margin-top:.75rem;color:var(--color-text-light)}.source-box{background:var(--color-bg-alt);padding:1.5rem;border-radius:var(--radius);margin:2rem 0}.source-box h3{font-size:1.3rem;margin-bottom:1rem}.source-box p{font-size:.85rem;color:var(--color-text-light);margin-top:.75rem}.source-box a{color:var(--color-primary);text-decoration:underline;text-underline-offset:3px}.next-links{display:flex;flex-wrap:wrap;gap:1rem}@media(max-width:1000px){.filter-grid{grid-template-columns:1fr 1fr}.base-strip{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.stay-grid,.booking-grid{grid-template-columns:1fr}.finder{padding:1.4rem}.filter-grid{grid-template-columns:1fr}.hero-link{margin:1rem 0 0;display:block}.base-strip{padding:1rem}.base-strip strong{font-size:.9rem}.stay-card img{height:220px}.stays-hero{padding:3rem 0}.results-heading{align-items:start}.results-heading button{max-width:130px;text-align:right}.stay-body{padding:1.3rem}}
</style>
