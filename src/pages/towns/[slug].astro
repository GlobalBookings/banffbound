---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { towns } from '../../data/towns';
import { hotels } from '../../data/hotels';

export function getStaticPaths() { return towns.map(town => ({ params: { slug: town.slug }, props: { town } })); }
const { town } = Astro.props;
const stays = town.hotelSlugs.map((slug: string) => hotels.find(hotel => hotel.slug === slug)).filter(Boolean);
const bookingUrl = `https://www.expedia.ca/Hotel-Search?destination=${encodeURIComponent(town.hotelArea === 'Downtown Banff' ? 'Banff, Alberta' : town.hotelArea)}&camref=1101l3MtWX`;
---

<BaseLayout title={`${town.name} Travel Guide: Winter Days, Transport & Where to Stay`} description={town.description} image={`https://banffbound.com${town.image}`} canonicalUrl={`https://banffbound.com/towns/${town.slug}/`} lastUpdated="2026-10-28">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [
    { '@type': 'TouristDestination', name: town.name, description: town.description, url: `https://banffbound.com/towns/${town.slug}/`, touristType: town.bestFor, image: `https://banffbound.com${town.image}` },
    { '@type': 'FAQPage', mainEntity: town.faqs.map((faq: { question: string; answer: string }) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ] })} />
  <div class="container"><Breadcrumbs items={[{ label: 'Towns & local areas', href: '/towns/' }, { label: town.name }]} /></div>
  <section class="guide-hero"><div class="container hero-grid"><div><span class="eyebrow">{town.region}</span><h1>{town.name}</h1><p class="lead">{town.bestFor}.</p><p>{town.intro}</p><div class="hero-links"><a class="btn" href="#winter-day">Plan a winter day &darr;</a><a class="btn btn-outline" href="#where-to-stay">Where to stay</a></div></div><img src={town.image} alt={`Trip inspiration for ${town.name}`} width="800" height="600" loading="eager" fetchpriority="high" /></div></section>
  <div class="container guide-layout">
    <aside class="guide-nav"><span class="eyebrow">Your local guide</span><nav aria-label={`${town.name} guide sections`}><a href="#where-to-stay">Choose your base</a><a href="#getting-around">Getting around</a><a href="#winter-day">Your winter day</a><a href="#seasonal-limits">Winter limits</a><a href="#other-seasons">Other seasons</a><a href="#questions">Common questions</a><a href="#official-sources">Official sources</a></nav><span class="checked">Researched 28 October 2026</span></aside>
    <div class="guide-content">
      <section id="where-to-stay"><span class="eyebrow">The right address</span><h2>Where to base yourself</h2><p>{town.stay}</p>
        {stays.length > 0 && <div class="stay-links">{stays.map((hotel: any) => <a href={`/hotel-directory/${hotel.slug}`}><span>Explore a stay</span><strong>{hotel.name} &rarr;</strong></a>)}</div>}
        <div class="booking-box"><p>Compare available rooms for your dates. Check the exact location, room facilities, taxes and cancellation terms before reserving.</p><a href={bookingUrl} target="_blank" rel="noopener sponsored" class="text-link">Search {town.name} stays on Expedia &rarr;</a><small>Affiliate link: BanffBound may earn a commission if you book.</small></div>
      </section>
      <section id="getting-around"><span class="eyebrow">Make the connections work</span><h2>Getting there &amp; getting around</h2><p>{town.transport}</p><p>For a ski day, build your travel around the booked lesson meeting time and the last return. Our <a href="/ski-day-planner">ski day planner</a> helps organise the pieces; the operator’s current timetable confirms the departure.</p></section>
      <section id="winter-day"><span class="eyebrow">One good day</span><h2>A winter day in {town.name}</h2><p class="section-note">A flexible planning idea, subject to weather, access and bookings. Choose one main outing and keep a warm alternative.</p><ol class="day-plan">{town.winter.map((step: { title: string; text: string }, i: number) => <li><span class="step-number">0{i + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol><a class="text-link" href="/winter">Explore more winter activities &rarr;</a></section>
      <section id="seasonal-limits" class="winter-note"><h2>What changes in winter</h2><p>{town.avoid}</p><p>Check conditions on the day. A summer trail description, old bus timetable or another visitor’s tracks do not confirm today’s access or safety.</p></section>
      <section id="other-seasons"><h2>Visiting outside winter?</h2><p>{town.otherSeasons}</p></section>
      <section id="questions"><h2>{town.name}: common questions</h2>{town.faqs.map((faq: { question: string; answer: string }) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
      <section id="official-sources"><span class="eyebrow">Check before you go</span><h2>Official local information</h2><p>Researched 28 October 2026. These sources provide the current operating details; this guide is not a live conditions report.</p><ul class="source-list">{town.sources.map((source: { label: string; href: string }) => <li><a href={source.href} target="_blank" rel="noopener">{source.label} &nearr;</a></li>)}</ul></section>
      <section class="keep-exploring"><h2>Keep planning</h2><div class="related-links">{town.related.map((item: { label: string; href: string }) => <a href={item.href}>{item.label} &rarr;</a>)}</div><div class="related-links"><a href="/towns/">Compare all six bases &rarr;</a><a href="/winter-stays">Winter stays finder &rarr;</a><a href="/learn-to-ski">Plan your first lesson &rarr;</a></div></section>
    </div>
  </div>
</BaseLayout>

<style>
  .eyebrow{display:block;text-transform:uppercase;letter-spacing:.13em;font-size:.7rem;font-weight:700;color:var(--color-primary);margin-bottom:.7rem}.guide-hero{background:var(--color-bg-alt);padding:3.5rem 0}.hero-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:3rem;align-items:center}.guide-hero h1{font-size:clamp(2.8rem,6vw,4.5rem);margin-bottom:1rem}.guide-hero .lead{font-size:1.2rem;color:var(--color-primary);font-weight:500}.guide-hero p{color:var(--color-text-light);margin-bottom:1.2rem}.guide-hero img{height:370px;width:100%;object-fit:cover;border-radius:var(--radius)}.hero-links{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}.guide-layout{display:grid;grid-template-columns:230px minmax(0,1fr);gap:4rem;padding-top:3rem;padding-bottom:5rem}.guide-nav{position:sticky;top:120px;align-self:start}.guide-nav nav{display:flex;flex-direction:column;gap:.7rem;font-size:.9rem}.guide-nav a{color:var(--color-primary)}.guide-nav a:hover{text-decoration:underline}.checked{display:block;font-size:.75rem;color:var(--color-text-light);margin-top:1.5rem}.guide-content section{margin-bottom:3.5rem;scroll-margin-top:125px}.guide-content h2{margin-bottom:1rem}.guide-content p{margin-bottom:1rem;color:var(--color-text-light)}.guide-content p a,.text-link{color:var(--color-primary);text-decoration:underline;text-underline-offset:3px;font-weight:600}.stay-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.75rem;margin:1.5rem 0}.stay-links a{border:1px solid #dce2d8;border-radius:8px;padding:1rem;background:white}.stay-links span{display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-light);margin-bottom:.3rem}.stay-links strong{font-size:.9rem;color:var(--color-primary)}.booking-box{background:var(--color-bg-alt);padding:1.25rem;border-radius:var(--radius)}.booking-box p{font-size:.9rem}.booking-box small{display:block;color:var(--color-text-light);font-size:.75rem;margin-top:.7rem}.day-plan{list-style:none;margin:1.5rem 0}.day-plan li{display:flex;gap:1.25rem;border-top:1px solid #dce2d8;padding:1.5rem 0}.step-number{font-family:var(--font-heading);font-size:1.7rem;color:var(--color-primary)}.day-plan h3{font-size:1.2rem;margin-bottom:.75rem}.day-plan p{margin-bottom:0}.section-note{font-size:.9rem}.winter-note{background:var(--color-bg-alt);border-left:4px solid var(--color-accent);padding:1.5rem;border-radius:var(--radius)}.winter-note h2{font-size:1.7rem}details{padding:1.1rem 0;border-bottom:1px solid #dce2d8}summary{font-weight:600;cursor:pointer}details p{margin-top:.75rem}.source-list{padding-left:1.2rem}.source-list li{margin:.6rem 0}.source-list a{color:var(--color-primary);text-decoration:underline;text-underline-offset:3px;font-size:.9rem}.related-links{display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:.75rem}.related-links a{border:1px solid #dce2d8;padding:.65rem 1rem;border-radius:8px;color:var(--color-primary);font-size:.85rem;background:white}@media(max-width:900px){.guide-layout{grid-template-columns:180px minmax(0,1fr);gap:2rem}.hero-grid{gap:2rem}}@media(max-width:700px){.hero-grid,.guide-layout{grid-template-columns:1fr}.guide-nav{position:static;border-bottom:1px solid #dce2d8;padding-bottom:1.5rem}.guide-nav nav{flex-direction:row;flex-wrap:wrap;gap:.65rem 1.25rem}.guide-hero img{height:230px}.guide-layout{gap:2rem}.guide-hero{padding:2.5rem 0}.hero-links .btn{font-size:.85rem}}
</style>
