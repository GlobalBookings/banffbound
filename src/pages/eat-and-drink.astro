---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DiningPlanningInteractions from '../components/DiningPlanningInteractions.astro';
import { buildDiningDirectory, type DiningDirectoryEntry } from '../data/restaurantSourceReviews';
import { banffDiningSourceReviews } from '../data/banffDiningSourceReviews';
import { diningFilterOptions, buildDiningPlan, diningPlannerNote } from '../data/diningPlanning';

const { venues } = buildDiningDirectory(banffDiningSourceReviews);
const initialPlan = buildDiningPlan();
const areaGroups = [
  { area: 'Banff', label: 'Banff', intro: 'Compare Bear Street, Banff Avenue and the separate Juniper Hotel journey.' },
  { area: 'Lake Louise', label: 'Lake Louise', intro: 'Village, hostel and Chateau dining create different arrival and access questions.' },
  { area: 'Canmore', label: 'Canmore', intro: 'Use the actual Bow Valley Trail, Railway Avenue, 9th Street or Benchlands Trail address.' },
  { area: 'Highway 1A', label: 'Parkway & Castle Junction', intro: 'Baker Creek is on the Bow Valley Parkway. Storm Mountain has a separate Highway 93 South approach.' },
].map(group => ({ ...group, venues: venues.filter(venue => venue.area === group.area) }));
const checkedCount = venues.filter(venue => venue.sourceReview.status === 'selected-facts').length;
const pendingCount = venues.length - checkedCount;
const reviewLabel = (value: string | null) => value ? new Date(value + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : 'Review pending';
const tel = (value: string) => 'tel:' + value.replace(/[^+\d]/g, '');
function cardActions(venue: DiningDirectoryEntry) {
  const links: { label: string; url: string }[] = [];
  if (venue.website) links.push({ label: venue.slug === 'lake-louise-station' ? 'Reopening updates' : venue.website === venue.menuUrl ? 'Menu & venue details' : venue.website === venue.reserveUrl ? 'Venue & booking details' : 'Venue website', url: venue.website });
  if (venue.menuUrl && !links.some(link => link.url === venue.menuUrl)) links.push({ label: 'Current menu', url: venue.menuUrl });
  if (venue.reserveUrl && !links.some(link => link.url === venue.reserveUrl)) links.push({ label: 'Booking details', url: venue.reserveUrl });
  for (const link of venue.enquiryLinks) if (!links.some(existing => existing.url === link.url)) links.push(link);
  return links;
}
const faqs = [
  { question: 'How should I choose where to eat around Banff?', answer: 'Choose the base you can reach and the kind of meal or café stop you want. Use the area and format filters to narrow this directory, then open the selected venue’s current menu, access and booking details. Plan the return to your stay as well as the outward journey.' },
  { question: 'Does a checked listing mean the restaurant is open?', answer: 'No. The dated check covers selected publisher details rather than live opening or available tables. Notices identify material limits, including the Station’s reported renovation closure and entries needing clarification. Confirm the actual service date directly with the venue.' },
  { question: 'Can non-guests use hotel restaurants near Lake Louise?', answer: 'Check the particular hotel and date. A venue can have guest-priority seating or a date-specific hotel-access restriction. Chateau dining is beside the lake, separate from Lake Louise village and the ski resort; confirm access before arranging that journey.' },
  { question: 'How do I plan dietary or accessibility requirements?', answer: 'Tell the selected venue the exact ingredients, preparation, entrance, seating or assistance arrangements you need. The filters describe geography and dining format; they do not assess allergies, mobility access or suitability for a particular guest.' },
  { question: 'Is a dinner reservation the same as a show or activity booking?', answer: 'Check the selected product. A table, a High Rollers bowling lane, a distillery tour or admission to a dated performance can require separate arrangements. Build the complete evening and return journey before adding another booking.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---

<BaseLayout title="Where to Eat in Banff, Lake Louise & Canmore" description="Choose a dining area and café, restaurant or pub format. Compare sourced venue locations, menus, booking routes, access notices and the return to your stay.">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'ItemList', name: 'Dining ideas in Banff, Lake Louise & Canmore', url: 'https://banffbound.com/eat-and-drink/', numberOfItems: venues.length, itemListElement: venues.map((venue, index) => ({ '@type': 'ListItem', position: index + 1, name: venue.name, url: `https://banffbound.com/eat-and-drink/#dining-${venue.slug}` })) })} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')} />
  <div class="container"><Breadcrumbs items={[{ label: 'Eat & Drink' }]} /></div>

  <section class="dining-hero">
    <div class="container dining-hero-inner">
      <div><span class="dining-eyebrow">At the table</span><h1>Eat & Drink in Banff & Beyond</h1><p>Make it a coffee stop, a mountain meal or the start of an evening. Choose the place you can reach, then find the menu and booking that fit.</p><a class="btn btn-accent" href="#dining-finder">Find your next stop ↓</a></div>
      <div class="dining-hero-note"><span>Build the whole evening</span><p>A good meal starts with the right address and ends with a way back to your stay.</p><a href="/blog/banff-nightlife-guide/#evening-planner">Build your Banff evening →</a></div>
    </div>
  </section>

  <section class="section" aria-labelledby="evening-guides-title">
    <div class="container">
      <div class="section-header"><span class="badge">After the mountains</span><h2 id="evening-guides-title">Give your evening a shape</h2><p>Make dinner the occasion, find a performance, or put a little friendly competition in the plan.</p></div>
      <div class="grid grid-2 evening-guide-links">
        <a href="/blog/banff-nightlife-guide/#evening-planner"><strong>Build your Banff evening →</strong><span>Compare five formats and connect the outing with the return to your stay.</span></a>
        <a href="/blog/new-places-to-eat-in-banff/"><strong>Find a dining discovery →</strong><span>Separate dated additions and reopenings from other restaurants to investigate.</span></a>
        <a href="/blog/banff-live-music/"><strong>Find music or a show →</strong><span>Choose a dated performance and the right table, ticket or registration.</span></a>
        <a href="/blog/drink-deals/"><strong>Compare current offer formats →</strong><span>Check the meal, admission and booking conditions behind an offer headline.</span></a>
      </div>
    </div>
  </section>

  <section class="section dining-finder" id="dining-finder" aria-labelledby="dining-title">
    <div class="container">
      <div class="section-header"><span class="badge">Choose your next stop</span><h2 id="dining-title">Find a meal that fits the journey</h2><p>{checkedCount} entries have selected operator details checked; {pendingCount} still need clarification. Read each notice before making a visit depend on it.</p></div>
      <form id="dining-form" class="dining-form" hidden>
        <div><label for="dining-area">Where will you be?</label><select id="dining-area" name="dining_area">{diningFilterOptions.area.map(([value, label]) => <option value={value}>{label}</option>)}</select></div>
        <div><label for="dining-format">What do you have in mind?</label><select id="dining-format" name="dining_format">{diningFilterOptions.format.map(([value, label]) => <option value={value}>{label}</option>)}</select></div>
        <button class="btn" type="submit">Show places</button><button class="btn btn-outline" type="reset">Show all</button>
      </form>
      <p id="dining-status" class="dining-status" role="status" aria-live="polite">{initialPlan.summary}</p>
      <p class="dining-scope">{diningPlannerNote}</p>
      <noscript><p>All places and their source links are listed below. Use the venue’s own current details to plan the visit.</p></noscript>
      <div id="dining-empty" class="dining-empty" hidden><h3>Try another area or format</h3><p>No directory entries match those choices. Broaden the filters or show all places; an empty result does not mean every local venue is closed.</p></div>
      {areaGroups.map(group => <section class="dining-area-group" data-dining-group aria-labelledby={`dining-area-${group.area.toLowerCase().replace(/\s+/g, '-')}`}>
        <div class="dining-area-heading"><h2 id={`dining-area-${group.area.toLowerCase().replace(/\s+/g, '-')}`}>{group.label}</h2><p>{group.intro}</p></div>
        <div class="dining-card-grid">{group.venues.map(venue => <article id={`dining-${venue.slug}`} data-dining-slug={venue.slug} class:list={['dining-card', { 'dining-card-pending': venue.sourceReview.status !== 'selected-facts' }]} aria-labelledby={`dining-name-${venue.slug}`}>
          <div class="dining-card-top"><span class="dining-format">{venue.type || 'Details to clarify'}</span><span class="dining-check">{venue.sourceReview.label} · {reviewLabel(venue.sourceReview.checkedOn)}</span></div>
          <h3 id={`dining-name-${venue.slug}`}>{venue.name}</h3>
          {venue.cuisine && <p class="dining-cuisine">{venue.cuisine}</p>}
          <p>{venue.description}</p>
          {venue.notices.map(notice => <aside class="dining-notice"><strong>{notice.label}</strong><p>{notice.text}</p><a href={notice.url} target="_blank" rel="noopener noreferrer">Check the publisher’s notice ↗</a></aside>)}
          {venue.address && <p class="dining-address"><span>Location</span>{venue.address}</p>}
          {venue.phone && <p class="dining-phone"><a href={tel(venue.phone)}>Call {venue.phone}</a></p>}
          <div class="dining-actions">{cardActions(venue).map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>
          <details class="dining-source-details"><summary>Visit checks & sources</summary><p>{venue.serviceNote}</p><p>{venue.journeyNote}</p><ul>{venue.sourceReview.sources.map(link => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a></li>)}</ul></details>
        </article>)}</div>
      </section>)}
    </div>
  </section>

  <section class="section dining-faq" aria-labelledby="dining-faq-title"><div class="container"><div class="section-header"><span class="badge">Before you book</span><h2 id="dining-faq-title">Dining questions</h2></div>{faqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>

  <section class="section dining-stays"><div class="container"><div class="section-header"><span class="badge">Settle in</span><h2>Stay close to your evening plans</h2><p>Choose the base for the whole trip, then match dinner with the journey back. These stay comparisons contain accommodation affiliate links.</p></div><div class="grid grid-3">
    <a href="/book/banff-hotels/"><strong>Compare Banff hotel bases →</strong><span>Six researched hotel locations for a Banff-centred stay.</span></a>
    <a href="/book/lake-louise-stays/"><strong>Compare Lake Louise stays →</strong><span>Keep the village, lakeshore and other room locations separate.</span></a>
    <a href="/towns/canmore/"><strong>Plan a Canmore stay →</strong><span>Compare actual areas, room examples and the wider journey.</span></a>
  </div></div></section>
  <DiningPlanningInteractions />
</BaseLayout>

<style>
  .dining-hero{background:var(--color-primary);color:white;padding:4rem 0 4.5rem;position:relative;overflow:hidden}
  .dining-hero::after{content:'';position:absolute;width:28rem;height:28rem;right:-8rem;top:-13rem;border:1px solid #ffffff1c;border-radius:50%;pointer-events:none}
  .dining-hero-inner{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(16rem,1fr);align-items:center;gap:4rem}
  .dining-hero h1{font-size:clamp(2.4rem,5vw,4.6rem);line-height:1.08;color:white;max-width:17ch;margin:.65rem 0 1.1rem}
  .dining-hero p{line-height:1.8;max-width:43rem;color:#f1eee6;margin-bottom:1.8rem}
  .dining-eyebrow,.dining-hero-note>span{font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.15em;color:var(--color-accent)}
  .dining-hero-note{padding:2rem;border:1px solid #ffffff40;border-radius:var(--radius);background:#ffffff08}
  .dining-hero-note p{font-size:1.25rem;line-height:1.6;margin:1rem 0}
  .dining-hero-note a{color:white;font-weight:700;text-underline-offset:4px}
  .evening-guide-links a,.dining-stays .grid>a{display:flex;flex-direction:column;gap:.65rem;padding:1.4rem;border:1px solid var(--color-border,#d4ddce);border-radius:var(--radius);background:var(--color-bg-alt);color:var(--color-primary);text-decoration:none}
  .evening-guide-links span,.dining-stays span{font-size:.95rem;line-height:1.6;color:var(--color-text-light)}
  .dining-finder{background:#f5f4ee;scroll-margin-top:6rem}
  .dining-form{display:flex;align-items:end;gap:1rem;flex-wrap:wrap;margin-bottom:1.1rem;background:white;padding:1.4rem;border:1px solid var(--color-border,#d4ddce);border-radius:var(--radius)}
  .dining-form[hidden],.dining-empty[hidden],[data-dining-slug][hidden],[data-dining-group][hidden]{display:none!important}
  .dining-form>div{flex:1 1 13rem;min-width:0}.dining-form label{display:block;font-weight:700;margin-bottom:.5rem;font-size:.9rem}
  .dining-form select{width:100%;min-height:3rem;border:1px solid #a6b1a5;border-radius:6px;padding:.7rem;background:white;color:var(--color-text);font:inherit}
  .dining-status{font-weight:700;margin-bottom:.5rem}.dining-scope{font-size:.9rem;color:var(--color-text-light);max-width:65rem;line-height:1.7}
  .dining-empty{padding:1.6rem;background:white;border:1px solid var(--color-border,#d4ddce);border-radius:var(--radius);margin:1.5rem 0}
  .dining-area-group{margin-top:3rem}.dining-area-heading{margin-bottom:1.3rem}.dining-area-heading h2{font-size:1.8rem;margin-bottom:.4rem}.dining-area-heading p{color:var(--color-text-light);line-height:1.7}
  .dining-card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.3rem;align-items:start}
  .dining-card{background:white;border:1px solid var(--color-border,#d4ddce);border-top:4px solid var(--color-primary);border-radius:var(--radius);padding:1.5rem;min-width:0;scroll-margin-top:6rem}
  .dining-card-pending{border-top-color:#9f7b37}.dining-card-top{display:flex;justify-content:space-between;gap:.7rem;align-items:start;flex-wrap:wrap;margin-bottom:.85rem}
  .dining-format{font-size:.73rem;text-transform:uppercase;font-weight:700;letter-spacing:.06em;color:var(--color-primary)}.dining-check{font-size:.72rem;color:#5d665a;background:#f0f2e9;padding:.25rem .5rem;border-radius:4px}
  .dining-card h3{font-size:1.55rem;line-height:1.25;margin:0 0 .55rem}.dining-card p{line-height:1.75;font-size:.94rem;margin:0 0 1rem}.dining-card .dining-cuisine{font-size:.8rem;color:var(--color-text-light);margin-bottom:.8rem}
  .dining-address{padding-top:.8rem;border-top:1px solid #e4e7df}.dining-address span{display:block;font-size:.69rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:var(--color-text-light)}
  .dining-phone a{font-weight:600;color:var(--color-primary)}.dining-actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:1rem}.dining-actions a{font-size:.8rem;font-weight:700;text-decoration:none;background:var(--color-primary);color:white;padding:.65rem .8rem;border-radius:5px;line-height:1.5;max-width:100%;overflow-wrap:anywhere}
  .dining-notice{border-left:3px solid #ae7a26;background:#faf4e6;padding:.9rem 1rem;margin:.9rem 0 1.1rem}.dining-notice strong{font-size:.85rem}.dining-notice p{font-size:.85rem;margin:.4rem 0}.dining-notice a{font-size:.82rem;color:var(--color-primary)}
  .dining-source-details{border-top:1px solid #e4e7df;padding-top:.9rem}.dining-source-details summary{cursor:pointer;font-size:.85rem;font-weight:700}.dining-source-details[open] summary{margin-bottom:.8rem}.dining-source-details p,.dining-source-details li{font-size:.84rem;line-height:1.7}.dining-source-details ul{padding-left:1.2rem}.dining-source-details a{overflow-wrap:anywhere}
  .dining-faq details{padding:1.15rem 0;border-bottom:1px solid var(--color-border,#d4ddce)}.dining-faq summary{cursor:pointer;font-weight:700}.dining-faq details p{line-height:1.8;max-width:60rem;margin:1rem 0 .2rem}
  .dining-stays{background:#edece2}.dining-stays .grid>a{background:white}
  a:focus-visible,button:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--color-accent);outline-offset:3px}
  @media(max-width:850px){.dining-hero-inner{grid-template-columns:1fr;gap:2rem}.dining-hero-note{max-width:40rem}.dining-card-grid{grid-template-columns:1fr}}
  @media(max-width:500px){.dining-hero{padding:2.8rem 0}.dining-hero h1{font-size:2.6rem}.dining-hero-note{padding:1.3rem}.dining-card{padding:1.15rem}.dining-form{padding:1rem}.dining-form .btn{flex:1 1 auto}.dining-check{max-width:100%}}
</style>
