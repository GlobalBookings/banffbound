---
import BaseLayout from '../layouts/BaseLayout.astro';
import WinterStart from '../components/WinterStart.astro';
import townSnapshot from '../data/live/town-events.json';
import { TOWN_FEEDS,townFeedView,mountainTime } from '../data/townFeedModel.mjs';
import { blogPosts } from '../data/blogPosts';
import { dataFreshness } from '../utils/dataFreshness';

/* Cached data is displayed only while its dated snapshot remains recent. */
let weatherData: any = {};
try { const m = await import('../data/live/weather.json'); weatherData = m.default || m; } catch { /* unavailable */ }
let trailData: any = {};
try { const m = await import('../data/live/trail-conditions.json'); trailData = m.default || m; } catch { /* unavailable */ }
const weatherFreshness = dataFreshness(weatherData.updatedAt, 6);
const weatherObservation = dataFreshness(weatherData.banff?.current?.observedAt,6);
const weatherExpiry = weatherFreshness.expiresAt && weatherObservation.expiresAt ? new Date(Math.min(Date.parse(weatherFreshness.expiresAt),Date.parse(weatherObservation.expiresAt))).toISOString() : null;
const trailFreshness = dataFreshness(trailData.updatedAt, 24);
const weatherAvailable = weatherFreshness.status === 'fresh' && weatherObservation.status === 'fresh' && weatherData.provider === 'Environment and Climate Change Canada' && !weatherData.error && Number.isFinite(weatherData.banff?.current?.temp);
const trailReports = (trailData.areas || []).flatMap((area: any) => area.trails || []);
const trailReportsRecent = trailReports.length > 0 && trailReports.every((trail: any) => dataFreshness(trail.lastUpdated, 24).status === 'fresh');
const trailsAvailable = trailReportsRecent && trailFreshness.status === 'fresh' && !trailData.error && Number.isInteger(trailData.summary?.open) && Number.isInteger(trailData.summary?.total) && trailData.summary.total > 0 && trailData.summary.open >= 0 && trailData.summary.open <= trailData.summary.total;

const featuredPosts = ['banff-heli-skiing', 'banff-snowshoeing-guide', 'banff-winter-driving', 'banff-ski-in-ski-out'].map(slug => blogPosts.find(post => post.slug === slug)).filter(Boolean);

const townCalendar = townFeedView(townSnapshot,'events');
const upcomingEvents = townCalendar.items.slice(0,3);

const homeDescription = "Plan Banff and Lake Louise around a place to stay. Compare room choices, build a ski day, choose winter activities and explore nearby mountain towns.";
---

<BaseLayout title="Banff Trip Planning: Stays, Winter Days & Mountain Towns" description={homeDescription} lastUpdated="2026-10-29">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        '@id': 'https://banffbound.com/#website',
        url: 'https://banffbound.com',
        name: 'BanffBound',
        description: homeDescription,
        publisher: { '@id': 'https://banffbound.com/#organization' },
        inLanguage: 'en',
      },
      {
        '@type': 'Organization',
        '@id': 'https://banffbound.com/#organization',
        name: 'BanffBound',
        url: 'https://banffbound.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://banffbound.com/favicon.svg',
        },
        sameAs: [
          'https://www.instagram.com/Banff_bound',
          'https://www.facebook.com/people/BanffBound/61580983035426/',
          'https://www.pinterest.com/Banff_bound/',
          'https://www.tiktok.com/@Banff_bound',
        ],
      },
    ],
  })} />

  <section class="home-hero" id="home-start" aria-labelledby="home-heading">
    <div class="container home-hero-grid">
      <div class="home-lead">
        <p class="eyebrow">Banff · Lake Louise · The Bow Valley</p>
        <h1 id="home-heading">Find your place <br />in Banff.</h1>
        <p class="home-deck">Compare a place to stay, give each day a main outing, and leave room to change the plan. Start with the base you will travel from.</p>
        <nav id="home-booking-start" aria-label="Start with a stay or winter experience">
          <a class="btn btn-primary" href="/book/banff-hotels/">Compare Banff hotels <span aria-hidden="true">→</span></a>
          <a class="home-secondary" href="/book/lake-louise-stays/">Staying near Lake Louise? Compare the area’s bases <span aria-hidden="true">→</span></a>
          <a class="home-secondary" href="/book/banff-winter-activities/">Choose a winter experience <span aria-hidden="true">→</span></a>
        </nav>
        <p class="home-plan-link">Already have a base? <a href="/trip-builder/">Build your days in the Trip Builder <span aria-hidden="true">→</span></a></p>
      </div>
      <figure class="home-image">
        <img src="https://images.unsplash.com/photo-1561134643-668f9057cce4?w=1200&q=75&fm=webp" srcset="https://images.unsplash.com/photo-1561134643-668f9057cce4?w=640&q=75&fm=webp 640w, https://images.unsplash.com/photo-1561134643-668f9057cce4?w=1200&q=75&fm=webp 1200w" sizes="(max-width: 850px) 100vw, 45vw" alt="Illustrative mountain photograph; not a verified route or current-condition view" fetchpriority="high" width="1200" height="800" />
        <figcaption>Illustrative mountain photograph</figcaption>
      </figure>
    </div>
  </section>

  <WinterStart />

  <section class="section home-topics" aria-labelledby="home-topic-heading">
    <div class="container home-editorial-grid">
      <div class="section-intro"><p class="eyebrow">Put the journey together</p><h2 id="home-topic-heading">A few useful next questions.</h2><p>A place to stay is one part of the trip. Work through the day’s transport, access and practical details before making dependent bookings.</p><a href="/tools/" class="row-link">Browse the planning tools <span aria-hidden="true">→</span></a></div>
      <div class="topic-rows">
        <a href="/towns"><h3>Which mountain base?</h3><p>Compare Banff, Canmore, Lake Louise and the towns beyond before choosing an address.</p><span aria-hidden="true">→</span></a>
        <a href="/calgary-to-banff"><h3>How will you get there and back?</h3><p>Join the airport journey, your room and the final return.</p><span aria-hidden="true">→</span></a>
        <p class="related-row">Local transport: <a href="/car-free-banff">Plan a car-free stay</a></p>
        <a href="/park-pass"><h3>What needs its own ticket?</h3><p>Work through admission separately from lake access, parking, lessons and activities.</p><span aria-hidden="true">→</span></a>
        <a href="/trip-cost"><h3>How do the quotes compare?</h3><p>Use the same people, nights and inclusions. Keep amounts you do not know visible.</p><span aria-hidden="true">→</span></a>
        <a href="/accessible-trails/"><h3>Which access details matter?</h3><p>Compare physical trail features, transport questions and specific visitor arrangements.</p><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section home-guides" aria-labelledby="home-guide-heading">
    <div class="container home-editorial-grid">
      <div class="section-intro"><p class="eyebrow">Take one idea further</p><h2 id="home-guide-heading">Plan the winter outing.</h2><p>A resort day, a forest walk and a heli-ski trip need different preparation. Use a guide for the activity you intend to book.</p><a href="/blog" class="row-link">View all travel guides <span aria-hidden="true">→</span></a></div>
      <div class="guide-rows">{featuredPosts.map(post => <a href={`/blog/${post.slug}`}><span class="guide-category">{post.category}</span><h3>{post.title}</h3><span class="guide-reading">{post.readTime} <span aria-hidden="true">→</span></span></a>)}</div>
    </div>
  </section>

  <section class="section home-explore" aria-labelledby="home-explore-heading"><div class="container"><div class="explore-heading"><div><p class="eyebrow">Time between the main plans</p><h2 id="home-explore-heading">Explore at your own pace.</h2></div><p>Find a meal, a shorter outing or a different kind of day near your base.</p></div><nav class="explore-links" aria-label="Browse Banff interests"><a href="/things-to-do">Things to do <span aria-hidden="true">→</span></a><a href="/eat-and-drink">Food and drink <span aria-hidden="true">→</span></a><a href="/shopping">Shops and supplies <span aria-hidden="true">→</span></a><a href="/activities">Activity planning <span aria-hidden="true">→</span></a><a href="/lakes">Lakes and access <span aria-hidden="true">→</span></a><a href="/tours">Tours and experiences <span aria-hidden="true">→</span></a><a href="/hotels">Hotel planning <span aria-hidden="true">→</span></a><a href="/packing-list">Packing checklist <span aria-hidden="true">→</span></a></nav></div></section>

  <section class="home-current" aria-labelledby="home-current-heading"><div class="container"><p class="eyebrow">Before you set out</p><h2 id="home-current-heading">Check the day’s reports.</h2><p>Weather, a dated trail report and an operator’s current notice answer different questions. Open the source for the actual outing.</p></div>
  <noscript><style>[data-snapshot-fresh] { display:none !important; } [data-fresh-until] [data-snapshot-unavailable][hidden] { display:block !important; }</style></noscript>
  <!-- Today in Banff -->
  <section class="today-strip">
    <div class="container">
      <div class="today-grid">
        <a href="https://weather.gc.ca/en/location/index.html?coords=51.178,-115.571" target="_blank" rel="noopener" class="today-item" data-fresh-until={weatherExpiry} data-snapshot-time={weatherObservation.updatedAt}>
          <span class="today-icon">🌡️</span>
          {weatherAvailable && <span data-snapshot-fresh class="today-detail">{weatherData.banff.current.temp}°C · {weatherData.banff.current.condition}</span>}
          <span data-snapshot-unavailable hidden={weatherAvailable} class="today-detail">Weather unavailable</span>
          <span class="today-label">{weatherData.provider === 'Environment and Climate Change Canada' && weatherObservation.updatedAt ? 'ECCC observation: '+weatherObservation.label+'. ' : ''}Check official forecast ↗</span>
        </a>
        <a href="https://parks.canada.ca/pn-np/ab/banff/activ/randonnee-hiking/etat-sentiers-trail-conditions" target="_blank" rel="noopener" class="today-item" data-fresh-until={trailFreshness.expiresAt} data-snapshot-time={trailFreshness.updatedAt}>
          <span class="today-icon">🥾</span>
          {trailsAvailable && <span data-snapshot-fresh class="today-detail">{trailData.summary.open}/{trailData.summary.total} reported open</span>}
          <span data-snapshot-unavailable hidden={trailsAvailable} class="today-detail">Trail status unavailable</span>
          <span class="today-label">Snapshot: {trailFreshness.label}. Check Parks Canada ↗</span>
        </a>
        <a href="/what-to-do-today" class="today-item today-cta">
          <span class="today-icon">🎯</span>
          <span class="today-detail">Find an outing</span>
          <span class="today-label">What to do →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Conditions planning links -->
  <section class="conditions-strip">
    <div class="container">
      <a href="/conditions" class="conditions-strip-inner">
        <span class="conditions-strip-season">🏔️ Before you head out</span>
        <span class="conditions-strip-divider" aria-hidden="true">|</span>
        <span class="conditions-strip-summary">Check weather, trail reports, road status and resort conditions</span>
        <span class="conditions-strip-cta">View Conditions →</span>
      </a>
      <div class="conditions-strip-tools">
        <a href="/what-to-do-today">🎯 What to Do Today</a>
        <a href="/wildlife-tracker">🐻 Wildlife Tracker</a>
        <a href="/trail-map">🗺️ Trail Map</a>
      </div>
    </div>
  </section>

  </section>

  <!-- Upcoming Events -->
    <section class="section" style="background: var(--color-bg-alt);" data-town-panel data-town-kind="events" data-town-expires={townCalendar.expiresAt} data-town-retrieved={townCalendar.retrievedAt}>
      <div class="container">
        <div class="section-header">
          <span class="badge">What's Happening</span>
          <h2>Town calendar dates</h2>
          <p>Dated listings from the Town's Events category. Confirm the organiser's details before making the journey.</p>
        </div>
        <p style="font-size:.85rem;color:var(--color-text-light);margin-bottom:1rem">Snapshot retrieved: {mountainTime(townCalendar.retrievedAt)}. {townCalendar.message}</p>
        {upcomingEvents.length > 0 && <div class="event-rows" data-town-results>
          {upcomingEvents.map(event => (
            <a href={event.link} target="_blank" rel="noopener" class="event-preview" data-town-event data-start={event.startDate} data-end={event.endDate}>
              <div>
                <span class="event-dates">{event.dates}</span>
                <h3>{event.title}</h3>
                <p>{event.description}</p>
                <span class="row-link">Learn More &rarr;</span>
              </div>
            </a>
          ))}
        </div>}
        <p data-town-no-matches hidden>No remaining event dates appear in these previews. Open the calendar for more listings.</p>
        <p data-town-stale hidden={townCalendar.status !== 'stale'}>The local calendar snapshot is unavailable, expired or cannot be checked here. Use the <a href={TOWN_FEEDS.events.pageUrl} target="_blank" rel="noopener">official Town calendar</a> for current dates; this does not mean no events are scheduled.</p>
        <noscript><style is:inline>[data-town-panel] [data-town-results] { display:none !important; } [data-town-panel][data-town-kind] [data-town-stale][hidden] { display:block !important; }</style><p>Feed previews are hidden without JavaScript because their expiry cannot be checked. Use the official calendar or the winter festival planning guides.</p></noscript>
        <div style="text-align: center; margin-top: 2rem;">
          <a href="/events" class="btn btn-outline">Events & Winter Festivals &rarr;</a>
          <a href={TOWN_FEEDS.events.pageUrl} target="_blank" rel="noopener" class="btn btn-outline">Official Town Calendar &rarr;</a>
        </div>
      </div>
    </section>
  <script>
    import { installTownFeedPanels } from '../utils/townEvents';
    installTownFeedPanels();
  </script>


</BaseLayout>
<script>
  import { installSnapshotExpiry } from '../utils/dataFreshness';
  installSnapshotExpiry();
</script>
<style>
  [data-fresh-until] [hidden] { display: none !important; }
  .eyebrow { color:#6b552e; font-size:.76rem; font-weight:700; letter-spacing:.11em; text-transform:uppercase; margin:0 0 1rem; }
  .home-hero { padding:3rem 0 4rem; background:var(--color-bg); }
  .home-hero-grid { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:5%; align-items:start; }
  .home-lead { min-width:0; }
  .home-lead h1 { font-size:clamp(3.5rem,6vw,5.5rem); line-height:1.03; letter-spacing:-.035em; margin:0 0 1.5rem; color:var(--color-primary); }
  .home-deck { max-width:48ch; font-size:1.12rem; line-height:1.65; margin:0 0 1.5rem; }
  #home-booking-start { display:flex; align-items:flex-start; flex-direction:column; gap:1rem; }
  #home-booking-start .btn { gap:1.2rem; text-align:left; }
  .home-secondary { font-size:1rem; line-height:1.5; text-decoration:underline; text-underline-offset:.22em; }
  .home-plan-link { margin:1.5rem 0 0; font-size:.94rem; color:var(--color-text-light); }
  .home-plan-link a { color:var(--color-primary); text-decoration:underline; text-underline-offset:.2em; }
  .home-image { margin:0; min-width:0; }
  .home-image img { width:100%; height:auto; aspect-ratio:1/1; object-fit:cover; display:block; }
  .home-image figcaption { margin-top:.65rem; color:var(--color-text-light); font-size:.75rem; }
  .home-editorial-grid { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.3fr); gap:8%; align-items:start; }
  .section-intro h2 { font-size:clamp(2rem,3.4vw,3rem); line-height:1.15; margin:0 0 1rem; }
  .section-intro p:not(.eyebrow) { line-height:1.7; color:var(--color-text-light); }
  .row-link { display:inline-block; margin-top:.8rem; font-weight:600; text-decoration:underline; text-underline-offset:.2em; }
  .topic-rows,.guide-rows { border-top:1px solid #bec7be; }
  .topic-rows>a { position:relative; display:block; border-bottom:1px solid #bec7be; padding:1.4rem 2rem 1.4rem 0; color:inherit; }
  .topic-rows h3 { font-size:1.35rem; margin:0 0 .45rem; }
  .topic-rows p { margin:0; color:var(--color-text-light); line-height:1.6; max-width:58ch; }
  .topic-rows>a>span { position:absolute; top:1.6rem; right:0; }
  .topic-rows .related-row { font-size:.9rem; padding:.8rem 0; border-bottom:1px solid #bec7be; }
  .related-row a { text-decoration:underline; text-underline-offset:.2em; }
  .home-guides { background:var(--color-bg-alt); }
  .guide-rows>a { display:grid; grid-template-columns:1fr auto; column-gap:1rem; padding:1.4rem 0; border-bottom:1px solid #bec7be; color:inherit; }
  .guide-category { color:#6b552e; font-size:.76rem; text-transform:uppercase; letter-spacing:.07em; grid-column:1/-1; margin-bottom:.45rem; }
  .guide-rows h3 { font-size:1.3rem; line-height:1.35; margin:0; }
  .guide-reading { font-size:.85rem; color:var(--color-text-light); white-space:nowrap; align-self:center; }
  .explore-heading { display:flex; justify-content:space-between; align-items:end; gap:3rem; margin-bottom:1.6rem; }
  .explore-heading h2 { margin:0; font-size:clamp(2rem,3.4vw,3rem); }
  .explore-heading>p { max-width:40ch; line-height:1.65; color:var(--color-text-light); }
  .explore-links { display:grid; grid-template-columns:1fr 1fr; column-gap:3rem; border-top:1px solid #bec7be; }
  .explore-links>a { display:flex; justify-content:space-between; gap:1rem; padding:1.2rem 0; border-bottom:1px solid #bec7be; font-size:1.12rem; font-weight:600; }
  .home-current { padding:3rem 0 0; border-top:1px solid #bec7be; }
  .home-current h2 { margin:0 0 1rem; font-size:clamp(2rem,3.4vw,3rem); }
  .home-current>.container>p:not(.eyebrow) { max-width:70ch; line-height:1.65; }
  .today-strip { padding:1.25rem 0; }
  .today-grid { display:flex; gap:1rem 2rem; flex-wrap:wrap; }
  .today-item { display:flex; flex-wrap:wrap; align-items:center; gap:.35rem .6rem; color:var(--color-primary); }
  .today-icon { font-size:1.1rem; }
  .today-detail { font-weight:700; }
  .today-label { color:var(--color-text-light); font-size:.88rem; }
  .conditions-strip { background:var(--color-primary); padding:1rem 0; }
  .conditions-strip-inner { display:flex; gap:.8rem; flex-wrap:wrap; align-items:center; color:white; line-height:1.5; }
  .conditions-strip-season { font-weight:600; }
  .conditions-strip-cta { color:var(--color-accent); font-weight:600; }
  .conditions-strip-tools { display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; padding-top:.8rem; }
  .conditions-strip-tools a { color:white; text-decoration:underline; text-underline-offset:.2em; }
  .event-rows { display:grid; grid-template-columns:1fr; border-top:1px solid #bec7be; }
  .event-preview { display:block; color:inherit; padding:1.5rem 0; border-bottom:1px solid #bec7be; }
  .event-preview h3 { font-size:1.3rem; margin:.4rem 0; }
  .event-preview p { max-width:75ch; line-height:1.65; }
  .event-dates { font-size:.85rem; color:#6b552e; font-weight:600; }
  .home-hero a:focus-visible,.home-topics a:focus-visible,.home-guides a:focus-visible,.home-explore a:focus-visible,.home-current a:focus-visible { outline:3px solid #977000; outline-offset:5px; }
  @media(max-width:850px) { .home-hero-grid,.home-editorial-grid { grid-template-columns:1fr; gap:2.5rem; } .home-hero { padding:2rem 0 3rem; } .home-lead h1 { font-size:clamp(3.3rem,9vw,5rem); } .home-image img { aspect-ratio:16/9; max-height:360px; } .section-intro { max-width:58ch; } .explore-heading { display:block; } }
  @media(max-width:550px) { .home-hero { padding-top:1.6rem; } .home-lead h1 { font-size:3.45rem; } .home-deck { font-size:1.04rem; } .home-hero-grid { gap:2rem; } .home-plan-link { line-height:1.6; } .guide-rows>a { grid-template-columns:1fr; } .guide-reading { margin-top:.7rem; } .explore-links { grid-template-columns:1fr; } .conditions-strip-divider { display:none; } }
</style>
