---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { wildlifeZones, wildlifeHabitatLabels, wildlifeVisitLabels, wildlifeAreaReviewedAt } from '../data/wildlifeZones';
import { wildlifeSpecies, wildlifeTrackerFaqs } from '../data/wildlifeFieldGuide';
import { wildlifeDistanceGroups, wildlifeContacts, wildlifeSources } from '../data/wildlifeSafety';
---
<BaseLayout lastUpdated={wildlifeAreaReviewedAt} title="Banff Wildlife Tracker — Habitat Map & Viewing Guide" description="Explore Banff wildlife habitat, public visitor areas, seasonal access and species identification. Filter ten area plans and prepare for responsible wildlife viewing.">
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:wildlifeTrackerFaqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))})} />
  <div class="container"><Breadcrumbs items={[{label:'Wildlife',href:'/wildlife'},{label:'Wildlife Tracker'}]} /></div>
  <section class="wild-hero"><div class="container"><span class="eyebrow">A landscape worth noticing</span><h1>Banff Wildlife Tracker</h1><p>Find a habitat to explore. Learn what to notice. Leave room for wildlife.</p><div class="hero-links"><a class="btn btn-accent" href="#area-plans">Explore ten area plans</a><a href="/wildlife#field-guide">Meet the species →</a></div></div></section>
  <section class="section"><div class="container">
    <div class="intro-panel"><h2>Plan a visit around habitat</h2><p>These are public visitor areas, with rounded map references to help compare journeys. Species filters match <strong>broad habitat</strong>; they do not show sightings at those points. Choose a walk, viewpoint or road journey that is worthwhile even without an animal encounter.</p><p><strong>No live sighting feed is connected.</strong> There are no recent animal positions or measured sighting frequencies on this map. Source and access review: <time datetime={wildlifeAreaReviewedAt}>29 October 2026</time>. Check current restrictions before travelling.</p></div>
    <form class="wildlife-controls" id="wildlife-filters" hidden aria-label="Compare wildlife habitat visits">
      <div><label for="species-filter">Learn about a species</label><select id="species-filter" name="species"><option value="all">All species</option>{wildlifeSpecies.map(s=><option value={s.id}>{s.name}</option>)}</select></div>
      <div><label for="habitat-filter">Habitat</label><select id="habitat-filter" name="habitat"><option value="all">Any habitat</option>{Object.entries(wildlifeHabitatLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></div>
      <div><label for="season-filter">Visit season</label><select id="season-filter" name="season"><option value="all">Any season</option><option value="spring">Spring</option><option value="summer">Summer</option><option value="fall">Fall</option><option value="winter">Winter</option></select></div>
      <div><label for="visit-filter">Journey style</label><select id="visit-filter" name="visit"><option value="all">Any journey</option>{Object.entries(wildlifeVisitLabels).map(([id,label])=><option value={id}>{label}</option>)}</select></div>
      <button type="reset" class="btn btn-secondary">Clear filters</button>
    </form>
    <p id="species-context" class="context-note">Explore the species field guide for identification and habitat context.</p>
    <div class="map-toolbar"><p id="area-count" role="status" aria-live="polite">10 area plans</p><button type="button" id="load-wildlife-map" hidden class="btn btn-secondary">Show area map</button></div>
    <p id="map-feedback" role="status" aria-live="polite">The complete area guide is available below. Load the map to compare the public visitor areas.</p>
    <div id="wildlife-map" hidden aria-label="Public visitor area reference map" tabindex="0"></div>
    <p class="map-key">Map references mark approximate visitor areas, never animal positions, habitat boundaries or navigation routes. No sighting radius or probability is assigned.</p>
    <div id="area-plans" class="zones-list">
      {wildlifeZones.map(z=><article class="zone-card" id={z.id} data-zone-id={z.id}><div class="zone-heading"><span class="eyebrow">{wildlifeVisitLabels[z.visit]}</span><h2>{z.name}</h2></div><div class="tags">{z.habitat.map(h=><span>{wildlifeHabitatLabels[h]}</span>)}</div><p>{z.description}</p><h3>A worthwhile objective</h3><p>{z.activity}</p><h3>Plan the approach</h3><p>{z.access}</p><h3>Winter context</h3><p>{z.winter}</p><div class="card-links"><a href={z.guide.href}>{z.guide.label} →</a><a href={z.source}>Parks Canada source</a><button class="locate-area" hidden type="button" data-locate={z.id}>Locate area on map</button></div></article>)}
    </div><p id="wildlife-empty" hidden role="status">No area plan matches all those choices. Clear a filter, or choose another habitat or journey style. This is not a statement about which animals are present.</p>
  </div></section>
  <section class="section safety-section"><div class="container"><div class="section-header"><h2>Give wildlife room</h2><p>Minimum viewing distances are a starting point. Increase the space if your presence changes an animal’s behaviour.</p></div><div class="safety-grid">{wildlifeDistanceGroups.map(g=><div class="safety-card"><strong>{g.metres} metres minimum</strong><p>{g.species.join(', ')}</p><a href={g.source}>Parks Canada viewing guidance</a></div>)}<div class="safety-card"><strong>On the road</strong><p>Slow down, stay in your vehicle and move on. If stopping is safe and permitted, pull fully out of traffic, use hazards and keep it brief. Move on if a wildlife jam develops.</p><a href={wildlifeSources.viewing}>Roadside viewing guidance</a></div></div><p>Never feed, bait, surround or follow wildlife. Keep dogs leashed, control food and respect closures. Read the <a href="/wildlife-safety">encounter guide</a>, <a href="/bear-spray">bear-spray planning guide</a> and <a href="/wildlife-calendar">seasonal preparation calendar</a>.</p><p><strong>Report an encounter:</strong> <a href={wildlifeContacts.wildlifeReport.href}>{wildlifeContacts.wildlifeReport.phone}</a> once safe. For immediate danger or an emergency, <a href={wildlifeContacts.emergency.href}>call 911</a>.</p></div></section>
  <section class="section"><div class="container faq"><h2>Wildlife map questions</h2>{wildlifeTrackerFaqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}<p><a href="/wildlife">Species identification and historical photo guide →</a></p></div></section>
</BaseLayout>
<script>
  import { filterWildlifeAreas, wildlifeZones } from '../data/wildlifeZones';
  import { wildlifeSpeciesHabitats, wildlifeSpecies } from '../data/wildlifeFieldGuide';
  const form=document.querySelector<HTMLFormElement>('#wildlife-filters')!;
  const selectors=['species','habitat','season','visit'];
  const fields=Object.fromEntries(selectors.map(id=>[id,document.querySelector<HTMLSelectElement>(`#${id}-filter`)!]));
  const count=document.querySelector('#area-count')!;
  const empty=document.querySelector<HTMLElement>('#wildlife-empty')!;
  const context=document.querySelector('#species-context')!;
  const mapBox=document.querySelector<HTMLElement>('#wildlife-map')!;
  const feedback=document.querySelector('#map-feedback')!;
  const button=document.querySelector<HTMLButtonElement>('#load-wildlife-map')!;
  form.hidden=false;button.hidden=false;document.querySelectorAll<HTMLButtonElement>('[data-locate]').forEach(b=>b.hidden=false);
  let visible=wildlifeZones;
  let map:any=null, layer:any=null, leafletPromise:Promise<void>|null=null;
  function applyFilters(){
    visible=filterWildlifeAreas(Object.fromEntries(selectors.map(id=>[id,fields[id].value])),wildlifeSpeciesHabitats);
    const ids=new Set(visible.map(z=>z.id));
    document.querySelectorAll<HTMLElement>('[data-zone-id]').forEach(c=>c.hidden=!ids.has(c.dataset.zoneId!));
    count.textContent=`${visible.length} area ${visible.length===1?'plan':'plans'}`;
    empty.hidden=visible.length>0;
    const species=wildlifeSpecies.find(s=>s.id===fields.species.value);
    context.textContent=species?`${species.name}: ${species.identify} ${species.viewing} Area matches below reflect broad habitat, not sightings.`:'Explore the species field guide for identification and habitat context.';
    if(map)drawAreas();
  }
  form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('change',applyFilters);
  form.addEventListener('reset',()=>setTimeout(applyFilters,0));
  function loadLeaflet():Promise<void>{
    if((window as any).L?.map)return Promise.resolve();
    if(leafletPromise)return leafletPromise;
    leafletPromise=new Promise((resolve,reject)=>{
      if(!document.querySelector('#wildlife-leaflet-style')){const css=document.createElement('link');css.id='wildlife-leaflet-style';css.rel='stylesheet';css.href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';document.head.appendChild(css);}
      const script=document.createElement('script');script.src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';let settled=false;
      const timer=setTimeout(()=>finish(new Error('Map library timed out')),10000);
      function finish(error?:Error){if(settled)return;settled=true;clearTimeout(timer);script.onload=null;script.onerror=null;if(error){script.remove();leafletPromise=null;reject(error);}else resolve();}
      script.onload=()=>finish((window as any).L?.map?undefined:new Error('Map library unavailable'));
      script.onerror=()=>finish(new Error('Map library request failed'));document.head.appendChild(script);
    });return leafletPromise;
  }
  function drawAreas(){
    const L=(window as any).L;layer.clearLayers();
    visible.forEach(z=>{const popup=document.createElement('div');const title=document.createElement('strong');title.textContent=z.name;const note=document.createElement('p');note.textContent='Approximate public visitor-area reference. No animal report.';const link=document.createElement('a');link.href=`#${z.id}`;link.textContent='Read the area plan';popup.append(title,note,link);L.circleMarker(z.reference,{radius:7,color:'#173e2c',fillColor:'#e9ac47',fillOpacity:1,weight:2}).addTo(layer).bindPopup(popup);});
    if(visible.length)map.fitBounds(L.latLngBounds(visible.map(z=>z.reference)),{padding:[30,30],maxZoom:11});
  }
  async function showMap(){
    button.disabled=true;feedback.textContent='Loading the public-area map…';
    try{await loadLeaflet();mapBox.hidden=false;if(!map){const L=(window as any).L;map=L.map(mapBox).setView([51.35,-115.9],9);const tiles=L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>',maxZoom:14}).addTo(map);tiles.on('tileerror',()=>feedback.textContent='Some map background tiles could not load. The area references and complete text plans remain available.');layer=L.layerGroup().addTo(map);}map.invalidateSize();drawAreas();feedback.textContent='Map loaded. Markers are visitor-area references. Filters update both the map and the text plans.';button.textContent='Refresh area map';return true;
    }catch{if(map){try{map.remove();}catch{}map=null;layer=null;}mapBox.hidden=true;feedback.textContent='The map could not load. Use the complete area plans below, or retry the map.';button.textContent='Retry area map';return false;}finally{button.disabled=false;}
  }
  button.addEventListener('click',showMap);
  document.querySelectorAll<HTMLButtonElement>('[data-locate]').forEach(b=>b.addEventListener('click',async()=>{const z=visible.find(z=>z.id===b.dataset.locate);if(z&&await showMap()){map.setView(z.reference,11);mapBox.scrollIntoView({behavior:'smooth',block:'center'});mapBox.focus({preventScroll:true});}}));
</script>
<style>
.wild-hero{padding:4rem 0;background:linear-gradient(120deg,#173e2c,#35694d);color:white}.wild-hero h1{color:white;font-size:clamp(2.2rem,5vw,3.5rem);margin:.6rem 0}.wild-hero p{font-size:1.2rem;max-width:700px}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:.72rem;font-weight:700}.hero-links{display:flex;gap:1.3rem;align-items:center;flex-wrap:wrap;margin-top:1.5rem}.hero-links>a:not(.btn){color:white}.intro-panel{max-width:900px;margin-bottom:2rem}.intro-panel p{line-height:1.7;margin:.8rem 0}.wildlife-controls{display:flex;flex-wrap:wrap;gap:1rem;align-items:end;padding:1.3rem;background:var(--color-bg-alt);border-radius:12px}.wildlife-controls>div{display:grid;gap:.35rem;flex:1 1 180px}.wildlife-controls label{font-size:.85rem;font-weight:700}.wildlife-controls select{padding:.65rem;max-width:100%;min-width:0;border:1px solid #94a79b;border-radius:6px;background:white}.context-note{padding:1rem 0;line-height:1.6}.map-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}.map-toolbar p{font-weight:700}#map-feedback,.map-key{font-size:.83rem;line-height:1.6;margin:.7rem 0}#wildlife-map{height:460px;max-height:65vh;border-radius:12px;overflow:hidden}.zones-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,350px),1fr));gap:1.4rem;margin-top:2rem;scroll-margin-top:120px}.zone-card{padding:1.5rem;border:1px solid #d5e0d7;border-radius:14px;background:white;scroll-margin-top:120px}[hidden]{display:none!important}.zone-card h2{font-size:1.3rem;margin:.4rem 0}.zone-card h3{font-size:.9rem;margin:1rem 0 .25rem}.zone-card p{line-height:1.65;font-size:.9rem;color:#405347}.tags{display:flex;gap:.35rem;flex-wrap:wrap;margin:.75rem 0}.tags span{font-size:.7rem;padding:.25rem .5rem;background:#e9f0e8;border-radius:20px}.card-links{display:flex;gap:.8rem;flex-wrap:wrap;align-items:center;margin-top:1.2rem;font-size:.8rem}.locate-area{background:none;border:0;text-decoration:underline;cursor:pointer;color:var(--color-primary);font:inherit;padding:0}.safety-section{background:var(--color-bg-alt)}.safety-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:1rem;margin:1.5rem 0}.safety-card{background:white;border-radius:12px;padding:1.4rem}.safety-card strong{font-size:1.1rem}.safety-card p{line-height:1.6;margin:.6rem 0}.safety-card a{font-size:.8rem}.safety-section>.container>p{line-height:1.7;margin:1rem 0}.faq{max-width:900px}.faq details{padding:1rem 0;border-bottom:1px solid #d5e0d7}.faq summary{cursor:pointer;font-weight:700}.faq details p{margin:.8rem 0;line-height:1.7}
</style>
