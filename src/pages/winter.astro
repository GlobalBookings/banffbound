---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WinterStatusNotice from '../components/WinterStatusNotice.astro';
import { winterGuides as guides, winterMonths as months, winterFaqs as faqs } from '../data/winterHub';
const categories = [ ['all', 'Everything'], ['ski', 'Ski & ride'], ['snow', 'Beyond the lifts'], ['family', 'Family fun'], ['slow', 'Slow days'], ['practical', 'Trip essentials'] ];
---
<BaseLayout title="Banff Winter Guide: Ski Days, Snow Adventures & Places to Stay" description="Plan winter in Banff, Canmore and Lake Louise. Find ski lessons, a ski day planner, heli-skiing advice, family snow days, winter hotels and practical travel guides." lastUpdated="2026-10-29">
  <div class="container"><Breadcrumbs items={[{ label: 'Winter in Banff' }]} /></div>
  <section class="winter-hero">
    <div class="container hero-grid">
      <div class="winter-intro">
        <span class="eyebrow">Banff · Lake Louise · Canmore · Beyond</span>
        <h1>Winter in Banff.<br /><em>Your way.</em></h1>
        <p>First turns, a snowy trail, or a very good hot chocolate. Find your way into winter in the Canadian Rockies, one well-planned day at a time.</p>
        <div class="hero-actions"><a class="btn btn-accent" href="#find-your-winter">Find your winter day ↓</a><a class="hero-link" href="/ski-day-planner">Plan a ski day →</a></div>
        <p class="editorial-date">Winter guide · Reviewed 28 October 2026</p>
      </div>
      <div class="winter-cover"><img src="/images/blog/banff-in-winter.webp" alt="Winter landscape in the Canadian Rockies" width="800" height="650" fetchpriority="high" /><div class="cover-note"><span>Less rushing. More Rockies.</span><a href="/towns">Find your mountain base →</a></div></div>
    </div>
  </section>
  <nav class="winter-jumps container" aria-label="On this page"><a href="#find-your-winter">Explore the guides</a><a href="#when-to-go">Choose a month</a><a href="#winter-itinerary">A flexible 4-day trip</a><a href="#winter-essentials">The essentials</a><a href="#winter-faq">Winter questions</a></nav>
  <div class="container notice-wrap"><WinterStatusNotice /></div>
  <section class="section" id="find-your-winter">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Pick a mood. Make a plan.</span><h2>Find your winter day</h2><p>From your first lesson to a quieter day off the slopes. All guides are available without signing up.</p></div>
      <div class="guide-controls" id="guide-controls" hidden>
        <div class="filter-tabs" role="group" aria-label="Filter winter guides">{categories.map(([id, label]) => <button type="button" data-filter={id} aria-pressed={id === 'all'}>{label}</button>)}</div>
        <label class="guide-search">Search the winter guides<input id="winter-search" type="search" placeholder="Try skating, lessons, hotels…" autocomplete="off" /></label>
      </div>
      <p id="guide-count" class="result-count" aria-live="polite">{guides.length} ways to plan your winter</p>
      <div class="winter-guide-grid">{guides.map((g,i) => <a class="winter-guide" href={g.href} data-category={g.category} data-search={`${g.title} ${g.desc} ${g.tag}`.toLowerCase()}><div class="guide-top"><span class="guide-number">{String(i+1).padStart(2,'0')}</span><span class="guide-tag">{g.tag}</span></div><h3>{g.title}</h3><p>{g.desc}</p><span class="read-guide">Open guide <span aria-hidden="true">↗</span></span></a>)}</div>
      <div class="empty-state" id="winter-empty" hidden><h3>No guides match those filters</h3><p>Try a broader term, or start again with all winter guides.</p><button type="button" class="btn btn-outline" id="reset-winter">Reset filters</button></div>
    </div>
  </section>
  <section class="section month-section" id="when-to-go">
    <div class="container month-grid"><div class="section-heading"><span class="eyebrow">Timing changes the trip</span><h2>Which winter is yours?</h2><p>These are seasonal planning patterns. Openings, weather, snow and access need a fresh check before your visit.</p><a href="/monthly-weather" class="text-link">See weather by month →</a></div>
      <div><div class="month-buttons" id="month-buttons" role="group" aria-label="Choose a winter month" hidden>{months.map((m,i) => <button type="button" data-month={m.id} aria-pressed={i === 0}>{m.name}</button>)}</div><div class="month-content">{months.map((m) => <article id={`month-${m.id}`} class="month-panel"><span class="eyebrow">{m.name}</span><h3>{m.headline}</h3><p>{m.text}</p><p class="month-focus">{m.focus}</p></article>)}</div></div>
    </div>
  </section>
  <section class="section" id="winter-itinerary"><div class="container"><div class="section-heading"><span class="eyebrow">Enough room to change your mind</span><h2>A flexible four days in Banff</h2><p>Use this as a starting point. Swap days for the forecast and confirmed operations; avoid prepaying every hour.</p></div><div class="day-grid">
    <article><span>Day 01</span><h3>Arrive & settle in</h3><p>Transfer from Calgary, find your nearest transport stop, fit rental gear if needed, and take a short walk in town. Save the long drive for another day.</p><a href="/calgary-to-banff">Plan your arrival →</a></article>
    <article><span>Day 02</span><h3>Make one snow memory</h3><p>Book a first lesson or choose a guided winter outing. Give yourself warm-up breaks and a relaxed evening rather than another big activity.</p><a href="/learn-to-ski">Start with a lesson →</a></article>
    <article><span>Day 03</span><h3>Go at your own pace</h3><p>Keep skiing if that is your thing, or explore a town with lunch, galleries and a managed rink if open. Check current access before a canyon or hot springs visit.</p><a href="/towns">Explore the towns →</a></article>
    <article><span>Day 04</span><h3>Leave a little breathing room</h3><p>Have a leisurely breakfast, return rentals, and allow weather buffer for your airport transfer. An overnight heli-ski trip belongs on a separate, longer itinerary.</p><a href="/blog/banff-heli-skiing">Understand heli-ski logistics →</a></article>
  </div></div></section>
  <section class="stay-banner"><div class="container stay-inner"><div><span class="eyebrow">Where you sleep shapes your day</span><h2>A walkable town hotel?<br />A suite? A mountain lodge?</h2><p>Compare winter bases and the stays that suit them. Check your dates, total price and cancellation terms with the booking provider.</p><p class="affiliate-note">We may earn a commission from Expedia links, at no extra cost to you.</p></div><div class="stay-actions"><a href="/winter-stays" class="btn btn-accent">Find your winter stay →</a><a href="https://www.expedia.ca/Hotel-Search?destination=Banff%2C+Alberta&camref=1101l3MtWX" target="_blank" rel="sponsored noopener" class="hero-link">Check Banff dates on Expedia ↗</a></div></div></section>
  <section class="section" id="winter-essentials"><div class="container"><div class="section-heading"><span class="eyebrow">Small decisions, better days</span><h2>The winter essentials</h2></div><div class="essentials-grid">
    <article><h3>Choose the base before the hotel</h3><p>Banff town makes evenings and ski-shuttle access simpler. Canmore, Lake Louise, Field and Golden offer different trips. Check the last connection home before committing to a car-free stay.</p><a href="/towns">Compare all six bases →</a></article>
    <article><h3>Budget for the whole day</h3><p>A ski day can include lessons, rentals, a helmet, tickets, transport, food and parking. Check exactly what a first-timer bundle includes before adding a full-mountain lift ticket.</p><a href="/ski-pass-calculator">Compare ski pass options →</a></article>
    <article><h3>Let conditions set the plan</h3><p>Check resort operations, official closures and the weather. Natural ice is not made safe by a calendar date. Summer hiking routes can cross avalanche terrain in winter.</p><a href="https://parks.canada.ca/pn-np/ab/banff/activ/raquette-snowshoeing">Parks Canada winter route advice ↗</a></article>
    <article><h3>Make the journey part of the booking</h3><p>Ask the rental company about actual tires. Requirements vary by road and province; do not treat a general “winter-ready” label as proof. Check Alberta 511 and DriveBC before driving.</p><a href="/blog/banff-winter-driving">Read the winter driving guide →</a></article>
    <article><h3>Plan for the least mobile person</h3><p>Snowbanks, slopes and ice can change access. Confirm step-free transfers, winter pathways, accessible rooms and equipment with each operator. Use short outings near a warm indoor stop.</p><a href="/accessible-trails">Explore accessibility planning →</a></article>
    <article><h3>Keep one easy alternative</h3><p>A museum, gallery, café or relaxed meal can save a cold or low-visibility day. Check opening hours and pick an option near your accommodation before heading out.</p><a href="/arts-culture">Find a quieter day in town →</a></article>
  </div></div></section>
  <section class="section faq-section" id="winter-faq"><div class="container faq-inner"><div class="section-heading"><span class="eyebrow">Good questions before you book</span><h2>Winter in Banff, explained</h2></div>{faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}<p class="source-note">Editorial review: 28 October 2026. For trip-day decisions use <a href="https://parks.canada.ca/pn-np/ab/banff/bulletins">Parks Canada bulletins</a>, <a href="https://511.alberta.ca/">Alberta 511</a>, <a href="https://www.drivebc.ca/">DriveBC</a>, and your operator’s current information.</p></div></section>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Banff Winter Guide', url: 'https://banffbound.com/winter', dateModified: '2026-10-29', mainEntity: { '@type': 'ItemList', itemListElement: guides.map((g,i) => ({ '@type': 'ListItem', position: i+1, name: g.title, url: `https://banffbound.com${g.href}` })) } })} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />
</BaseLayout>
<script>
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('.winter-guide')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const search = document.querySelector<HTMLInputElement>('#winter-search')!;
  let active = 'all';
  const filter = () => {
    const term = search.value.trim().toLowerCase();
    let count = 0;
    for (const card of cards) { const show = (active === 'all' || card.dataset.category === active) && (card.dataset.search || '').includes(term); card.hidden = !show; if (show) count++; }
    buttons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.filter === active)));
    document.querySelector('#guide-count')!.textContent = `${count} ${count === 1 ? 'guide' : 'guides'} to explore`;
    document.querySelector<HTMLElement>('#winter-empty')!.hidden = count > 0;
  };
  document.querySelector<HTMLElement>('#guide-controls')!.hidden = false;
  buttons.forEach(b => b.addEventListener('click', () => { active = b.dataset.filter!; filter(); }));
  search.addEventListener('input', filter);
  document.querySelector('#reset-winter')!.addEventListener('click', () => { active = 'all'; search.value = ''; filter(); search.focus(); });
  const monthButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-month]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.month-panel')];
  const showMonth = (id: string) => { panels.forEach(p => p.hidden = p.id !== `month-${id}`); monthButtons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.month === id))); };
  document.querySelector<HTMLElement>('#month-buttons')!.hidden = false;
  monthButtons.forEach(b => b.addEventListener('click', () => showMonth(b.dataset.month!)));
  showMonth('november');
</script>
<style>
  [hidden] { display: none !important; }
  section[id] { scroll-margin-top: 115px; }
  .eyebrow { display: block; font-size: .73rem; letter-spacing: .13em; text-transform: uppercase; font-weight: 700; color: #6b552e; margin-bottom: .8rem; }
  .winter-hero { background: var(--color-primary); color: white; padding: 3rem 0; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: center; }
  .winter-intro .eyebrow { color: var(--color-accent-light); }
  .winter-intro h1 { color: white; font-size: clamp(2.8rem,5.6vw,4.7rem); line-height: 1.08; margin-bottom: 1.5rem; }
  .winter-intro h1 em { color: var(--color-accent-light); font-weight: inherit; }
  .winter-intro > p { max-width: 39rem; color: #e1e8e2; font-size: 1.05rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1.2rem; align-items: center; margin-top: 1.7rem; }
  .hero-link { color: white; text-decoration: underline; text-underline-offset: 5px; font-size: .9rem; }
  .winter-intro .editorial-date { font-size: .76rem; margin-top: 2rem; color: #c1d1c5; }
  .winter-cover { position: relative; border-radius: 120px 12px 12px 12px; overflow: hidden; background: #345942; }
  .winter-cover img { width: 100%; height: 440px; object-fit: cover; }
  .cover-note { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent,rgba(0,0,0,.8)); padding: 4rem 1.5rem 1.5rem; }
  .cover-note span { display: block; font-family: var(--font-heading); font-size: 1.5rem; }
  .cover-note a { font-size: .8rem; text-decoration: underline; }
  .winter-jumps { display: flex; gap: 1.4rem; flex-wrap: wrap; padding-top: 1.1rem; padding-bottom: 1.1rem; font-size: .8rem; border-bottom: 1px solid #deded3; }
  .winter-jumps a:hover { text-decoration: underline; }
  .notice-wrap { margin-top: 1.8rem; }
  .section-heading { max-width: 660px; margin-bottom: 2rem; }
  .section-heading h2 { margin-bottom: .9rem; }
  .section-heading p { color: var(--color-text-light); }
  .guide-controls { display: flex; flex-direction: column; gap: 1.2rem; }
  .filter-tabs, .month-buttons { display: flex; gap: .5rem; flex-wrap: wrap; }
  .filter-tabs button, .month-buttons button { font: inherit; font-size: .82rem; padding: .65rem 1rem; border: 1px solid #c7ccc2; background: transparent; border-radius: 999px; cursor: pointer; color: var(--color-primary); }
  button[aria-pressed="true"] { background: var(--color-primary); border-color: var(--color-primary); color: white; }
  .guide-search { max-width: 430px; font-size: .8rem; font-weight: 600; }
  .guide-search input { display: block; width: 100%; border: 1px solid #b4bbaf; padding: .85rem 1rem; border-radius: 8px; font: inherit; font-size: .95rem; background: white; margin-top: .35rem; }
  .result-count { font-size: .8rem; color: var(--color-text-light); margin: 1.3rem 0 .8rem; }
  .winter-guide-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .winter-guide { display: flex; flex-direction: column; padding: 1.6rem; border: 1px solid #e0e0d5; border-radius: 12px; background: white; transition: border-color .2s, transform .2s; }
  .winter-guide:hover { border-color: var(--color-primary); transform: translateY(-3px); }
  .guide-top { display: flex; align-items: center; justify-content: space-between; gap: .6rem; margin-bottom: 1.4rem; }
  .guide-number { color: #647a65; font-size: .8rem; font-weight: 600; }
  .guide-tag { font-size: .65rem; color: #655029; border-radius: 30px; background: #f5efdf; padding: .2rem .65rem; }
  .winter-guide h3 { font-size: 1.3rem; margin-bottom: .7rem; }
  .winter-guide p { font-size: .86rem; color: var(--color-text-light); margin-bottom: 1.5rem; }
  .read-guide { font-size: .78rem; font-weight: 600; color: var(--color-primary); margin-top: auto; display: flex; justify-content: space-between; }
  .empty-state { background: var(--color-bg-alt); border-radius: 12px; padding: 2rem; text-align: center; }
  .empty-state p { margin: .8rem 0 1.3rem; }
  .month-section, .faq-section { background: var(--color-bg-alt); }
  .month-grid { display: grid; grid-template-columns: .85fr 1.3fr; gap: 4rem; }
  .text-link { display: inline-block; color: var(--color-primary); font-weight: 600; font-size: .9rem; margin-top: 1rem; text-decoration: underline; }
  .month-panel { background: white; padding: 1.8rem; border-radius: 12px; margin-top: 1rem; }
  .month-panel h3 { font-size: 1.5rem; margin-bottom: 1rem; }
  .month-panel p { font-size: .9rem; }
  .month-focus { color: var(--color-primary); border-top: 1px solid #e1e4da; padding-top: 1rem; margin-top: 1rem; font-size: .78rem !important; font-weight: 600; }
  .day-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1.5rem; }
  .day-grid article { border-top: 3px solid var(--color-accent); padding-top: 1.3rem; }
  .day-grid span { color: #6b552e; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
  .day-grid h3 { margin: .6rem 0 .8rem; font-size: 1.3rem; }
  .day-grid p, .essentials-grid p { font-size: .88rem; color: var(--color-text-light); }
  .day-grid a, .essentials-grid a { display: inline-block; margin-top: 1rem; font-size: .8rem; color: var(--color-primary); font-weight: 600; text-decoration: underline; }
  .stay-banner { padding: 3.5rem 0; background: var(--color-primary); color: white; }
  .stay-inner { display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; align-items: center; }
  .stay-inner .eyebrow { color: var(--color-accent-light); }
  .stay-inner h2 { color: white; margin-bottom: 1rem; }
  .stay-inner p { color: #dce5db; font-size: .92rem; max-width: 600px; }
  .stay-inner .affiliate-note { font-size: .75rem; margin-top: .9rem; }
  .stay-actions { display: flex; flex-direction: column; align-items: center; gap: 1.2rem; }
  .essentials-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 2rem; }
  .essentials-grid h3 { font-size: 1.3rem; margin-bottom: .8rem; }
  .faq-inner { max-width: 900px; }
  details { border-bottom: 1px solid #cdcfc3; padding: 1.1rem 0; }
  summary { cursor: pointer; font-weight: 600; color: var(--color-primary); }
  details p { padding-top: .8rem; font-size: .9rem; }
  .source-note { font-size: .77rem; color: var(--color-text-light); margin-top: 2rem; }
  .source-note a { text-decoration: underline; }
  @media (max-width: 900px) { .hero-grid { gap: 1.8rem; } .winter-guide-grid, .essentials-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .day-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .month-grid { gap: 2rem; } }
  @media (max-width: 640px) { .winter-hero { padding: 2rem 0; } .hero-grid, .month-grid, .stay-inner { grid-template-columns: 1fr; } .winter-cover img { height: 280px; } .winter-cover { border-radius: 70px 12px 12px 12px; } .winter-guide-grid, .essentials-grid, .day-grid { grid-template-columns: 1fr; } .winter-jumps { gap: .7rem 1.1rem; } .winter-intro h1 { font-size: 2.9rem; } .stay-actions { align-items: flex-start; } }
  @media (prefers-reduced-motion: reduce) { .winter-guide { transition: none; } .winter-guide:hover { transform: none; } }
</style>
