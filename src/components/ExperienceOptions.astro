---
import { experienceOptionTarget, type BanffExperienceGroup } from '../data/banffExperiences';

interface Props { group: BanffExperienceGroup; contentId?: string; }
const { group, contentId = group.contentId } = Astro.props;
const headingId = `experience-options-${group.id}`;
---

<section class="experience-options" aria-labelledby={headingId} data-experience-options={group.id} data-landing-page="activity-guide" data-landing-id="activity-guide" data-content-id={contentId} data-content-type="activity-guide">
  <div class="options-heading"><p class="options-eyebrow">Choose the actual outing</p><h2 id={headingId}>Compare the booking options</h2><p>Check the departure, itinerary and selected option before paying. Each booking has its own dates, inclusions and terms.</p></div>
  {group.options.length > 12 && <form class="operator-option-controls" data-experience-option-controls role="search" aria-label="Find a booking option" hidden><label for={`option-search-${group.id}`}>Find an option<input id={`option-search-${group.id}`} type="search" placeholder="Experience, provider or departure" autocomplete="off" data-experience-option-search /></label><button type="reset">Reset</button></form>}
  <p class="operator-option-count" data-experience-option-count role="status" aria-live="polite">{group.options.length} {group.options.length === 1 ? 'booking option' : 'booking options'}</p>
  <div class="operator-options">
    {group.options.map(option => {
      const target = experienceOptionTarget(group, option);
      const details = option.details;
      const noticeId = `offer-notice-${option.productId}`;
      return <article class="operator-option" id={`offer-${option.productId}`} data-experience-option={option.productId} data-description-review={option.reviewState} data-option-search={`${details?.title || option.optionTitle} ${details?.provider || ''} ${details?.departure || ''} ${details?.description || ''}`.toLowerCase()}>
        <div class="operator-option-main">
          {details?.provider && <p class="operator-name">{details.provider}</p>}
          <h3>{details?.title || option.optionTitle}</h3>
          <p class="operator-summary">{details?.description || 'See the full itinerary and available options on GetYourGuide.'}</p>
          {details && <dl class="operator-facts">{details.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>}
          {target.launchState === 'held' && details && <p class="operator-notice" id={noticeId}>{target.seasonalNotice}</p>}
        </div>
        <div class="operator-option-action">
          <a class="operator-booking-link" href={target.bookingUrl} target="_blank" rel="noopener noreferrer sponsored" aria-label={`${target.label}: ${details?.title || option.optionTitle}; opens GetYourGuide in a new tab`} aria-describedby={target.launchState === 'held' && details ? noticeId : undefined} data-guide-id={group.id} data-content-id={contentId} data-content-type="activity-guide" data-landing-id="activity-guide" data-landing-placement="experience-option" data-offer-id={target.offerId} data-activity-target-id={target.id} data-paid-affiliate-campaign={target.paidCampaignLabel} data-affiliate-target-path={new URL(target.bookingUrl).pathname}>{target.label} <span aria-hidden="true">↗</span></a>
          <p>GetYourGuide · Affiliate link</p>
        </div>
        {details && <details class="operator-planning-notes"><summary>Planning notes for this option</summary><div><p>{details.lead}</p>{details.sections.map(section => <section aria-labelledby={`offer-${option.productId}-${section.id}`}><h4 id={`offer-${option.productId}-${section.id}`}>{section.title}</h4>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}<h4>Before booking</h4><ul>{details.bookingChecks.map(check => <li>{check}</li>)}</ul>{details.faqs.length > 0 && <><h4>Questions about this option</h4><dl class="operator-questions">{details.faqs.map(faq => <div><dt>{faq.question}</dt><dd>{faq.answer}</dd></div>)}</dl></>}<p class="operator-source-date">Product information checked <time datetime={details.checkedAt}>{details.checkedAt}</time>. Confirm the actual date and option with the provider.</p></div></details>}
      </article>;
    })}
  </div>
  {group.options.length > 12 && <button type="button" class="operator-show-all" data-experience-option-show-all hidden>Show all {group.options.length} options</button>}
  <p class="options-disclosure">BanffBound may earn a commission from qualifying bookings. Booking and payment take place with the provider.</p>
</section>

<script>
  function initExperienceOptions() {
    for (const section of document.querySelectorAll<HTMLElement>('[data-experience-options]')) {
      if (section.dataset.optionsReady) continue;
      const form = section.querySelector<HTMLFormElement>('[data-experience-option-controls]');
      const search = section.querySelector<HTMLInputElement>('[data-experience-option-search]');
      const showAll = section.querySelector<HTMLButtonElement>('[data-experience-option-show-all]');
      const status = section.querySelector<HTMLElement>('[data-experience-option-count]');
      const cards = [...section.querySelectorAll<HTMLElement>('[data-experience-option]')];
      if (!form || !search || !showAll || !status) continue;
      section.dataset.optionsReady = 'true';
      let expanded = false;
      function update() {
        const words = search!.value.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
        const matches = cards.filter(card => words.every(word => (card.dataset.optionSearch || '').includes(word)));
        let shown = 0;
        for (const card of cards) {
          const matchesSearch = matches.includes(card);
          const visible = matchesSearch && (expanded || shown < 12);
          card.hidden = !visible;
          if (visible) shown++;
        }
        status!.textContent = `${shown} of ${matches.length} ${words.length ? 'matching options' : 'booking options'}`;
        showAll!.textContent = `Show all ${matches.length} options`;
        showAll!.hidden = expanded || matches.length <= 12;
      }
      form.hidden = false;
      form.addEventListener('submit', event => { event.preventDefault(); expanded = false; update(); });
      form.addEventListener('input', () => { expanded = false; update(); });
      form.addEventListener('reset', () => requestAnimationFrame(() => { expanded = false; update(); }));
      showAll.addEventListener('click', () => { expanded = true; update(); });
      update();
    }
  }
  initExperienceOptions();
  document.addEventListener('astro:page-load', initExperienceOptions);
</script>

<style>
  .operator-option-controls{display:flex;align-items:end;gap:.8rem;margin:0 0 1rem;padding:1rem 1.2rem;background:#eef3e8;border:1px solid #d2dfca;border-radius:4px}.operator-option-controls[hidden],.operator-option[hidden],.operator-show-all[hidden]{display:none!important}.operator-option-controls label{display:grid;gap:.4rem;flex:1;font-size:.8rem;font-weight:700;color:#3b5637}.operator-option-controls input{min-height:44px;width:100%;min-width:0;padding:.65rem .8rem;border:1px solid #a6b89d;border-radius:3px;background:#fff;font:inherit;font-size:.9rem;font-weight:400}.operator-option-controls button,.operator-show-all{min-height:44px;padding:.65rem 1rem;border:1px solid #66805a;border-radius:3px;font:inherit;font-size:.85rem;font-weight:700;background:white;color:#365333;cursor:pointer}.operator-option-count{font-size:.8rem!important;line-height:1.5!important;color:#607258;margin:0 0 1rem}.operator-show-all{display:block;margin:1.25rem auto 0}.operator-option-controls :is(input,button):focus-visible,.operator-show-all:focus-visible{outline:3px solid #a97624;outline-offset:3px}
  .experience-options{margin:2.6rem auto;max-width:1050px}.options-heading{margin-bottom:1.5rem;max-width:800px}.options-eyebrow{margin:0 0 .6rem;font-size:.7rem!important;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:#627356}.options-heading h2{font-size:clamp(1.9rem,3vw,2.6rem);line-height:1.15;margin:0 0 .8rem;color:var(--color-primary)}.options-heading>p:last-child{font-size:1rem;line-height:1.65}.operator-options{display:grid;gap:1.25rem}.operator-option{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,.3fr);gap:1rem 1.75rem;padding:1.7rem;border:1px solid #cdd9c7;border-radius:5px;background:#fff;scroll-margin-top:115px;min-width:0}.operator-name{margin:0 0 .5rem!important;font-size:.72rem!important;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#5d7055}.operator-option h3{font-size:clamp(1.45rem,2.6vw,1.95rem);line-height:1.2;color:var(--color-primary);margin:0 0 .8rem}.operator-summary{font-size:.97rem;line-height:1.65;margin:0 0 1rem}.operator-facts{margin:0;display:grid;gap:.65rem;font-size:.85rem;line-height:1.6}.operator-facts>div{display:grid;grid-template-columns:minmax(100px,.3fr) 1fr;gap:1rem}.operator-facts dt{font-weight:700;color:#53694b}.operator-facts dd{margin:0}.operator-notice{margin:1.1rem 0 0;padding:.8rem 1rem;border-left:3px solid #a97624;background:#fff8e7;font-size:.83rem;line-height:1.6;color:#594a30}.operator-option-action{align-self:start;padding-top:.4rem}.operator-booking-link{display:flex;justify-content:center;align-items:center;gap:.6rem;min-height:56px;padding:.8rem 1rem;border:1px solid #b34d23;border-radius:3px;background:#b34d23;color:white!important;font-size:1rem;font-weight:800;text-decoration:none!important;line-height:1.3;text-align:center}.operator-booking-link:hover{background:#923b1b}.operator-booking-link:focus-visible,.operator-planning-notes>summary:focus-visible{outline:3px solid #a97624;outline-offset:4px}.operator-option-action>p{font-size:.66rem!important;line-height:1.5!important;color:#5d6b54;text-align:center;margin:.5rem 0 0}.operator-planning-notes{grid-column:1/-1;border-top:1px solid #e0e6dd;margin-top:.3rem;padding-top:.85rem}.operator-planning-notes>summary{font-size:.85rem;line-height:1.6;font-weight:700;cursor:pointer;min-height:28px}.operator-planning-notes>div{padding-top:.5rem;max-width:850px}.operator-planning-notes p,.operator-planning-notes li,.operator-questions{font-size:.94rem;line-height:1.75}.operator-planning-notes h4{font-size:1.18rem;margin:1.5rem 0 .65rem;color:var(--color-primary)}.operator-planning-notes li{margin:.5rem 0}.operator-questions{display:grid;gap:1rem;margin:0}.operator-questions dt{font-weight:700}.operator-questions dd{margin:.35rem 0 0}.operator-source-date,.options-disclosure{font-size:.75rem!important;line-height:1.6!important;color:#5e6b58;margin-top:1.2rem}@media(max-width:650px){.operator-option{grid-template-columns:1fr;padding:1.2rem;gap:1rem}.operator-option-action{padding:0}.operator-facts>div{grid-template-columns:1fr;gap:.15rem}.operator-planning-notes{grid-column:1}.operator-booking-link{min-height:54px}.experience-options{margin:2rem auto}}
</style>
